---
import MetaTags from '../components/seo/MetaTags.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import '../styles/themes.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const envDefaultTheme = import.meta.env.PUBLIC_DEFAULT_THEME || 'obsidian';
---

<!doctype html>
<html lang="en" class="scroll-smooth dark" data-theme={envDefaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <MetaTags title={title} description={description} />
    <JsonLd />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Zero-Flash Theme Initialization Script (Runs synchronously before render) -->
    <script is:inline define:vars={{ envDefaultTheme }}>
      (function () {
        try {
          const stored = localStorage.getItem('theme-preference');
          const activeTheme = stored || envDefaultTheme || 'obsidian';
          document.documentElement.setAttribute('data-theme', activeTheme);
          if (activeTheme === 'cleanroom') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', envDefaultTheme || 'obsidian');
        }
      })();
    </script>
  </head>
  <body class="bg-theme-base text-theme-secondary font-sans antialiased min-h-screen relative overflow-x-hidden selection:bg-theme-accent/25 selection:text-theme-accent">
    <!-- Ambient Radial Mesh Glows -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-theme-accent/10 rounded-full blur-[128px]"></div>
      <div class="absolute top-1/3 -right-40 w-[30rem] h-[30rem] bg-theme-secondaryAccent/10 rounded-full blur-[140px]"></div>
      <div class="absolute bottom-10 left-1/4 w-[32rem] h-[32rem] bg-theme-accent/5 rounded-full blur-[160px]"></div>
      <!-- Subtle Grid Pattern Overlay -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--border-subtle)_1px,transparent_1px),linear-gradient(to_bottom,var(--border-subtle)_1px,transparent_1px)] bg-[size:32px_32px] opacity-25"></div>
    </div>

    <!-- Main App Container -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <style is:global>
      /* Custom modern scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg-base);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--border-subtle);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--border-strong);
      }
    </style>
  </body>
</html>
