---
import MetaTags from '../components/seo/MetaTags.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import ResumeModal from '../components/ResumeModal.astro';
import HotkeysModal from '../components/HotkeysModal.astro';
import GpgModal from '../components/GpgModal.astro';
import ScrollTelemetryHUD from '../components/ScrollTelemetryHUD.astro';
import '../styles/themes.css';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
  type?: string;
  date?: string;
  section?: string;
}

const { title, description, canonicalURL, image, type = 'website', date, section } = Astro.props;
const envDefaultTheme = import.meta.env.PUBLIC_DEFAULT_THEME || 'swiss';
const isInitialDark = envDefaultTheme === 'obsidian' || envDefaultTheme === 'amber' || envDefaultTheme === 'synthwave' || envDefaultTheme === 'emerald';
---

<!doctype html>
<html lang="en" class={`scroll-smooth ${isInitialDark ? 'dark' : ''}`} data-theme={envDefaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <!-- Preload Self-Hosted Critical Fonts (Eliminates Font-Swap Reflow & Zero External Chains) -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <MetaTags title={title} description={description} canonicalURL={canonicalURL} image={image} type={type} date={date} section={section} />
    <JsonLd />
    <link rel="alternate" type="application/rss+xml" title="Mahmudul Hasan Projects RSS Feed" href="/rss.xml" />
    <link rel="ai-catalog" type="application/json" href="/.well-known/ai-catalog.json" />
    <link rel="ard" type="application/json" href="/.well-known/ard.json" />
    <link rel="agent-card" type="application/json" href="/.well-known/agent-card.json" />
    <link rel="agent-skills" type="application/json" href="/.well-known/agent-skills.json" />
    <link rel="pgpkey" type="application/pgp-keys" href="/mhcybroot-key.asc" />
    <link rel="author" href="https://mahmudulhasan.info.bd/#contact" />

    <!-- Zero-Flash Theme Initialization Script (Runs synchronously before render) -->
    <script is:inline define:vars={{ envDefaultTheme }}>
      (function () {
        try {
          const urlTheme = new URLSearchParams(window.location.search).get('theme');
          const stored = urlTheme || localStorage.getItem('theme-preference');
          const activeTheme = stored || envDefaultTheme || 'swiss';
          document.documentElement.setAttribute('data-theme', activeTheme);
          if (activeTheme === 'cleanroom' || activeTheme === 'swiss') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
          const themeColors = {
            swiss: '#F8F9FF',
            obsidian: '#090D16',
            amber: '#0B0904',
            synthwave: '#0B0514',
            emerald: '#040B07',
            cleanroom: '#FFFFFF',
          };
          const metaTheme = document.querySelector('meta[name="theme-color"]');
          if (metaTheme && themeColors[activeTheme]) {
            metaTheme.setAttribute('content', themeColors[activeTheme]);
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', envDefaultTheme || 'swiss');
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="bg-theme-base text-theme-secondary font-sans antialiased min-h-screen relative overflow-x-hidden selection:bg-theme-accent selection:text-white">
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:rounded-sm focus:bg-theme-accent focus:text-white focus:font-mono focus:text-xs focus:font-bold focus:shadow-2xl focus:outline-none"
    >
      Skip to main content
    </a>

    <!-- Main App Container -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <!-- Interactive Resume Dossier Modal (Global Scope) -->
    <ResumeModal />

    <!-- Hotkeys Command Palette Matrix (Global Scope) -->
    <HotkeysModal />

    <!-- GPG Cryptographic Verification Modal (Global Scope) -->
    <GpgModal />

    <!-- Floating Telemetry & Scroll HUD (Global Scope) -->
    <ScrollTelemetryHUD />

    <style is:global>
      /* Custom modern scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg-base);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--border-subtle);
        border-radius: 2px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--border-strong);
      }

      @media print {
        #theme-switcher-container,
        #theme-dropdown-menu,
        #mobile-menu-toggle,
        #mobile-drawer,
        #mobile-drawer-overlay,
        #hotkeys-modal,
        #gpg-modal,
        #reading-progress-bar,
        .theme-glow-sphere {
          display: none !important;
        }
      }
    </style>

    <!-- Telemetry Service Worker Registration (Offline Resilience) -->
    <script is:inline>
      if ('serviceWorker' in navigator && (window.location.protocol === 'https:' || window.location.hostname === 'localhost')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }

      // DevTools Systems Engineering Telemetry Console Banner
      try {
        console.log(
          '%c MH // SYS-ARCH :: ZERO-FAULT TOLERANCE %c\n' +
          'Engineer: Mahmudul Hasan (@mhcybroot)\n' +
          'Discipline: Software & Smart Hardware Systems Engineer\n' +
          'Coordinates: [23.8103° N, 90.4125° E] (Dhaka, Bangladesh)\n' +
          'Core Stack: Rust 2024 (Axum, Tokio), Java 21 (Loom, Spring Boot), ZKTeco ADMS, RTSP, Astro\n' +
          'Direct Route: info@mahmudulhasan.info.bd\n' +
          'Hotkeys: Press [?] anywhere to launch Command Matrix.\n',
          'background: #BA3C00; color: #FFFFFF; font-weight: bold; font-family: monospace; font-size: 12px; padding: 3px 6px; border-radius: 2px;',
          'color: inherit; font-family: monospace; font-size: 11px; line-height: 1.5;'
        );
      } catch (e) {}
    </script>
  </body>
</html>
