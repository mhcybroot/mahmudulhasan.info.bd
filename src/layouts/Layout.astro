---
import MetaTags from '../components/seo/MetaTags.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import '../styles/themes.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const envDefaultTheme = import.meta.env.PUBLIC_DEFAULT_THEME || 'swiss';
const isInitialDark = envDefaultTheme === 'obsidian' || envDefaultTheme === 'amber' || envDefaultTheme === 'synthwave' || envDefaultTheme === 'emerald';
---

<!doctype html>
<html lang="en" class={`scroll-smooth ${isInitialDark ? 'dark' : ''}`} data-theme={envDefaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <!-- Preload Critical Fonts (Eliminates Font-Swap Reflow & Flattens Network Tree) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <MetaTags title={title} description={description} />
    <JsonLd />
    <link rel="alternate" type="application/rss+xml" title="Mahmudul Hasan Projects RSS Feed" href="/rss.xml" />
    <link rel="ai-catalog" type="application/json" href="/.well-known/ai-catalog.json" />

    <!-- Zero-Flash Theme Initialization Script (Runs synchronously before render) -->
    <script is:inline define:vars={{ envDefaultTheme }}>
      (function () {
        try {
          const stored = localStorage.getItem('theme-preference');
          const activeTheme = stored || envDefaultTheme || 'swiss';
          document.documentElement.setAttribute('data-theme', activeTheme);
          if (activeTheme === 'cleanroom' || activeTheme === 'swiss') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', envDefaultTheme || 'swiss');
        }
      })();
    </script>
  </head>
  <body class="bg-theme-base text-theme-secondary font-sans antialiased min-h-screen relative overflow-x-hidden selection:bg-theme-accent selection:text-white">
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:rounded-sm focus:bg-theme-accent focus:text-white focus:font-mono focus:text-xs focus:font-bold focus:shadow-2xl focus:outline-none"
    >
      Skip to main content
    </a>

    <!-- Ambient Radial Mesh Glows -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="theme-glow-sphere absolute -top-40 -left-40 w-96 h-96 bg-theme-accent/10 rounded-full blur-[128px]"></div>
      <div class="theme-glow-sphere absolute top-1/3 -right-40 w-[30rem] h-[30rem] bg-theme-secondaryAccent/10 rounded-full blur-[140px]"></div>
      <div class="theme-glow-sphere absolute bottom-10 left-1/4 w-[32rem] h-[32rem] bg-theme-accent/5 rounded-full blur-[160px]"></div>
      <!-- Subtle Grid Pattern Overlay — 24px Swiss Cartesian Grid -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--border-subtle)_1px,transparent_1px),linear-gradient(to_bottom,var(--border-subtle)_1px,transparent_1px)] bg-[size:24px_24px] opacity-30"></div>
    </div>

    <!-- Main App Container -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <style is:global>
      /* Custom modern scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg-base);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--border-subtle);
        border-radius: 2px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--border-strong);
      }
    </style>

    <!-- Telemetry Service Worker Registration (Offline Resilience) -->
    <script is:inline>
      if ('serviceWorker' in navigator && (window.location.protocol === 'https:' || window.location.hostname === 'localhost')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }

      // DevTools Systems Engineering Telemetry Console Banner
      try {
        console.log(
          '%c MH // SYS-ARCH :: ZERO-FAULT TOLERANCE %c\n' +
          'Engineer: Mahmudul Hasan (@mhcybroot)\n' +
          'Discipline: Software & Smart Hardware Systems Engineer\n' +
          'Coordinates: [23.8103° N, 90.4125° E] (Dhaka, Bangladesh)\n' +
          'Core Stack: Rust 2024 (Axum, Tokio), Java 21 (Loom, Spring Boot), ZKTeco ADMS, RTSP, Astro\n' +
          'Direct Route: info@mahmudulhasan.info.bd\n' +
          'Hotkeys: Press [?] anywhere to launch Command Matrix.\n',
          'background: #FD761A; color: #FFFFFF; font-weight: bold; font-family: monospace; font-size: 12px; padding: 3px 6px; border-radius: 2px;',
          'color: inherit; font-family: monospace; font-size: 11px; line-height: 1.5;'
        );
      } catch (e) {}
    </script>
  </body>
</html>
