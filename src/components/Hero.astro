---
// Hero Section Component — Swiss Architectural Editorial
---

<section id="hero" class="relative pt-6 sm:pt-10 pb-12 sm:pb-16 border-b border-theme-border">
  <!-- Top Rubric Meta Bar -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div class="inline-flex items-center gap-2 border border-theme-border bg-theme-surface px-3 py-1 font-mono text-xs">
      <span class="w-2 h-2 bg-theme-accent shrink-0"></span>
      <span class="font-semibold text-theme-primary">Software &amp; Smart Hardware Systems Engineer • Dhaka, BD</span>
    </div>
    <div class="inline-flex items-center gap-2 font-mono text-xs text-theme-muted">
      <span class="text-theme-muted">[STATUS]</span>
      <span class="font-bold text-theme-primary">FIELD TESTED // ZERO-FAULT ARCHITECTURE</span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <!-- Left Column: Identity & Positioning -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Headline & Value Positioning — 64px Scale Display Hero -->
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-5xl lg:text-[54px] lg:leading-[62px] font-extrabold text-theme-primary tracking-tight">
          I Build Software &amp; Smart Hardware Systems That 
          <span class="inline-block relative">
            <span class="text-theme-secondary">Never Crash</span>
            <span class="absolute bottom-1 left-0 w-full h-1.5 bg-theme-accent"></span>
          </span>
          and 
          <span class="inline-block relative">
            <span class="text-theme-secondary">Never Slow Down.</span>
            <span class="absolute bottom-1 left-0 w-full h-1.5 bg-theme-accent"></span>
          </span>
        </h1>
        <p class="font-mono text-xs sm:text-sm text-theme-accent font-bold uppercase tracking-wider">
          Mahmudul Hasan (@mhcybroot) / Full-Stack Solutions &amp; Industrial IoT Automation
        </p>
      </div>

      <!-- Subtitle Narrative in Clear Plain English -->
      <p class="text-base sm:text-lg text-theme-secondary max-w-2xl leading-relaxed">
        From <strong class="text-theme-primary font-medium">automated car parking gates</strong> and <strong class="text-theme-primary font-medium">factory biometric attendance</strong> to <strong class="text-theme-primary font-medium">high-speed web &amp; mobile apps</strong>, I help businesses in Bangladesh and worldwide automate complex operations, eliminate expensive cloud subscriptions, and handle thousands of concurrent users with zero downtime.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="#systems"
          class="group inline-flex items-center gap-2 px-6 py-3 rounded-sm bg-theme-accent text-white font-mono text-xs sm:text-sm font-bold hover:brightness-110 transition-all shadow-sm active:scale-95 border border-theme-accent"
        >
          <span>See What I Build ↓</span>
        </a>

        <button
          id="hero-resume-btn"
          type="button"
          class="group inline-flex items-center gap-2 px-6 py-3 rounded-sm bg-theme-surface border border-theme-border text-theme-primary font-mono text-xs sm:text-sm font-semibold hover:border-theme-secondary hover:text-theme-secondary transition-all shadow-sm active:scale-95 cursor-pointer"
        >
          <svg class="w-4 h-4 text-theme-muted group-hover:text-theme-secondary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <span>View Printable Resume Dossier</span>
        </button>

        <a
          href="#contact"
          class="inline-flex items-center gap-1.5 px-4 py-3 rounded-sm text-theme-muted hover:text-theme-primary text-xs font-mono transition-colors"
        >
          <span>Direct Channel →</span>
        </a>
      </div>
    </div>

    <!-- Right Column: Specular Studio Portrait & Reliability Card -->
    <div class="lg:col-span-5 relative flex justify-center">
      <div class="relative w-full max-w-md rounded-sm p-2.5 bg-theme-surface border border-theme-border shadow-sm transition-all duration-300 hover:border-theme-accent">
        <!-- Portrait Container -->
        <div class="relative w-full aspect-square rounded-sm overflow-hidden border border-theme-border bg-theme-base group">
          <img
            src="/assets/images/avatar.jpg"
            alt="Mahmudul Hasan (@mhcybroot) - Systems Engineer Studio Portrait"
            width="400"
            height="400"
            class="w-full h-full object-cover contrast-105 transition-transform duration-700 ease-out group-hover:scale-105"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-theme-base/80 via-transparent to-transparent opacity-70 pointer-events-none"></div>

          <!-- Floating Location & Availability Pill -->
          <div class="absolute bottom-2.5 inset-x-2.5">
            <div class="flex items-center justify-between px-3 py-1.5 rounded-sm bg-theme-surface/95 border border-theme-border shadow-sm">
              <div class="flex items-center gap-2">
                <span class="inline-block w-2 h-2 bg-theme-accent"></span>
                <span class="font-mono text-xs text-theme-primary font-semibold">Dhaka, Bangladesh [UTC+6]</span>
              </div>
              <span class="font-mono text-[10px] text-theme-muted bg-theme-lowest px-1.5 py-0.5 border border-theme-border">ONLINE</span>
            </div>
          </div>
        </div>

        <!-- Reliability & Production Telemetry Sub-Card -->
        <div class="mt-2.5 p-3 rounded-sm bg-theme-lowest border border-theme-border space-y-2">
          <div class="flex items-center justify-between font-mono text-[10px] text-theme-muted border-b border-theme-border pb-1.5">
            <span class="flex items-center gap-1.5 font-bold text-theme-primary">
              <span>CORE SPECIALIZATION</span>
            </span>
            <span class="text-theme-accent font-mono flex items-center gap-1 font-bold">
              <span class="w-1.5 h-1.5 bg-theme-accent"></span>
              <span>ZERO FAULT TOLERANCE</span>
            </span>
          </div>

          <div class="grid grid-cols-2 gap-2 font-mono text-xs">
            <div>
              <div class="text-theme-muted text-[10px] uppercase tracking-wider font-semibold">System Uptime</div>
              <div class="text-theme-primary font-bold flex items-center gap-1 mt-0.5">
                <span>99.98%</span>
                <span class="text-[10px] text-theme-muted font-normal">• Benchmarked</span>
              </div>
            </div>
            <div>
              <div class="text-theme-muted text-[10px] uppercase tracking-wider font-semibold">Live Traffic</div>
              <div class="text-theme-secondary font-bold flex items-center gap-1 mt-0.5">
                <span>Production</span>
                <span class="text-[10px] text-theme-muted font-normal">/ Multi-Tenant</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Architectural Metrics Bar (4-Column Continuous Plate) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 bg-theme-surface border border-theme-border mt-10">
    <div class="p-4 border-b sm:border-b-0 sm:border-r border-theme-border relative">
      <div class="font-mono text-[10px] text-theme-muted mb-1">[BENCHMARK_01]</div>
      <div class="font-mono text-sm sm:text-base font-bold text-theme-primary mb-1">&lt;0.84s Gate Open Latency</div>
      <p class="text-xs text-theme-muted">Benchmarked RS485 loop with zero jitter</p>
      <span class="absolute top-2 right-2 text-theme-muted/50 font-mono text-xs">+</span>
    </div>
    <div class="p-4 border-b sm:border-b-0 lg:border-r border-theme-border relative">
      <div class="font-mono text-[10px] text-theme-muted mb-1">[BENCHMARK_02]</div>
      <div class="font-mono text-sm sm:text-base font-bold text-theme-primary mb-1">10,000+ RPS / Lane</div>
      <p class="text-xs text-theme-muted">Tokio Rust async worker pools</p>
      <span class="absolute top-2 right-2 text-theme-muted/50 font-mono text-xs">+</span>
    </div>
    <div class="p-4 border-b sm:border-b-0 sm:border-r border-theme-border relative">
      <div class="font-mono text-[10px] text-theme-muted mb-1">[BENCHMARK_03]</div>
      <div class="font-mono text-sm sm:text-base font-bold text-theme-primary mb-1">&lt;15MB RAM Core</div>
      <p class="text-xs text-theme-muted">Zero memory leak on bare metal</p>
      <span class="absolute top-2 right-2 text-theme-muted/50 font-mono text-xs">+</span>
    </div>
    <div class="p-4 relative">
      <div class="font-mono text-[10px] text-theme-muted mb-1">[BENCHMARK_04]</div>
      <div class="font-mono text-sm sm:text-base font-bold text-theme-primary mb-1">100% Offline-Ready</div>
      <p class="text-xs text-theme-muted">Local SQLite edge &amp; self-healing sync</p>
      <span class="absolute top-2 right-2 text-theme-muted/50 font-mono text-xs">+</span>
    </div>
  </div>
</section>
