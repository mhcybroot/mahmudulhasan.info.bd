---
// Hero Section Component — Human-First & Business Value Focus
---

<section id="hero" class="relative pt-8 sm:pt-14 pb-12 sm:pb-20">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <!-- Left Column: Identity & Positioning -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Verified Architect Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-theme-surface border border-theme-border backdrop-blur-sm shadow-sm hover:border-theme-accent/50 transition-colors">
        <svg class="w-4 h-4 text-theme-accent animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span class="font-mono text-xs text-theme-accent tracking-wide font-semibold">
          Software &amp; Smart Hardware Systems Engineer • Dhaka, BD
        </span>
      </div>

      <!-- Headline & Value Positioning -->
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-theme-primary tracking-tight leading-tight">
          I Build Software &amp; Smart Hardware Systems That <span class="text-transparent bg-clip-text bg-gradient-to-r from-theme-accent to-theme-secondaryAccent">Never Crash and Never Slow Down.</span>
        </h1>
        <p class="font-mono text-base sm:text-lg text-theme-accent tracking-tight flex items-center flex-wrap gap-2">
          <span class="font-bold text-theme-primary">
            Mahmudul Hasan
          </span>
          <span class="text-theme-muted font-normal">(@mhcybroot)</span>
          <span class="text-theme-muted text-xs sm:text-sm font-normal">/ Full-Stack Solutions &amp; Automation</span>
        </p>
      </div>

      <!-- Subtitle Narrative in Clear Plain English -->
      <p class="text-base sm:text-lg text-theme-secondary max-w-2xl leading-relaxed">
        From <strong class="text-theme-primary font-medium">automated car parking gates</strong> and <strong class="text-theme-primary font-medium">factory biometric attendance</strong> to <strong class="text-theme-primary font-medium">high-speed web &amp; mobile apps</strong>, I help businesses in Bangladesh and worldwide automate complex operations, eliminate expensive cloud subscriptions, and handle thousands of concurrent users with zero downtime.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href="#systems"
          class="group inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-theme-accent text-theme-lowest font-bold text-sm sm:text-base hover:brightness-110 transition-all shadow-[0_0_25px_var(--accent-glow)] active:scale-95"
        >
          <span>See What I Build</span>
          <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>

        <a
          href="#contact"
          class="group inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-theme-surface border border-theme-border text-theme-primary font-semibold text-sm sm:text-base hover:border-theme-accent hover:text-theme-accent transition-all shadow-sm active:scale-95 cursor-pointer"
        >
          <span>Discuss a Project</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <button
          id="hero-resume-btn"
          type="button"
          class="hidden sm:inline-flex items-center gap-1.5 px-4 py-3 rounded-xl text-theme-muted hover:text-theme-primary text-xs font-mono transition-colors cursor-pointer"
        >
          <span>Quick View Resume →</span>
        </button>
      </div>

      <!-- 4 Human-Centric Assurance Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-theme-border">
        <div class="p-3.5 rounded-xl bg-theme-card border border-theme-border hover:border-theme-accent/40 transition-colors">
          <div class="font-mono text-xl sm:text-2xl font-bold text-theme-accent tracking-tight">100%</div>
          <div class="font-mono text-xs text-theme-muted mt-1 flex items-center justify-between">
            <span>Crash-Proof</span>
            <span class="w-1.5 h-1.5 rounded-full bg-theme-accent"></span>
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-theme-card border border-theme-border hover:border-theme-secondaryAccent/40 transition-colors">
          <div class="font-mono text-xl sm:text-2xl font-bold text-theme-secondaryAccent tracking-tight">Hardware+Web</div>
          <div class="font-mono text-xs text-theme-muted mt-1 flex items-center justify-between">
            <span>End-to-End</span>
            <span class="w-1.5 h-1.5 rounded-full bg-theme-secondaryAccent"></span>
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-theme-card border border-theme-border hover:border-theme-accent/40 transition-colors">
          <div class="font-mono text-xl sm:text-2xl font-bold text-theme-primary tracking-tight">Zero Bloat</div>
          <div class="font-mono text-xs text-theme-muted mt-1 flex items-center justify-between">
            <span>Low Server Costs</span>
            <span class="w-1.5 h-1.5 rounded-full bg-theme-accent"></span>
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-theme-card border border-theme-border hover:border-theme-secondaryAccent/40 transition-colors">
          <div class="font-mono text-xl sm:text-2xl font-bold text-theme-secondaryAccent tracking-tight">2.5+ Yrs</div>
          <div class="font-mono text-xs text-theme-muted mt-1 flex items-center justify-between">
            <span>Live Production</span>
            <span class="w-1.5 h-1.5 rounded-full bg-theme-secondaryAccent"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Specular Studio Portrait & Reliability Card -->
    <div class="lg:col-span-5 relative flex justify-center">
      <div class="relative w-full max-w-md rounded-3xl p-2.5 bg-theme-card border border-theme-border backdrop-blur-xl shadow-2xl transition-all duration-300 hover:border-theme-accent/50 hover:shadow-[0_0_40px_var(--accent-glow)]">
        <!-- Portrait Container -->
        <div class="relative w-full aspect-square rounded-2xl overflow-hidden border border-theme-border bg-theme-base group">
          <img
            src="/assets/images/avatar.jpg"
            alt="Mahmudul Hasan (@mhcybroot) - Systems Engineer Studio Portrait"
            width="400"
            height="400"
            class="w-full h-full object-cover contrast-105 transition-transform duration-700 ease-out group-hover:scale-105"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-theme-base via-transparent to-transparent opacity-80 pointer-events-none"></div>

          <!-- Floating Location & Availability Pill -->
          <div class="absolute bottom-3 inset-x-3">
            <div class="flex items-center justify-between px-3 py-2 rounded-xl bg-theme-base/90 border border-theme-border backdrop-blur-md shadow-lg">
              <div class="flex items-center gap-2">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-theme-secondaryAccent opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-theme-secondaryAccent"></span>
                </span>
                <span class="font-mono text-xs text-theme-secondaryAccent font-semibold">Available for Projects • Dhaka, BD</span>
              </div>
              <span class="font-mono text-[10px] text-theme-muted bg-theme-surface px-2 py-0.5 rounded border border-theme-border">Ready</span>
            </div>
          </div>
        </div>

        <!-- Reliability & Production Telemetry Sub-Card -->
        <div class="mt-3 p-3.5 rounded-2xl bg-theme-base border border-theme-border space-y-2">
          <div class="flex items-center justify-between font-mono text-[11px] text-theme-muted border-b border-theme-border pb-2">
            <span class="flex items-center gap-1.5 font-semibold text-theme-primary">
              <svg class="w-3.5 h-3.5 text-theme-accent animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
              </svg>
              <span>CORE SPECIALIZATION</span>
            </span>
            <span class="text-theme-secondaryAccent font-mono flex items-center gap-1 font-bold">
              <span class="w-1.5 h-1.5 rounded-full bg-theme-secondaryAccent"></span>
              <span>100% RELIABLE</span>
            </span>
          </div>

          <div class="grid grid-cols-2 gap-2 font-mono text-xs">
            <div>
              <div class="text-theme-muted text-[10px] uppercase tracking-wider font-semibold">System Uptime</div>
              <div class="text-theme-accent font-bold flex items-center gap-1 mt-0.5">
                <span>99.98%</span>
                <span class="text-[10px] text-theme-muted font-normal">• Zero Loss</span>
              </div>
            </div>
            <div>
              <div class="text-theme-muted text-[10px] uppercase tracking-wider font-semibold">Live Traffic</div>
              <div class="text-theme-secondaryAccent font-bold flex items-center gap-1 mt-0.5">
                <span>High Volume</span>
                <span class="text-[10px] text-theme-muted font-normal">/ Production</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
