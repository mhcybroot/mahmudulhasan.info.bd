---
// Hero Section Component
---

<section id="hero" class="relative pt-8 sm:pt-14 pb-12 sm:pb-20">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <!-- Left Column: Identity & Positioning -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Verified Architect Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#0F172A]/90 border border-[#1E293B] backdrop-blur-sm shadow-sm hover:border-[#06B6D4]/50 transition-colors">
        <svg class="w-4 h-4 text-[#06B6D4] animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span class="font-mono text-xs text-[#38BDF8] tracking-wide font-medium">
          High-Throughput & Edge Systems Architect • Dhaka, BD
        </span>
      </div>

      <!-- Headline & Handle -->
      <div class="space-y-2">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[#F8FAFC] tracking-tight leading-tight">
          Mahmudul Hasan
        </h1>
        <p class="font-mono text-lg sm:text-xl text-[#38BDF8] tracking-tight flex items-center flex-wrap gap-2">
          <span class="font-semibold text-transparent bg-clip-text bg-gradient-to-r from-[#38BDF8] to-[#10B981]">
            @mhcybroot
          </span>
          <span class="text-[#64748B] text-sm sm:text-base font-normal">/ Systems & Concurrency Engineer</span>
        </p>
      </div>

      <!-- Subtitle Narrative -->
      <p class="text-base sm:text-lg text-[#94A3B8] max-w-2xl leading-relaxed">
        Full-Stack Software & Systems Engineer bridging the gap between high-throughput concurrent backends (<span class="text-[#F8FAFC] font-medium border-b border-[#38BDF8]/50 pb-0.5">Rust & Java 21</span>), low-level hardware protocols (<span class="text-[#F8FAFC] font-medium border-b border-[#10B981]/50 pb-0.5">ZKTeco ADMS, RTSP</span>), and modern reactive 3D platforms.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href="#systems"
          class="group inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-[#06B6D4] text-[#090D16] font-semibold text-sm sm:text-base hover:bg-[#38BDF8] transition-all shadow-[0_0_25px_rgba(6,182,212,0.35)] active:scale-95"
        >
          <span>Explore Systems</span>
          <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>

        <button
          id="hero-resume-btn"
          type="button"
          class="group inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-[#0F172A] border border-[#1E293B] text-[#F8FAFC] font-medium text-sm sm:text-base hover:border-[#38BDF8] hover:text-[#38BDF8] transition-all hover:shadow-[0_0_20px_rgba(56,189,248,0.15)] active:scale-95 cursor-pointer"
        >
          <span>Quick View Resume</span>
          <svg class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </button>
      </div>

      <!-- 4 Key Telemetry Metrics -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-[#1E293B]/70">
        <div class="p-3.5 rounded-lg bg-[#0F172A]/80 border border-[#1E293B] hover:border-[#06B6D4]/40 transition-colors">
          <div class="font-mono text-xl sm:text-2xl font-bold text-[#38BDF8] tracking-tight">2.5+ Yrs</div>
          <div class="font-mono text-[11px] text-[#94A3B8] mt-1 flex items-center justify-between">
            <span>Production Eng</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#06B6D4]"></span>
          </div>
        </div>

        <div class="p-3.5 rounded-lg bg-[#0F172A]/80 border border-[#1E293B] hover:border-[#10B981]/40 transition-colors">
          <div class="font-mono text-xl sm:text-2xl font-bold text-[#10B981] tracking-tight">Rust & Java</div>
          <div class="font-mono text-[11px] text-[#94A3B8] mt-1 flex items-center justify-between">
            <span>Axum & Spring 3.4</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
          </div>
        </div>

        <div class="p-3.5 rounded-lg bg-[#0F172A]/80 border border-[#1E293B] hover:border-[#38BDF8]/40 transition-colors">
          <div class="font-mono text-xl sm:text-2xl font-bold text-[#F8FAFC] tracking-tight">IoT & Edge</div>
          <div class="font-mono text-[11px] text-[#94A3B8] mt-1 flex items-center justify-between">
            <span>ADMS & RTSP</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#38BDF8]"></span>
          </div>
        </div>

        <div class="p-3.5 rounded-lg bg-[#0F172A]/80 border border-[#1E293B] hover:border-[#10B981]/40 transition-colors">
          <div class="font-mono text-xl sm:text-2xl font-bold text-[#38BDF8] tracking-tight">7+ Deploy</div>
          <div class="font-mono text-[11px] text-[#94A3B8] mt-1 flex items-center justify-between">
            <span>Multi-Node VPS</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Specular Studio Portrait & Edge Telemetry Card -->
    <div class="lg:col-span-5 relative flex justify-center">
      <div class="relative w-full max-w-md rounded-2xl p-2.5 bg-[#0F172A]/70 border border-[#1E293B] backdrop-blur-xl shadow-2xl transition-all duration-300 hover:border-[#38BDF8]/50 hover:shadow-[0_0_40px_rgba(56,189,248,0.2)]">
        <!-- Portrait Container -->
        <div class="relative w-full aspect-square rounded-xl overflow-hidden border border-[#1E293B]/70 bg-[#090D16] group">
          <img
            src="/assets/images/avatar.jpg"
            alt="Mahmudul Hasan (@mhcybroot) - Systems Engineer Studio Portrait"
            class="w-full h-full object-cover contrast-105 transition-transform duration-700 ease-out group-hover:scale-105"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#090D16] via-transparent to-transparent opacity-80 pointer-events-none"></div>

          <!-- Floating Location & Availability Pill -->
          <div class="absolute bottom-3 inset-x-3">
            <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-[#090D16]/90 border border-[#1E293B] backdrop-blur-md shadow-lg">
              <div class="flex items-center gap-2">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-[#10B981]"></span>
                </span>
                <span class="font-mono text-[11px] text-[#10B981] font-medium">Based in Dhaka, BD (UTC+6)</span>
              </div>
              <span class="font-mono text-[10px] text-[#94A3B8] bg-[#1E293B] px-1.5 py-0.5 rounded">Available for Roles</span>
            </div>
          </div>
        </div>

        <!-- Micro-Telemetry Sub-Card -->
        <div class="mt-3 p-3 rounded-xl bg-[#090D16]/90 border border-[#1E293B] space-y-2">
          <div class="flex items-center justify-between font-mono text-[10px] text-[#94A3B8] border-b border-[#1E293B] pb-1.5">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#38BDF8] animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
              </svg>
              <span>EDGE TELEMETRY NODE</span>
            </span>
            <span class="text-[#10B981] font-mono flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
              <span>ONLINE (0 err)</span>
            </span>
          </div>

          <div class="grid grid-cols-2 gap-2 font-mono text-[11px]">
            <div>
              <div class="text-[#64748B] text-[9px] uppercase tracking-wider">Dhaka PoP Latency</div>
              <div class="text-[#38BDF8] font-semibold flex items-center gap-1">
                <span>12ms</span>
                <span class="text-[9px] text-[#94A3B8]">• 99.98% SLA</span>
              </div>
            </div>
            <div>
              <div class="text-[#64748B] text-[9px] uppercase tracking-wider">Tokio Async Workers</div>
              <div class="text-[#10B981] font-semibold flex items-center gap-1">
                <span>16 Cores</span>
                <span class="text-[9px] text-[#94A3B8]">/ Active</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
