---
// Hero Section Component — Swiss Architectural Editorial
---

<section id="hero" class="pt-8 sm:pt-12 pb-12 sm:pb-16 border-b border-theme-border relative">
  <!-- Top Rubric Meta Bar -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 sm:mb-8">
    <div class="inline-flex items-center gap-2 border border-theme-border bg-theme-lowest px-3 py-1 font-mono text-xs">
      <span class="w-2 h-2 bg-theme-accent shrink-0"></span>
      <span class="font-semibold text-theme-primary">Software &amp; Smart Hardware Systems Engineer • Dhaka, BD</span>
    </div>
    <div class="inline-flex items-center gap-2 font-mono text-xs text-theme-secondary">
      <span class="text-theme-muted">[STATUS]</span>
      <span class="font-bold text-theme-primary">FIELD TESTED // ZERO-FAULT ARCHITECTURE</span>
    </div>
  </div>

  <div class="max-w-5xl">
    <h1 class="hidden md:block font-sans text-display-hero text-theme-primary tracking-tight mb-6">
      I Build Software &amp; Smart Hardware Systems That 
      <span class="inline-block relative">
        <span class="text-theme-secondary">Never Crash</span>
        <span class="absolute bottom-1 left-0 w-full h-1 bg-theme-accent"></span>
      </span>
      and 
      <span class="inline-block relative">
        <span class="text-theme-secondary">Never Slow Down.</span>
        <span class="absolute bottom-1 left-0 w-full h-1 bg-theme-accent"></span>
      </span>
    </h1>
    <h1 class="md:hidden font-sans text-display-hero-mobile text-theme-primary tracking-tight mb-6 leading-tight">
      I Build Software &amp; Smart Hardware Systems That 
      <span class="text-theme-secondary underline decoration-theme-accent">Never Crash</span> and 
      <span class="text-theme-secondary underline decoration-theme-accent">Never Slow Down.</span>
    </h1>
    <p class="font-mono text-xs sm:text-sm text-theme-accent font-bold uppercase tracking-wider mb-4">
      Mahmudul Hasan (@mhcybroot) / Full-Stack Solutions &amp; Industrial IoT Automation
    </p>
    <p class="text-base sm:text-lg text-theme-secondary max-w-3xl mb-8 leading-relaxed">
      From automated car parking gates and factory biometric attendance to high-speed web &amp; mobile apps, I help businesses in Bangladesh and worldwide automate complex operations, eliminate expensive cloud subscriptions, and handle thousands of concurrent users with zero downtime.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-wrap items-center gap-4 mb-10 sm:mb-12">
      <a
        href="#systems"
        class="inline-flex items-center gap-2 bg-theme-accent text-white font-mono text-xs sm:text-sm font-bold px-6 py-3.5 hover:brightness-110 transition-colors border border-theme-accent shadow-sm active:scale-95"
      >
        <span>See What I Build ↓</span>
      </a>

      <button
        id="hero-resume-btn"
        type="button"
        class="inline-flex items-center gap-2 bg-theme-lowest text-theme-primary font-mono text-xs sm:text-sm px-6 py-3.5 border border-theme-border hover:border-theme-secondary transition-colors cursor-pointer shadow-sm active:scale-95"
      >
        <svg class="w-4 h-4 text-theme-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        <span>View Printable Resume Dossier</span>
      </button>
    </div>
  </div>

  <!-- Architectural Metrics Bar (4-Column Continuous Plate) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 bg-theme-lowest border border-theme-border">
    <div class="p-4 sm:p-5 border-b sm:border-b-0 sm:border-r border-theme-border relative">
      <div class="font-mono text-[10px] text-theme-muted mb-1">[BENCHMARK_01]</div>
      <div class="text-base sm:text-lg font-bold text-theme-primary mb-1">&lt;0.84s Gate Open Latency</div>
      <p class="text-xs text-theme-muted">Benchmarked RS485 loop with zero jitter</p>
      <span class="absolute top-2 right-2 text-theme-muted/50 font-mono text-xs">+</span>
    </div>
    <div class="p-4 sm:p-5 border-b sm:border-b-0 lg:border-r border-theme-border relative">
      <div class="font-mono text-[10px] text-theme-muted mb-1">[BENCHMARK_02]</div>
      <div class="text-base sm:text-lg font-bold text-theme-primary mb-1">10,000+ RPS / Lane</div>
      <p class="text-xs text-theme-muted">Tokio Rust async worker pools</p>
      <span class="absolute top-2 right-2 text-theme-muted/50 font-mono text-xs">+</span>
    </div>
    <div class="p-4 sm:p-5 border-b sm:border-b-0 sm:border-r border-theme-border relative">
      <div class="font-mono text-[10px] text-theme-muted mb-1">[BENCHMARK_03]</div>
      <div class="text-base sm:text-lg font-bold text-theme-primary mb-1">&lt;15MB RAM Core</div>
      <p class="text-xs text-theme-muted">Zero memory leak on bare metal</p>
      <span class="absolute top-2 right-2 text-theme-muted/50 font-mono text-xs">+</span>
    </div>
    <div class="p-4 sm:p-5 relative">
      <div class="font-mono text-[10px] text-theme-muted mb-1">[BENCHMARK_04]</div>
      <div class="text-base sm:text-lg font-bold text-theme-primary mb-1">100% Offline-Ready</div>
      <p class="text-xs text-theme-muted">Local SQLite edge &amp; self-healing sync</p>
      <span class="absolute top-2 right-2 text-theme-muted/50 font-mono text-xs">+</span>
    </div>
  </div>
</section>
