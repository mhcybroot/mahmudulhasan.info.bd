---
// Header / Navigation Bar Component — Swiss Architectural Editorial
import ThemeSwitcher from './ThemeSwitcher.astro';
---

<header class="bg-theme-surface/95 backdrop-blur-md sticky top-0 z-40 border-b border-theme-border transition-all duration-200">
  <div class="flex items-center justify-between max-w-7xl mx-auto px-4 sm:px-6 h-16 w-full">
    <!-- Brand Anchor & Coordinates -->
    <div class="flex items-center gap-3">
      <a href="#hero" class="flex items-center gap-2 group transition-transform active:scale-[0.98]">
        <span class="inline-block w-2.5 h-2.5 bg-theme-accent shrink-0"></span>
        <span class="font-mono text-sm sm:text-base font-bold tracking-wider uppercase text-theme-primary group-hover:text-theme-accent transition-colors">
          MH // SYS-ARCH
        </span>
      </a>
      <span class="hidden lg:inline-block font-mono text-[10px] text-theme-muted bg-theme-lowest px-2 py-0.5 border border-theme-border">
        [23.8103° N, 90.4125° E]
      </span>
    </div>

    <!-- Desktop Navigation Links (Uppercase Monospace) -->
    <nav class="hidden md:flex items-center space-x-6 lg:space-x-8 font-mono text-xs uppercase tracking-wider text-theme-muted">
      <a href="#systems" class="nav-desktop-link text-theme-accent border-b-2 border-theme-accent py-4 font-semibold hover:text-theme-accent transition-colors">Flagship Systems</a>
      <a href="#deployments" class="nav-desktop-link hover:text-theme-accent py-4 transition-colors font-medium">Deployments</a>
      <a href="#arsenal" class="nav-desktop-link hover:text-theme-accent py-4 transition-colors font-medium">Arsenal</a>
      <a href="#chronicle" class="nav-desktop-link hover:text-theme-accent py-4 transition-colors font-medium">Chronicle</a>
      <a href="#endorsements" class="nav-desktop-link hover:text-theme-accent py-4 transition-colors font-medium">Endorsements</a>
      <a href="#contact" class="nav-desktop-link hover:text-theme-accent py-4 transition-colors font-medium">Contact</a>
    </nav>

    <!-- Trailing Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Telemetry Spec Badge -->
      <div class="hidden sm:flex items-center gap-1.5 px-2 py-1 bg-theme-lowest border border-theme-border font-mono text-[10px] text-theme-primary">
        <span class="w-1.5 h-1.5 rounded-full bg-theme-accent animate-pulse shrink-0"></span>
        <span class="font-semibold tracking-wider">SYS_SPEC // V4.2</span>
      </div>

      <!-- Theme Switcher Dropdown -->
      <ThemeSwitcher />

      <!-- Quick Dossier Modal Trigger -->
      <button
        id="nav-resume-btn"
        data-trigger-dossier="true"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm bg-theme-secondary text-white font-mono text-xs font-semibold hover:opacity-90 transition-all border border-theme-secondary cursor-pointer shadow-sm active:scale-95"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="hidden lg:inline">Interactive Resume Dossier</span>
        <span class="lg:hidden">Dossier</span>
      </button>

      <!-- Mobile Menu Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden p-2 rounded-sm text-theme-muted hover:text-theme-primary hover:bg-theme-lowest focus:outline-none"
        aria-label="Toggle Navigation Menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  function initNavbarScrollSpy() {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-desktop-link');
    if (!navLinks.length) return;

    const sectionIds = ['systems', 'deployments', 'arsenal', 'chronicle', 'endorsements', 'contact'];
    const sections = sectionIds
      .map(id => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href === `#${id}`) {
              link.classList.add('text-theme-accent', 'border-b-2', 'border-theme-accent', 'font-semibold');
              link.classList.remove('text-theme-muted', 'font-medium');
            } else {
              link.classList.remove('text-theme-accent', 'border-b-2', 'border-theme-accent', 'font-semibold');
              link.classList.add('text-theme-muted', 'font-medium');
            }
          });
        }
      });
    }, {
      rootMargin: '-20% 0px -65% 0px',
      threshold: 0
    });

    sections.forEach(section => observer.observe(section));
  }

  initNavbarScrollSpy();
  document.addEventListener('astro:page-load', initNavbarScrollSpy);
</script>
