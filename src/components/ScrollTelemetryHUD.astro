---
// Floating Architectural Telemetry & Back-To-Top HUD
---

<aside
  id="telemetry-hud"
  class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40 transition-all duration-300 opacity-0 pointer-events-none translate-y-2"
  aria-label="Scroll Telemetry & Quick Navigation"
>
  <div class="bg-theme-lowest/95 backdrop-blur-md border border-theme-border rounded-sm shadow-xl px-3 py-1.5 flex items-center gap-2.5 font-mono text-[10px] text-theme-secondary select-none">
    <div class="hidden sm:flex items-center gap-1.5 text-theme-muted border-r border-theme-border pr-2">
      <span class="w-1.5 h-1.5 rounded-full bg-theme-accent animate-pulse"></span>
      <span>[23.81° N, 90.41° E]</span>
    </div>

    <div class="flex items-center gap-1">
      <span class="text-theme-muted">ALT:</span>
      <span id="telemetry-alt" class="font-bold text-theme-primary min-w-[36px]">0PX</span>
    </div>

    <button
      id="btn-scroll-top"
      type="button"
      class="inline-flex items-center gap-1 pl-2 border-l border-theme-border text-theme-accent hover:text-theme-primary font-bold transition-colors cursor-pointer"
      title="Return to Root Node (Top)"
    >
      <span>TOP</span>
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
      </svg>
    </button>
  </div>
</aside>

<script>
  const hud = document.getElementById('telemetry-hud');
  const altText = document.getElementById('telemetry-alt');
  const topBtn = document.getElementById('btn-scroll-top');

  let ticking = false;

  function updateScroll() {
    const scrollY = Math.round(window.scrollY);

    if (scrollY > 250) {
      hud?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
      hud?.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
    } else {
      hud?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
      hud?.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
    }

    if (altText) {
      altText.textContent = `${scrollY}PX`;
    }

    ticking = false;
  }

  // Initialize altitude and visibility state immediately on mount
  updateScroll();

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(updateScroll);
      ticking = true;
    }
  }, { passive: true });

  topBtn?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });
</script>

<style>
  @media print {
    #telemetry-hud {
      display: none !important;
    }
  }
</style>
