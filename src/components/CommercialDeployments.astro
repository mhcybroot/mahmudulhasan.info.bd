---
// Live Commercial Deployments Component — Swiss Field Operations
const deployments = [
  {
    nodeId: "NODE // 01",
    title: "Skylink Innovations Ltd",
    url: "https://skylinkltd.ai",
    domain: "skylinkltd.ai",
    desc: "Enterprise biometric attendance, facial recognition terminals & security operations portal handling live workforce authentication with zero missing punches.",
    stack: "Java 21 • ZKTeco ADMS • Spring Boot • WebSockets"
  },
  {
    nodeId: "NODE // 02",
    title: "Finara Property Solutions LLC",
    url: "https://finaraprosolutions.com",
    domain: "finaraprosolutions.com",
    desc: "US Real Estate investment acquisition analysis & valuation portal with multi-parameter automated deal pipelines, mortgage modeling, and audit security.",
    stack: "React 19 • Node.js • Tailwind CSS • Cloudflare Edge"
  },
  {
    nodeId: "NODE // 03",
    title: "HomeSync Smart Automation",
    url: "https://homesyncllc.org",
    domain: "homesyncllc.org",
    caseStudyUrl: "/systems/homesync-iot",
    desc: "Interactive 3D IoT Smart Home Configurator with live hardware telemetry, lighting presets, perimeter sensors, and sub-second control response.",
    stack: "Three.js WebGL • MQTT • TypeScript • Zero-Lag"
  },
  {
    nodeId: "NODE // 04",
    title: "DreamZone Builders Inc",
    url: "https://dreamzonebuilders.com",
    domain: "dreamzonebuilders.com",
    desc: "Commercial architectural & structural engineering milestone tracking portfolio with high-fidelity asset rendering, blueprints, and floorplans.",
    stack: "Astro • Tailwind CSS • High-DPI Engine • Edge CDN"
  }
];
---

<section id="deployments" class="pt-12 pb-12 sm:pt-16 sm:pb-16 border-t border-theme-border space-y-8 scroll-mt-24">
  <!-- Section Heading — Swiss Division 02 -->
  <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-theme-border pb-3 gap-3">
    <div>
      <span class="font-mono text-xs text-theme-accent font-semibold tracking-wider uppercase block">
        // FIELD OPERATIONS :: DIVISION 02
      </span>
      <h2 class="text-headline-lg-mobile md:text-headline-lg font-bold text-theme-primary mt-1">Live Commercial Deployments</h2>
    </div>
    <div class="font-mono text-xs text-theme-muted">
      AUDIT_STATE: PRODUCTION HARDENED
    </div>
  </div>

  <!-- 2x2 Architectural Drafting Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {deployments.map((d) => (
      <div class="bg-theme-lowest border border-theme-border p-5 rounded-sm relative flex flex-col justify-between hover:border-theme-secondary transition-colors space-y-4">
        <div>
          <!-- Node Header Bar -->
          <div class="flex items-center justify-between border-b border-theme-border pb-2.5 mb-3 font-mono text-xs">
            <span class="text-theme-accent font-bold tracking-wider">{d.nodeId}</span>
            <a
              href={d.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-theme-secondary hover:text-theme-accent flex items-center gap-1 font-mono transition-colors"
            >
              <span>{d.domain}</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <h3 class="text-headline-sm font-bold text-theme-primary mb-2">
            {d.title}
          </h3>

          <p class="text-body-sm text-theme-secondary leading-relaxed mb-4">
            {d.desc}
          </p>
        </div>

        <div>
          <!-- Stack & Active Status Plate -->
          <div class="bg-[#eff4ff] dark:bg-theme-surface p-2.5 border border-theme-border font-mono text-xs text-theme-secondary flex justify-between items-center rounded-sm">
            <span>Stack: {d.stack}</span>
            <span class="text-theme-accent font-semibold flex items-center gap-1.5 shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-theme-accent animate-pulse"></span>
              ACTIVE
            </span>
          </div>

          {d.caseStudyUrl && (
            <div class="pt-2 text-right">
              <a
                href={d.caseStudyUrl}
                class="inline-flex items-center gap-1 text-xs font-mono font-semibold text-theme-secondary hover:text-theme-accent transition-colors"
              >
                <span>Explore 3D Case Study</span>
                <span class="text-theme-accent">→</span>
              </a>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
