---
// Contact Section Component — Swiss Division 06
---

<section id="contact" class="pt-12 pb-12 sm:pt-16 sm:pb-16 border-t border-theme-border scroll-mt-24">
  <!-- Master Blueprint Container -->
  <div class="rounded-sm border-2 border-theme-secondary bg-theme-lowest p-6 sm:p-10 space-y-6 relative shadow-sm">
    <div class="space-y-2 max-w-3xl">
      <span class="font-mono text-xs text-theme-accent font-semibold uppercase tracking-wider block">
        // DIRECT TRANSMISSION CHANNEL :: DIVISION 06
      </span>
      <h2 class="text-headline-lg-mobile md:text-headline-lg font-bold text-theme-primary tracking-tight flex items-center gap-2 group">
        <span>Have a Complex System in Mind? Let's Build Something Rock-Solid.</span>
        <a href="#contact" class="opacity-0 group-hover:opacity-100 text-theme-accent transition-opacity text-base font-mono" title="Permanent section link">#</a>
      </h2>
      <p class="text-sm sm:text-base text-theme-secondary leading-relaxed">
        Available for industrial automation, custom high-throughput backends, hardware firmware integrations, and enterprise web/mobile applications with zero downtime.
      </p>
    </div>

    <!-- Primary Contact Route Box -->
    <!--email_off-->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center bg-[#eff4ff] dark:bg-theme-surface border border-theme-border p-4 sm:p-5 rounded-sm">
      <div class="md:col-span-8 flex flex-col">
        <span class="font-mono text-[10px] text-theme-muted uppercase mb-1">PRIMARY INBOX (ENCRYPTED ROUTE):</span>
        <span id="footer-contact-email" class="font-mono text-sm sm:text-lg font-bold text-theme-primary select-all">
          info@mahmudulhasan.info.bd
        </span>
      </div>
      <div class="md:col-span-4 flex flex-wrap gap-2 justify-start md:justify-end">
        <button
          id="btn-copy-email"
          type="button"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-sm bg-theme-secondary text-white font-mono text-xs font-semibold hover:brightness-110 transition-all border border-theme-secondary shadow-sm active:scale-95 cursor-pointer"
        >
          <svg id="copy-icon" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span id="copy-btn-text">Copy Email</span>
        </button>

        <a
          href="mailto:info@mahmudulhasan.info.bd"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-sm bg-theme-accent text-white font-mono text-xs font-bold hover:brightness-110 transition-all border border-theme-accent shadow-sm active:scale-95"
        >
          <span>Send Mail</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
    <!--/email_off-->

    <!-- Telemetry Details Grid (3-Column Plate) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-theme-border font-mono text-xs">
      <div>
        <span class="text-theme-muted text-[10px] uppercase block mb-1">PHONE &amp; WHATSAPP:</span>
        <a href="tel:+8801410749454" class="text-theme-primary hover:text-theme-accent font-bold text-sm transition-colors inline-block">+880 1410-749454</a>
      </div>
      <div>
        <span class="text-theme-muted text-[10px] uppercase block mb-1">PRIMARY PHYSICAL DISPATCH:</span>
        <span class="text-theme-primary font-bold text-sm">Dhaka, Bangladesh [UTC+6]</span>
      </div>
      <div>
        <span class="text-theme-muted text-[10px] uppercase block mb-1">SERVICE LEVEL AGREEMENT:</span>
        <span class="text-theme-accent font-bold text-sm">&lt; 4 Hours Response Time</span>
      </div>
    </div>

    <!-- Social & Communication Channels -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-theme-border font-mono text-xs">
      <div class="flex flex-wrap items-center gap-2">
        <a
          href="https://github.com/mhcybroot"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm bg-theme-lowest border border-theme-border text-theme-secondary hover:text-theme-accent hover:border-theme-accent transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>GitHub (@mhcybroot)</span>
        </a>

        <a
          href="https://linkedin.com/in/mhcybroot"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm bg-theme-lowest border border-theme-border text-theme-secondary hover:text-theme-accent hover:border-theme-accent transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
          <span>LinkedIn (@mhcybroot)</span>
        </a>

        <button
          type="button"
          data-trigger-gpg="true"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm bg-theme-lowest border border-theme-border text-theme-secondary hover:text-theme-accent hover:border-theme-accent transition-colors cursor-pointer"
          title="Verify GPG Public Key & Fingerprint (Hotkey: G)"
        >
          <svg class="w-3.5 h-3.5 text-theme-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>GPG Key [G]</span>
        </button>
      </div>

      <div class="text-theme-muted text-[11px] flex items-center gap-2">
        <span class="inline-block w-2 h-2 bg-theme-accent"></span>
        <span>ZERO-FAULT TOLERANCE // FIELD PROVEN</span>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('btn-copy-email');
  const copyBtnText = document.getElementById('copy-btn-text');

  copyBtn?.addEventListener('click', async () => {
    const email = 'info@mahmudulhasan.info.bd';
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(email);
      } else {
        const ta = document.createElement('textarea');
        ta.value = email;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      if (copyBtnText) copyBtnText.textContent = 'COPIED TO BUFFER [OK]';
      copyBtn?.classList.add('bg-theme-accent', 'border-theme-accent');
      setTimeout(() => {
        if (copyBtnText) copyBtnText.textContent = 'Copy Email';
        copyBtn?.classList.remove('bg-theme-accent', 'border-theme-accent');
      }, 2000);
    } catch {
      try {
        const ta = document.createElement('textarea');
        ta.value = email;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        if (copyBtnText) copyBtnText.textContent = 'COPIED TO BUFFER [OK]';
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = 'Copy Email';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy email: ', err);
      }
    }
  });
</script>
