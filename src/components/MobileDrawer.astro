---
// Mobile Navigation Drawer Component
---

<div id="mobile-drawer-overlay" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"></div>

<aside
  id="mobile-drawer"
  class="fixed top-0 right-0 bottom-0 w-72 sm:w-80 bg-theme-base border-l border-theme-border z-50 transform translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col p-6 shadow-2xl"
  aria-label="Mobile Navigation"
  aria-hidden="true"
  inert
>
  <div class="flex items-center justify-between pb-6 border-b border-theme-border">
    <div class="flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-theme-secondaryAccent animate-ping"></span>
      <span class="font-mono text-sm font-semibold text-theme-primary">~/mhcybroot</span>
    </div>
    <button id="mobile-drawer-close" class="p-2 text-theme-muted hover:text-theme-primary rounded-sm hover:bg-theme-surface" aria-label="Close menu">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="flex flex-col space-y-4 py-6 font-mono text-sm uppercase tracking-wider text-theme-muted">
    <a href="/#hero" class="mobile-nav-link hover:text-theme-accent py-1.5 transition-colors">Overview</a>
    <a href="/#systems" class="mobile-nav-link hover:text-theme-accent py-1.5 transition-colors">Flagship Systems</a>
    <a href="/#deployments" class="mobile-nav-link hover:text-theme-accent py-1.5 transition-colors">Deployments</a>
    <a href="/#arsenal" class="mobile-nav-link hover:text-theme-accent py-1.5 transition-colors">Arsenal</a>
    <a href="/#chronicle" class="mobile-nav-link hover:text-theme-accent py-1.5 transition-colors">Chronicle</a>
    <a href="/#endorsements" class="mobile-nav-link hover:text-theme-accent py-1.5 transition-colors">Endorsements</a>
    <a href="/#contact" class="mobile-nav-link hover:text-theme-accent py-1.5 transition-colors">Contact</a>
  </nav>

  <!-- Mobile Quick Theme Switcher Pills -->
  <div class="pt-4 pb-2 border-t border-theme-border space-y-2">
    <div class="font-mono text-[10px] text-theme-muted uppercase tracking-wider">Quick Visual Theme</div>
    <div class="grid grid-cols-6 gap-1.5">
      <button type="button" class="mobile-theme-pill h-7 rounded-sm border border-theme-border bg-[#FD761A] hover:scale-105 transition-transform" data-theme="swiss" title="Swiss Editorial"></button>
      <button type="button" class="mobile-theme-pill h-7 rounded-sm border border-theme-border bg-[#38BDF8] hover:scale-105 transition-transform" data-theme="obsidian" title="Obsidian Telemetry"></button>
      <button type="button" class="mobile-theme-pill h-7 rounded-sm border border-theme-border bg-[#F59E0B] hover:scale-105 transition-transform" data-theme="amber" title="Amber Cockpit"></button>
      <button type="button" class="mobile-theme-pill h-7 rounded-sm border border-theme-border bg-[#EC4899] hover:scale-105 transition-transform" data-theme="synthwave" title="Neon Synthwave"></button>
      <button type="button" class="mobile-theme-pill h-7 rounded-sm border border-theme-border bg-[#10B981] hover:scale-105 transition-transform" data-theme="emerald" title="Emerald Mainframe"></button>
      <button type="button" class="mobile-theme-pill h-7 rounded-sm border border-theme-border bg-[#FFFFFF] hover:scale-105 transition-transform" data-theme="cleanroom" title="Cleanroom Lab"></button>
    </div>
  </div>

  <div class="mt-auto pt-6 border-t border-theme-border flex flex-col gap-3">
    <div class="grid grid-cols-2 gap-2">
      <button
        id="mobile-drawer-hotkeys-btn"
        data-trigger-hotkeys="true"
        type="button"
        class="py-2 px-3 rounded-sm bg-theme-surface border border-theme-border text-xs font-mono text-theme-secondary hover:text-theme-accent hover:border-theme-accent transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
        title="Open Command Matrix"
      >
        <span>Hotkeys [?]</span>
      </button>
      <button
        id="mobile-drawer-gpg-btn"
        data-trigger-gpg="true"
        type="button"
        class="py-2 px-3 rounded-sm bg-theme-surface border border-theme-border text-xs font-mono text-theme-secondary hover:text-theme-accent hover:border-theme-accent transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
        title="View GPG Key"
      >
        <span>GPG Key [G]</span>
      </button>
    </div>

    <button
      id="mobile-drawer-resume-btn"
      data-trigger-dossier="true"
      type="button"
      class="w-full py-2.5 px-4 rounded-sm bg-theme-surface border border-theme-border text-xs font-mono font-semibold text-theme-primary hover:border-theme-accent hover:text-theme-accent flex items-center justify-center gap-2"
    >
      <span>Quick View Resume</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </button>
    <a
      href="/#contact"
      class="w-full py-2.5 px-4 rounded-sm bg-theme-accent text-white text-xs font-mono font-bold hover:brightness-110 text-center"
    >
      Connect Directly
    </a>
  </div>
</aside>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-drawer-close');
  const overlay = document.getElementById('mobile-drawer-overlay');
  const drawer = document.getElementById('mobile-drawer');
  const navLinks = document.querySelectorAll('.mobile-nav-link');
  const themePills = document.querySelectorAll('.mobile-theme-pill');

  function openDrawer() {
    drawer?.classList.remove('translate-x-full');
    drawer?.removeAttribute('aria-hidden');
    drawer?.removeAttribute('inert');
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    overlay?.classList.add('opacity-100');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeDrawer() {
    drawer?.classList.add('translate-x-full');
    drawer?.setAttribute('aria-hidden', 'true');
    drawer?.setAttribute('inert', '');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    overlay?.classList.remove('opacity-100');
    document.body.style.overflow = '';
    toggleBtn?.focus();
  }

  toggleBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
  document.getElementById('mobile-drawer-resume-btn')?.addEventListener('click', closeDrawer);
  document.getElementById('mobile-drawer-hotkeys-btn')?.addEventListener('click', closeDrawer);
  document.getElementById('mobile-drawer-gpg-btn')?.addEventListener('click', closeDrawer);
  navLinks.forEach(link => link.addEventListener('click', closeDrawer));

  themePills.forEach(pill => {
    pill.addEventListener('click', () => {
      const theme = pill.getAttribute('data-theme');
      if (theme) {
        document.documentElement.setAttribute('data-theme', theme);
        if (theme === 'cleanroom' || theme === 'swiss') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
        const themeColors: Record<string, string> = {
          swiss: '#F8F9FF',
          obsidian: '#090D16',
          amber: '#0B0904',
          synthwave: '#0B0514',
          emerald: '#040B07',
          cleanroom: '#FFFFFF',
        };
        const metaTheme = document.querySelector('meta[name="theme-color"]');
        if (metaTheme && themeColors[theme]) {
          metaTheme.setAttribute('content', themeColors[theme]);
        }
        localStorage.setItem('theme-preference', theme);
        closeDrawer();
      }
    });
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });
</script>
