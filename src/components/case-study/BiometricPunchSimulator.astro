---
// Interactive Biometric Time Attendance & Shift Rush Simulator
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl overflow-hidden shadow-2xl space-y-6 p-6 sm:p-8">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-xs font-mono text-cyan-400 uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
        Hardware Telemetry Simulation
      </div>
      <h3 class="text-xl sm:text-2xl font-mono font-bold text-white">
        Skylink HRMS 9:00 AM Shift-Rush Simulator
      </h3>
      <p class="text-xs text-slate-300 font-sans mt-0.5">
        Experience how Project Loom virtual threads process simultaneous biometric punches from multiple factory floor terminals without server lag or missing logs.
      </p>
    </div>

    <!-- Cycle Controller CTA -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="btn-rush-simulate"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-cyan-500 text-slate-950 font-mono text-xs font-bold hover:bg-cyan-400 active:scale-95 transition-all shadow-[0_0_20px_rgba(6,182,212,0.4)] cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Simulate 9:00 AM Rush</span>
      </button>

      <button
        type="button"
        id="btn-reset-hrms-sim"
        class="px-3 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 hover:text-white hover:border-slate-500 font-mono text-xs font-medium transition-all cursor-pointer"
        title="Reset Simulator"
      >
        Reset
      </button>
    </div>
  </div>

  <!-- Terminal Device Screen & Real-Time Stats -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Visual ZKTeco Hardware Terminal Mockup -->
    <div class="lg:col-span-5 flex flex-col items-center justify-center p-6 rounded-2xl bg-slate-950 border-2 border-slate-800 space-y-4 shadow-inner relative">
      <div class="absolute top-3 left-4 text-[9px] font-mono text-slate-400 uppercase tracking-widest font-bold flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        ZK-TECO TERMINAL // LIVE ADMS
      </div>

      <!-- Biometric Device Screen -->
      <div class="w-full max-w-xs p-5 rounded-xl bg-slate-900 border border-slate-700 text-center space-y-3 mt-4">
        <!-- Optical Sensor Glow -->
        <div id="sim-zk-sensor" class="w-16 h-16 mx-auto rounded-full bg-cyan-950 border-2 border-cyan-400/50 flex items-center justify-center text-2xl transition-all duration-300">
          👆
        </div>

        <div>
          <div id="sim-zk-screen-title" class="text-sm font-mono font-bold text-white">
            PLEASE PUNCH FINGER
          </div>
          <div id="sim-zk-screen-subtitle" class="text-xs font-mono text-slate-400 mt-0.5">
            Shift A • Ready for Ingestion
          </div>
        </div>

        <!-- Terminal Internal Time -->
        <div class="text-[11px] font-mono text-cyan-400 bg-slate-950 py-1 px-2 rounded border border-slate-800 inline-block">
          08:58:45 AM • 12ms PING
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2 pt-2">
        <button
          type="button"
          id="btn-single-punch"
          class="px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700 hover:border-cyan-400 font-mono text-xs text-slate-200 transition-colors font-medium cursor-pointer"
        >
          Single Punch
        </button>
        <button
          type="button"
          id="btn-double-punch"
          class="px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700 hover:border-emerald-400 font-mono text-xs text-slate-200 transition-colors font-medium cursor-pointer"
        >
          Test Double-Punch Filter
        </button>
      </div>
    </div>

    <!-- Live HR Dashboard Stats Grid -->
    <div class="lg:col-span-7 flex flex-col justify-between space-y-4">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
          <div class="text-[10px] text-slate-400 uppercase">Present Today</div>
          <div id="sim-stat-present" class="text-xl font-bold text-emerald-400 mt-1">42</div>
        </div>
        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
          <div class="text-[10px] text-slate-400 uppercase">Late Arrivals</div>
          <div id="sim-stat-late" class="text-xl font-bold text-amber-400 mt-1">3</div>
        </div>
        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
          <div class="text-[10px] text-slate-400 uppercase">Loom Threads</div>
          <div id="sim-stat-threads" class="text-xl font-bold text-cyan-300 mt-1">0</div>
        </div>
        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
          <div class="text-[10px] text-slate-400 uppercase">Lost Punches</div>
          <div class="text-xl font-bold text-emerald-400 mt-1">0 (0.0%)</div>
        </div>
      </div>

      <!-- Live Microsecond Terminal Log Output -->
      <div class="rounded-2xl bg-slate-950 border border-slate-800 p-4 font-mono text-xs space-y-2 overflow-x-auto shadow-inner h-48 flex flex-col justify-between">
        <div class="text-slate-400 border-b border-slate-800 pb-2 mb-1 flex justify-between items-center text-[11px] shrink-0">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            <span class="font-bold text-slate-200">[DAEMON-LOG: adms.http.push.listener]</span>
          </span>
          <span class="text-cyan-400 font-semibold">SPRING BOOT 3.4 // VIRTUAL THREADS</span>
        </div>
        <div id="sim-hrms-log" class="space-y-1.5 text-xs text-slate-300 overflow-y-auto flex-1">
          <div><span class="text-slate-400">08:58:00.000</span> [READY] ADMS endpoint listening on :8080/iclock/cdata. Heartbeat OK.</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initHrmsSimulator() {
    const sensor = document.getElementById('sim-zk-sensor');
    const screenTitle = document.getElementById('sim-zk-screen-title');
    const screenSubtitle = document.getElementById('sim-zk-screen-subtitle');
    const statPresent = document.getElementById('sim-stat-present');
    const statLate = document.getElementById('sim-stat-late');
    const statThreads = document.getElementById('sim-stat-threads');
    const hrmsLog = document.getElementById('sim-hrms-log');

    const btnRush = document.getElementById('btn-rush-simulate');
    const btnReset = document.getElementById('btn-reset-hrms-sim');
    const btnSingle = document.getElementById('btn-single-punch');
    const btnDouble = document.getElementById('btn-double-punch');

    let presentCount = 42;
    let lateCount = 3;

    function addLog(tag: string, msg: string, colorClass = 'text-slate-200') {
      if (!hrmsLog) return;
      const now = new Date();
      const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}.${String(now.getMilliseconds()).padStart(3, '0')}`;
      const div = document.createElement('div');
      div.className = colorClass;
      div.innerHTML = `<span class="text-slate-400 font-mono">${timeStr}</span> <span class="font-bold">[${tag}]</span> ${msg}`;
      hrmsLog.appendChild(div);
      hrmsLog.scrollTop = hrmsLog.scrollHeight;
    }

    function resetSimulation() {
      presentCount = 42;
      lateCount = 3;
      if (statPresent) statPresent.textContent = '42';
      if (statLate) statLate.textContent = '3';
      if (statThreads) statThreads.textContent = '0';
      if (screenTitle) screenTitle.textContent = 'PLEASE PUNCH FINGER';
      if (screenSubtitle) screenSubtitle.textContent = 'Shift A • Ready for Ingestion';
      if (sensor) {
        sensor.className = 'w-16 h-16 mx-auto rounded-full bg-cyan-950 border-2 border-cyan-400/50 flex items-center justify-center text-2xl transition-all duration-300';
      }
      if (hrmsLog) {
        hrmsLog.innerHTML = `<div><span class="text-slate-400">08:58:00.000</span> [READY] ADMS endpoint listening on :8080/iclock/cdata. Heartbeat OK.</div>`;
      }
    }

    function processPunch(empId: string, name: string, isLate = false) {
      if (sensor) {
        sensor.className = 'w-16 h-16 mx-auto rounded-full bg-emerald-950 border-2 border-emerald-400 shadow-[0_0_20px_rgba(16,185,129,0.8)] flex items-center justify-center text-2xl transition-all duration-300';
      }
      if (screenTitle) screenTitle.textContent = `THANK YOU, ${name.toUpperCase()}!`;
      if (screenSubtitle) screenSubtitle.textContent = `ID: ${empId} • Verified (PUNCH IN)`;

      if (isLate) {
        lateCount++;
        if (statLate) statLate.textContent = String(lateCount);
      } else {
        presentCount++;
        if (statPresent) statPresent.textContent = String(presentCount);
      }

      addLog('ADMS-PUSH', `POST /iclock/cdata?SN=ZK-99410&table=ATTLOG payload: <span class="text-cyan-300">${empId} \t 2026-10-29 08:59:10</span>`, 'text-cyan-300');
      addLog('LOOM-VIRTUAL', `VirtualThread[#${Math.floor(Math.random() * 8000) + 1000}] committed to DB in <span class="text-emerald-400 font-bold">11.4ms</span>. Broadcasted to live dashboard.`, 'text-emerald-300');

      setTimeout(() => {
        if (sensor) sensor.className = 'w-16 h-16 mx-auto rounded-full bg-cyan-950 border-2 border-cyan-400/50 flex items-center justify-center text-2xl transition-all duration-300';
        if (screenTitle) screenTitle.textContent = 'PLEASE PUNCH FINGER';
        if (screenSubtitle) screenSubtitle.textContent = 'Shift A • Ready for Ingestion';
      }, 1500);
    }

    btnSingle?.addEventListener('click', () => {
      processPunch('EMP-1049', 'Mahmudul Hasan');
    });

    btnDouble?.addEventListener('click', () => {
      processPunch('EMP-1049', 'Mahmudul Hasan');
      setTimeout(() => {
        addLog('DE-DUP-FILTER', 'Duplicate punch detected within 3-min sliding window. Merged with previous log, zero double-penalty.', 'text-amber-300');
      }, 300);
    });

    btnRush?.addEventListener('click', () => {
      resetSimulation();
      if (statThreads) statThreads.textContent = '50';
      addLog('BURST-INGRESS', 'Simulating 50 simultaneous factory shift workers punching at 8:59:58 AM...', 'text-amber-400');

      let completed = 0;
      const interval = setInterval(() => {
        completed += 5;
        presentCount += 5;
        if (statPresent) statPresent.textContent = String(presentCount);
        addLog('LOOM-BATCH', `VirtualThreads batch processed: ${completed}/50 punches ingested (0 drops, p99 latency: 12.8ms).`, 'text-emerald-300');

        if (completed >= 50) {
          clearInterval(interval);
          if (statThreads) statThreads.textContent = '0 (Idle)';
          addLog('RUSH-COMPLETE', '100% of punch records securely stored in PostgreSQL. Zero lost punches.', 'text-emerald-400 font-bold');
        }
      }, 350);
    });

    btnReset?.addEventListener('click', resetSimulation);
  }

  initHrmsSimulator();
  document.addEventListener('astro:page-load', initHrmsSimulator);
</script>
