---
// QuickBooks Ledger Sync: Automated Invoice Import, Tiered Bank Reconciliation & QBO API Engine Simulator
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl p-6 sm:p-8 space-y-8 shadow-2xl">
  <!-- Simulator Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-indigo-400 font-mono text-xs uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-indigo-400 animate-pulse"></span>
        Interactive Accounting Synchronization &amp; Reconciliation Sandbox
      </div>
      <h2 class="text-2xl sm:text-3xl font-mono font-bold text-white flex items-center gap-3">
        QuickBooks Ledger Sync Simulator
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 font-sans mt-1">
        Experience automated CSV header normalization, multi-tier bank reconciliation matching, and Intuit OAuth 2.0 payload generation in real time.
      </p>
    </div>

    <!-- Active Perspective Switcher -->
    <div class="flex items-center p-1 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono overflow-x-auto">
      <button
        type="button"
        id="qb-tab-ingest"
        class="qb-tab-btn px-3.5 py-1.5 rounded-lg bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 font-semibold transition-all shadow-sm"
        data-view="ingest"
      >
        📑 CSV Ingestion &amp; QBO Payload
      </button>
      <button
        type="button"
        id="qb-tab-recon"
        class="qb-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="recon"
      >
        ⚖️ Multi-Tier Reconciliation
      </button>
      <button
        type="button"
        id="qb-tab-oauth"
        class="qb-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="oauth"
      >
        🔐 OAuth 2.0 &amp; Token Vault
      </button>
    </div>
  </div>

  <!-- View 1: CSV Ingestion & QBO Payload (Default) -->
  <div id="qb-screen-ingest" class="qb-screen space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Source CSV Selection & Mapping Options -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
              Source Transaction Batch
            </span>
            <span class="text-[10px] text-slate-400 font-mono">InvoiceRowMapper.java</span>
          </div>

          <!-- Scenario Presets -->
          <div class="space-y-1.5">
            <label class="text-[11px] text-slate-300 font-sans font-semibold">Select Test Transaction Scenario:</label>
            <div class="grid grid-cols-1 gap-2">
              <button
                type="button"
                class="qb-preset-btn text-left p-2.5 rounded-xl border border-indigo-500/50 bg-indigo-950/30 text-white hover:border-indigo-400 transition-all text-xs"
                data-preset="valid_multiline"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>Standard Multi-Line Invoice</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono">READY</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">INV-2025-001 • Acme Corp • 2 Lines • Zero-Tax Compliant</div>
              </button>

              <button
                type="button"
                class="qb-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-preset="positive_tax"
              >
                <div class="font-bold flex items-center justify-between text-amber-300">
                  <span>Positive Tax-Rate Exception</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-mono">POLICY BLOCK</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">INV-2025-002 • Globex LLC • 8.25% Tax Rate Flagged</div>
              </button>

              <button
                type="button"
                class="qb-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-preset="duplicate_doc"
              >
                <div class="font-bold flex items-center justify-between text-rose-300">
                  <span>Duplicate QBO DocNumber Conflict</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 font-mono">EXISTS_IN_QBO</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">INV-2024-884 • Initech Inc • Idempotent Gateway Guard</div>
              </button>

              <button
                type="button"
                class="qb-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-preset="missing_duedate"
              >
                <div class="font-bold flex items-center justify-between text-orange-300">
                  <span>Malformed Schema Validation</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-orange-500/20 text-orange-300 font-mono">INVALID_ROW</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">Missing CustomerRef &amp; Blank DueDate Fields</div>
              </button>
            </div>
          </div>

          <!-- Raw CSV Viewport -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-[11px] text-slate-300 font-sans">
              <span class="font-semibold">Raw Unstructured CSV Buffer:</span>
              <span class="text-indigo-400 font-mono text-[10px]" id="qb-csv-lines-count">2 data rows</span>
            </div>
            <pre id="qb-raw-csv" class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-[10px] text-slate-300 font-mono overflow-x-auto whitespace-pre leading-relaxed max-h-36">Invoice_No,Client_Name,Date_Issued,Payment_Due,Service_Desc,Qty,Unit_Rate,Taxable,Tax_Rate
INV-2025-001,Acme Corporation,2025-05-18,2025-06-18,Backend Architecture Audit,1,2800.00,N,0.00
INV-2025-001,Acme Corporation,2025-05-18,2025-06-18,High-Concurrency Tuning,1,1450.00,N,0.00</pre>
          </div>

          <!-- Action Button -->
          <button
            type="button"
            id="qb-btn-execute-ingest"
            class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-indigo-500 to-sky-600 hover:from-indigo-400 hover:to-sky-500 text-white font-mono font-bold text-xs shadow-lg shadow-indigo-500/20 transition-all flex items-center justify-center gap-2"
          >
            <span>⚡ Parse, Normalize &amp; Validate</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Normalization Pipeline & QBO Payload -->
      <div class="lg:col-span-7 space-y-4">
        <!-- Live Validation Status Banner -->
        <div id="qb-status-banner" class="p-4 rounded-2xl bg-emerald-950/40 border border-emerald-500/40 text-emerald-300 text-xs font-mono flex items-start justify-between gap-3 shadow-lg">
          <div class="space-y-1">
            <div class="flex items-center gap-2 font-bold text-emerald-200">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span id="qb-banner-title">STATUS: READY_FOR_QBO_DISPATCH</span>
            </div>
            <p id="qb-banner-detail" class="text-slate-300 font-sans text-xs">
              All 2 invoice lines validated. Zero tax-rate compliance verified. QBO duplicate pre-flight query returned negative.
            </p>
          </div>
          <div class="text-right font-mono text-[11px] shrink-0">
            <div class="text-slate-400 text-[9px] uppercase">Latency</div>
            <div class="text-emerald-400 font-bold" id="qb-metric-latency">1.4ms</div>
          </div>
        </div>

        <!-- Normalization Mapping Matrix -->
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-sky-400"></span>
              Header Mapping &amp; Type Casting
            </span>
            <span class="text-[10px] text-sky-400">MappingProfileService.java</span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px]">
            <div class="p-2 rounded-xl bg-slate-900 border border-slate-800">
              <div class="text-[9px] text-slate-500 uppercase">Document Ref</div>
              <div class="font-bold text-indigo-300 font-mono text-xs" id="qb-map-doc">INV-2025-001</div>
              <div class="text-[9px] text-slate-400">Canonical: DocNumber</div>
            </div>
            <div class="p-2 rounded-xl bg-slate-900 border border-slate-800">
              <div class="text-[9px] text-slate-500 uppercase">Customer Ref</div>
              <div class="font-bold text-sky-300 font-mono text-xs truncate" id="qb-map-customer">Acme Corp</div>
              <div class="text-[9px] text-slate-400">Resolved ID: 419</div>
            </div>
            <div class="p-2 rounded-xl bg-slate-900 border border-slate-800">
              <div class="text-[9px] text-slate-500 uppercase">Line Item Sum</div>
              <div class="font-bold text-emerald-400 font-mono text-xs" id="qb-map-total">$4,250.00</div>
              <div class="text-[9px] text-slate-400" id="qb-map-lines">2 Sales Items</div>
            </div>
            <div class="p-2 rounded-xl bg-slate-900 border border-slate-800">
              <div class="text-[9px] text-slate-500 uppercase">Tax Classification</div>
              <div class="font-bold text-purple-300 font-mono text-xs" id="qb-map-tax">NON-TAXABLE</div>
              <div class="text-[9px] text-slate-400">Code: NON</div>
            </div>
          </div>
        </div>

        <!-- Generated Intuit QBO REST Payload -->
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
              Generated Intuit QBO REST JSON Payload
            </span>
            <span class="text-[10px] text-slate-400">QuickBooksInvoicePayloadFactory.java</span>
          </div>

          <pre id="qb-json-output" class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-[11px] text-emerald-300 font-mono overflow-x-auto max-h-56 leading-relaxed">&#123;
  "DocNumber": "INV-2025-001",
  "TxnDate": "2025-05-18",
  "DueDate": "2025-06-18",
  "CustomerRef": &#123; "value": "419", "name": "Acme Corporation" &#125;,
  "Line": [
    &#123;
      "Amount": 2800.00,
      "DetailType": "SalesItemLineDetail",
      "Description": "Backend Architecture Audit",
      "SalesItemLineDetail": &#123;
        "Qty": 1,
        "UnitPrice": 2800.00,
        "ItemRef": &#123; "value": "72", "name": "Consulting Services" &#125;,
        "TaxCodeRef": &#123; "value": "NON" &#125;
      &#125;
    &#125;,
    &#123;
      "Amount": 1450.00,
      "DetailType": "SalesItemLineDetail",
      "Description": "High-Concurrency Tuning",
      "SalesItemLineDetail": &#123;
        "Qty": 1,
        "UnitPrice": 1450.00,
        "ItemRef": &#123; "value": "72", "name": "Consulting Services" &#125;,
        "TaxCodeRef": &#123; "value": "NON" &#125;
      &#125;
    &#125;
  ]
&#125;</pre>
        </div>
      </div>
    </div>
  </div>

  <!-- View 2: Multi-Tier Bank Reconciliation -->
  <div id="qb-screen-recon" class="qb-screen hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Bank Statement Input -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              Bank Statement Transaction Line
            </span>
            <span class="text-[10px] text-cyan-400">BankStatementRow.java</span>
          </div>

          <div class="space-y-2">
            <label class="text-[11px] text-slate-300 font-sans font-semibold">Select Inbound Bank Deposit Line:</label>
            <div class="grid grid-cols-1 gap-2">
              <button
                type="button"
                class="qb-recon-preset-btn text-left p-2.5 rounded-xl border border-cyan-500/50 bg-cyan-950/30 text-white hover:border-cyan-400 transition-all text-xs"
                data-recon="tier1"
              >
                <div class="font-bold flex items-center justify-between text-cyan-300">
                  <span>Tier 1: Exact Reference Match</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono">100% MATCH</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">WIRE-REF#884210 • $5,400.00 • Post Date: 2025-05-18</div>
              </button>

              <button
                type="button"
                class="qb-recon-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-recon="tier2"
              >
                <div class="font-bold flex items-center justify-between text-sky-300">
                  <span>Tier 2: Date-Window Settlement</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-300 font-mono">94% CONFIDENCE</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">STRIPE PAYOUT T-419 • $3,250.00 • Shifted +4 Days</div>
              </button>

              <button
                type="button"
                class="qb-recon-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-recon="batch_sum"
              >
                <div class="font-bold flex items-center justify-between text-purple-300">
                  <span>Batch Lump-Sum Aggregation</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 font-mono">BATCH_SUM</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">MERCHANT DEPOSIT #910 • $14,500.00 • 3 Grouped Invoices</div>
              </button>

              <button
                type="button"
                class="qb-recon-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-recon="tier3"
              >
                <div class="font-bold flex items-center justify-between text-amber-300">
                  <span>Tier 3: Fuzzy Description Overlap</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-mono">72% REVIEW</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">AMZN WEB SERVICES EU • $1,840.00 • Token Overlap</div>
              </button>
            </div>
          </div>

          <!-- Matching Engine Parameters -->
          <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 space-y-2">
            <div class="text-[10px] uppercase font-bold text-slate-400">Algorithm Parameters</div>
            <div class="flex items-center justify-between text-[11px] text-slate-300">
              <span>Date Window Tolerance:</span>
              <span class="font-mono text-cyan-400">&plusmn; 7 Days</span>
            </div>
            <div class="flex items-center justify-between text-[11px] text-slate-300">
              <span>Auto-Apply Confidence Threshold:</span>
              <span class="font-mono text-emerald-400">&ge; 90%</span>
            </div>
            <div class="flex items-center justify-between text-[11px] text-slate-300">
              <span>Fuzzy String Distance:</span>
              <span class="font-mono text-purple-400">Levenshtein &amp; 3-gram</span>
            </div>
          </div>

          <button
            type="button"
            id="qb-btn-execute-recon"
            class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-cyan-600 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 text-white font-mono font-bold text-xs shadow-lg shadow-cyan-500/20 transition-all flex items-center justify-center gap-2"
          >
            <span>⚖️ Run Reconciliation Scoring</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Candidate Matching & Disposition -->
      <div class="lg:col-span-7 space-y-4">
        <!-- Match Evaluation Card -->
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Ledger Candidate Match Evaluation
            </span>
            <span class="text-[10px] text-emerald-400">ReconciliationService.java:scoreBest()</span>
          </div>

          <!-- Match Result Stats Grid -->
          <div class="grid grid-cols-3 gap-3">
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center">
              <div class="text-[9px] text-slate-500 uppercase">Assigned Tier</div>
              <div class="font-bold text-sm text-cyan-300 font-mono mt-0.5" id="qb-recon-tier">TIER 1: EXACT</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center">
              <div class="text-[9px] text-slate-500 uppercase">Confidence Score</div>
              <div class="font-bold text-sm text-emerald-400 font-mono mt-0.5" id="qb-recon-conf">100%</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center">
              <div class="text-[9px] text-slate-500 uppercase">Disposition</div>
              <div class="font-bold text-sm text-emerald-300 font-mono mt-0.5" id="qb-recon-disp">AUTO_APPLY</div>
            </div>
          </div>

          <!-- Match Rationale -->
          <div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 text-slate-300 space-y-1">
            <div class="text-[10px] uppercase font-bold text-slate-400">Decision Rationale:</div>
            <p id="qb-recon-reason" class="text-xs font-sans text-slate-200">
              Matched bank deposit reference WIRE-REF#884210 directly to Open Invoice #INV-2025-001 ($5,400.00). Transaction dates align identically on 2025-05-18.
            </p>
          </div>

          <!-- Matched QBO Candidate Ledger Rows -->
          <div class="space-y-2">
            <div class="text-[10px] uppercase font-bold text-slate-400">Matched Open QBO Ledger Candidates:</div>
            <div id="qb-recon-candidates" class="space-y-2">
              <div class="p-3 rounded-xl bg-slate-900 border border-emerald-500/30 flex items-center justify-between text-xs font-mono">
                <div>
                  <div class="font-bold text-white flex items-center gap-2">
                    <span>INV-2025-001</span>
                    <span class="text-[10px] text-slate-400">Acme Corporation</span>
                  </div>
                  <div class="text-[10px] text-slate-400 font-sans">Date: 2025-05-18 • Ref: WIRE-REF#884210</div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-emerald-400">$5,400.00</div>
                  <div class="text-[9px] text-emerald-500 uppercase font-bold">100% Match</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 3: OAuth 2.0 & Token Vault -->
  <div id="qb-screen-oauth" class="qb-screen hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Token Vault Controls -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-purple-400"></span>
              Encrypted Credential Vault
            </span>
            <span class="text-[10px] text-purple-400">QboCredentialsCryptoService.java</span>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 space-y-2 text-[11px]">
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Target Realm ID:</span>
              <span class="font-mono text-purple-300 font-bold">91303541890241</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Environment:</span>
              <span class="font-mono text-sky-400">sandbox-quickbooks.api.intuit.com</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Cipher Algorithm:</span>
              <span class="font-mono text-emerald-400">AES-256-GCM / NoPadding</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Token Status:</span>
              <span class="font-mono text-emerald-400 font-bold" id="qb-token-badge">ACTIVE (3,540s left)</span>
            </div>
          </div>

          <div class="space-y-2">
            <button
              type="button"
              id="qb-btn-refresh-token"
              class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-purple-950/50 border border-purple-500/40 text-purple-200 font-mono font-bold text-xs shadow-md transition-all flex items-center justify-center gap-2"
            >
              <span>🔄 Force OAuth2 Bearer Token Refresh</span>
            </button>
            <button
              type="button"
              id="qb-btn-test-ping"
              class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-sky-950/50 border border-sky-500/40 text-sky-200 font-mono font-bold text-xs shadow-md transition-all flex items-center justify-center gap-2"
            >
              <span>⚡ Send Idempotent Company Ping</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Encrypted Store & Gateway Telemetry -->
      <div class="lg:col-span-7 space-y-4">
