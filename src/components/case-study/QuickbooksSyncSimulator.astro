      tier1: {
        tier: 'TIER 1: EXACT',
        confidence: '100%',
        disposition: 'AUTO_APPLY',
        reason: 'Matched bank deposit reference WIRE-REF#884210 directly to Open Invoice #INV-2025-001 ($5,400.00). Transaction dates align identically on 2025-05-18.',
