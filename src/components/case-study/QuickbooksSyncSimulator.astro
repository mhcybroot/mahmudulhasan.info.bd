      const time = new Date().toTimeString().split(' ')[0] + '.' + Math.floor(Math.random() * 900 + 100);
      const colorClass = type === 'success' ? 'text-emerald-400' : type === 'purple' ? 'text-purple-400' : type === 'sky' ? 'text-sky-400' : 'text-slate-400';
