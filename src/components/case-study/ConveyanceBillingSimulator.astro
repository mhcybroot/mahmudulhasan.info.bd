---
// Conveyance Billing Simulator: Flutter 3.29, Multi-Leg Journey Audit, bKash/EFT Disbursal, Vector PDF Voucher
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl p-6 sm:p-8 space-y-8 shadow-2xl">
  <!-- Simulator Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-cyan-300 font-mono text-xs uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
        Interactive Conveyance &amp; Payout Sandbox
      </div>
      <h2 class="text-2xl sm:text-3xl font-mono font-bold text-white flex items-center gap-3">
        SSSMS: Multi-Leg Travel Audit &amp; bKash Disbursal
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 font-sans mt-1">
        Experience real-world Bangladeshi corporate field travel auditing, fare checks, and instant mobile banking payouts.
      </p>
    </div>

    <!-- Active Perspective Switcher -->
    <div class="flex items-center p-1 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono">
      <button
        type="button"
        id="view-employee-btn"
        class="perspective-btn px-3.5 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-semibold transition-all shadow-sm"
        data-view="employee"
      >
        🛵 Field Engineer
      </button>
      <button
        type="button"
        id="view-manager-btn"
        class="perspective-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="manager"
      >
        💼 Finance Manager
      </button>
      <button
        type="button"
        id="view-voucher-btn"
        class="perspective-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="voucher"
      >
        📄 PDF Voucher
      </button>
    </div>
  </div>

  <!-- Main Simulator Viewport -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- View 1: Field Engineer Submit Mode (Default) -->
    <div id="screen-employee" class="lg:col-span-12 space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left: Journey Leg Builder -->
        <div class="lg:col-span-7 space-y-4">
          <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
              <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                Multi-Leg Journey Details (Dhaka Field Operations)
              </span>
              <span class="text-cyan-300 font-bold" id="legs-count-badge">3 Legs Recorded</span>
            </div>

            <!-- List of Journey Legs -->
            <div class="space-y-2.5" id="journey-legs-container">
              <!-- Leg 1 -->
              <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between gap-3">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded text-[10px] bg-cyan-950 text-cyan-300 border border-cyan-500/40 font-bold">CNG</span>
                    <span class="text-white font-bold text-xs">Dhanmondi 27 → Motijheel Commercial Area</span>
                  </div>
                  <div class="text-[11px] text-slate-400">Client: City Bank Head Office • Distance: 14.2 km</div>
                </div>
                <div class="text-right font-bold text-emerald-400 text-sm">
                  BDT 280.00
                </div>
              </div>

              <!-- Leg 2 -->
              <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between gap-3">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded text-[10px] bg-emerald-950 text-emerald-300 border border-emerald-500/40 font-bold">Bus</span>
                    <span class="text-white font-bold text-xs">Motijheel → Kawran Bazar Sub-Station</span>
                  </div>
                  <div class="text-[11px] text-slate-400">Transit: Metro/Local Bus • Distance: 6.8 km</div>
                </div>
                <div class="text-right font-bold text-emerald-400 text-sm">
                  BDT 35.00
                </div>
              </div>

              <!-- Leg 3 -->
              <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between gap-3">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded text-[10px] bg-amber-950 text-amber-300 border border-amber-500/40 font-bold">Bike Fuel</span>
                    <span class="text-white font-bold text-xs">Kawran Bazar → Uttara Sector 4 Data Center</span>
                  </div>
                  <div class="text-[11px] text-slate-400">Server Rack Inspection • Distance: 18.5 km (BDT 11.9/km)</div>
                </div>
                <div class="text-right font-bold text-emerald-400 text-sm">
                  BDT 220.00
                </div>
              </div>
            </div>

            <!-- Add New Leg Inline Form -->
            <div class="p-3.5 rounded-xl bg-slate-900/50 border border-slate-800/80 space-y-3 pt-3">
              <span class="text-[11px] font-bold text-slate-300 block uppercase">+ Add Custom Travel Leg</span>
              <div class="grid grid-cols-2 gap-2">
                <input
                  type="text"
                  id="new-leg-from"
                  placeholder="From (e.g. Mirpur 10)"
                  value="Uttara Sector 4"
                  class="px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-slate-200 text-xs focus:outline-none focus:border-cyan-400 font-mono"
                />
                <input
                  type="text"
                  id="new-leg-to"
                  placeholder="To (e.g. Gulshan 1)"
                  value="Gulshan 1 Hub"
                  class="px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-slate-200 text-xs focus:outline-none focus:border-cyan-400 font-mono"
                />
              </div>
              <div class="grid grid-cols-3 gap-2">
                <select
                  id="new-leg-mode"
                  class="px-2 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-slate-200 text-xs focus:outline-none focus:border-cyan-400 font-mono"
                >
                  <option value="Rickshaw">Rickshaw</option>
                  <option value="CNG" selected>CNG Auto</option>
                  <option value="Bus">Bus / Metro</option>
                  <option value="Bike Fuel">Bike / Fuel</option>
                  <option value="Taxi">Uber / Taxi</option>
                </select>
                <input
                  type="number"
                  id="new-leg-dist"
                  placeholder="Km"
                  value="11.2"
                  class="px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-slate-200 text-xs focus:outline-none focus:border-cyan-400 font-mono"
                />
                <input
                  type="number"
                  id="new-leg-cost"
                  placeholder="BDT"
                  value="190"
                  class="px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-slate-200 text-xs focus:outline-none focus:border-cyan-400 font-mono"
                />
              </div>
              <button
                type="button"
                id="add-leg-btn"
                class="w-full py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-300 font-bold text-xs transition-colors border border-slate-700"
              >
                + Insert Leg to Claim
              </button>
            </div>
          </div>
        </div>

        <!-- Right: Claim Summary & Action -->
        <div class="lg:col-span-5 space-y-4">
          <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
            <span class="text-xs font-bold text-white uppercase tracking-wider block border-b border-slate-800 pb-3">
              Claim Summary &amp; Submission
            </span>

            <div class="space-y-3">
              <div class="flex items-center justify-between text-slate-300">
                <span>Employee Name:</span>
                <span class="font-bold text-white">Mahmudul Hasan</span>
              </div>
              <div class="flex items-center justify-between text-slate-300">
                <span>Department &amp; Code:</span>
                <span class="text-cyan-300 font-semibold">IT &amp; Networks (#EMP-409)</span>
              </div>
              <div class="flex items-center justify-between text-slate-300">
                <span>Total Route Distance:</span>
                <span class="font-bold text-white" id="summary-total-dist">39.5 km</span>
              </div>
              <div class="flex items-center justify-between text-slate-300 border-t border-slate-800 pt-3">
                <span class="text-sm font-bold text-white">Total Claim Amount:</span>
                <span class="text-xl font-bold text-emerald-400" id="summary-total-cost">BDT 535.00</span>
              </div>
            </div>

            <!-- Policy Compliance Check Box -->
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 space-y-1.5">
              <div class="flex items-center gap-2 text-emerald-400 font-bold text-[11px]">
                <span>✓</span>
                <span>Automated Fare Policy Passed</span>
              </div>
              <p class="text-[10px] text-slate-400 font-sans leading-tight">
                All transit rates conform to company policy ceilings (CNG &lt; BDT 25/km, Fuel &lt; BDT 14/km). No anomaly detected.
              </p>
            </div>

            <button
              type="button"
              id="submit-claim-btn"
              class="w-full py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 active:scale-[0.98] text-slate-950 font-mono font-bold text-xs tracking-wide transition-all shadow-[0_0_20px_rgba(6,182,212,0.4)] flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4 text-slate-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 13l4 4L19 7"/>
              </svg>
              <span>Submit Claim for Manager Review</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- View 2: Finance Manager Review & Payout Mode -->
    <div id="screen-manager" class="lg:col-span-12 space-y-6 hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Review Card -->
        <div class="lg:col-span-7 space-y-4">
          <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
              <div>
                <span class="text-xs font-bold text-white uppercase tracking-wider block">
                  Claim Audit: #CLM-2026-10-89
                </span>
                <span class="text-[11px] text-slate-400">Submitted by Mahmudul Hasan • Oct 28, 2026</span>
              </div>
              <span id="manager-claim-status" class="px-2.5 py-1 rounded text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/40 font-bold">
                PENDING REVIEW
              </span>
            </div>

            <!-- Approved Amount Adjustment Input -->
            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-3">
              <div class="flex items-center justify-between">
                <label class="text-xs font-bold text-slate-200">Reimbursement Approval Amount:</label>
                <div class="flex items-center gap-1.5">
                  <span class="text-slate-400 font-bold">BDT</span>
                  <input
                    type="number"
                    id="approved-amount-input"
                    value="535.00"
                    class="w-28 px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-700 text-emerald-400 font-bold text-sm focus:outline-none focus:border-cyan-400 font-mono text-right"
                  />
                </div>
              </div>
              <p class="text-[11px] text-slate-400 font-sans">
                Managers can approve full claim or make policy adjustments with audit notes.
              </p>
            </div>

            <!-- Manager Remarks -->
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-200 block">Manager Audit Remarks:</label>
              <textarea
                id="manager-remarks-input"
                rows="2"
                class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-200 text-xs focus:outline-none focus:border-cyan-400 font-mono"
              >Site maintenance at City Bank and Uttara data center verified. Approved for instant bKash disbursal.</textarea>
            </div>
          </div>
        </div>

        <!-- Payout Disbursal Channel -->
        <div class="lg:col-span-5 space-y-4">
          <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
            <span class="text-xs font-bold text-white uppercase tracking-wider block border-b border-slate-800 pb-3">
              Corporate Payout Channel
            </span>

            <div class="space-y-2">
              <label class="p-3 rounded-xl bg-slate-900 border border-cyan-500/40 flex items-center justify-between cursor-pointer group">
                <div class="flex items-center gap-2.5">
                  <input type="radio" name="payout-channel" value="bKash" checked class="accent-cyan-400" />
                  <span class="text-white font-bold text-xs">bKash Corporate Payout</span>
                </div>
                <span class="text-pink-400 font-bold text-[10px]">Instant 0.0% Fee</span>
              </label>

              <label class="p-3 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between cursor-pointer group hover:border-slate-700">
                <div class="flex items-center gap-2.5">
                  <input type="radio" name="payout-channel" value="Nagad" class="accent-cyan-400" />
                  <span class="text-white font-bold text-xs">Nagad Merchant Transfer</span>
                </div>
                <span class="text-orange-400 font-bold text-[10px]">Instant Disbursal</span>
              </label>

              <label class="p-3 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between cursor-pointer group hover:border-slate-700">
                <div class="flex items-center gap-2.5">
                  <input type="radio" name="payout-channel" value="Bank EFT" class="accent-cyan-400" />
                  <span class="text-white font-bold text-xs">City Bank BEFTN Transfer</span>
                </div>
                <span class="text-emerald-400 font-bold text-[10px]">Salary Account</span>
              </label>
            </div>

            <button
              type="button"
              id="disburse-payout-btn"
              class="w-full py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 active:scale-[0.98] text-slate-950 font-mono font-bold text-xs tracking-wide transition-all shadow-[0_0_20px_rgba(16,185,129,0.4)] flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4 text-slate-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
              </svg>
              <span>1-Click Disburse Payment</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- View 3: Printable PDF Voucher Preview Screen -->
    <div id="screen-voucher" class="lg:col-span-12 space-y-4 hidden">
      <div class="max-w-2xl mx-auto rounded-2xl bg-white text-slate-900 p-8 shadow-2xl font-mono text-xs border border-slate-300 space-y-5">
        <!-- Letterhead -->
        <div class="flex items-center justify-between border-b-2 border-slate-900 pb-4">
          <div>
            <h3 class="text-lg font-bold tracking-tight text-slate-900">SKYLINK INNOVATIONS LTD.</h3>
            <p class="text-[10px] text-slate-600">Enterprise Technology &amp; Security Engineering Solutions • Dhaka, Bangladesh</p>
          </div>
          <div class="text-right">
            <span class="px-2 py-1 rounded bg-emerald-100 text-emerald-800 font-bold text-[10px] border border-emerald-300" id="voucher-status-pill">
              PAID &amp; SETTLED
            </span>
            <div class="text-[10px] text-slate-500 mt-1" id="voucher-trx-id">TRX-BKASH-892147</div>
          </div>
        </div>

        <div class="text-center py-1">
          <span class="text-xs font-bold uppercase tracking-wider border-b border-slate-300 pb-0.5">
            CONVEYANCE EXPENSE REIMBURSEMENT VOUCHER
          </span>
        </div>

        <!-- Employee Info Grid -->
        <div class="grid grid-cols-2 gap-2 text-[11px] bg-slate-50 p-3 rounded-lg border border-slate-200">
          <div>Employee: <strong class="text-slate-900">Mahmudul Hasan</strong></div>
          <div>Code: <strong class="text-slate-900">EMP-409</strong></div>
          <div>Department: <strong class="text-slate-900">IT &amp; Networks</strong></div>
          <div>Voucher Date: <strong class="text-slate-900">Oct 28, 2026</strong></div>
        </div>

        <!-- Journey Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-[11px] border-collapse border border-slate-300">
            <thead class="bg-slate-100 border-b border-slate-300 text-slate-700">
              <tr>
                <th class="p-2 border-r border-slate-300">Leg</th>
                <th class="p-2 border-r border-slate-300">Origin → Destination</th>
                <th class="p-2 border-r border-slate-300">Transit</th>
                <th class="p-2 border-r border-slate-300 text-right">Dist</th>
                <th class="p-2 text-right">Cost (BDT)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 text-slate-800" id="voucher-table-body">
              <tr>
                <td class="p-2 border-r border-slate-300 font-bold">1</td>
                <td class="p-2 border-r border-slate-300">Dhanmondi 27 → Motijheel Office</td>
                <td class="p-2 border-r border-slate-300">CNG</td>
                <td class="p-2 border-r border-slate-300 text-right">14.2 km</td>
                <td class="p-2 text-right font-bold">280.00</td>
              </tr>
              <tr>
                <td class="p-2 border-r border-slate-300 font-bold">2</td>
                <td class="p-2 border-r border-slate-300">Motijheel → Kawran Bazar Sub-Station</td>
                <td class="p-2 border-r border-slate-300">Bus</td>
                <td class="p-2 border-r border-slate-300 text-right">6.8 km</td>
                <td class="p-2 text-right font-bold">35.00</td>
              </tr>
              <tr>
                <td class="p-2 border-r border-slate-300 font-bold">3</td>
                <td class="p-2 border-r border-slate-300">Kawran Bazar → Uttara Sector 4 Data Center</td>
                <td class="p-2 border-r border-slate-300">Bike Fuel</td>
                <td class="p-2 border-r border-slate-300 text-right">18.5 km</td>
                <td class="p-2 text-right font-bold">220.00</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Total Calculation -->
        <div class="flex items-center justify-between border-t border-slate-300 pt-3 text-xs">
          <div class="text-slate-600 text-[10px]">
            Audit Remark: <span id="voucher-audit-remark" class="font-bold text-slate-800">Verified site maintenance visit. Approved for bKash.</span>
          </div>
          <div class="text-right">
            <span class="text-slate-600 block text-[10px]">Total Disbursed:</span>
            <span class="text-base font-bold text-slate-900" id="voucher-total-bdt">BDT 535.00</span>
          </div>
        </div>

        <!-- Signatures -->
        <div class="grid grid-cols-2 pt-6 text-center text-[10px] text-slate-500 border-t border-slate-200">
          <div>
            <div class="font-bold text-slate-800 font-mono">Mahmudul Hasan</div>
            <div class="border-t border-slate-400 mt-1 pt-1 mx-8">Claimant Signature</div>
          </div>
          <div>
            <div class="font-bold text-emerald-800 font-mono">FINANCE DEPT (AUDITED)</div>
            <div class="border-t border-slate-400 mt-1 pt-1 mx-8">Authorizing Officer</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initConveyanceSimulator() {
    const viewEmployeeBtn = document.getElementById('view-employee-btn');
    const viewManagerBtn = document.getElementById('view-manager-btn');
    const viewVoucherBtn = document.getElementById('view-voucher-btn');
    const perspectiveBtns = document.querySelectorAll('.perspective-btn');

    const screenEmployee = document.getElementById('screen-employee');
    const screenManager = document.getElementById('screen-manager');
    const screenVoucher = document.getElementById('screen-voucher');

    const addLegBtn = document.getElementById('add-leg-btn');
    const newLegFrom = document.getElementById('new-leg-from') as HTMLInputElement | null;
    const newLegTo = document.getElementById('new-leg-to') as HTMLInputElement | null;
    const newLegMode = document.getElementById('new-leg-mode') as HTMLSelectElement | null;
    const newLegDist = document.getElementById('new-leg-dist') as HTMLInputElement | null;
    const newLegCost = document.getElementById('new-leg-cost') as HTMLInputElement | null;

    const journeyLegsContainer = document.getElementById('journey-legs-container');
    const legsCountBadge = document.getElementById('legs-count-badge');
    const summaryTotalDist = document.getElementById('summary-total-dist');
    const summaryTotalCost = document.getElementById('summary-total-cost');
    const approvedAmountInput = document.getElementById('approved-amount-input') as HTMLInputElement | null;
    const managerRemarksInput = document.getElementById('manager-remarks-input') as HTMLTextAreaElement | null;

    const submitClaimBtn = document.getElementById('submit-claim-btn');
    const disbursePayoutBtn = document.getElementById('disburse-payout-btn');
    const managerClaimStatus = document.getElementById('manager-claim-status');
    const voucherStatusPill = document.getElementById('voucher-status-pill');
    const voucherTrxId = document.getElementById('voucher-trx-id');
    const voucherTotalBdt = document.getElementById('voucher-total-bdt');
    const voucherAuditRemark = document.getElementById('voucher-audit-remark');

    let legs = [
      { from: 'Dhanmondi 27', to: 'Motijheel Commercial Area', mode: 'CNG', dist: 14.2, cost: 280 },
      { from: 'Motijheel', to: 'Kawran Bazar Sub-Station', mode: 'Bus', dist: 6.8, cost: 35 },
      { from: 'Kawran Bazar', to: 'Uttara Sector 4 Data Center', mode: 'Bike Fuel', dist: 18.5, cost: 220 },
    ];

    function updateTotals() {
      let totalDist = 0;
      let totalCost = 0;
      legs.forEach((l) => {
        totalDist += l.dist;
        totalCost += l.cost;
      });

      if (legsCountBadge) legsCountBadge.textContent = `${legs.length} Legs Recorded`;
      if (summaryTotalDist) summaryTotalDist.textContent = `${totalDist.toFixed(1)} km`;
      if (summaryTotalCost) summaryTotalCost.textContent = `BDT ${totalCost.toFixed(2)}`;
      if (approvedAmountInput) approvedAmountInput.value = totalCost.toFixed(2);
      if (voucherTotalBdt) voucherTotalBdt.textContent = `BDT ${totalCost.toFixed(2)}`;
    }

    // View Switching
    perspectiveBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        perspectiveBtns.forEach((b) => {
          b.className = 'perspective-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold';
        });
        btn.className = 'perspective-btn px-3.5 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-semibold transition-all shadow-sm';

        const view = btn.getAttribute('data-view');
        screenEmployee?.classList.add('hidden');
        screenManager?.classList.add('hidden');
        screenVoucher?.classList.add('hidden');

        if (view === 'employee') screenEmployee?.classList.remove('hidden');
        if (view === 'manager') screenManager?.classList.remove('hidden');
        if (view === 'voucher') screenVoucher?.classList.remove('hidden');
      });
    });

    // Add Leg
    addLegBtn?.addEventListener('click', () => {
      const from = newLegFrom?.value || 'Point A';
      const to = newLegTo?.value || 'Point B';
      const mode = newLegMode?.value || 'CNG';
      const dist = parseFloat(newLegDist?.value || '5.0');
      const cost = parseFloat(newLegCost?.value || '100.0');

      legs.push({ from, to, mode, dist, cost });

      if (journeyLegsContainer) {
        const div = document.createElement('div');
        div.className = 'p-3.5 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between gap-3';
        div.innerHTML = `
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded text-[10px] bg-cyan-950 text-cyan-300 border border-cyan-500/40 font-bold">${mode}</span>
              <span class="text-white font-bold text-xs">${from} → ${to}</span>
            </div>
            <div class="text-[11px] text-slate-400">Custom Route • Distance: ${dist} km</div>
          </div>
          <div class="text-right font-bold text-emerald-400 text-sm">
            BDT ${cost.toFixed(2)}
          </div>
        `;
        journeyLegsContainer.appendChild(div);
      }

      updateTotals();
    });

    // Submit Claim Button
    submitClaimBtn?.addEventListener('click', () => {
      viewManagerBtn?.click();
    });

    // Disburse Payout Button
    disbursePayoutBtn?.addEventListener('click', () => {
      const selectedRadio = document.querySelector('input[name="payout-channel"]:checked') as HTMLInputElement | null;
      const channel = selectedRadio?.value || 'bKash';
      const randomTrx = 'TRX-' + channel.toUpperCase().replace(/\s/g, '') + '-' + Math.floor(100000 + Math.random() * 900000);

      if (managerClaimStatus) {
        managerClaimStatus.className = 'px-2.5 py-1 rounded text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 font-bold';
        managerClaimStatus.textContent = 'SETTLED & DISBURSED';
      }

      if (voucherTrxId) voucherTrxId.textContent = randomTrx;
      if (voucherAuditRemark && managerRemarksInput) {
        voucherAuditRemark.textContent = managerRemarksInput.value;
      }
      if (voucherTotalBdt && approvedAmountInput) {
        voucherTotalBdt.textContent = `BDT ${parseFloat(approvedAmountInput.value).toFixed(2)}`;
      }

      viewVoucherBtn?.click();
    });
  }

  initConveyanceSimulator();
  document.addEventListener('astro:page-load', initConveyanceSimulator);
</script>
