---
// Interactive Parking Gate & Lane Automation Simulator
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl overflow-hidden shadow-2xl space-y-6 p-6 sm:p-8">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-xs font-mono text-cyan-400 uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
        Interactive Hardware Simulation
      </div>
      <h3 class="text-xl sm:text-2xl font-mono font-bold text-white">
        PMS-V2 Automated Lane &amp; Barrier Simulator
      </h3>
      <p class="text-xs text-slate-300 font-sans mt-0.5">
        Experience how an inbound vehicle triggers AI license plate detection, anti-passback verification, and barrier arm opening in &lt; 0.84 seconds.
      </p>
    </div>

    <!-- Cycle Controller CTA -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="btn-auto-simulate"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-cyan-500 text-slate-950 font-mono text-xs font-bold hover:bg-cyan-400 active:scale-95 transition-all shadow-[0_0_20px_rgba(6,182,212,0.4)] cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Run Auto-Cycle</span>
      </button>

      <button
        type="button"
        id="btn-reset-simulator"
        class="px-3 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 hover:text-white hover:border-slate-500 font-mono text-xs font-medium transition-all cursor-pointer"
        title="Reset Simulation"
      >
        Reset
      </button>
    </div>
  </div>

  <!-- Visual Lane & Barrier Viewport -->
  <div class="relative w-full h-64 sm:h-72 rounded-2xl bg-slate-950 border border-slate-800 overflow-hidden flex flex-col justify-between p-4 sm:p-6 select-none shadow-inner">
    <!-- Road & Lane Striping Background -->
    <div class="absolute inset-x-0 bottom-0 h-32 bg-slate-900/60 border-t border-slate-800 flex items-center justify-around pointer-events-none">
      <div class="w-12 h-2 bg-yellow-500/40 rounded"></div>
      <div class="w-12 h-2 bg-yellow-500/40 rounded"></div>
      <div class="w-12 h-2 bg-yellow-500/40 rounded"></div>
      <div class="w-12 h-2 bg-yellow-500/40 rounded"></div>
      <div class="w-12 h-2 bg-yellow-500/40 rounded"></div>
    </div>

    <!-- Top Status Indicator & AI Camera -->
    <div class="flex items-start justify-between relative z-10">
      <!-- Camera Node Box -->
      <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-cyan-950 border border-cyan-500/50 flex items-center justify-center text-cyan-300">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <div class="text-[10px] font-mono uppercase text-slate-400 font-semibold">AI CAMERA NODE</div>
          <div id="sim-camera-status" class="text-xs font-mono text-cyan-400 font-bold">Scanning Lane 01...</div>
        </div>
      </div>

      <!-- Traffic Light Signal -->
      <div class="p-2 rounded-xl bg-slate-900 border border-slate-800 flex items-center gap-2">
        <div id="sim-light-red" class="w-4 h-4 rounded-full bg-rose-500 shadow-[0_0_12px_rgba(244,63,94,0.8)] transition-all"></div>
        <div id="sim-light-green" class="w-4 h-4 rounded-full bg-emerald-950 opacity-40 transition-all"></div>
      </div>
    </div>

    <!-- Barrier Gate Hardware Unit & Vehicle Animation Track -->
    <div class="relative w-full h-32 z-10 flex items-end">
      <!-- Inbound Vehicle Box -->
      <div
        id="sim-vehicle"
        class="absolute bottom-4 left-4 transition-all duration-700 ease-out flex items-center gap-2 p-2.5 rounded-xl bg-slate-800 border border-slate-700 shadow-xl"
        style="transform: translateX(0px);"
      >
        <div class="text-2xl">🚗</div>
        <div>
          <div class="text-[10px] font-mono text-slate-400">INBOUND CAR</div>
          <div id="sim-plate-display" class="font-mono text-xs font-bold text-white tracking-wider bg-slate-950 px-1.5 py-0.5 rounded border border-slate-800">
            DHK-METRO-GA-44-2190
          </div>
        </div>
      </div>

      <!-- Barrier Gate Post & Arm -->
      <div class="absolute bottom-4 right-1/3 flex flex-col items-center">
        <!-- Mechanical Barrier Arm -->
        <div
          id="sim-barrier-arm"
          class="w-36 sm:w-44 h-2.5 bg-gradient-to-r from-yellow-400 via-red-500 to-yellow-400 rounded-full origin-left transition-transform duration-500 shadow-lg border border-slate-900"
          style="transform: rotate(0deg);"
        ></div>
        <!-- Gate Stanchion -->
        <div class="w-8 h-16 bg-slate-800 border-2 border-slate-700 rounded-t-lg flex flex-col items-center justify-center gap-1 shadow-2xl">
          <div class="w-3 h-3 rounded-full bg-slate-900 border border-slate-700"></div>
          <span class="text-[8px] font-mono text-slate-400 font-bold">ZK-GATE</span>
        </div>
      </div>
    </div>

    <!-- Active State Pill -->
    <div class="flex items-center justify-between text-xs font-mono text-slate-300 border-t border-slate-800/80 pt-2 z-10">
      <span class="flex items-center gap-2">
        <span class="text-slate-400 font-semibold">GATE STATUS:</span>
        <span id="sim-barrier-label" class="text-rose-400 font-bold">BARRIER DOWN (LOCKED)</span>
      </span>
      <span class="text-slate-400">
        LATENCY: <span id="sim-latency-display" class="text-cyan-300 font-bold">0.00ms</span>
      </span>
    </div>
  </div>

  <!-- Step-by-Step Interactive Triggers -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 sm:gap-3 text-xs font-mono">
    <button
      type="button"
      id="btn-step-1"
      class="p-2.5 rounded-xl bg-slate-800 border border-slate-700 hover:border-cyan-400 text-slate-200 text-left transition-colors font-medium cursor-pointer"
    >
      <div class="text-[10px] text-slate-400 font-semibold">STEP 1</div>
      <div>Approach Lane</div>
    </button>
    <button
      type="button"
      id="btn-step-2"
      class="p-2.5 rounded-xl bg-slate-800 border border-slate-700 hover:border-cyan-400 text-slate-200 text-left transition-colors font-medium cursor-pointer"
    >
      <div class="text-[10px] text-slate-400 font-semibold">STEP 2</div>
      <div>AI Plate OCR</div>
    </button>
    <button
      type="button"
      id="btn-step-3"
      class="p-2.5 rounded-xl bg-slate-800 border border-slate-700 hover:border-cyan-400 text-slate-200 text-left transition-colors font-medium cursor-pointer"
    >
      <div class="text-[10px] text-slate-400 font-semibold">STEP 3</div>
      <div>Anti-Passback</div>
    </button>
    <button
      type="button"
      id="btn-step-4"
      class="p-2.5 rounded-xl bg-slate-800 border border-slate-700 hover:border-cyan-400 text-slate-200 text-left transition-colors font-medium cursor-pointer"
    >
      <div class="text-[10px] text-slate-400 font-semibold">STEP 4</div>
      <div>Lift Barrier Arm</div>
    </button>
    <button
      type="button"
      id="btn-step-5"
      class="p-2.5 rounded-xl bg-slate-800 border border-slate-700 hover:border-cyan-400 text-slate-200 text-left transition-colors font-medium col-span-2 sm:col-span-1 cursor-pointer"
    >
      <div class="text-[10px] text-slate-400 font-semibold">STEP 5</div>
      <div>Pass &amp; Commit</div>
    </button>
  </div>

  <!-- Live Microsecond Terminal Log Output -->
  <div class="rounded-2xl bg-slate-950 border border-slate-800 p-4 font-mono text-xs space-y-2 overflow-x-auto shadow-inner">
    <div class="text-slate-400 border-b border-slate-800 pb-2 mb-2 flex justify-between items-center text-[11px]">
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span class="font-bold text-slate-200">[DAEMON-LOG: pms.lane01.gateway]</span>
      </span>
      <span class="text-cyan-400 font-semibold">TOKIO REACTOR 16 WORKERS</span>
    </div>
    <div id="sim-terminal-log" class="space-y-1.5 text-xs text-slate-300">
      <div><span class="text-slate-400">00:00:00.000</span> [READY] Simulator initialized. Ready for vehicle approach.</div>
    </div>
  </div>
</div>

<script>
  function initGateSimulator() {
    const vehicle = document.getElementById('sim-vehicle');
    const barrierArm = document.getElementById('sim-barrier-arm');
    const barrierLabel = document.getElementById('sim-barrier-label');
    const cameraStatus = document.getElementById('sim-camera-status');
    const lightRed = document.getElementById('sim-light-red');
    const lightGreen = document.getElementById('sim-light-green');
    const terminalLog = document.getElementById('sim-terminal-log');
    const latencyDisplay = document.getElementById('sim-latency-display');
    const btnAuto = document.getElementById('btn-auto-simulate');
    const btnReset = document.getElementById('btn-reset-simulator');

    let currentStep = 0;
    let autoInterval: any = null;

    function addLog(tag: string, msg: string, colorClass = 'text-slate-200') {
      if (!terminalLog) return;
      const now = new Date();
      const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}.${String(now.getMilliseconds()).padStart(3, '0')}`;
      const div = document.createElement('div');
      div.className = colorClass;
      div.innerHTML = `<span class="text-slate-400 font-mono">${timeStr}</span> <span class="font-bold">[${tag}]</span> ${msg}`;
      terminalLog.appendChild(div);
      terminalLog.scrollTop = terminalLog.scrollHeight;
    }

    function resetSimulation() {
      if (autoInterval) clearInterval(autoInterval);
      currentStep = 0;
      if (vehicle) vehicle.style.transform = 'translateX(0px)';
      if (barrierArm) barrierArm.style.transform = 'rotate(0deg)';
      if (barrierLabel) {
        barrierLabel.textContent = 'BARRIER DOWN (LOCKED)';
        barrierLabel.className = 'text-rose-400 font-bold';
      }
      if (cameraStatus) cameraStatus.textContent = 'Scanning Lane 01...';
      if (lightRed) {
        lightRed.className = 'w-4 h-4 rounded-full bg-rose-500 shadow-[0_0_12px_rgba(244,63,94,0.8)] transition-all';
      }
      if (lightGreen) {
        lightGreen.className = 'w-4 h-4 rounded-full bg-emerald-950 opacity-40 transition-all';
      }
      if (latencyDisplay) latencyDisplay.textContent = '0.00ms';
      if (terminalLog) {
        terminalLog.innerHTML = `<div><span class="text-slate-400">00:00:00.000</span> [READY] Simulator initialized. Ready for vehicle approach.</div>`;
      }
    }

    function executeStep(step: number) {
      currentStep = step;
      if (step === 1) {
        if (vehicle) vehicle.style.transform = 'translateX(90px)';
        addLog('RADAR-LOOP', 'Vehicle presence detected on loop sensor A1. Triggering camera trigger zone.');
        if (latencyDisplay) latencyDisplay.textContent = '12.4ms';
      } else if (step === 2) {
        if (cameraStatus) cameraStatus.textContent = 'Plate Identified: DHK-METRO-GA-44-2190';
        addLog('FRIGATE-OCR', 'Captured 1080p frame. Extracted plate: <span class="text-cyan-300 font-bold">DHK-METRO-GA-44-2190</span> (Confidence: 0.992)', 'text-cyan-300');
        if (latencyDisplay) latencyDisplay.textContent = '48.1ms';
      } else if (step === 3) {
        addLog('SECURITY-AUTH', 'Anti-passback verified: Valid Entry. No mismatch found in active PostgreSQL tx-ledger.', 'text-emerald-300');
        if (latencyDisplay) latencyDisplay.textContent = '62.8ms';
      } else if (step === 4) {
        if (barrierArm) barrierArm.style.transform = 'rotate(-75deg)';
        if (barrierLabel) {
          barrierLabel.textContent = 'BARRIER OPEN (PASSAGE CLEAR)';
          barrierLabel.className = 'text-emerald-400 font-bold';
        }
        if (lightRed) lightRed.className = 'w-4 h-4 rounded-full bg-rose-950 opacity-40 transition-all';
        if (lightGreen) lightGreen.className = 'w-4 h-4 rounded-full bg-emerald-500 shadow-[0_0_12px_rgba(16,185,129,0.8)] transition-all';
        addLog('GPIO-RELAY', 'Sent HIGH pulse to ZKTeco barrier stanchion (PIN 14: OPEN). Gate fully raised in 0.78s.', 'text-emerald-400');
        if (latencyDisplay) latencyDisplay.textContent = '780.0ms';
      } else if (step === 5) {
        if (vehicle) vehicle.style.transform = 'translateX(280px)';
        addLog('COMMIT-AUDIT', 'Vehicle cleared safety loop B2. Parking slot occupied count updated. Gate arm lowered.', 'text-slate-100');
        setTimeout(() => {
          if (barrierArm) barrierArm.style.transform = 'rotate(0deg)';
          if (barrierLabel) {
            barrierLabel.textContent = 'BARRIER DOWN (LOCKED)';
            barrierLabel.className = 'text-rose-400 font-bold';
          }
          if (lightRed) lightRed.className = 'w-4 h-4 rounded-full bg-rose-500 shadow-[0_0_12px_rgba(244,63,94,0.8)] transition-all';
          if (lightGreen) lightGreen.className = 'w-4 h-4 rounded-full bg-emerald-950 opacity-40 transition-all';
        }, 600);
      }
    }

    btnAuto?.addEventListener('click', () => {
      resetSimulation();
      let step = 1;
      executeStep(step);
      autoInterval = setInterval(() => {
        step++;
        if (step <= 5) {
          executeStep(step);
        } else {
          clearInterval(autoInterval);
        }
      }, 900);
    });

    btnReset?.addEventListener('click', resetSimulation);
    document.getElementById('btn-step-1')?.addEventListener('click', () => executeStep(1));
    document.getElementById('btn-step-2')?.addEventListener('click', () => executeStep(2));
    document.getElementById('btn-step-3')?.addEventListener('click', () => executeStep(3));
    document.getElementById('btn-step-4')?.addEventListener('click', () => executeStep(4));
    document.getElementById('btn-step-5')?.addEventListener('click', () => executeStep(5));
  }

  initGateSimulator();
  document.addEventListener('astro:page-load', initGateSimulator);
</script>
