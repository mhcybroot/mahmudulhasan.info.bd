---
// SecureNotes Simulator: NestJS Clean Architecture, JWT Authentication, RBAC Guard, Compound Indexing
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl p-6 sm:p-8 space-y-8 shadow-2xl">
  <!-- Simulator Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-cyan-300 font-mono text-xs uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
        Interactive REST API &amp; RBAC Security Sandbox
      </div>
      <h2 class="text-2xl sm:text-3xl font-mono font-bold text-white flex items-center gap-3">
        SecureNotes: Multi-Tenant RBAC &amp; Index Engine
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 font-sans mt-1">
        Test JWT token authorization, ownership isolation guards, and sub-5ms compound B-Tree index lookups in real time.
      </p>
    </div>

    <!-- Active User / Role Switcher -->
    <div class="flex items-center p-1 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono">
      <button
        type="button"
        id="role-user-btn"
        class="role-btn px-3 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-semibold transition-all shadow-sm"
        data-role="USER"
      >
        👤 User (Alice)
      </button>
      <button
        type="button"
        id="role-admin-btn"
        class="role-btn px-3 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-role="ADMIN"
      >
        🛡️ Admin (Bob)
      </button>
      <button
        type="button"
        id="role-guest-btn"
        class="role-btn px-3 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-role="GUEST"
      >
        🦹 Attacker (No Auth)
      </button>
    </div>
  </div>

  <!-- Interactive Sandbox Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Left Column: API Client Request Builder & Quick Tests -->
    <div class="lg:col-span-5 space-y-5">
      <!-- Active JWT Security Token Card -->
      <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 font-mono text-xs space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-slate-400 font-semibold">ACTIVE JWT BEARER TOKEN</span>
          <span id="jwt-role-badge" class="px-2 py-0.5 rounded text-[10px] bg-cyan-950 text-cyan-300 border border-cyan-500/40 font-bold">
            ROLE: USER
          </span>
        </div>
        <div class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 text-[11px] text-slate-300 break-all leading-relaxed font-mono select-all">
          <span class="text-rose-400">eyJhbGciOi...</span><span class="text-cyan-300" id="jwt-payload-sample">.eyJzdWIiOiJ1c2VyLTAxIiwicm9sZSI6IlVTRVIiLCJpYXQiOjE3...</span><span class="text-emerald-400">.SIG_OK</span>
        </div>
        <div class="flex items-center justify-between text-[10px] text-slate-400 pt-1">
          <span>Decoded Identity: <strong class="text-white" id="token-identity">alice@enterprise.org</strong></span>
          <span class="text-emerald-400">HS256 Valid</span>
        </div>
      </div>

      <!-- Quick Route Testing Buttons -->
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-3 font-mono">
        <span class="text-xs font-bold text-white uppercase tracking-wider block">
          Select REST API Endpoint
        </span>

        <div class="space-y-2">
          <button
            type="button"
            class="route-select-btn w-full p-3 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-left hover:border-cyan-400 transition-all group"
            data-method="GET"
            data-endpoint="/notes?page=1&limit=5"
            data-desc="Queries Alice's personal notes using compound index { owner: 1, createdAt: -1 }."
          >
            <div class="flex items-center justify-between text-xs">
              <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-bold">GET</span>
              <span class="text-cyan-300 font-bold group-hover:translate-x-1 transition-transform">/notes</span>
            </div>
            <p class="text-[11px] text-slate-300 font-sans mt-1">
              Fetch personal notes. Scans B-Tree index; returns only tenant-owned documents.
            </p>
          </button>

          <button
            type="button"
            class="route-select-btn w-full p-3 rounded-xl bg-slate-900 border border-slate-800 text-left hover:border-slate-700 transition-all group"
            data-method="POST"
            data-endpoint="/notes"
            data-desc="Creates new encrypted note with DTO class-validator sanitization."
          >
            <div class="flex items-center justify-between text-xs">
              <span class="px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 font-bold">POST</span>
              <span class="text-slate-300 font-bold group-hover:translate-x-1 transition-transform">/notes</span>
            </div>
            <p class="text-[11px] text-slate-300 font-sans mt-1">
              Create new note. Validates title &amp; content; binds author to JWT sub claim.
            </p>
          </button>

          <button
            type="button"
            class="route-select-btn w-full p-3 rounded-xl bg-slate-900 border border-slate-800 text-left hover:border-slate-700 transition-all group"
            data-method="GET"
            data-endpoint="/admin/all-notes"
            data-desc="Audits all company notes. Protected by @Roles('ADMIN') guard."
          >
            <div class="flex items-center justify-between text-xs">
              <span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold">GET</span>
              <span class="text-slate-300 font-bold group-hover:translate-x-1 transition-transform">/admin/all-notes</span>
            </div>
            <p class="text-[11px] text-slate-300 font-sans mt-1">
              Admin audit feed. Blocks non-admin roles with strict 403 Forbidden.
            </p>
          </button>

          <button
            type="button"
            class="route-select-btn w-full p-3 rounded-xl bg-slate-900 border border-slate-800 text-left hover:border-slate-700 transition-all group"
            data-method="DELETE"
            data-endpoint="/notes/note-bob-secret"
            data-desc="Attempts to delete Bob's confidential note. Triggers ownership guard."
          >
            <div class="flex items-center justify-between text-xs">
              <span class="px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 font-bold">DELETE</span>
              <span class="text-slate-300 font-bold group-hover:translate-x-1 transition-transform">/notes/:id (IDOR Test)</span>
            </div>
            <p class="text-[11px] text-slate-300 font-sans mt-1">
              Ownership Guard check. Alice trying to delete Bob's note is rejected immediately.
            </p>
          </button>
        </div>

        <button
          type="button"
          id="send-request-btn"
          class="w-full mt-3 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 active:scale-[0.98] text-slate-950 font-mono font-bold text-xs tracking-wide transition-all shadow-[0_0_20px_rgba(6,182,212,0.4)] flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4 text-slate-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
          <span>Dispatch HTTP Request</span>
        </button>
      </div>

      <!-- Quick Note Creator (POST /notes inline test) -->
      <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs">
        <span class="text-xs font-bold text-white block">Inline Note Composer</span>
        <input
          type="text"
          id="new-note-title"
          placeholder="Note title (e.g., Q3 System Architecture Decisions)"
          value="Sprint 44: Rust Microservices Concurrency Specs"
          class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-200 focus:outline-none focus:border-cyan-400 text-xs"
        />
        <textarea
          id="new-note-content"
          rows="2"
          placeholder="Confidential meeting notes or architecture decisions..."
          class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-200 focus:outline-none focus:border-cyan-400 text-xs"
        >Tokio reactor threads pinned to isolated CPU cores. Zero locks on hot state mutations.</textarea>
        <button
          type="button"
          id="save-inline-note-btn"
          class="w-full py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-300 font-bold border border-slate-700 transition-colors"
        >
          + Save Note via POST /notes
        </button>
      </div>
    </div>

    <!-- Right Column: Live Telemetry & Response JSON Viewer -->
    <div class="lg:col-span-7 space-y-5">
      <!-- Database Execution & Security Telemetry Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono">
        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-center">
          <span class="text-[10px] text-slate-400 uppercase block">HTTP Status</span>
          <span id="metric-status" class="text-xl font-bold text-emerald-400">200 OK</span>
        </div>
        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-center">
          <span class="text-[10px] text-slate-400 uppercase block">Latency</span>
          <span id="metric-latency" class="text-xl font-bold text-cyan-300">4.2 ms</span>
        </div>
        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-center">
          <span class="text-[10px] text-slate-400 uppercase block">Index Plan</span>
          <span id="metric-plan" class="text-xl font-bold text-emerald-300">IXSCAN</span>
        </div>
        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-center">
          <span class="text-[10px] text-slate-400 uppercase block">RBAC Guard</span>
          <span id="metric-guard" class="text-xl font-bold text-emerald-400">PASSED</span>
        </div>
      </div>

      <!-- Execution Explanation Banner -->
      <div id="execution-explanation-card" class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs space-y-1">
        <div class="flex items-center justify-between">
          <span class="text-slate-400 text-[10px] uppercase font-bold">Execution Plan Details</span>
          <span id="plan-tag" class="px-2 py-0.5 rounded text-[10px] bg-emerald-950 text-emerald-300 border border-emerald-500/40 font-bold">
            INDEX SCAN (B-TREE)
          </span>
        </div>
        <p id="plan-desc" class="text-[11px] text-slate-300 font-sans leading-relaxed">
          Executed query against compound index <code class="text-cyan-300 font-mono">&#123; owner: 1, createdAt: -1 &#125;</code>. Examined exactly 5 index keys, scanning 0 unindexed collection records.
        </p>
      </div>

      <!-- Live Terminal JSON Response Viewer -->
      <div class="rounded-2xl bg-slate-950 border border-slate-800 overflow-hidden shadow-2xl font-mono text-xs">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-900 border-b border-slate-800">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
            <span id="response-route-label" class="ml-2 text-slate-300 font-semibold">
              GET /notes?page=1&amp;limit=5
            </span>
          </div>
          <span class="text-slate-400 text-[10px]" id="response-size-label">1.24 KB • application/json</span>
        </div>

        <pre id="json-response-view" class="p-5 text-xs text-slate-200 overflow-x-auto leading-relaxed max-h-[360px] selection:bg-cyan-500/30 selection:text-cyan-100"><code>&#123;
  "statusCode": 200,
  "data": &#123;
    "items": [
      &#123;
        "id": "671fb20a91e4f8001",
        "title": "Sprint 44: Rust Microservices Concurrency Specs",
        "content": "Tokio reactor threads pinned to isolated CPU cores. Zero locks on hot state mutations.",
        "owner": &#123;
          "id": "user-01",
          "name": "Alice Engineer",
          "email": "alice@enterprise.org"
        &#125;,
        "createdAt": "2026-10-28T19:42:10.000Z"
      &#125;,
      &#123;
        "id": "671fb18d91e4f8002",
        "title": "Biometric Terminal Encryption Protocols",
        "content": "ZKTeco push packets must validate HMAC-SHA256 device key before database commit.",
        "owner": &#123;
          "id": "user-01",
          "name": "Alice Engineer",
          "email": "alice@enterprise.org"
        &#125;,
        "createdAt": "2026-10-28T18:15:00.000Z"
      &#125;
    ],
    "total": 2,
    "page": 1,
    "limit": 5,
    "totalPages": 1
  &#125;
&#125;</code></pre>
      </div>
    </div>
  </div>
</div>

<script>
  function initSecureNotesSimulator() {
    const roleUserBtn = document.getElementById('role-user-btn');
    const roleAdminBtn = document.getElementById('role-admin-btn');
    const roleGuestBtn = document.getElementById('role-guest-btn');
    const roleBtns = document.querySelectorAll('.role-btn');

    const jwtRoleBadge = document.getElementById('jwt-role-badge');
    const jwtPayloadSample = document.getElementById('jwt-payload-sample');
    const tokenIdentity = document.getElementById('token-identity');

    const routeBtns = document.querySelectorAll('.route-select-btn');
    const sendBtn = document.getElementById('send-request-btn');
    const saveInlineBtn = document.getElementById('save-inline-note-btn');
    const newNoteTitle = document.getElementById('new-note-title') as HTMLInputElement | null;
    const newNoteContent = document.getElementById('new-note-content') as HTMLTextAreaElement | null;

    const metricStatus = document.getElementById('metric-status');
    const metricLatency = document.getElementById('metric-latency');
    const metricPlan = document.getElementById('metric-plan');
    const metricGuard = document.getElementById('metric-guard');
    const planTag = document.getElementById('plan-tag');
    const planDesc = document.getElementById('plan-desc');
    const responseRouteLabel = document.getElementById('response-route-label');
    const responseSizeLabel = document.getElementById('response-size-label');
    const jsonView = document.getElementById('json-response-view');

    // Current State
    let currentRole = 'USER'; // 'USER' | 'ADMIN' | 'GUEST'
    let currentMethod = 'GET';
    let currentEndpoint = '/notes?page=1&limit=5';

    // Role Switch Handlers
    roleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        roleBtns.forEach((b) => {
          b.className = 'role-btn px-3 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold';
        });
        btn.className = 'role-btn px-3 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-semibold transition-all shadow-sm';

        const role = btn.getAttribute('data-role') || 'USER';
        currentRole = role;

        if (role === 'USER') {
          if (jwtRoleBadge) {
            jwtRoleBadge.className = 'px-2 py-0.5 rounded text-[10px] bg-cyan-950 text-cyan-300 border border-cyan-500/40 font-bold';
            jwtRoleBadge.textContent = 'ROLE: USER';
          }
          if (jwtPayloadSample) jwtPayloadSample.textContent = '.eyJzdWIiOiJ1c2VyLTAxIiwicm9sZSI6IlVTRVIiLCJpYXQiOjE3...';
          if (tokenIdentity) tokenIdentity.textContent = 'alice@enterprise.org';
        } else if (role === 'ADMIN') {
          if (jwtRoleBadge) {
            jwtRoleBadge.className = 'px-2 py-0.5 rounded text-[10px] bg-emerald-950 text-emerald-300 border border-emerald-500/40 font-bold';
            jwtRoleBadge.textContent = 'ROLE: ADMIN';
          }
          if (jwtPayloadSample) jwtPayloadSample.textContent = '.eyJzdWIiOiJhZG1pbi0wMSIsInJvbGUiOiJBRE1JTiIsImlhdCI6MTc...';
          if (tokenIdentity) tokenIdentity.textContent = 'bob_cto@enterprise.org';
        } else if (role === 'GUEST') {
          if (jwtRoleBadge) {
            jwtRoleBadge.className = 'px-2 py-0.5 rounded text-[10px] bg-rose-950 text-rose-300 border border-rose-500/40 font-bold';
            jwtRoleBadge.textContent = 'UNAUTHENTICATED';
          }
          if (jwtPayloadSample) jwtPayloadSample.textContent = '[NO BEARER HEADER SUPPLIED]';
          if (tokenIdentity) tokenIdentity.textContent = 'Anonymous / Attacker';
        }
      });
    });

    // Route Select Handler
    routeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        routeBtns.forEach((b) => {
          b.className = 'route-select-btn w-full p-3 rounded-xl bg-slate-900 border border-slate-800 text-left hover:border-slate-700 transition-all group';
        });
        btn.className = 'route-select-btn w-full p-3 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-left hover:border-cyan-400 transition-all group';

        currentMethod = btn.getAttribute('data-method') || 'GET';
        currentEndpoint = btn.getAttribute('data-endpoint') || '/notes?page=1&limit=5';
        if (responseRouteLabel) {
          responseRouteLabel.textContent = `${currentMethod} ${currentEndpoint}`;
        }
      });
    });

    // Execute Request Logic
    function executeRequest() {
      if (responseRouteLabel) {
        responseRouteLabel.textContent = `${currentMethod} ${currentEndpoint}`;
      }

      // 1. Guest Check (All protected routes require auth)
      if (currentRole === 'GUEST') {
        renderResponse(401, '401 Unauthorized', '1.1 ms', 'N/A', 'REJECTED (JwtAuthGuard)', 'NO INDEX',
          'Request rejected at the gateway. Missing Bearer authorization header or invalid signature.',
          {
            statusCode: 401,
            message: 'Unauthorized: Bearer token is missing or expired',
            error: 'Unauthorized'
          }
        );
        return;
      }

      // 2. Admin Route Protection Check
      if (currentEndpoint.includes('/admin/all-notes')) {
        if (currentRole !== 'ADMIN') {
          renderResponse(403, '403 Forbidden', '1.8 ms', 'N/A', 'BLOCKED (RolesGuard)', 'GUARD BLOCK',
            'RolesGuard evaluated required @Roles(\'ADMIN\') against JWT role \'USER\'. Access denied.',
            {
              statusCode: 403,
              message: 'Forbidden resource: This route requires ADMIN privileges',
              error: 'Forbidden'
            }
          );
          return;
        }

        // Admin Access Succeeded
        renderResponse(200, '200 OK', '5.1 ms', 'IXSCAN', 'PASSED (Admin Role)', 'B-TREE INDEX',
          'Admin query verified. Traversed index { createdAt: -1 } across all organization documents.',
          {
            statusCode: 200,
            data: {
              items: [
                {
                  id: '671fb20a91e4f8001',
                  title: 'Sprint 44: Rust Microservices Concurrency Specs',
                  owner: { id: 'user-01', name: 'Alice Engineer', email: 'alice@enterprise.org' },
                  createdAt: '2026-10-28T19:42:10.000Z'
                },
                {
                  id: '671fb99991e4f8402',
                  title: 'Executive Financial Compensation & Board Minutes',
                  owner: { id: 'admin-01', name: 'Bob CTO', email: 'bob_cto@enterprise.org' },
                  createdAt: '2026-10-28T19:00:00.000Z'
                }
              ],
              total: 2,
              auditAccessGranted: true
            }
          }
        );
        return;
      }

      // 3. IDOR Ownership Check (Delete test)
      if (currentMethod === 'DELETE') {
        if (currentRole === 'USER') {
          renderResponse(403, '403 Forbidden', '2.4 ms', 'IXSCAN', 'BLOCKED (Ownership Policy)', 'IDOR PREVENTED',
            'Ownership policy violation: Note belongs to Bob (admin-01). Alice (user-01) cannot delete other users\' data.',
            {
              statusCode: 403,
              message: 'Forbidden: You do not own this note. IDOR exploit prevented.',
              error: 'Forbidden'
            }
          );
        } else {
          renderResponse(200, '200 OK', '4.6 ms', 'IXSCAN', 'PASSED (Owner Verified)', 'INDEX DELETE',
            'Ownership verified. Deleted note from collection and committed updated index tree.',
            {
              statusCode: 200,
              message: 'Note deleted successfully',
              deletedId: 'note-bob-secret'
            }
          );
        }
        return;
      }

      // 4. POST Create Note
      if (currentMethod === 'POST') {
        const title = newNoteTitle?.value || 'Confidential Architecture Note';
        const content = newNoteContent?.value || 'Encrypted content saved to MongoDB.';
        renderResponse(201, '201 Created', '3.8 ms', 'INDEX INSERT', 'PASSED (ValidationPipe)', 'COMPOUND WRITE',
          'Payload validated via class-validator. Inserted note into MongoDB and updated { owner: 1, createdAt: -1 } index.',
          {
            statusCode: 201,
            data: {
              id: '671fb' + Math.floor(Math.random() * 10000000).toString(16),
              title: title,
              content: content,
              owner: {
                id: currentRole === 'ADMIN' ? 'admin-01' : 'user-01',
                name: currentRole === 'ADMIN' ? 'Bob CTO' : 'Alice Engineer'
              },
              createdAt: new Date().toISOString()
            }
          }
        );
        return;
      }

      // 5. Default GET /notes (Personal Query with Compound Index)
      renderResponse(200, '200 OK', '4.2 ms', 'IXSCAN', 'PASSED (JwtAuthGuard)', 'COMPOUND B-TREE',
        'Executed query against compound index { owner: 1, createdAt: -1 }. Examined 2 index keys with zero COLLSCAN table overhead.',
        {
          statusCode: 200,
          data: {
            items: [
              {
                id: '671fb20a91e4f8001',
                title: 'Sprint 44: Rust Microservices Concurrency Specs',
                content: 'Tokio reactor threads pinned to isolated CPU cores. Zero locks on hot state mutations.',
                owner: {
                  id: currentRole === 'ADMIN' ? 'admin-01' : 'user-01',
                  name: currentRole === 'ADMIN' ? 'Bob CTO' : 'Alice Engineer'
                },
                createdAt: '2026-10-28T19:42:10.000Z'
              }
            ],
            total: 1,
            page: 1,
            limit: 5,
            totalPages: 1
          }
        }
      );
    }

    function renderResponse(statusNum: number, statusText: string, latency: string, plan: string, guard: string, tag: string, desc: string, json: any) {
      if (metricStatus) {
        metricStatus.textContent = statusText;
        metricStatus.className = statusNum < 300 ? 'text-xl font-bold text-emerald-400' : statusNum === 401 ? 'text-xl font-bold text-amber-400' : 'text-xl font-bold text-rose-400';
      }
      if (metricLatency) metricLatency.textContent = latency;
      if (metricPlan) metricPlan.textContent = plan;
      if (metricGuard) {
        metricGuard.textContent = guard.includes('PASSED') ? 'PASSED' : 'BLOCKED';
        metricGuard.className = guard.includes('PASSED') ? 'text-xl font-bold text-emerald-400' : 'text-xl font-bold text-rose-400';
      }
      if (planTag) {
        planTag.textContent = tag;
        planTag.className = statusNum < 300
          ? 'px-2 py-0.5 rounded text-[10px] bg-emerald-950 text-emerald-300 border border-emerald-500/40 font-bold'
          : 'px-2 py-0.5 rounded text-[10px] bg-rose-950 text-rose-300 border border-rose-500/40 font-bold';
      }
      if (planDesc) planDesc.textContent = desc;
      if (jsonView) {
        jsonView.innerHTML = `<code>${JSON.stringify(json, null, 2)}</code>`;
      }
    }

    sendBtn?.addEventListener('click', executeRequest);
    saveInlineBtn?.addEventListener('click', () => {
      currentMethod = 'POST';
      currentEndpoint = '/notes';
      executeRequest();
    });
  }

  initSecureNotesSimulator();
  document.addEventListener('astro:page-load', initSecureNotesSimulator);
</script>
