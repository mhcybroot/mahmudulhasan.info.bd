---
// Cameraman: Edge CCTV AI Webhook Ingestion, Bangla ANPR & Multi-Model Vision Pipeline Simulator
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl p-6 sm:p-8 space-y-8 shadow-2xl">
  <!-- Simulator Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-rose-400 font-mono text-xs uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-rose-400 animate-pulse"></span>
        Interactive Edge CCTV AI &amp; Bangla ANPR Vision Sandbox
      </div>
      <h2 class="text-2xl sm:text-3xl font-mono font-bold text-white flex items-center gap-3">
        Cameraman Vision Simulator
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 font-sans mt-1">
        Experience sub-25ms camera webhook ingestion, BRTA Bangla license plate grammar parsing, PPE workplace safety auditing, and edge database resilience.
      </p>
    </div>

    <!-- Active Perspective Switcher -->
    <div class="flex items-center p-1 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono overflow-x-auto">
      <button
        type="button"
        id="cm-tab-anpr"
        class="cm-tab-btn px-3.5 py-1.5 rounded-lg bg-rose-500/20 text-rose-300 border border-rose-500/40 font-semibold transition-all shadow-sm"
        data-view="anpr"
      >
        🚗 Bangla ANPR &amp; Plate Grammar
      </button>
      <button
        type="button"
        id="cm-tab-ppe"
        class="cm-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="ppe"
      >
        🦺 Industrial PPE Safety Audit
      </button>
      <button
        type="button"
        id="cm-tab-stream"
        class="cm-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="stream"
      >
        📡 Webhook Ingest &amp; DB Fallback
      </button>
    </div>
  </div>

  <!-- View 1: Bangla ANPR Sandbox (Default) -->
  <div id="cm-screen-anpr" class="cm-screen space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Camera Event Inputs -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-rose-400"></span>
              CCTV Ingress Stream
            </span>
            <span class="text-[10px] text-slate-400 font-mono">Camera: Toll-Gate-01</span>
          </div>

          <!-- Scenario Presets -->
          <div class="space-y-1.5">
            <label class="text-[11px] text-slate-300 font-sans font-semibold">Select Vehicle Ingress Snapshot:</label>
            <div class="grid grid-cols-1 gap-2">
              <button
                type="button"
                class="cm-preset-btn text-left p-2.5 rounded-xl border border-rose-500/50 bg-rose-950/30 text-white hover:border-rose-400 transition-all text-xs"
                data-type="standard"
                data-raw="LICENSE_PLATE:
ঢাকা মেট্রো ঘ
১২-৩৪৫৬
CONTEXT: White Toyota Hiace microbus at primary toll lane"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>Standard Metro Plate</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono">100% VALID</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">ঢাকা মেট্রো ঘ • ১২-৩৪৫৬ • Class 'ঘ' (SUV/Microbus)</div>
              </button>

              <button
                type="button"
                class="cm-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-type="fuzzy"
                data-raw="RAW_OCR:
ডাকা মেট্রো গ
11-9872
VEHICLE: Silver Toyota Corolla sedan"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>Fuzzy District &amp; Western Digits</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-mono">AUTOCORRECTED</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">Typo 'ডাকা' =&gt; 'ঢাকা' • Digits '11-9872' =&gt; '১১-৯৮৭২'</div>
              </button>

              <button
                type="button"
                class="cm-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-type="ctg"
                data-raw="ANPR_DETECTION:
চট্টগ্রাম মেট্রো চ
৫৪-৩২১০
TYPE: Commercial delivery van"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>Chittagong Abbreviation Normalizer</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-300 font-mono">PREFIX NORMALIZED</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">'চট্টগ্রাম' normalized to BRTA standard 'চট্ট মেট্রো চ'</div>
              </button>

              <button
                type="button"
                class="cm-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-type="rural"
                data-raw="PLATE_STRING:
সিলেট হ
৩৩-৪৪৫৫
CONTEXT: Blue commuter motorcycle"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>Non-Metro Rural Registration</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 font-mono">NO METRO</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">সিলেট হ • ৩৩-৪৪৫৫ • Two-wheeler motorcycle class 'হ'</div>
              </button>
            </div>
          </div>

          <!-- Toggles -->
          <div class="pt-2 border-t border-slate-800 space-y-2">
            <div class="flex items-center justify-between">
              <label class="flex items-center gap-2 cursor-pointer text-slate-300 text-xs">
                <input type="checkbox" id="cm-opt-fuzzy" checked class="rounded bg-slate-900 border-slate-700 text-rose-500 focus:ring-0" />
                <span>64-District Levenshtein Tolerance (&le; 1)</span>
              </label>
              <span class="text-[10px] text-emerald-400 font-mono">ACTIVE</span>
            </div>
            <div class="flex items-center justify-between">
              <label class="flex items-center gap-2 cursor-pointer text-slate-300 text-xs">
                <input type="checkbox" id="cm-opt-digit" checked class="rounded bg-slate-900 border-slate-700 text-rose-500 focus:ring-0" />
                <span>Auto-Convert Western Numerals (0-9 =&gt; ০-৯)</span>
              </label>
              <span class="text-[10px] text-cyan-400 font-mono">ACTIVE</span>
            </div>
          </div>

          <button
            type="button"
            id="cm-btn-process"
            class="w-full py-2.5 px-4 rounded-xl bg-rose-500 hover:bg-rose-400 text-slate-950 font-bold font-mono text-xs flex items-center justify-center gap-2 transition-all shadow-lg shadow-rose-500/20"
          >
            <span>Simulate Webhook &amp; Validate Plate</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Right Column: Plate Rendering & Parsed Telemetry -->
      <div class="lg:col-span-7 space-y-4">
        <!-- Rendered Physical Plate Box -->
        <div class="p-6 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              BRTA Verified Vehicle Plate Rendering
            </span>
            <span id="cm-ingest-badge" class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 text-[10px]">
              ⚡ Webhook Ack: 21ms (HTTP 202)
            </span>
          </div>

          <!-- Physical Plate Graphic -->
          <div class="flex justify-center py-2">
            <div class="w-72 sm:w-80 p-4 rounded-xl border-4 border-slate-900 bg-gradient-to-b from-emerald-800 to-emerald-950 text-white text-center shadow-2xl relative overflow-hidden ring-2 ring-emerald-500/50">
              <div class="absolute top-1.5 left-2 w-2 h-2 rounded-full bg-slate-300 border border-slate-600"></div>
              <div class="absolute top-1.5 right-2 w-2 h-2 rounded-full bg-slate-300 border border-slate-600"></div>
              <div class="absolute bottom-1.5 left-2 w-2 h-2 rounded-full bg-slate-300 border border-slate-600"></div>
              <div class="absolute bottom-1.5 right-2 w-2 h-2 rounded-full bg-slate-300 border border-slate-600"></div>

              <div id="cm-plate-top" class="text-xl sm:text-2xl font-bold tracking-wider font-sans drop-shadow-md text-amber-200">
                ঢাকা মেট্রো ঘ
              </div>
              <div class="my-1 border-b border-emerald-600/60"></div>
              <div id="cm-plate-bottom" class="text-2xl sm:text-3xl font-bold tracking-widest font-sans drop-shadow-md text-white">
                ১২-৩৪৫৬
              </div>
            </div>
          </div>

          <!-- Parsed Token Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
            <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-center">
              <div class="text-[10px] text-slate-400">DISTRICT</div>
              <div id="cm-token-district" class="text-sm font-bold text-rose-300 mt-0.5">ঢাকা</div>
              <div class="text-[9px] text-emerald-400">64-BRTA Validated</div>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-center">
              <div class="text-[10px] text-slate-400">METRO STATUS</div>
              <div id="cm-token-metro" class="text-sm font-bold text-cyan-300 mt-0.5">TRUE</div>
              <div class="text-[9px] text-slate-400">মেট্রোপলিটন জোন</div>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-center">
              <div class="text-[10px] text-slate-400">CLASS LETTER</div>
              <div id="cm-token-class" class="text-sm font-bold text-amber-300 mt-0.5">ঘ (Microbus)</div>
              <div class="text-[9px] text-slate-400">Private Vehicle</div>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-center">
              <div class="text-[10px] text-slate-400">SERIES &amp; NUM</div>
              <div id="cm-token-number" class="text-sm font-bold text-emerald-300 mt-0.5">১২-৩৪৫৬</div>
              <div class="text-[9px] text-emerald-400">BRTA Formatted</div>
            </div>
          </div>
        </div>

        <!-- Terminal Execution Log -->
        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-2 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span class="ml-2 text-slate-300 text-[11px] font-bold">Rust Axum &amp; Levenshtein Grammar Log</span>
            </div>
            <span class="text-[10px] text-rose-400">Axum 0.7 Pipeline</span>
          </div>

          <div
            id="cm-terminal-log"
            class="h-44 overflow-y-auto p-3 rounded-xl bg-slate-900 border border-slate-800/80 font-mono text-[11px] leading-relaxed space-y-1 text-slate-300"
          >
            <div class="text-slate-500">[00.000s] Ingesting POST /api/webhook from Dahua NVR (192.168.1.120)</div>
            <div class="text-emerald-400 font-bold">[00.021s] Axum returned HTTP 202 ACCEPTED in 21ms. Background task spawned.</div>
            <div class="text-cyan-300">[00.035s] AI Module [anpr] parsed raw OCR output stream:</div>
            <div class="text-slate-400">&gt;&gt;&gt; Top: "ঢাকা মেট্রো ঘ" | Bottom: "১২-৩৪৫৬"</div>
            <div class="text-emerald-300">[00.038s] District lookup: "ঢাকা" matched in DISTRICTS array (Distance: 0).</div>
            <div class="text-amber-300">[00.040s] Extracted Class Letter: 'ঘ' (Valid BRTA SUV/Microbus series).</div>
            <div class="text-emerald-400 font-bold">[00.042s] Event written to PostgreSQL `processed_events` table (ID: e8f9-42b1).</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 2: Industrial PPE Compliance Sandbox -->
  <div id="cm-screen-ppe" class="cm-screen hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-amber-400"></span>
              Workplace Safety Auditor
            </span>
            <span class="text-[10px] text-slate-400 font-mono">Module: ppe_detection</span>
          </div>

          <div class="space-y-1.5">
            <label class="text-[11px] text-slate-300 font-sans font-semibold">Select Worker Ingress Test:</label>
            <div class="grid grid-cols-1 gap-2">
              <button
                type="button"
                class="cm-ppe-btn text-left p-2.5 rounded-xl border border-emerald-500/50 bg-emerald-950/30 text-white transition-all text-xs"
                data-ppe="full"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>100% Fully Compliant Worker</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono">GATE OPEN</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">Hardhat: Yes • High-Vis Vest: Yes • Face Mask: Yes</div>
              </button>

              <button
                type="button"
                class="cm-ppe-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-ppe="missing_vest"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>Safety Vest Violation</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-mono">GATE LOCKED</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">Worker missing high-visibility safety vest in industrial crane zone</div>
              </button>

              <button
                type="button"
                class="cm-ppe-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-ppe="no_hardhat"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>Critical Hardhat Violation</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 font-mono">SIREN ALARM</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">Worker in construction zone without protective helmet</div>
              </button>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 space-y-1.5 text-xs">
            <div class="text-slate-300 font-bold">Factory Safety Interlock:</div>
            <p class="text-[11px] text-slate-400 font-sans leading-relaxed">
              When Cameraman detects missing PPE items, the Axum server fires an immediate MQTT or relay trigger to lock the physical turnstile and notify shift supervisors.
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: PPE Audit Telemetry -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-6 rounded-2xl bg-slate-950 border border-slate-800 space-y-5 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-amber-400"></span>
              Optical PPE Recognition Results
            </span>
            <span id="cm-ppe-status-badge" class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[10px] font-bold">
              ✓ COMPLIANCE PASSED
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div id="cm-ppe-card-hardhat" class="p-4 rounded-xl bg-emerald-950/30 border border-emerald-500/40 space-y-1 text-center">
              <div class="text-2xl">⛑️</div>
              <div class="font-bold text-white">HARDHAT HELMET</div>
              <div id="cm-ppe-val-hardhat" class="text-xs text-emerald-300 font-bold">DETECTED (98%)</div>
            </div>

            <div id="cm-ppe-card-vest" class="p-4 rounded-xl bg-emerald-950/30 border border-emerald-500/40 space-y-1 text-center">
              <div class="text-2xl">🦺</div>
              <div class="font-bold text-white">SAFETY VEST</div>
              <div id="cm-ppe-val-vest" class="text-xs text-emerald-300 font-bold">DETECTED (95%)</div>
            </div>

            <div id="cm-ppe-card-turnstile" class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1 text-center">
              <div class="text-2xl">🚪</div>
              <div class="font-bold text-white">TURNSTILE GATE</div>
              <div id="cm-ppe-val-turnstile" class="text-xs text-emerald-400 font-bold">UNLOCKED (ALLOW)</div>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 text-[11px] font-mono text-slate-300 space-y-1">
            <div class="text-slate-500">// Industrial Safety Telemetry Event:</div>
            <div id="cm-ppe-json">
              &#123; "event": "ppe_audit", "violations_found": false, "turnstile_action": "PERMIT_INGRESS" &#125;
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 3: Webhook Ingest & In-Memory Resiliency -->
  <div id="cm-screen-stream" class="cm-screen hidden space-y-6">
    <div class="p-6 rounded-2xl bg-slate-950 border border-slate-800 space-y-5 font-mono text-xs">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div>
          <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            Zero-Downtime Database Disconnect Resilience (RwLock Ring Buffer)
          </span>
          <p class="text-[11px] text-slate-400 font-sans mt-0.5">
            If PostgreSQL restarts or WAN connections flicker, Cameraman automatically diverts events to an in-memory thread-safe buffer without failing camera webhooks.
          </p>
        </div>
        <button
          type="button"
          id="cm-btn-toggle-db"
          class="px-3 py-1.5 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[11px] font-bold transition-all hover:bg-emerald-500/30"
        >
          DB Status: CONNECTED (Click to cut)
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-white">Active Storage Mode</span>
            <span id="cm-storage-mode" class="text-[10px] text-emerald-400 font-bold">POSTGRESQL 16 (PRIMARY)</span>
          </div>
          <p class="text-[11px] text-slate-400 font-sans leading-relaxed">
            Events are written to durable relational storage with spatial index support and foreign-key camera associations.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-white">RwLock Ring Buffer Capacity</span>
            <span class="text-[10px] text-cyan-300 font-bold">50 Events Max (FIFO Ring)</span>
          </div>
          <p class="text-[11px] text-slate-400 font-sans leading-relaxed">
            Guarantees zero heap memory leaks on low-power industrial edge devices (Raspberry Pi 5 / Jetson Orin Nano).
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initCameramanSimulator() {
    // Tab Switching
    const tabAnpr = document.getElementById('cm-tab-anpr');
    const tabPpe = document.getElementById('cm-tab-ppe');
    const tabStream = document.getElementById('cm-tab-stream');
    const screenAnpr = document.getElementById('cm-screen-anpr');
    const screenPpe = document.getElementById('cm-screen-ppe');
    const screenStream = document.getElementById('cm-screen-stream');

    const allTabs = [tabAnpr, tabPpe, tabStream];
    const allScreens = [screenAnpr, screenPpe, screenStream];

    allTabs.forEach(tab => {
      tab?.addEventListener('click', () => {
        allTabs.forEach(t => {
          t?.classList.remove('bg-rose-500/20', 'text-rose-300', 'border-rose-500/40', 'shadow-sm');
          t?.classList.add('text-slate-400');
        });
        tab.classList.remove('text-slate-400');
        tab.classList.add('bg-rose-500/20', 'text-rose-300', 'border-rose-500/40', 'shadow-sm');

        const view = tab.getAttribute('data-view');
        allScreens.forEach(s => s?.classList.add('hidden'));
        if (view === 'anpr') screenAnpr?.classList.remove('hidden');
        else if (view === 'ppe') screenPpe?.classList.remove('hidden');
        else if (view === 'stream') screenStream?.classList.remove('hidden');
      });
    });

    // Preset Buttons
    const presetButtons = document.querySelectorAll('.cm-preset-btn');
    const plateTop = document.getElementById('cm-plate-top');
    const plateBottom = document.getElementById('cm-plate-bottom');
    const tokenDistrict = document.getElementById('cm-token-district');
    const tokenMetro = document.getElementById('cm-token-metro');
    const tokenClass = document.getElementById('cm-token-class');
    const tokenNumber = document.getElementById('cm-token-number');
    const terminalLog = document.getElementById('cm-terminal-log');
    let currentScenario = 'standard';

    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        presetButtons.forEach(b => {
          b.classList.remove('border-rose-500/50', 'bg-rose-950/30', 'text-white');
          b.classList.add('border-slate-800', 'bg-slate-900', 'text-slate-300');
        });
        btn.classList.remove('border-slate-800', 'bg-slate-900', 'text-slate-300');
        btn.classList.add('border-rose-500/50', 'bg-rose-950/30', 'text-white');

        currentScenario = btn.getAttribute('data-type') || 'standard';
        runAnprSimulation();
      });
    });

    function runAnprSimulation() {
      if (!terminalLog) return;
      if (currentScenario === 'standard') {
        if (plateTop) plateTop.textContent = 'ঢাকা মেট্রো ঘ';
        if (plateBottom) plateBottom.textContent = '১২-৩৪৫৬';
        if (tokenDistrict) tokenDistrict.textContent = 'ঢাকা';
        if (tokenMetro) tokenMetro.textContent = 'TRUE';
        if (tokenClass) tokenClass.textContent = 'ঘ (Microbus)';
        if (tokenNumber) tokenNumber.textContent = '১২-৩৪৫৬';

        terminalLog.innerHTML = `
          <div class="text-slate-500">[00.000s] Ingesting POST /api/webhook from Dahua NVR (192.168.1.120)</div>
          <div class="text-emerald-400 font-bold">[00.021s] Axum returned HTTP 202 ACCEPTED in 21ms. Background task spawned.</div>
          <div class="text-cyan-300">[00.035s] AI Module [anpr] parsed raw OCR output stream:</div>
          <div class="text-slate-400">&gt;&gt;&gt; Top: "ঢাকা মেট্রো ঘ" | Bottom: "১২-৩৪৫৬"</div>
          <div class="text-emerald-300">[00.038s] District lookup: "ঢাকা" matched in DISTRICTS array (Distance: 0).</div>
          <div class="text-amber-300">[00.040s] Extracted Class Letter: 'ঘ' (Valid BRTA SUV/Microbus series).</div>
          <div class="text-emerald-400 font-bold">[00.042s] Event written to PostgreSQL \`processed_events\` table (ID: e8f9-42b1).</div>
        `;
      } else if (currentScenario === 'fuzzy') {
        if (plateTop) plateTop.textContent = 'ঢাকা মেট্রো গ';
        if (plateBottom) plateBottom.textContent = '১১-৯৮৭২';
        if (tokenDistrict) tokenDistrict.textContent = 'ঢাকা (Corrected)';
        if (tokenMetro) tokenMetro.textContent = 'TRUE';
        if (tokenClass) tokenClass.textContent = 'গ (Sedan Car)';
        if (tokenNumber) tokenNumber.textContent = '১১-৯৮৭২';

        terminalLog.innerHTML = `
          <div class="text-slate-500">[00.000s] Ingesting POST /api/webhook (JSON Base64) from Hikvision IP Cam</div>
          <div class="text-emerald-400 font-bold">[00.019s] HTTP 202 ACCEPTED in 19ms. Decoded 3.4MB image in memory.</div>
          <div class="text-amber-400 font-bold">[00.036s] OCR Typo Detected: "ডাকা মেট্রো গ"</div>
          <div class="text-cyan-300">[00.037s] Levenshtein match: "ডাকা" =&gt; "ঢাকা" (Edit distance: 1 &lt;= tolerance 1). Autocorrected!</div>
          <div class="text-purple-300">[00.039s] Normalizing digits: "11-9872" =&gt; "১১-৯৮৭২" (Bengali digits).</div>
          <div class="text-emerald-400 font-bold">[00.041s] BRTA Validated Plate: "ঢাকা মেট্রো গ ১১-৯৮৭২" saved to database.</div>
        `;
      } else if (currentScenario === 'ctg') {
        if (plateTop) plateTop.textContent = 'চট্ট মেট্রো চ';
        if (plateBottom) plateBottom.textContent = '৫৪-৩২১০';
        if (tokenDistrict) tokenDistrict.textContent = 'চট্ট (Normal)';
        if (tokenMetro) tokenMetro.textContent = 'TRUE';
        if (tokenClass) tokenClass.textContent = 'চ (Delivery Van)';
        if (tokenNumber) tokenNumber.textContent = '৫৪-৩২১০';

        terminalLog.innerHTML = `
          <div class="text-slate-500">[00.000s] Ingesting multipart/form-data from Uniview Toll Camera</div>
          <div class="text-emerald-400 font-bold">[00.024s] HTTP 202 ACCEPTED in 24ms. Snapshot saved to /uploads.</div>
          <div class="text-cyan-300">[00.038s] Detected full string: "চট্টগ্রাম মেট্রো চ"</div>
          <div class="text-emerald-300">[00.039s] Applied abbreviation rule: "চট্টগ্রাম" normalized to official BRTA prefix "চট্ট".</div>
          <div class="text-emerald-400 font-bold">[00.042s] Validated: "চট্ট মেট্রো চ \n৫৪-৩২১০". Barrier gate relay fired.</div>
        `;
      } else if (currentScenario === 'rural') {
        if (plateTop) plateTop.textContent = 'সিলেট হ';
        if (plateBottom) plateBottom.textContent = '৩৩-৪৪৫৫';
        if (tokenDistrict) tokenDistrict.textContent = 'সিলেট';
        if (tokenMetro) tokenMetro.textContent = 'FALSE';
        if (tokenClass) tokenClass.textContent = 'হ (Motorcycle)';
        if (tokenNumber) tokenNumber.textContent = '৩৩-৪৪৫৫';

        terminalLog.innerHTML = `
          <div class="text-slate-500">[00.000s] Ingesting rural highway checkpoint webhook from camera #04</div>
          <div class="text-emerald-400 font-bold">[00.022s] HTTP 202 ACCEPTED in 22ms.</div>
          <div class="text-cyan-300">[00.036s] Non-Metro Plate detected. District: "সিলেট", Class: 'হ' (Two-Wheeler).</div>
          <div class="text-emerald-400 font-bold">[00.040s] Validated successfully without metropolitan token. Stored in DB.</div>
        `;
      }
    }

    const btnProcess = document.getElementById('cm-btn-process');
    btnProcess?.addEventListener('click', runAnprSimulation);

    // PPE Controls
    const ppeButtons = document.querySelectorAll('.cm-ppe-btn');
    const ppeStatusBadge = document.getElementById('cm-ppe-status-badge');
    const cardHardhat = document.getElementById('cm-ppe-card-hardhat');
    const valHardhat = document.getElementById('cm-ppe-val-hardhat');
    const cardVest = document.getElementById('cm-ppe-card-vest');
    const valVest = document.getElementById('cm-ppe-val-vest');
    const cardTurnstile = document.getElementById('cm-ppe-card-turnstile');
    const valTurnstile = document.getElementById('cm-ppe-val-turnstile');
    const ppeJson = document.getElementById('cm-ppe-json');

    ppeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        ppeButtons.forEach(b => {
          b.classList.remove('border-emerald-500/50', 'bg-emerald-950/30', 'text-white', 'border-amber-500/50', 'bg-amber-950/30', 'border-rose-500/50', 'bg-rose-950/30');
          b.classList.add('border-slate-800', 'bg-slate-900', 'text-slate-300');
        });
        btn.classList.remove('border-slate-800', 'bg-slate-900', 'text-slate-300');

        const mode = btn.getAttribute('data-ppe');
        if (mode === 'full') {
          btn.classList.add('border-emerald-500/50', 'bg-emerald-950/30', 'text-white');
          if (ppeStatusBadge) {
            ppeStatusBadge.textContent = '✓ COMPLIANCE PASSED';
            ppeStatusBadge.className = 'px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[10px] font-bold';
          }
          if (cardHardhat) cardHardhat.className = 'p-4 rounded-xl bg-emerald-950/30 border border-emerald-500/40 space-y-1 text-center';
          if (valHardhat) { valHardhat.textContent = 'DETECTED (98%)'; valHardhat.className = 'text-xs text-emerald-300 font-bold'; }
          if (cardVest) cardVest.className = 'p-4 rounded-xl bg-emerald-950/30 border border-emerald-500/40 space-y-1 text-center';
          if (valVest) { valVest.textContent = 'DETECTED (95%)'; valVest.className = 'text-xs text-emerald-300 font-bold'; }
          if (cardTurnstile) cardTurnstile.className = 'p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1 text-center';
          if (valTurnstile) { valTurnstile.textContent = 'UNLOCKED (ALLOW)'; valTurnstile.className = 'text-xs text-emerald-400 font-bold'; }
          if (ppeJson) ppeJson.innerHTML = '&#123; "event": "ppe_audit", "violations_found": false, "turnstile_action": "PERMIT_INGRESS" &#125;';
        } else if (mode === 'missing_vest') {
          btn.classList.add('border-amber-500/50', 'bg-amber-950/30', 'text-white');
          if (ppeStatusBadge) {
            ppeStatusBadge.textContent = '⚠ VIOLATION: MISSING VEST';
            ppeStatusBadge.className = 'px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[10px] font-bold';
          }
          if (cardHardhat) cardHardhat.className = 'p-4 rounded-xl bg-emerald-950/30 border border-emerald-500/40 space-y-1 text-center';
          if (valHardhat) { valHardhat.textContent = 'DETECTED (97%)'; valHardhat.className = 'text-xs text-emerald-300 font-bold'; }
          if (cardVest) cardVest.className = 'p-4 rounded-xl bg-amber-950/40 border border-amber-500/50 space-y-1 text-center';
          if (valVest) { valVest.textContent = 'MISSING (0%) ❌'; valVest.className = 'text-xs text-amber-300 font-bold'; }
          if (cardTurnstile) cardTurnstile.className = 'p-4 rounded-xl bg-amber-950/30 border border-amber-500/40 space-y-1 text-center';
          if (valTurnstile) { valTurnstile.textContent = 'LOCKED (INTERLOCKED)'; valTurnstile.className = 'text-xs text-amber-400 font-bold'; }
          if (ppeJson) ppeJson.innerHTML = '&#123; "event": "ppe_audit", "violations_found": true, "missing_items": ["safety_vest"], "turnstile_action": "LOCK_RELAY" &#125;';
        } else if (mode === 'no_hardhat') {
          btn.classList.add('border-rose-500/50', 'bg-rose-950/30', 'text-white');
          if (ppeStatusBadge) {
            ppeStatusBadge.textContent = '🚨 DANGER: NO HELMET';
            ppeStatusBadge.className = 'px-2.5 py-0.5 rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/40 text-[10px] font-bold';
          }
          if (cardHardhat) cardHardhat.className = 'p-4 rounded-xl bg-rose-950/40 border border-rose-500/50 space-y-1 text-center';
          if (valHardhat) { valHardhat.textContent = 'MISSING (0%) ❌'; valHardhat.className = 'text-xs text-rose-300 font-bold'; }
          if (cardVest) cardVest.className = 'p-4 rounded-xl bg-emerald-950/30 border border-emerald-500/40 space-y-1 text-center';
          if (valVest) { valVest.textContent = 'DETECTED (94%)'; valVest.className = 'text-xs text-emerald-300 font-bold'; }
          if (cardTurnstile) cardTurnstile.className = 'p-4 rounded-xl bg-rose-950/30 border border-rose-500/40 space-y-1 text-center';
          if (valTurnstile) { valTurnstile.textContent = 'LOCKED (ALARM ON)'; valTurnstile.className = 'text-xs text-rose-400 font-bold'; }
          if (ppeJson) ppeJson.innerHTML = '&#123; "event": "ppe_audit", "violations_found": true, "missing_items": ["hardhat"], "siren_trigger": true &#125;';
        }
      });
    });

    // DB Fallback Toggle
    const btnToggleDb = document.getElementById('cm-btn-toggle-db');
    const storageMode = document.getElementById('cm-storage-mode');
    let dbConnected = true;

    btnToggleDb?.addEventListener('click', () => {
      dbConnected = !dbConnected;
      if (dbConnected) {
        btnToggleDb.textContent = 'DB Status: CONNECTED (Click to cut)';
        btnToggleDb.className = 'px-3 py-1.5 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[11px] font-bold transition-all hover:bg-emerald-500/30';
        if (storageMode) {
          storageMode.textContent = 'POSTGRESQL 16 (PRIMARY)';
          storageMode.className = 'text-[10px] text-emerald-400 font-bold';
        }
      } else {
        btnToggleDb.textContent = 'DB Status: OFFLINE (Click to restore)';
        btnToggleDb.className = 'px-3 py-1.5 rounded-xl bg-rose-500/20 text-rose-300 border border-rose-500/40 text-[11px] font-bold transition-all hover:bg-rose-500/30';
        if (storageMode) {
          storageMode.textContent = 'IN-MEMORY RWLOCK BUFFER (RING FALLBACK)';
          storageMode.className = 'text-[10px] text-rose-400 font-bold';
        }
      }
    });
  }

  initCameramanSimulator();
  document.addEventListener('astro:page-load', initCameramanSimulator);
</script>
