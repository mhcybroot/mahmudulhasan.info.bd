---
interface Props {
  metrics: {
    throughput: string;
    latency: string;
    memoryUsage: string;
    binarySize?: string;
    uptime?: string;
  };
  stack?: string[];
}

const {
  metrics,
  stack = [
    '100% Offline & Private',
    'Zero Cloud Uploads',
    'Ultra-Lightweight',
    'Natural Edge Sharpening',
    'Free & Open Source',
    'Rust Powered'
  ]
} = Astro.props;
---

<div class="space-y-6">
  <!-- Status Badge & Guarantee Banner -->
  <div class="flex flex-wrap items-center gap-3">
    <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-bold bg-emerald-950/90 text-emerald-300 border border-emerald-500/60 shadow-sm">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
      100% OFFLINE // ZERO DATA COLLECTION GUARANTEE
    </span>
    <span class="text-xs font-mono text-slate-300 bg-slate-800/80 px-2.5 py-1 rounded-md border border-slate-700">Works on Windows & Linux</span>
  </div>

  <!-- 4 Human-Centric Value Cards in Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" role="region" aria-label="Key Benefits & Performance Metrics">
    <!-- Card 1: Processing Speed -->
    <div class="relative overflow-hidden rounded-xl bg-slate-900 border border-slate-700/80 p-5 hover:border-cyan-400 transition-colors group shadow-lg">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-300 font-semibold">Speed &amp; Capacity</span>
        <span class="w-3 h-3 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]" title="Verified Instant Speed"></span>
      </div>
      <div class="text-3xl font-mono font-bold text-white group-hover:text-cyan-300 transition-colors">
        {metrics.throughput}
      </div>
      <p class="mt-2 text-xs font-sans text-slate-200 leading-snug">
        Enlarges and sharpens hundreds of photos in less than a second.
      </p>
      <div class="mt-3 pt-3 border-t border-slate-800 flex justify-between text-xs font-mono text-cyan-300">
        <span>7x Faster</span>
        <span>Zero Waiting</span>
      </div>
    </div>

    <!-- Card 2: Instant Response -->
    <div class="relative overflow-hidden rounded-xl bg-slate-900 border border-slate-700/80 p-5 hover:border-cyan-400 transition-colors group shadow-lg">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-300 font-semibold">Time Per Photo</span>
        <span class="text-xs font-mono px-2 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-500/50 font-bold">Instant</span>
      </div>
      <div class="text-3xl font-mono font-bold text-white group-hover:text-cyan-300 transition-colors">
        {metrics.latency}
      </div>
      <p class="mt-2 text-xs font-sans text-slate-200 leading-snug">
        Faster than a human eye blink. Clean results appear immediately.
      </p>
      <div class="mt-3 pt-3 border-t border-slate-800 flex justify-between text-xs font-mono text-cyan-300">
        <span>Single-Click</span>
        <span>Batch Mode</span>
      </div>
    </div>

    <!-- Card 3: PC Health & Memory -->
    <div class="relative overflow-hidden rounded-xl bg-slate-900 border border-slate-700/80 p-5 hover:border-emerald-400 transition-colors group shadow-lg">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-300 font-semibold">Memory Usage</span>
        <span class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-500/50 font-bold">Ultralight</span>
      </div>
      <div class="text-3xl font-mono font-bold text-emerald-300">
        {metrics.memoryUsage}
      </div>
      <p class="mt-2 text-xs font-sans text-slate-200 leading-snug">
        Uses less RAM than a single browser tab. Never slows down your PC.
      </p>
      <div class="mt-3 pt-3 border-t border-slate-800 flex justify-between text-xs font-mono text-emerald-300">
        <span>Runs on Any PC</span>
        <span>Battery Friendly</span>
      </div>
    </div>

    <!-- Card 4: Complete Privacy -->
    <div class="relative overflow-hidden rounded-xl bg-slate-900 border border-slate-700/80 p-5 hover:border-emerald-400 transition-colors group shadow-lg">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-300 font-semibold">Data Privacy</span>
        <span class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-500/50 font-bold">100% Offline</span>
      </div>
      <div class="text-3xl font-mono font-bold text-emerald-300">
        100% Safe
      </div>
      <p class="mt-2 text-xs font-sans text-slate-200 leading-snug">
        Your family &amp; customer photos never leave your device. Zero cloud risk.
      </p>
      <div class="mt-3 pt-3 border-t border-slate-800 flex justify-between text-xs font-mono text-emerald-300">
        <span>No Internet Needed</span>
        <span>No Account Required</span>
      </div>
    </div>
  </div>

  <!-- Key Assurance Badges -->
  <div class="flex flex-wrap items-center gap-2 pt-2">
    <span class="text-xs font-mono text-slate-300 font-bold mr-2 uppercase tracking-wide">GUARANTEES //</span>
    {stack.map((item) => (
      <span class="inline-flex items-center px-3 py-1 rounded-md bg-slate-800 border border-slate-700 text-xs font-mono text-slate-200 hover:border-cyan-400 transition-colors font-medium">
        {item}
      </span>
    ))}
  </div>
</div>
