---
interface Props {
  metrics: {
    throughput: string;
    latency: string;
    memoryUsage: string;
    binarySize?: string;
    uptime?: string;
  };
  stack?: string[];
}

const { metrics, stack = ['Rust 2021', 'AVX2/NEON SIMD', 'Rayon Threadpool', 'AMD FidelityFX CAS', 'egui/eframe GUI', 'SHA-256 DRM'] } = Astro.props;
---

<div class="space-y-6">
  <!-- Status Badge & Title Area -->
  <div class="flex flex-wrap items-center gap-3">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      PRODUCTION CASE STUDY // SYSTEMS ENGINE v2.1-STABLE
    </span>
    <span class="text-xs font-mono text-slate-400">Arch: x86_64 / aarch64</span>
  </div>

  <!-- 4 High-Impact Telemetry Stat Cards in Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" role="region" aria-label="High-Impact Engine Telemetry">
    <!-- Card 1: Batch Throughput -->
    <div class="relative overflow-hidden rounded-xl bg-slate-900/80 border border-slate-800 p-5 hover:border-cyan-500/40 transition-colors group">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Batch Throughput</span>
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400" title="Live Telemetry Verified"></span>
      </div>
      <div class="text-3xl font-mono font-bold text-slate-100 group-hover:text-cyan-400 transition-colors">
        {metrics.throughput}
      </div>
      <p class="mt-2 text-xs font-sans text-slate-400 flex items-center gap-1">
        <span class="text-emerald-400 font-mono font-medium">▲ 7.1x</span> vs OpenCV C++ Baseline
      </p>
      <div class="mt-3 pt-3 border-t border-slate-800/80 flex justify-between text-[11px] font-mono text-slate-500">
        <span>Target: 720x480</span>
        <span>16 Threads</span>
      </div>
    </div>

    <!-- Card 2: Latency Profile -->
    <div class="relative overflow-hidden rounded-xl bg-slate-900/80 border border-slate-800 p-5 hover:border-cyan-500/40 transition-colors group">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Latency / Frame</span>
        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">p99</span>
      </div>
      <div class="text-3xl font-mono font-bold text-slate-100 group-hover:text-cyan-400 transition-colors">
        {metrics.latency}
      </div>
      <p class="mt-2 text-xs font-sans text-slate-400 flex items-center gap-1">
        <span class="text-cyan-400 font-mono font-medium">Lanczos3</span> + CAS Filtering
      </p>
      <div class="mt-3 pt-3 border-t border-slate-800/80 flex justify-between text-[11px] font-mono text-slate-500">
        <span>Kernel: SIMD AVX2</span>
        <span>P50: 2.18ms</span>
      </div>
    </div>

    <!-- Card 3: Memory Footprint -->
    <div class="relative overflow-hidden rounded-xl bg-slate-900/80 border border-slate-800 p-5 hover:border-cyan-500/40 transition-colors group">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Peak Memory RSS</span>
        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Zero-GC</span>
      </div>
      <div class="text-3xl font-mono font-bold text-slate-100 group-hover:text-emerald-400 transition-colors">
        {metrics.memoryUsage}
      </div>
      <p class="mt-2 text-xs font-sans text-slate-400 flex items-center gap-1">
        <span class="text-emerald-400 font-mono font-medium">93% reduction</span> vs JVM/Python
      </p>
      <div class="mt-3 pt-3 border-t border-slate-800/80 flex justify-between text-[11px] font-mono text-slate-500">
        <span>Zero Heap Drift</span>
        <span>Static 9.7MB Bin</span>
      </div>
    </div>

    <!-- Card 4: Verification Status -->
    <div class="relative overflow-hidden rounded-xl bg-slate-900/80 border border-slate-800 p-5 hover:border-cyan-500/40 transition-colors group">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Verification Suite</span>
        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">All Green</span>
      </div>
      <div class="text-3xl font-mono font-bold text-emerald-400">
        4/4 Tests
      </div>
      <p class="mt-2 text-xs font-sans text-slate-400 flex items-center gap-1">
        <span class="text-emerald-400 font-mono font-medium">100% Pass</span> • 0 Deadlocks
      </p>
      <div class="mt-3 pt-3 border-t border-slate-800/80 flex justify-between text-[11px] font-mono text-slate-500">
        <span>CI: Automated</span>
        <span>Runtime: 0.27s</span>
      </div>
    </div>
  </div>

  <!-- Tech Badges Bar -->
  <div class="flex flex-wrap items-center gap-2 pt-2">
    <span class="text-xs font-mono text-slate-500 mr-2">TECH_STACK //</span>
    {stack.map((item) => (
      <span class="inline-flex items-center px-2.5 py-1 rounded bg-slate-800/80 border border-slate-700 text-xs font-mono text-cyan-300 hover:border-cyan-400/50 transition-colors">
        {item}
      </span>
    ))}
  </div>
</div>
