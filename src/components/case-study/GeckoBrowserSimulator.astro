---
// GeckoEngine: Independent Android Web Browser & GeckoView Omni 134 Runtime Simulator
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl p-6 sm:p-8 space-y-8 shadow-2xl">
  <!-- Simulator Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-orange-400 font-mono text-xs uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-orange-400 animate-pulse"></span>
        Interactive Android Native &amp; GeckoView Omni Sandbox
      </div>
      <h2 class="text-2xl sm:text-3xl font-mono font-bold text-white flex items-center gap-3">
        GeckoEngine: Mobile Web Runtime Simulator
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 font-sans mt-1">
        Experience Mozilla GeckoView 134 Quantum rendering, reactive session lifecycle delegates, and scheme-aware URL dispatch.
      </p>
    </div>

    <!-- Active Perspective Switcher -->
    <div class="flex items-center p-1 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono overflow-x-auto">
      <button
        type="button"
        id="gecko-tab-browser"
        class="gecko-tab-btn px-3.5 py-1.5 rounded-lg bg-orange-500/20 text-orange-300 border border-orange-500/40 font-semibold transition-all shadow-sm"
        data-view="browser"
      >
        📱 Live Browser Runtime
      </button>
      <button
        type="button"
        id="gecko-tab-compare"
        class="gecko-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="compare"
      >
        ⚖️ GeckoView vs Blink WebView
      </button>
      <button
        type="button"
        id="gecko-tab-delegates"
        class="gecko-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="delegates"
      >
        📡 GeckoSession Delegates
      </button>
    </div>
  </div>

  <!-- View 1: Live Browser Runtime (Default) -->
  <div id="gecko-screen-browser" class="gecko-screen space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Controls & Presets -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-orange-400"></span>
              Runtime Configuration
            </span>
            <span class="px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 text-[10px]">
              GECKOVIEW 134.0 OMNI
            </span>
          </div>

          <!-- Fast Navigation Quicklinks -->
          <div class="space-y-2">
            <label class="text-[11px] text-slate-400 uppercase font-semibold">Test Destination Presets:</label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
              <button
                type="button"
                class="gecko-preset-btn p-2 rounded-lg bg-slate-900 border border-slate-700 hover:border-orange-400 text-left transition-all text-[11px]"
                data-url="https://mozilla.org"
              >
                <div class="text-white font-bold truncate">🌐 Mozilla</div>
                <div class="text-slate-400 text-[10px] truncate">Quantum Core</div>
              </button>
              <button
                type="button"
                class="gecko-preset-btn p-2 rounded-lg bg-slate-900 border border-slate-700 hover:border-orange-400 text-left transition-all text-[11px]"
                data-url="https://duckduckgo.com"
              >
                <div class="text-white font-bold truncate">🦆 DuckDuckGo</div>
                <div class="text-slate-400 text-[10px] truncate">Privacy Engine</div>
              </button>
              <button
                type="button"
                class="gecko-preset-btn p-2 rounded-lg bg-slate-900 border border-slate-700 hover:border-orange-400 text-left transition-all text-[11px]"
                data-url="internal://enterprise-kiosk"
              >
                <div class="text-white font-bold truncate">🏢 Kiosk ERP</div>
                <div class="text-slate-400 text-[10px] truncate">Hardened Intranet</div>
              </button>
            </div>
          </div>

          <!-- URL Normalizer Diagnostic Sandbox -->
          <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 space-y-2">
            <div class="text-[11px] text-slate-300 font-bold flex items-center justify-between">
              <span>Scheme Resolver Test:</span>
              <span id="gecko-resolver-badge" class="text-orange-400 text-[10px]">AUTO-RESOLVE</span>
            </div>
            <p class="text-[10px] text-slate-400 leading-relaxed font-sans">
              Enter any bare string (e.g. <code class="text-orange-300">rust microkernel</code>) or domain (e.g. <code class="text-orange-300">github.com</code>). Kotlin handler normalizes scheme before GeckoSession loading.
            </p>
          </div>

          <!-- Engine Status Metrics -->
          <div class="grid grid-cols-2 gap-2 text-[11px]">
            <div class="p-2.5 rounded-lg bg-slate-900 border border-slate-800">
              <div class="text-slate-400 text-[10px]">ENGINE PROCESS</div>
              <div class="text-white font-bold mt-0.5">Isolated Daemon</div>
            </div>
            <div class="p-2.5 rounded-lg bg-slate-900 border border-slate-800">
              <div class="text-slate-400 text-[10px]">COMPOSITOR</div>
              <div class="text-emerald-400 font-bold mt-0.5">WebRender 60fps</div>
            </div>
            <div class="p-2.5 rounded-lg bg-slate-900 border border-slate-800">
              <div class="text-slate-400 text-[10px]">JAVASCRIPT JIT</div>
              <div class="text-cyan-300 font-bold mt-0.5">SpiderMonkey 134</div>
            </div>
            <div class="p-2.5 rounded-lg bg-slate-900 border border-slate-800">
              <div class="text-slate-400 text-[10px]">CHROMIUM DEPENDENCY</div>
              <div class="text-rose-400 font-bold mt-0.5">0% (Pure Gecko)</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Android Mobile Viewport -->
      <div class="lg:col-span-7">
        <div class="rounded-3xl border-2 border-slate-700 bg-slate-950 p-3 shadow-2xl flex flex-col h-[520px]">
          <!-- Mobile Browser Header & Navigation Bar -->
          <div class="rounded-2xl bg-slate-900 border border-slate-800 p-2.5 space-y-2 mb-2">
            <!-- Top Controls: Navigation Buttons & URL Bar -->
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                id="gecko-btn-back"
                disabled
                class="p-2 rounded-lg bg-slate-800 text-slate-500 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-slate-700 hover:text-white transition-all text-xs font-mono font-bold"
                title="Go Back"
              >
                ◀
              </button>
              <button
                type="button"
                id="gecko-btn-forward"
                disabled
                class="p-2 rounded-lg bg-slate-800 text-slate-500 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-slate-700 hover:text-white transition-all text-xs font-mono font-bold"
                title="Go Forward"
              >
                ▶
              </button>
              <button
                type="button"
                id="gecko-btn-reload"
                class="p-2 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-all text-xs font-mono font-bold"
                title="Reload Page"
              >
                🔄
              </button>

              <!-- URL Input Bar -->
              <div class="relative flex-1 flex items-center">
                <input
                  type="text"
                  id="gecko-url-input"
                  value="https://mozilla.org"
                  placeholder="Enter URL or search query..."
                  class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-1.5 text-xs font-mono text-slate-100 focus:outline-none focus:border-orange-400 focus:ring-1 focus:ring-orange-400 pr-12 transition-all placeholder:text-slate-600"
                />
                <button
                  type="button"
                  id="gecko-btn-go"
                  class="absolute right-1 px-2.5 py-1 rounded-lg bg-orange-600 hover:bg-orange-500 text-white font-mono text-[11px] font-bold transition-all shadow-sm"
                >
                  GO
                </button>
              </div>
            </div>

            <!-- Progress Bar (Subscribes to GeckoSession.ProgressDelegate) -->
            <div class="w-full bg-slate-950 rounded-full h-1 overflow-hidden">
              <div
                id="gecko-progress-bar"
                class="bg-gradient-to-r from-orange-500 via-amber-400 to-emerald-400 h-full w-0 transition-all duration-300"
              ></div>
            </div>
          </div>

          <!-- Viewport Render Canvas (Simulated GeckoView) -->
          <div class="relative flex-1 rounded-xl bg-slate-900 border border-slate-800 overflow-hidden flex flex-col justify-between p-6">
            <!-- Simulated Page Content -->
            <div id="gecko-viewport-content" class="space-y-4">
              <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-orange-500"></span>
                  <span id="gecko-page-title" class="font-mono font-bold text-white text-sm">
                    Mozilla: Reclaiming the Web with GeckoView
                  </span>
                </div>
                <span id="gecko-security-indicator" class="font-mono text-[10px] px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center gap-1">
                  🔒 TLS 1.3 Verified
                </span>
              </div>

              <div id="gecko-page-body" class="space-y-3 font-sans text-xs text-slate-300 leading-relaxed">
                <p>
                  You are viewing an independent mobile web instance rendered by <strong class="text-white">Mozilla GeckoView Omni 134</strong>. This rendering path executes outside of Google Chromium’s ecosystem, completely freeing your Android app from Blink-based tracking and forced Manifest V3 network restrictions.
                </p>
                <div class="p-3.5 rounded-xl bg-slate-950/80 border border-slate-800 font-mono text-[11px] text-slate-200 space-y-1">
                  <div class="text-orange-400 font-semibold">⚡ Engine Highlights:</div>
                  <div>• Stylo: Parallel Rust-based CSS styling engine</div>
                  <div>• WebRender: Hardware GPU-accelerated page compositor</div>
                  <div>• SpiderMonkey: High-performance ECMAScript runtime</div>
                </div>
              </div>
            </div>

            <!-- Bottom Floating Telemetry Bar -->
            <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between font-mono text-[10px] text-slate-400">
              <span id="gecko-status-text">Status: 200 OK • Loaded in 24ms</span>
              <span class="text-emerald-400">FPS: 60 • GPU VRAM: 38MB</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 2: Architectural Comparison Matrix -->
  <div id="gecko-screen-compare" class="gecko-screen hidden space-y-6">
    <div class="rounded-2xl bg-slate-950 border border-slate-800 p-6 space-y-6">
      <div class="border-b border-slate-800 pb-4">
        <h3 class="text-lg font-mono font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-orange-400"></span>
          GeckoView Omni vs. Android System WebView (Chromium Blink)
        </h3>
        <p class="text-xs text-slate-300 font-sans mt-1">
          Why enterprise systems and privacy-hardened Android hardware choose Mozilla GeckoView over Google’s default WebView.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 font-mono text-xs">
        <!-- GeckoView Omni Card -->
        <div class="p-5 rounded-xl bg-slate-900 border border-orange-500/40 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="font-bold text-orange-400 text-sm">Mozilla GeckoView Omni 134</span>
            <span class="px-2 py-0.5 rounded bg-orange-500/20 text-orange-300 text-[10px]">INDEPENDENT</span>
          </div>
          <ul class="space-y-2.5 text-slate-300 text-[11px]">
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>Chromium Independence:</strong> Zero dependence on Google Play Services or Android OS updates.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>Full Extension API:</strong> Supports native Gecko WebExtensions with unrestricted ad-blocking and network filters.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>Rust-Powered WebRender:</strong> GPU rendering engine delivers smooth 60 FPS scrolling with zero jank.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>Micro-Level Delegate Control:</strong> Direct access to network, permissions, and session lifecycle.</span>
            </li>
          </ul>
        </div>

        <!-- Android System WebView Card -->
        <div class="p-5 rounded-xl bg-slate-900 border border-slate-700 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="font-bold text-slate-300 text-sm">Android System WebView (Blink)</span>
            <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-400 text-[10px]">MONOPOLY</span>
          </div>
          <ul class="space-y-2.5 text-slate-400 text-[11px]">
            <li class="flex items-start gap-2">
              <span class="text-rose-400 font-bold">✗</span>
              <span><strong>Google Telemetry:</strong> Automatically ties browsing activity to Google Advertising IDs and OS services.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose-400 font-bold">✗</span>
              <span><strong>Manifest V3 Lock-In:</strong> Strips powerful content-blocking APIs, enforcing crippled ad-blockers.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose-400 font-bold">✗</span>
              <span><strong>Fragmented OS Updates:</strong> Renders inconsistently across older Android versions without manual updates.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose-400 font-bold">✗</span>
              <span><strong>Opaque Callbacks:</strong> Black-box browser engine with minimal visibility into rendering crashes.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- View 3: Live Delegate Event Inspector -->
  <div id="gecko-screen-delegates" class="gecko-screen hidden space-y-6">
    <div class="rounded-2xl bg-slate-950 border border-slate-800 p-6 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div>
          <h3 class="font-mono font-bold text-white text-base flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
            GeckoSession Reactive Delegate Stream
          </h3>
          <p class="text-xs text-slate-300 font-sans mt-0.5">
            Real-time telemetry showing live calls dispatched by ProgressDelegate &amp; NavigationDelegate listeners.
          </p>
        </div>
        <button
          type="button"
          id="gecko-btn-clear-logs"
          class="px-2.5 py-1 rounded-lg bg-slate-800 text-slate-300 hover:text-white border border-slate-700 text-xs font-mono"
        >
          Clear Stream
        </button>
      </div>

      <!-- Terminal Output Window -->
      <div
        id="gecko-terminal-logs"
        class="bg-slate-900 rounded-xl p-4 font-mono text-xs text-slate-200 border border-slate-800 h-64 overflow-y-auto space-y-1.5 scrollbar-thin scrollbar-thumb-slate-700"
      >
        <div class="text-slate-500 font-semibold">// Initializing GeckoRuntime singleton across Android Application lifecycle...</div>
        <div class="text-emerald-400 font-semibold">[GeckoRuntime.create] Singleton initialized. Context: com.example.browser</div>
        <div class="text-cyan-300">[GeckoSession.open] Session attached to GeckoView container view.</div>
        <div class="text-amber-300">[ProgressDelegate.onPageStart] Target URL: https://mozilla.org</div>
        <div class="text-slate-300">[ProgressDelegate.onProgressChange] 35% -> DOM parsing complete</div>
        <div class="text-slate-300">[ProgressDelegate.onProgressChange] 75% -> Stylesheets computed (Stylo)</div>
        <div class="text-slate-300">[ProgressDelegate.onProgressChange] 100% -> Frame rendered (WebRender)</div>
        <div class="text-emerald-400">[ProgressDelegate.onPageStop] Page loaded successfully. Status: 200 OK</div>
        <div class="text-purple-300">[NavigationDelegate.onCanGoBack] canGoBack: false | canGoForward: false</div>
      </div>
    </div>
  </div>
</div>

<script>
  // Script handling simulator interactions
  function initGeckoSimulator() {
    const tabBrowser = document.getElementById('gecko-tab-browser');
    const tabCompare = document.getElementById('gecko-tab-compare');
    const tabDelegates = document.getElementById('gecko-tab-delegates');

    const screenBrowser = document.getElementById('gecko-screen-browser');
    const screenCompare = document.getElementById('gecko-screen-compare');
    const screenDelegates = document.getElementById('gecko-screen-delegates');

    const tabs = [
      { btn: tabBrowser, screen: screenBrowser },
      { btn: tabCompare, screen: screenCompare },
      { btn: tabDelegates, screen: screenDelegates },
    ];

    tabs.forEach(({ btn, screen }) => {
      btn?.addEventListener('click', () => {
        tabs.forEach(t => {
          t.btn?.classList.remove('bg-orange-500/20', 'text-orange-300', 'border-orange-500/40');
          t.btn?.classList.add('text-slate-400');
          t.screen?.classList.add('hidden');
        });
        btn.classList.add('bg-orange-500/20', 'text-orange-300', 'border-orange-500/40');
        btn.classList.remove('text-slate-400');
        screen?.classList.remove('hidden');
      });
    });

    // Browser Viewport Elements
    const urlInput = document.getElementById('gecko-url-input') as HTMLInputElement | null;
    const btnGo = document.getElementById('gecko-btn-go');
    const btnBack = document.getElementById('gecko-btn-back') as HTMLButtonElement | null;
    const btnForward = document.getElementById('gecko-btn-forward') as HTMLButtonElement | null;
    const btnReload = document.getElementById('gecko-btn-reload');
    const progressBar = document.getElementById('gecko-progress-bar');
    const pageTitle = document.getElementById('gecko-page-title');
    const pageBody = document.getElementById('gecko-page-body');
    const statusText = document.getElementById('gecko-status-text');
    const terminalLogs = document.getElementById('gecko-terminal-logs');
    const btnClearLogs = document.getElementById('gecko-btn-clear-logs');
    const presetBtns = document.querySelectorAll('.gecko-preset-btn');

    // Navigation History State
    let historyStack: string[] = ['https://mozilla.org'];
    let historyIndex = 0;

    function logEvent(text: string, colorClass: string) {
      if (!terminalLogs) return;
      const time = new Date().toISOString().substring(11, 19);
      const row = document.createElement('div');
      row.className = colorClass;
      row.textContent = `[${time}] ${text}`;
      terminalLogs.appendChild(row);
      terminalLogs.scrollTop = terminalLogs.scrollHeight;
    }

    function updateNavButtons() {
      if (btnBack) {
        btnBack.disabled = historyIndex <= 0;
        if (historyIndex > 0) {
          btnBack.classList.remove('text-slate-500', 'disabled:opacity-40');
          btnBack.classList.add('text-slate-200');
        } else {
          btnBack.classList.add('text-slate-500', 'disabled:opacity-40');
          btnBack.classList.remove('text-slate-200');
        }
      }
      if (btnForward) {
        btnForward.disabled = historyIndex >= historyStack.length - 1;
        if (historyIndex < historyStack.length - 1) {
          btnForward.classList.remove('text-slate-500', 'disabled:opacity-40');
          btnForward.classList.add('text-slate-200');
        } else {
          btnForward.classList.add('text-slate-500', 'disabled:opacity-40');
          btnForward.classList.remove('text-slate-200');
        }
      }
    }

    function navigate(rawUrl: string, pushHistory = true) {
      let finalUrl = rawUrl.trim();
      if (!finalUrl) return;

      // Smart Scheme Resolver (from MainActivity.kt)
      if (finalUrl.startsWith('http://') || finalUrl.startsWith('https://') || finalUrl.startsWith('internal://')) {
        // Keep as is
      } else if (finalUrl.includes('.') && !finalUrl.includes(' ')) {
        finalUrl = `https://${finalUrl}`;
      } else {
        finalUrl = `https://www.google.com/search?q=${encodeURIComponent(finalUrl)}`;
      }

      if (urlInput) urlInput.value = finalUrl;

      if (pushHistory) {
        if (historyIndex < historyStack.length - 1) {
          historyStack = historyStack.slice(0, historyIndex + 1);
        }
        historyStack.push(finalUrl);
        historyIndex = historyStack.length - 1;
      }

      updateNavButtons();

      // Trigger Simulated GeckoSession Progress
      if (progressBar) {
        progressBar.style.width = '15%';
      }
      logEvent(`[ProgressDelegate.onPageStart] Initiating session load: ${finalUrl}`, 'text-amber-300 font-semibold');

      setTimeout(() => {
        if (progressBar) progressBar.style.width = '55%';
        logEvent(`[ProgressDelegate.onProgressChange] 55% -> Network headers parsed`, 'text-slate-300');
      }, 150);

      setTimeout(() => {
        if (progressBar) progressBar.style.width = '85%';
        logEvent(`[ProgressDelegate.onProgressChange] 85% -> Stylo layout calculated`, 'text-slate-300');
      }, 300);

      setTimeout(() => {
        if (progressBar) progressBar.style.width = '100%';
        logEvent(`[ProgressDelegate.onPageStop] WebRender frame committed (200 OK)`, 'text-emerald-400 font-semibold');
        logEvent(`[NavigationDelegate.onLocationChange] URL committed: ${finalUrl}`, 'text-cyan-300');
        logEvent(`[NavigationDelegate.onCanGoBack] canGoBack: ${historyIndex > 0} | canGoForward: ${historyIndex < historyStack.length - 1}`, 'text-purple-300');

        // Render simulated content
        if (finalUrl.includes('duckduckgo')) {
          if (pageTitle) pageTitle.textContent = 'DuckDuckGo — Privacy, simplified.';
          if (pageBody) {
            pageBody.innerHTML = `
              <p>Searching anonymously with zero user trackers or personalized ad attribution. Rendered via <strong class="text-white">GeckoView 134</strong>.</p>
              <div class="p-3.5 rounded-xl bg-slate-950/80 border border-slate-800 font-mono text-[11px] text-slate-200 space-y-1">
                <div class="text-orange-400 font-semibold">🔒 Privacy Score: 100%</div>
                <div>• Zero third-party telemetry scripts</div>
                <div>• Isolated Gecko Cookie Partitioning</div>
                <div>• Fingerprint Protection: ACTIVE</div>
              </div>
            `;
          }
        } else if (finalUrl.includes('internal://enterprise-kiosk')) {
          if (pageTitle) pageTitle.textContent = 'Enterprise Kiosk ERP Portal';
          if (pageBody) {
            pageBody.innerHTML = `
              <p>Industrial handheld client running in kiosk lock-down mode. Native hardware serial ports and barcode scanners bound directly to GeckoView session.</p>
              <div class="p-3.5 rounded-xl bg-slate-950/80 border border-slate-800 font-mono text-[11px] text-slate-200 space-y-1">
                <div class="text-emerald-400 font-semibold">🏭 Factory Terminal Telemetry:</div>
                <div>• Device Mode: Kiosk Lock-down (No System Dialogs)</div>
                <div>• Local Offline Cache: 100% Hit Rate</div>
                <div>• Memory Footprint: 36.4 MB RAM</div>
              </div>
            `;
          }
        } else if (finalUrl.includes('google.com/search')) {
          const q = new URL(finalUrl).searchParams.get('q') || '';
          if (pageTitle) pageTitle.textContent = `Search Results: ${q}`;
          if (pageBody) {
            pageBody.innerHTML = `
              <p>Scheme resolver dynamically mapped unformatted query into URL-encoded search parameters.</p>
              <div class="p-3.5 rounded-xl bg-slate-950/80 border border-slate-800 font-mono text-[11px] text-slate-200 space-y-1">
                <div class="text-cyan-400 font-semibold">🔍 Query Dispatch Result:</div>
                <div>• Normalized Query: "${q}"</div>
                <div>• Dispatch Latency: 12ms</div>
                <div>• Fallback Engine: Google Search</div>
              </div>
            `;
          }
        } else {
          if (pageTitle) pageTitle.textContent = 'Mozilla: Reclaiming the Web with GeckoView';
          if (pageBody) {
            pageBody.innerHTML = `
              <p>You are viewing an independent mobile web instance rendered by <strong class="text-white">Mozilla GeckoView Omni 134</strong>. Bypasses Chromium Blink tracking entirely.</p>
              <div class="p-3.5 rounded-xl bg-slate-950/80 border border-slate-800 font-mono text-[11px] text-slate-200 space-y-1">
                <div class="text-orange-400 font-semibold">⚡ Engine Highlights:</div>
                <div>• Stylo: Parallel Rust-based CSS styling engine</div>
                <div>• WebRender: Hardware GPU-accelerated page compositor</div>
                <div>• SpiderMonkey: High-performance ECMAScript runtime</div>
              </div>
            `;
          }
        }

        if (statusText) statusText.textContent = `Status: 200 OK • Loaded in ${Math.floor(Math.random() * 20 + 15)}ms`;

        setTimeout(() => {
          if (progressBar) progressBar.style.width = '0%';
        }, 400);
      }, 500);
    }

    btnGo?.addEventListener('click', () => {
      if (urlInput) navigate(urlInput.value);
    });

    urlInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        navigate(urlInput.value);
      }
    });

    btnBack?.addEventListener('click', () => {
      if (historyIndex > 0) {
        historyIndex--;
        navigate(historyStack[historyIndex], false);
      }
    });

    btnForward?.addEventListener('click', () => {
      if (historyIndex < historyStack.length - 1) {
        historyIndex++;
        navigate(historyStack[historyIndex], false);
      }
    });

    btnReload?.addEventListener('click', () => {
      if (urlInput) navigate(urlInput.value, false);
    });

    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-url');
        if (url) navigate(url);
      });
    });

    btnClearLogs?.addEventListener('click', () => {
      if (terminalLogs) terminalLogs.innerHTML = '<div class="text-slate-500 font-semibold">// Stream cleared. Waiting for session events...</div>';
    });
  }

  initGeckoSimulator();
  document.addEventListener('astro:page-load', initGeckoSimulator);
</script>
