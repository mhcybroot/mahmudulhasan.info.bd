      if (!mobileLogs) return;
      const time = new Date().toTimeString().split(' ')[0] + '.' + Math.floor(Math.random() * 900 + 100);
      const colorClass = type === 'rose' ? 'text-rose-400' : type === 'emerald' ? 'text-emerald-400' : type === 'sky' ? 'text-sky-400' : 'text-slate-400';
      const el = document.createElement('div');
      el.className = colorClass;
      el.textContent = `[${time}] ${msg}`;
      mobileLogs.appendChild(el);
      mobileLogs.scrollTop = mobileLogs.scrollHeight;
    }

