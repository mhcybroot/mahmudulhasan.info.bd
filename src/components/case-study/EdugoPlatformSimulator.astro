---
// EduGo: Multi-Tenant Academic ERP & Dual-Security Filter Architecture Simulator
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl p-6 sm:p-8 space-y-8 shadow-2xl">
  <!-- Simulator Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-sky-400 font-mono text-xs uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse"></span>
        Interactive Dual-Security &amp; Multi-Tenant Sandbox
      </div>
      <h2 class="text-2xl sm:text-3xl font-mono font-bold text-white flex items-center gap-3">
        EduGo: Dual-Security &amp; Tenant Core
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 font-sans mt-1">
        Simulate concurrent stateless JWT mobile verification, session-based Vaadin admin security, and hierarchical database tenant isolation in real time.
      </p>
    </div>

    <!-- Active Perspective Switcher -->
    <div class="flex items-center p-1 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono overflow-x-auto">
      <button
        type="button"
        id="edugo-tab-security"
        class="edugo-tab-btn px-3.5 py-1.5 rounded-lg bg-sky-500/20 text-sky-300 border border-sky-500/40 font-semibold transition-all shadow-sm"
        data-view="security"
      >
        🛡️ Dual Security Chains
      </button>
      <button
        type="button"
        id="edugo-tab-tenant"
        class="edugo-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="tenant"
      >
        🏛️ Multi-Tenant Isolation
      </button>
      <button
        type="button"
        id="edugo-tab-mobile"
        class="edugo-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="mobile"
      >
        📱 Flutter Token Interceptor
      </button>
    </div>
  </div>

  <!-- View 1: Dual Security Chains (Default) -->
  <div id="edugo-screen-security" class="edugo-screen space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Inbound HTTP Request Selection -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-sky-400"></span>
              Inbound HTTP Traffic Dispatcher
            </span>
            <span class="text-[10px] text-slate-400 font-mono">SecurityConfig.java</span>
          </div>

          <!-- Scenario Presets -->
          <div class="space-y-1.5">
            <label class="text-[11px] text-slate-300 font-sans font-semibold">Select Test Request Path:</label>
            <div class="grid grid-cols-1 gap-2">
              <button
                type="button"
                class="edugo-req-btn text-left p-2.5 rounded-xl border border-sky-500/50 bg-sky-950/30 text-white hover:border-sky-400 transition-all text-xs"
                data-req="mobile_login"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>POST /api/v1/auth/login</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-300 font-mono">ORDER(0)</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">Mobile Flutter Client • Stateless JWT Bearer Minting</div>
              </button>

              <button
                type="button"
                class="edugo-req-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-req="vaadin_web"
              >
                <div class="font-bold flex items-center justify-between text-indigo-300">
                  <span>GET /ui/admin/dashboard</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300 font-mono">ORDER(1)</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">Desktop Browser • VaadinWebSecurity • Cookie Session</div>
              </button>

              <button
                type="button"
                class="edugo-req-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-req="superadmin_api"
              >
                <div class="font-bold flex items-center justify-between text-purple-300">
                  <span>POST /api/v1/super-admin/institutes</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 font-mono">RBAC GATE</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">Tenant Provisioning • Requires ROLE_SUPER_ADMIN</div>
              </button>

              <button
                type="button"
                class="edugo-req-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-req="google_oauth_mobile"
              >
                <div class="font-bold flex items-center justify-between text-emerald-300">
                  <span>POST /api/v1/auth/google</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono">ID_TOKEN</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">Mobile Google Auth • Cryptographic Sign Verification</div>
              </button>
            </div>
          </div>

          <!-- Raw Inbound HTTP Header Inspection -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-[11px] text-slate-300 font-sans">
              <span class="font-semibold">Inbound HTTP Request Headers:</span>
              <span class="text-sky-400 font-mono text-[10px]" id="edugo-req-method">POST</span>
            </div>
            <pre id="edugo-raw-headers" class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-[10px] text-slate-300 font-mono overflow-x-auto whitespace-pre leading-relaxed max-h-36">Host: edugo.local:8080
Content-Type: application/json
Accept: application/json
User-Agent: EduGo-Mobile-Flutter/3.29.0 (Android SDK 34)
Origin: http://10.0.2.2:8080
Body: &#123; "email": "admin@edugo.local", "password": "••••••••" &#125;</pre>
          </div>

          <!-- Dispatch Button -->
          <button
            type="button"
            id="edugo-btn-dispatch"
            class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white font-mono font-bold text-xs shadow-lg shadow-sky-500/20 transition-all flex items-center justify-center gap-2"
          >
            <span>⚡ Evaluate Security Filter Chain</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Security Filter Chain Diagnostics -->
      <div class="lg:col-span-7 space-y-4">
        <!-- Target Chain Banner -->
        <div id="edugo-status-banner" class="p-4 rounded-2xl bg-sky-950/40 border border-sky-500/40 text-sky-300 text-xs font-mono flex items-start justify-between gap-3 shadow-lg">
          <div class="space-y-1">
            <div class="flex items-center gap-2 font-bold text-sky-200">
              <span class="w-2 h-2 rounded-full bg-sky-400"></span>
              <span id="edugo-banner-title">CHAIN: @Order(0) apiSecurityFilterChain</span>
            </div>
            <p id="edugo-banner-detail" class="text-slate-300 font-sans text-xs">
              Matches /api/**. Session creation policy set to STATELESS. CSRF disabled. Handed off to JwtAuthenticationFilter.
            </p>
          </div>
          <div class="text-right font-mono text-[11px] shrink-0">
            <div class="text-slate-400 text-[9px] uppercase">Latency</div>
            <div class="text-emerald-400 font-bold" id="edugo-metric-latency">11.4ms</div>
          </div>
        </div>

        <!-- Filter Step Evaluation Matrix -->
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
              Security Filter Execution Pipeline
            </span>
            <span class="text-[10px] text-indigo-400">Spring Security 6.3</span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px]">
            <div class="p-2 rounded-xl bg-slate-900 border border-slate-800">
              <div class="text-[9px] text-slate-500 uppercase">Matcher Rule</div>
              <div class="font-bold text-sky-300 font-mono text-xs" id="edugo-step-match">/api/**</div>
              <div class="text-[9px] text-slate-400">Order: 0</div>
            </div>
            <div class="p-2 rounded-xl bg-slate-900 border border-slate-800">
              <div class="text-[9px] text-slate-500 uppercase">CSRF Guard</div>
              <div class="font-bold text-amber-300 font-mono text-xs" id="edugo-step-csrf">DISABLED</div>
              <div class="text-[9px] text-slate-400">Mobile REST Safe</div>
            </div>
            <div class="p-2 rounded-xl bg-slate-900 border border-slate-800">
              <div class="text-[9px] text-slate-500 uppercase">Session Policy</div>
              <div class="font-bold text-purple-300 font-mono text-xs" id="edugo-step-session">STATELESS</div>
              <div class="text-[9px] text-slate-400">Zero Memory Bloat</div>
            </div>
            <div class="p-2 rounded-xl bg-slate-900 border border-slate-800">
              <div class="text-[9px] text-slate-500 uppercase">Auth Provider</div>
              <div class="font-bold text-emerald-300 font-mono text-xs" id="edugo-step-provider">JWT Filter</div>
              <div class="text-[9px] text-slate-400">HMAC-SHA256</div>
            </div>
          </div>
        </div>

        <!-- Generated Security Context & Output Payload -->
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              SecurityContext &amp; Response Telemetry
            </span>
            <span class="text-[10px] text-slate-400">SecurityContextHolder.getContext()</span>
          </div>

          <pre id="edugo-json-output" class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-[11px] text-emerald-300 font-mono overflow-x-auto max-h-56 leading-relaxed">&#123;
  "httpStatus": 200,
  "authenticated": true,
  "principal": "admin@edugo.local",
  "authorities": ["ROLE_SUPER_ADMIN", "ROLE_INSTITUTE_ADMIN"],
  "tokenType": "Bearer",
  "accessToken": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbkBlZHVnby5sb2NhbCIsInJvbGVzIjpbIlNVUEVSX0FETUlOIl0sImV4cCI6MTcxNTgwMDAwMH0...",
  "accessExpiresIn": "900s (15 min)",
  "refreshToken": "ref_8849204128914_uuid",
  "refreshExpiresIn": "604800s (7 days)"
&#125;</pre>
        </div>
      </div>
    </div>
  </div>

  <!-- View 2: Multi-Tenant Isolation -->
  <div id="edugo-screen-tenant" class="edugo-screen hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Tenant Selection -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
              Target Institute Tenant
            </span>
            <span class="text-[10px] text-indigo-400">Institute.java</span>
          </div>

          <div class="space-y-2">
            <label class="text-[11px] text-slate-300 font-sans font-semibold">Select Active Institution Context:</label>
            <div class="grid grid-cols-1 gap-2">
              <button
                type="button"
                class="edugo-tenant-btn text-left p-2.5 rounded-xl border border-indigo-500/50 bg-indigo-950/30 text-white hover:border-indigo-400 transition-all text-xs"
                data-tenant="dhaka_college"
              >
                <div class="font-bold flex items-center justify-between text-indigo-300">
                  <span>Dhaka Residential Model College</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300 font-mono">ENTERPRISE</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">UUID: inst-dhaka-01 • 4 Divisions • 2,400 Students</div>
              </button>

              <button
                type="button"
                class="edugo-tenant-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-tenant="ctg_grammar"
              >
                <div class="font-bold flex items-center justify-between text-sky-300">
                  <span>Chittagong Grammar School</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-300 font-mono">PRO</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">UUID: inst-ctg-02 • 2 Divisions • 1,150 Students</div>
              </button>

              <button
                type="button"
                class="edugo-tenant-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-tenant="sylhet_poly"
              >
                <div class="font-bold flex items-center justify-between text-emerald-300">
                  <span>Sylhet Technical Institute</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono">STARTER</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">UUID: inst-syl-03 • 1 Division • 580 Students</div>
              </button>
            </div>
          </div>

          <!-- Tenant Boundary Parameters -->
          <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 space-y-2 text-[11px]">
            <div class="text-[10px] uppercase font-bold text-slate-400">Tenant Metadata</div>
            <div class="flex items-center justify-between text-slate-300">
              <span>Institution Type:</span>
              <span class="font-mono text-sky-400" id="edugo-tenant-type">Higher Secondary College</span>
            </div>
            <div class="flex items-center justify-between text-slate-300">
              <span>Active Divisions:</span>
              <span class="font-mono text-emerald-400" id="edugo-tenant-divisions">Science, Commerce, Arts, Cambridge</span>
            </div>
            <div class="flex items-center justify-between text-slate-300">
              <span>Flyway V7 Index:</span>
              <span class="font-mono text-indigo-400">idx_students_tenant_div_status</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Database Query & Roster Inspector -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              PostgreSQL Multi-Tenant Query Execution
            </span>
            <span class="text-[10px] text-emerald-400">Flyway V7 B-Tree Scan</span>
          </div>

          <!-- Parameterized SQL Query View -->
          <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
            <div class="text-[9px] text-slate-500 uppercase">Parameterized SQL Query with Automated Tenant Barrier:</div>
            <pre id="edugo-sql-query" class="text-[11px] text-sky-300 font-mono whitespace-pre overflow-x-auto leading-relaxed">SELECT s.id, s.roll_no, s.full_name, d.name AS division
FROM students s
INNER JOIN divisions d ON s.division_id = d.id
WHERE s.institute_id = 'inst-dhaka-01'
  AND s.status = 'ACTIVE'
ORDER BY s.roll_no ASC LIMIT 3;</pre>
          </div>

          <!-- Tenant Query Results Table -->
          <div class="space-y-2">
            <div class="text-[10px] uppercase font-bold text-slate-400">Isolated Student Partition Records:</div>
            <div id="edugo-tenant-records" class="space-y-2">
              <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between text-xs font-mono">
                <div>
                  <div class="font-bold text-white flex items-center gap-2">
                    <span>#1001</span>
                    <span class="text-slate-300 font-sans">Tanvir Ahmed</span>
                  </div>
                  <div class="text-[10px] text-slate-400 font-sans">Division: Science A • GPA: 5.00</div>
                </div>
                <div class="text-right">
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono">ISOLATED</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 3: Flutter Token Interceptor -->
  <div id="edugo-screen-mobile" class="edugo-screen hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Interceptor Controls -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              Flutter Mobile HTTP Interceptor
            </span>
            <span class="text-[10px] text-cyan-400">api_client.dart</span>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 space-y-2 text-[11px]">
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Access Token TTL:</span>
              <span class="font-mono text-amber-300 font-bold">15 Minutes (Short-Lived)</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Refresh Token TTL:</span>
              <span class="font-mono text-sky-400">7 Days (Single Re-use)</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Hardware Vault:</span>
              <span class="font-mono text-emerald-400">Android KeyStore / iOS Keychain</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Token Status:</span>
              <span class="font-mono text-emerald-400 font-bold" id="edugo-mobile-token-state">VALID (840s left)</span>
            </div>
          </div>

          <div class="space-y-2">
            <button
              type="button"
              id="edugo-btn-expire-token"
              class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-rose-950/50 border border-rose-500/40 text-rose-200 font-mono font-bold text-xs shadow-md transition-all flex items-center justify-center gap-2"
            >
              <span>⚠️ Simulate Access Token Expiration (HTTP 401)</span>
            </button>
            <button
              type="button"
              id="edugo-btn-silent-refresh"
              class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-emerald-950/50 border border-emerald-500/40 text-emerald-200 font-mono font-bold text-xs shadow-md transition-all flex items-center justify-center gap-2"
            >
              <span>🔄 Run Silent Interceptor Handshake</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Interceptor Event Stream -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Live Interceptor Diagnostic Log
            </span>
            <span class="text-[10px] text-slate-400">Dio/HttpClient Interceptor</span>
          </div>

          <!-- Log Stream Container -->
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 font-mono text-[11px] space-y-2 max-h-56 overflow-y-auto" id="edugo-mobile-logs">
            <div class="text-slate-400">[03:40:01.120] [MOBILE] SecureTokenStore initialized from Android Keystore.</div>
            <div class="text-slate-400">[03:40:01.185] [HTTP GET] /api/v1/institute/courses -&gt; 200 OK (Access token active).</div>
            <div class="text-emerald-400">[03:40:01.210] [GATEWAY] User session authenticated as admin@edugo.local.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // EduGo Platform Simulator Reactive Sandbox Script
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tab Switching
    const tabButtons = document.querySelectorAll('.edugo-tab-btn');
    const screens = {
      security: document.getElementById('edugo-screen-security'),
      tenant: document.getElementById('edugo-screen-tenant'),
      mobile: document.getElementById('edugo-screen-mobile'),
    };

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view');
        tabButtons.forEach(b => {
          b.classList.remove('bg-sky-500/20', 'text-sky-300', 'border', 'border-sky-500/40');
          b.classList.add('text-slate-400');
        });
        btn.classList.add('bg-sky-500/20', 'text-sky-300', 'border', 'border-sky-500/40');
        btn.classList.remove('text-slate-400');

        Object.keys(screens).forEach(key => {
          if (screens[key]) {
            if (key === view) {
              screens[key].classList.remove('hidden');
            } else {
              screens[key].classList.add('hidden');
            }
          }
        });
      });
    });

    // 2. Dual Security Filter Chain Presets
    const securityPresets = {
      mobile_login: {
        method: 'POST',
        headers: `Host: edugo.local:8080
Content-Type: application/json
Accept: application/json
User-Agent: EduGo-Mobile-Flutter/3.29.0 (Android SDK 34)
Origin: http://10.0.2.2:8080
Body: { "email": "admin@edugo.local", "password": "••••••••" }`,
        bannerTitle: 'CHAIN: @Order(0) apiSecurityFilterChain',
        bannerDetail: 'Matches /api/**. Session policy set to STATELESS. CSRF disabled. Handed off to JwtAuthenticationFilter.',
        latency: '11.4ms',
