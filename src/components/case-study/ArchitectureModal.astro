---
interface Props {
  id?: string;
}

const { id = 'arch-node-modal' } = Astro.props;
---

<dialog id={id} class="bg-transparent backdrop:bg-black/80 backdrop:backdrop-blur-sm p-4 w-full max-w-2xl rounded-sm open:animate-in open:fade-in-0 open:zoom-in-95 text-theme-primary">
  <div class="relative bg-theme-surface border border-theme-border rounded-sm p-6 sm:p-8 shadow-2xl overflow-hidden">
    <!-- Close button -->
    <button type="button" id="close-arch-modal" aria-label="Close dialog" class="absolute top-4 right-4 p-2 rounded-sm text-theme-muted hover:text-theme-primary hover:bg-theme-lowest transition-colors cursor-pointer">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <!-- Modal Header -->
    <div class="flex items-center gap-3 mb-4">
      <div class="w-3 h-3 rounded-full bg-theme-accent"></div>
      <h3 id="modal-node-title" class="text-xl font-mono font-bold text-theme-primary">
        Architecture Node Deep-Dive
      </h3>
    </div>

    <!-- Node Badge -->
    <div class="mb-4">
      <span id="modal-node-badge" class="px-2.5 py-1 rounded-sm bg-theme-lowest border border-theme-border text-xs font-mono text-theme-accent font-semibold">
        Subsystem Specification
      </span>
    </div>

    <!-- Modal Body Content -->
    <div id="modal-node-body" class="space-y-4 text-sm font-sans text-theme-secondary leading-relaxed border-t border-theme-border pt-4">
      <p>Click on any node in the architecture diagram to view its low-level concurrency, memory buffer layout, and SIMD dispatch specs.</p>
    </div>

    <!-- Modal Footer Actions -->
    <div class="mt-6 pt-4 border-t border-theme-border flex items-center justify-between">
      <span class="text-xs font-mono text-theme-muted">ENGINEERING SPEC // ZERO-COPY</span>
      <button type="button" id="close-arch-modal-btn" class="px-4 py-2 rounded-sm bg-theme-lowest border border-theme-border hover:border-theme-secondary text-xs font-mono text-theme-primary transition-colors cursor-pointer">
        Dismiss (Esc)
      </button>
    </div>
  </div>
</dialog>

<script>
  function initArchModal() {
    const dialog = document.getElementById('arch-node-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('close-arch-modal');
    const closeActionBtn = document.getElementById('close-arch-modal-btn');
    const titleEl = document.getElementById('modal-node-title');
    const badgeEl = document.getElementById('modal-node-badge');
    const bodyEl = document.getElementById('modal-node-body');

    if (!dialog) return;

    function closeModal() {
      dialog.close();
    }

    closeBtn?.addEventListener('click', closeModal);
    closeActionBtn?.addEventListener('click', closeModal);
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height
        && rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
      if (!isInDialog) {
        dialog.close();
      }
    });

    const nodeTriggers = document.querySelectorAll('[data-node-id]');
    nodeTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const nodeId = trigger.getAttribute('data-node-id');
        const nodeTitle = trigger.getAttribute('data-node-title') || 'Architecture Node';
        const nodeBadge = trigger.getAttribute('data-node-badge') || 'Pipeline Layer';
        const nodeDesc = trigger.getAttribute('data-node-desc') || '';

        if (titleEl) titleEl.textContent = nodeTitle;
        if (badgeEl) badgeEl.textContent = nodeBadge;
        if (bodyEl) {
          bodyEl.innerHTML = `
            <p class="font-mono text-theme-secondary text-sm leading-relaxed">${nodeDesc}</p>
            <div class="mt-3 p-3 rounded-sm bg-theme-lowest border border-theme-border font-mono text-xs text-emerald-600 dark:text-emerald-400">
              $ cat /proc/sys/kernel/sched_latency_ns
              <br/><span class="text-theme-muted">Hardware Allocation: Bounded memory slice without heap reallocation.</span>
            </div>
          `;
        }

        dialog.showModal();
      });
    });
  }

  initArchModal();
  document.addEventListener('astro:page-load', initArchModal);
</script>
