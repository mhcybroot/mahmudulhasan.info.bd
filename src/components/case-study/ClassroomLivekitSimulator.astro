---
// ClassroomLivekitSimulator.astro - Interactive WebRTC SFU Virtual Classroom Simulator
---

<div class="rounded-3xl border border-theme-border bg-theme-card/90 backdrop-blur-xl p-5 sm:p-7 shadow-2xl space-y-6">
  <!-- Header Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-theme-border gap-3">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          ROOM: CSE-402 (DISTRIBUTED SYSTEMS)
        </span>
        <span class="text-xs font-mono text-theme-muted hidden sm:inline">• Spring Boot 3.4 &amp; LiveKit SFU</span>
      </div>
      <h3 class="text-xl font-bold text-theme-primary mt-1">Live WebRTC SFU Interactive Media Stage</h3>
    </div>

    <!-- SFU Telemetry Badges -->
    <div class="flex items-center gap-2 flex-wrap text-xs font-mono">
      <div class="px-2.5 py-1 rounded-lg bg-theme-base border border-theme-border flex items-center gap-1.5">
        <span class="text-theme-muted">RTT:</span>
        <span id="lk-latency-val" class="text-emerald-400 font-bold">42ms</span>
      </div>
      <div class="px-2.5 py-1 rounded-lg bg-theme-base border border-theme-border flex items-center gap-1.5">
        <span class="text-theme-muted">Uplink:</span>
        <span id="lk-bitrate-val" class="text-sky-400 font-bold">1.25 Mbps</span>
      </div>
      <div class="px-2.5 py-1 rounded-lg bg-theme-base border border-theme-border flex items-center gap-1.5">
        <span class="text-theme-muted">Dynacast:</span>
        <span id="lk-dynacast-badge" class="text-indigo-400 font-bold">Active (1080p)</span>
      </div>
    </div>
  </div>

  <!-- Stage Grid: Teacher Tile (Left/Top) & Student Mesh (Right/Bottom) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
    <!-- Teacher Broadcast Stage (7 Cols on desktop) -->
    <div class="lg:col-span-7 flex flex-col rounded-2xl border border-theme-border bg-slate-950 overflow-hidden shadow-inner">
      <!-- Video Window Preview -->
      <div class="relative aspect-video bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 flex items-center justify-center p-4 overflow-hidden border-b border-slate-800">
        <!-- Background Simulated Screen Share Feed -->
        <div class="absolute inset-0 opacity-20 flex flex-col p-4 font-mono text-[10px] text-sky-400 pointer-events-none select-none">
          <div class="flex items-center justify-between border-b border-sky-500/20 pb-1 mb-2">
            <span>[SCREEN SHARE] architecture_sfu_topology.drawio</span>
            <span>1080p@60fps • 4.8 Mbps</span>
          </div>
          <div class="space-y-1 text-slate-400">
            <div>┌─ [Client Browser: WebRTC RTP Source]</div>
            <div>│   ├── Opus Audio Track (48kHz Stereo)</div>
            <div>│   └── VP8 Simulcast (1080p / 720p / 360p Layers)</div>
            <div>▼</div>
            <div>[LiveKit Selective Forwarding Unit] ──&gt; Dynacast Subscriber Downlinks</div>
          </div>
        </div>

        <!-- Instructor Avatar / Video Tile -->
        <div class="relative z-10 flex flex-col items-center text-center space-y-3">
          <div class="relative">
            <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-sky-600 to-indigo-600 flex items-center justify-center text-white text-2xl font-bold shadow-lg shadow-sky-500/20 border-2 border-sky-400/50">
              MH
            </div>
            <!-- Live Decibel Visualizer Ring -->
            <div class="absolute -bottom-1 -right-1 px-1.5 py-0.5 rounded-full bg-emerald-500 text-[10px] font-mono text-white flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
              MIC ON
            </div>
          </div>
          <div>
            <div class="text-sm font-bold text-white flex items-center justify-center gap-1.5">
              <span>Mahmudul Hasan</span>
              <span class="px-1.5 py-0.2 rounded text-[10px] bg-sky-500/20 text-sky-300 border border-sky-500/30">HOST / TEACHER</span>
            </div>
            <p class="text-[11px] text-slate-400">Broadcasting Lecture Feed • 1080p Simulcast</p>
          </div>

          <!-- Animated Audio Waveform -->
          <div class="flex items-center gap-1 h-5 pt-1" id="teacher-waveform">
            <span class="w-1 bg-emerald-400 rounded-full h-2 animate-bounce" style="animation-delay: 0.1s"></span>
            <span class="w-1 bg-emerald-400 rounded-full h-4 animate-bounce" style="animation-delay: 0.2s"></span>
            <span class="w-1 bg-emerald-400 rounded-full h-5 animate-bounce" style="animation-delay: 0.3s"></span>
            <span class="w-1 bg-emerald-400 rounded-full h-3 animate-bounce" style="animation-delay: 0.15s"></span>
            <span class="w-1 bg-emerald-400 rounded-full h-5 animate-bounce" style="animation-delay: 0.25s"></span>
            <span class="w-1 bg-emerald-400 rounded-full h-2 animate-bounce" style="animation-delay: 0.05s"></span>
          </div>
        </div>

        <!-- Watermark / Stream Tag -->
        <div class="absolute top-3 left-3 px-2 py-0.5 rounded-md bg-black/60 backdrop-blur-md border border-white/10 text-[10px] font-mono text-slate-300 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span>
          LIVE 1080p
        </div>
      </div>

      <!-- Instructor Control Bar -->
      <div class="p-3 bg-slate-900 flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
        <div class="flex items-center gap-2">
          <button id="btn-toggle-mic" class="px-3 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40 flex items-center gap-1.5 transition-all">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
            </svg>
            <span id="btn-mic-label">Teacher Mic (On)</span>
          </button>

          <button id="btn-toggle-screen" class="px-3 py-1.5 rounded-lg bg-sky-500/20 hover:bg-sky-500/30 text-sky-300 border border-sky-500/40 flex items-center gap-1.5 transition-all">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>Screen Share</span>
          </button>
        </div>

        <!-- Mute All Participants Button -->
        <button id="btn-mute-all" class="px-3 py-1.5 rounded-lg bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 border border-rose-500/40 font-bold flex items-center gap-1.5 transition-all shadow-sm hover:scale-[1.02]">
          <svg class="w-3.5 h-3.5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
          </svg>
          <span>Mute All Students (RPC)</span>
        </button>
      </div>
    </div>

    <!-- Student Multi-Tile Grid (5 Cols on desktop) -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-3">
      <div class="flex items-center justify-between text-xs font-mono text-theme-muted">
        <span>CONNECTED SUBSCRIBERS (4/500)</span>
        <span class="text-emerald-400">LiveKit Dynacast Active</span>
      </div>

      <!-- 4 Student Tiles -->
      <div class="grid grid-cols-2 gap-3" id="students-grid">
        <!-- Student 1 -->
        <div class="student-card rounded-xl border border-slate-800 bg-slate-900/90 p-3 space-y-2 relative overflow-hidden transition-all duration-300" data-student-id="stu-1">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-white truncate">Tanvir Ahmed</span>
            <span class="student-layer px-1.5 py-0.2 rounded text-[10px] font-mono bg-sky-500/20 text-sky-400 border border-sky-500/30">1080p</span>
          </div>
          <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span class="student-rtt text-emerald-400">28ms</span>
            <span class="student-mic-badge px-1.5 rounded text-[10px] bg-slate-800 text-slate-400">Muted</span>
          </div>
          <div class="h-1 w-full bg-slate-800 rounded-full overflow-hidden">
            <div class="h-full bg-emerald-500 w-full"></div>
          </div>
        </div>

        <!-- Student 2 (Unmuted, test target for mute-all) -->
        <div class="student-card rounded-xl border border-slate-800 bg-slate-900/90 p-3 space-y-2 relative overflow-hidden transition-all duration-300" data-student-id="stu-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-white truncate">Nusrat Jahan</span>
            <span class="student-layer px-1.5 py-0.2 rounded text-[10px] font-mono bg-sky-500/20 text-sky-400 border border-sky-500/30">720p</span>
          </div>
          <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span class="student-rtt text-emerald-400">36ms</span>
            <span class="student-mic-badge px-1.5 rounded text-[10px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Speaking
            </span>
          </div>
          <div class="h-1 w-full bg-slate-800 rounded-full overflow-hidden">
            <div class="h-full bg-emerald-500 w-3/4"></div>
          </div>
        </div>

        <!-- Student 3 (Cellular jitter test target) -->
        <div class="student-card rounded-xl border border-slate-800 bg-slate-900/90 p-3 space-y-2 relative overflow-hidden transition-all duration-300" data-student-id="stu-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-white truncate">Rafiqul Islam</span>
            <span class="student-layer px-1.5 py-0.2 rounded text-[10px] font-mono bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">720p</span>
          </div>
          <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span class="student-rtt text-emerald-400">54ms</span>
            <span class="student-mic-badge px-1.5 rounded text-[10px] bg-slate-800 text-slate-400">Muted</span>
          </div>
          <div class="h-1 w-full bg-slate-800 rounded-full overflow-hidden">
            <div class="h-full bg-emerald-500 w-full" id="stu-3-bar"></div>
          </div>
        </div>

        <!-- Student 4 -->
        <div class="student-card rounded-xl border border-slate-800 bg-slate-900/90 p-3 space-y-2 relative overflow-hidden transition-all duration-300" data-student-id="stu-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-white truncate">Sultana Razia</span>
            <span class="student-layer px-1.5 py-0.2 rounded text-[10px] font-mono bg-sky-500/20 text-sky-400 border border-sky-500/30">1080p</span>
          </div>
          <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span class="student-rtt text-emerald-400">31ms</span>
            <span class="student-mic-badge px-1.5 rounded text-[10px] bg-amber-500/20 text-amber-400 border border-amber-500/30">Hand Raised ✋</span>
          </div>
          <div class="h-1 w-full bg-slate-800 rounded-full overflow-hidden">
            <div class="h-full bg-emerald-500 w-full"></div>
          </div>
        </div>
      </div>

      <!-- Quick Action Controls -->
      <div class="pt-2 flex flex-col sm:flex-row gap-2">
        <button id="btn-trigger-jitter" class="flex-1 py-2 px-3 rounded-xl bg-theme-base border border-theme-border hover:border-amber-500/50 text-xs font-mono text-theme-primary flex items-center justify-center gap-1.5 transition-all cursor-pointer">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Simulate Weak Mobile Connection (3G)</span>
        </button>
        <button id="btn-reset-sim" class="py-2 px-3 rounded-xl bg-theme-base border border-theme-border hover:border-theme-accent/50 text-xs font-mono text-theme-muted hover:text-theme-primary transition-all cursor-pointer">
          Reset
        </button>
      </div>
      <p class="text-[11px] text-theme-muted font-mono">
        *Click &quot;Simulate Weak Mobile Connection&quot; to see how the system dynamically adjusts video quality so students never suffer frozen video or dropped audio.
      </p>
    </div>
  </div>

  <!-- Student Join & Admission Sandbox -->
  <div class="rounded-2xl border border-theme-border bg-theme-base/60 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <span class="text-xs font-mono font-semibold text-theme-accent uppercase tracking-wider flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        Student PIN &amp; Mobile Admission Tester (Spring Security &amp; Token Grant)
      </span>
      <span class="text-[11px] font-mono text-theme-muted">PhoneValidator.normalize()</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs font-mono">
      <div class="space-y-1">
        <label class="text-[11px] text-theme-muted">Student Name</label>
        <input id="in-student-name" type="text" value="Arif Hossain" class="w-full px-3 py-1.5 rounded-lg bg-theme-card border border-theme-border text-theme-primary focus:outline-none focus:border-theme-accent text-xs" />
      </div>
      <div class="space-y-1">
        <label class="text-[11px] text-theme-muted">Bangladesh Phone</label>
        <input id="in-student-phone" type="text" value="01712-345678" class="w-full px-3 py-1.5 rounded-lg bg-theme-card border border-theme-border text-theme-primary focus:outline-none focus:border-theme-accent text-xs" />
      </div>
      <div class="space-y-1">
        <label class="text-[11px] text-theme-muted">Room PIN</label>
        <input id="in-student-pin" type="text" value="4921" class="w-full px-3 py-1.5 rounded-lg bg-theme-card border border-theme-border text-theme-primary focus:outline-none focus:border-theme-accent text-xs" />
      </div>
      <div class="flex items-end">
        <button id="btn-request-token" class="w-full py-2 px-3 rounded-lg bg-theme-accent text-theme-base font-bold hover:opacity-90 transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-sm">
          <span>Authorize &amp; Mint JWT</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Real-Time WebRTC SDP & LiveKit RPC Telemetry Terminal -->
  <div class="rounded-2xl border border-slate-800 bg-slate-950 p-4 font-mono text-xs overflow-hidden shadow-inner space-y-2">
    <div class="flex items-center justify-between pb-2 border-b border-slate-800 text-[11px] text-slate-400">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
        <span class="text-slate-300 font-semibold ml-1">LiveKit SFU RPC &amp; WebRTC Telemetry Stream</span>
      </div>
      <span class="text-slate-400">LiveKit Java Client SDK • HMAC-SHA256</span>
    </div>

    <div id="lk-terminal-log" class="space-y-1 text-[11px] leading-relaxed max-h-40 overflow-y-auto text-slate-300 pr-1">
      <div class="text-slate-400">[19:40:02.102] LiveKitService initialized: RoomServiceClient connected to wss://livekit.classroom.internal</div>
      <div class="text-slate-400">[19:40:02.128] Room 'CSE-402' verified status: LIVE | 4 participants connected</div>
      <div class="text-emerald-400">[19:40:05.890] Host TEACHER-01 published video track (VP8, 1080p, 60fps) &amp; Opus stereo audio</div>
      <div class="text-sky-400">[19:40:06.012] Dynacast engine: subscribers bandwidth negotiated; downlinks routed at $O(1)$ client upload</div>
    </div>
  </div>
</div>

<script>
  // DOM References
  const btnMuteAll = document.getElementById('btn-mute-all');
  const btnToggleMic = document.getElementById('btn-toggle-mic');
  const btnMicLabel = document.getElementById('btn-mic-label');
  const teacherWaveform = document.getElementById('teacher-waveform');
  const btnTriggerJitter = document.getElementById('btn-trigger-jitter');
  const btnResetSim = document.getElementById('btn-reset-sim');
  const btnRequestToken = document.getElementById('btn-request-token');
  const terminalLog = document.getElementById('lk-terminal-log');

  const lkLatencyVal = document.getElementById('lk-latency-val');
  const lkBitrateVal = document.getElementById('lk-bitrate-val');
  const lkDynacastBadge = document.getElementById('lk-dynacast-badge');

  function appendLog(colorClass: string, text: string) {
    if (!terminalLog) return;
    const now = new Date().toTimeString().split(' ')[0] + '.' + String(Math.floor(Math.random() * 900) + 100);
    const div = document.createElement('div');
    div.className = colorClass;
    div.textContent = `[${now}] ${text}`;
    terminalLog.appendChild(div);
    terminalLog.scrollTop = terminalLog.scrollHeight;
  }

  // Teacher Mic Toggle
  let teacherMicActive = true;
  btnToggleMic?.addEventListener('click', () => {
    teacherMicActive = !teacherMicActive;
    if (teacherMicActive) {
      btnToggleMic.className = 'px-3 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40 flex items-center gap-1.5 transition-all';
      if (btnMicLabel) btnMicLabel.textContent = 'Teacher Mic (On)';
      teacherWaveform?.classList.remove('opacity-20');
      appendLog('text-emerald-400', 'Host TEACHER-01 unmuted audio track: Opus 48kHz audio active');
    } else {
      btnToggleMic.className = 'px-3 py-1.5 rounded-lg bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 border border-rose-500/40 flex items-center gap-1.5 transition-all';
      if (btnMicLabel) btnMicLabel.textContent = 'Teacher Mic (Muted)';
      teacherWaveform?.classList.add('opacity-20');
      appendLog('text-rose-400', 'Host TEACHER-01 muted audio track at source');
    }
  });

  // Mute All Participants via LiveKit Server RPC
  btnMuteAll?.addEventListener('click', () => {
    appendLog('text-rose-400', 'RPC DISPATCH: LiveKitService.muteAllParticipants("CSE-402") initiated');
    appendLog('text-slate-400', 'Listing participants from RoomServiceClient... Found 4 active session tokens');

    // Simulate instant server response (<35ms)
    setTimeout(() => {
      // Find Student 2 (who was speaking) and mute them
      const stu2 = document.querySelector('[data-student-id="stu-2"]');
      if (stu2) {
        const badge = stu2.querySelector('.student-mic-badge');
        if (badge) {
          badge.className = 'student-mic-badge px-1.5 rounded text-[10px] bg-slate-800 text-slate-400';
          badge.textContent = 'Muted (Host)';
        }
      }
      appendLog('text-emerald-400', 'RPC COMPLETE: 1 student audio track muted (TEACHER identity excluded). Propagation: 22ms');
    }, 22);
  });

  // Simulate 3G Cellular Jitter & Dynacast Fallback
  btnTriggerJitter?.addEventListener('click', () => {
    appendLog('text-amber-400', 'SIMULATING NETWORK JITTER: Injecting 24% packet loss & 320ms latency on Student 3 (01823-xxxxxx)');

    if (lkLatencyVal) lkLatencyVal.textContent = '198ms';
    if (lkBitrateVal) lkBitrateVal.textContent = '380 Kbps';
    if (lkDynacastBadge) {
      lkDynacastBadge.textContent = 'Dynacast Fallback (360p)';
      lkDynacastBadge.className = 'text-amber-400 font-bold';
    }

    const stu3 = document.querySelector('[data-student-id="stu-3"]');
    if (stu3) {
      const layer = stu3.querySelector('.student-layer');
      if (layer) {
        layer.textContent = '360p (Dynacast)';
        layer.className = 'student-layer px-1.5 py-0.2 rounded text-[10px] font-mono bg-amber-500/20 text-amber-400 border border-amber-500/30';
      }
      const rtt = stu3.querySelector('.student-rtt');
      if (rtt) {
        rtt.textContent = '198ms (Jitter)';
        rtt.className = 'student-rtt text-amber-400';
      }
      const bar = document.getElementById('stu-3-bar');
      if (bar) {
        bar.className = 'h-full bg-amber-500 w-1/3 transition-all duration-500';
      }
    }

    appendLog('text-sky-400', 'SFU ADAPTIVE BITRATE: Throttled Student 3 downlink to 360p layer; zero audio buffer underrun detected');
  });

  // Reset Simulator
  btnResetSim?.addEventListener('click', () => {
    if (lkLatencyVal) lkLatencyVal.textContent = '42ms';
    if (lkBitrateVal) lkBitrateVal.textContent = '1.25 Mbps';
    if (lkDynacastBadge) {
      lkDynacastBadge.textContent = 'Active (1080p)';
      lkDynacastBadge.className = 'text-indigo-400 font-bold';
    }

    const stu2 = document.querySelector('[data-student-id="stu-2"]');
    if (stu2) {
      const badge = stu2.querySelector('.student-mic-badge');
      if (badge) {
        badge.className = 'student-mic-badge px-1.5 rounded text-[10px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center gap-1';
        badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Speaking';
      }
    }

    const stu3 = document.querySelector('[data-student-id="stu-3"]');
    if (stu3) {
      const layer = stu3.querySelector('.student-layer');
      if (layer) {
        layer.textContent = '720p';
        layer.className = 'student-layer px-1.5 py-0.2 rounded text-[10px] font-mono bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
      }
      const rtt = stu3.querySelector('.student-rtt');
      if (rtt) {
        rtt.textContent = '54ms';
        rtt.className = 'student-rtt text-emerald-400';
      }
      const bar = document.getElementById('stu-3-bar');
      if (bar) {
        bar.className = 'h-full bg-emerald-500 w-full transition-all duration-500';
      }
    }

    appendLog('text-slate-400', 'Simulation state reset: all subscriber downlinks restored to nominal 720p/1080p profiles');
  });

  // Token Minting & Admission Sandbox
  btnRequestToken?.addEventListener('click', () => {
    const inName = (document.getElementById('in-student-name') as HTMLInputElement)?.value.trim() || 'Student';
    const inPhone = (document.getElementById('in-student-phone') as HTMLInputElement)?.value.trim() || '01712345678';
    const inPin = (document.getElementById('in-student-pin') as HTMLInputElement)?.value.trim() || '4921';

    // Phone validation simulation (matches PhoneValidator.java)
    const digitsOnly = inPhone.replace(/\D/g, '');
    let normalizedPhone = digitsOnly;
    if (digitsOnly.startsWith('880')) {
      normalizedPhone = '+' + digitsOnly;
    } else if (digitsOnly.startsWith('01') && digitsOnly.length === 11) {
      normalizedPhone = '+88' + digitsOnly;
    } else {
      appendLog('text-rose-400', `VALIDATION ERROR: Invalid Bangladesh mobile format: "${inPhone}". Expected +8801XXXXXXXXX`);
      return;
    }

    if (inPin !== '4921') {
      appendLog('text-rose-400', `SECURITY DENIAL: Incorrect room PIN "${inPin}". Expected valid room secret.`);
      return;
    }

    appendLog('text-slate-400', `PhoneValidator: Sanitized "${inPhone}" -> "${normalizedPhone}"`);
    appendLog('text-slate-400', `RoomService: Verified PIN for room "CSE-402" -> STATUS = LIVE`);

    // Simulated JWT Generation
    const mockIdentity = `STU-${Math.floor(1000 + Math.random() * 9000)}`;
    const mockJwt = `eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE3NjM1OTIwMDAsImlzcyI6ImFwaS1rZXkiLCJzdWIiOiIke21vY2tJZGVudGl0eX0iLCJ2aWRlbyI6eyJyb29tSm9pbiI6dHJ1ZSwicm9vbSI6IkNTRS00MDIiLCJjYW5QdWJsaXNoIjp0cnVlLCJjYW5TdWJzY3JpYmUiOnRydWUsImNhblB1Ymxpc2hEYXRhIjp0cnVlfX0...`;

    appendLog('text-emerald-400', `JWT TOKEN ISSUED for ${inName} (${mockIdentity}): grants=[canSubscribe=true, canPublish=true, canPublishSources=[mic, cam, screen]]`);
    appendLog('text-sky-400', `LiveKit Handshake: token authenticated. Joining room CSE-402 via WSS. (RTT 34ms)`);
  });
