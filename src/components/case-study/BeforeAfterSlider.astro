---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`rounded-2xl bg-slate-900/90 border border-slate-800 p-6 shadow-2xl relative overflow-hidden ${className}`}>
  <!-- Header Bar -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-800">
    <div>
      <div class="flex items-center gap-2">
        <h3 class="text-lg font-mono font-bold text-slate-100 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
          Interactive Visual Proof: Before / After Split Viewport
        </h3>
      </div>
      <p class="text-xs text-slate-400 mt-1">
        Compare raw bilinear input against SIMD Lanczos3 + Contrast-Adaptive Sharpening (FidelityFX CAS).
      </p>
    </div>

    <!-- Live Telemetry Badge & Preset Buttons -->
    <div class="flex items-center gap-3">
      <div class="hidden md:flex items-center gap-1.5 px-2.5 py-1 rounded bg-slate-800/80 border border-slate-700 text-[11px] font-mono text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        60 FPS OpenGL Viewport
      </div>

      <div class="flex items-center gap-1 bg-slate-800/90 p-1 rounded-lg border border-slate-700/80" role="group" aria-label="Split View Presets">
        <button type="button" data-split="25" class="preset-btn px-2.5 py-1 text-xs font-mono rounded text-slate-400 hover:text-cyan-300 transition-colors">25%</button>
        <button type="button" data-split="50" class="preset-btn px-2.5 py-1 text-xs font-mono rounded bg-cyan-500/20 text-cyan-400 font-semibold border border-cyan-500/30">50%</button>
        <button type="button" data-split="75" class="preset-btn px-2.5 py-1 text-xs font-mono rounded text-slate-400 hover:text-cyan-300 transition-colors">75%</button>
      </div>
    </div>
  </div>

  <!-- Interactive Comparison Canvas -->
  <div class="relative w-full aspect-[16/9] max-h-[540px] rounded-xl overflow-hidden select-none bg-slate-950 border border-slate-800/80 group" id="slider-viewport">
    <!-- Left Layer (Raw Input: 640x480 simulation) -->
    <div class="absolute inset-0 w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950">
      <!-- Simulated Raw Silicon Circuit Board / Microchip Trace -->
      <div class="w-full h-full flex flex-col items-center justify-center p-8 opacity-75 blur-[2.5px] filter contrast-75">
        <svg class="w-3/4 h-3/4 text-cyan-500/40" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="20" y="20" width="360" height="160" rx="8" stroke="currentColor" stroke-width="4" stroke-dasharray="8 8"/>
          <circle cx="90" cy="70" r="30" stroke="currentColor" stroke-width="3"/>
          <line x1="120" y1="70" x2="280" y2="70" stroke="currentColor" stroke-width="4"/>
          <rect x="230" y="100" width="100" height="50" rx="4" stroke="currentColor" stroke-width="3"/>
          <text x="50" y="150" font-family="JetBrains Mono" font-size="20" fill="currentColor">640x480 RAW</text>
        </svg>
      </div>

      <!-- Raw Badge -->
      <div class="absolute bottom-4 left-4 z-10 px-3 py-1.5 rounded-lg bg-slate-900/90 backdrop-blur border border-slate-700/80 text-xs font-mono text-slate-300">
        <span class="text-rose-400 font-semibold">● BEFORE:</span> Raw Input (640x480, Unprocessed)
      </div>
    </div>

    <!-- Right Layer (Enhanced Output: Clipped via width percentage) -->
    <div class="absolute inset-y-0 right-0 h-full overflow-hidden transition-[width] duration-75 ease-out" id="after-layer" style="width: 50%;">
      <div class="absolute inset-0 w-full h-full bg-gradient-to-bl from-slate-900 via-slate-950 to-slate-900 flex items-center justify-center">
        <!-- Razor-sharp Circuit Vector -->
        <div class="w-full h-full flex flex-col items-center justify-center p-8">
          <svg class="w-3/4 h-3/4 text-cyan-400" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="20" y="20" width="360" height="160" rx="8" stroke="#00FFA3" stroke-width="3"/>
            <circle cx="90" cy="70" r="30" stroke="#00F0FF" stroke-width="3"/>
            <line x1="120" y1="70" x2="280" y2="70" stroke="#00F0FF" stroke-width="4"/>
            <rect x="230" y="100" width="100" height="50" rx="4" stroke="#00FFA3" stroke-width="3"/>
            <text x="50" y="150" font-family="JetBrains Mono" font-size="20" fill="#00FFA3" font-weight="bold">720x480 CAS 4K</text>
          </svg>
        </div>
      </div>

      <!-- Enhanced Badge -->
      <div class="absolute bottom-4 right-4 z-10 px-3 py-1.5 rounded-lg bg-slate-900/90 backdrop-blur border border-cyan-500/50 text-xs font-mono text-cyan-300 shadow-lg shadow-cyan-950/50">
        <span class="text-emerald-400 font-semibold">● AFTER:</span> 720x480 (Lanczos3 + CAS Enhanced)
      </div>
    </div>

    <!-- Draggable Divider Line -->
    <div class="absolute inset-y-0 z-20 pointer-events-none" id="divider-line" style="left: 50%;">
      <div class="w-0.5 h-full bg-cyan-400 shadow-[0_0_12px_rgba(0,240,255,0.8)] relative -translate-x-1/2">
        <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-slate-900 border-2 border-cyan-400 flex items-center justify-center shadow-lg text-cyan-300">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Hidden Native Range Input for Keyboard & Touch Accessibility -->
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      id="split-range-input"
      aria-label="Before and After Split Slider"
      class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-30"
    />
  </div>

  <!-- Legend & Micro-Metrics -->
  <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono text-slate-400">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
      <span>Aliasing Artifacts: <strong class="text-slate-200">0.00%</strong></span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
      <span>Ringing (Halos): <strong class="text-slate-200">Suppressed</strong></span>
    </div>
    <div class="flex items-center gap-2 sm:justify-end">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      <span>Color Space: <strong class="text-slate-200">RGBA8 (sRGB)</strong></span>
    </div>
  </div>
</div>

<script>
  function initBeforeAfterSlider() {
    const range = document.getElementById('split-range-input') as HTMLInputElement | null;
    const afterLayer = document.getElementById('after-layer');
    const dividerLine = document.getElementById('divider-line');
    const presetBtns = document.querySelectorAll('.preset-btn');

    if (!range || !afterLayer || !dividerLine) return;

    function updateSplit(val: number) {
      const leftPercent = val;
      const rightPercent = 100 - val;
      afterLayer.style.width = `${rightPercent}%`;
      dividerLine.style.left = `${leftPercent}%`;

      presetBtns.forEach((btn) => {
        const btnSplit = parseInt(btn.getAttribute('data-split') || '0', 10);
        if (Math.abs(btnSplit - val) < 2) {
          btn.classList.add('bg-cyan-500/20', 'text-cyan-400', 'font-semibold', 'border-cyan-500/30');
          btn.classList.remove('text-slate-400');
        } else {
          btn.classList.remove('bg-cyan-500/20', 'text-cyan-400', 'font-semibold', 'border-cyan-500/30');
          btn.classList.add('text-slate-400');
        }
      });
    }

    range.addEventListener('input', (e) => {
      const val = parseInt((e.target as HTMLInputElement).value, 10);
      updateSplit(val);
    });

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const splitVal = parseInt(btn.getAttribute('data-split') || '50', 10);
        range.value = splitVal.toString();
        updateSplit(splitVal);
      });
    });
  }

  // Support Astro page transitions or direct load
  initBeforeAfterSlider();
  document.addEventListener('astro:page-load', initBeforeAfterSlider);
</script>
