---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`rounded-2xl bg-slate-900 border border-slate-700 p-6 shadow-2xl relative overflow-hidden ${className}`}>
  <!-- Header Bar -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-800">
    <div>
      <div class="flex items-center gap-2">
        <h2 class="text-xl font-mono font-bold text-white flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-cyan-400"></span>
          See It in Action: Interactive Before &amp; After Comparison
        </h2>
      </div>
      <p class="text-sm text-slate-300 mt-1">
        Drag the center slider left and right to see blurry, pixelated photos transform into sharp, printable HD visuals.
      </p>
    </div>

    <!-- Preset Buttons -->
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1 bg-slate-800 p-1 rounded-lg border border-slate-700" role="group" aria-label="Comparison View Presets">
        <button type="button" data-split="25" class="preset-btn px-3 py-1.5 text-xs font-mono rounded text-slate-200 hover:text-cyan-300 transition-colors font-medium">25%</button>
        <button type="button" data-split="50" class="preset-btn px-3 py-1.5 text-xs font-mono rounded bg-cyan-950 text-cyan-300 font-bold border border-cyan-500/60 shadow-sm">50% (Default)</button>
        <button type="button" data-split="75" class="preset-btn px-3 py-1.5 text-xs font-mono rounded text-slate-200 hover:text-cyan-300 transition-colors font-medium">75%</button>
      </div>
    </div>
  </div>

  <!-- Interactive Comparison Canvas -->
  <div class="relative w-full aspect-[16/9] max-h-[520px] rounded-xl overflow-hidden select-none bg-slate-950 border border-slate-700 group" id="slider-viewport">
    <!-- Left Layer (Raw Input: Blurry simulation) -->
    <div class="absolute inset-0 w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950">
      <!-- Simulated Blurry Circuit & Document Graphic -->
      <div class="w-full h-full flex flex-col items-center justify-center p-8 opacity-80 blur-[3px] filter contrast-75">
        <svg class="w-3/4 h-3/4 text-cyan-500/50" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="20" y="20" width="360" height="160" rx="8" stroke="currentColor" stroke-width="4" stroke-dasharray="8 8"/>
          <circle cx="90" cy="70" r="30" stroke="currentColor" stroke-width="3"/>
          <line x1="120" y1="70" x2="280" y2="70" stroke="currentColor" stroke-width="4"/>
          <rect x="230" y="100" width="100" height="50" rx="4" stroke="currentColor" stroke-width="3"/>
          <text x="50" y="150" font-family="JetBrains Mono" font-size="20" fill="currentColor">BLURRY LOW-RES</text>
        </svg>
      </div>

      <!-- Raw Badge -->
      <div class="absolute bottom-4 left-4 z-10 px-3.5 py-2 rounded-lg bg-slate-950/95 backdrop-blur border border-rose-500/40 text-xs font-mono text-slate-100 shadow-xl">
        <span class="text-rose-400 font-bold">● BEFORE:</span> Blurry &amp; Pixelated (Hard to Read)
      </div>
    </div>

    <!-- Right Layer (Enhanced Output) -->
    <div class="absolute inset-y-0 right-0 h-full overflow-hidden transition-[width] duration-75 ease-out" id="after-layer" style="width: 50%;">
      <div class="absolute inset-0 w-full h-full bg-gradient-to-bl from-slate-900 via-slate-950 to-slate-900 flex items-center justify-center">
        <!-- Razor-sharp Circuit & Document Graphic -->
        <div class="w-full h-full flex flex-col items-center justify-center p-8">
          <svg class="w-3/4 h-3/4 text-cyan-300" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="20" y="20" width="360" height="160" rx="8" stroke="#34d399" stroke-width="3"/>
            <circle cx="90" cy="70" r="30" stroke="#38bdf8" stroke-width="3"/>
            <line x1="120" y1="70" x2="280" y2="70" stroke="#38bdf8" stroke-width="4"/>
            <rect x="230" y="100" width="100" height="50" rx="4" stroke="#34d399" stroke-width="3"/>
            <text x="50" y="150" font-family="JetBrains Mono" font-size="20" fill="#34d399" font-weight="bold">SHARP HIGH-DEFINITION</text>
          </svg>
        </div>
      </div>

      <!-- Enhanced Badge -->
      <div class="absolute bottom-4 right-4 z-10 px-3.5 py-2 rounded-lg bg-slate-950/95 backdrop-blur border border-emerald-500/50 text-xs font-mono text-slate-100 shadow-xl">
        <span class="text-emerald-400 font-bold">● AFTER:</span> Enhanced HD (Crisp, Clear &amp; Natural)
      </div>
    </div>

    <!-- Draggable Divider Line -->
    <div class="absolute inset-y-0 z-20 pointer-events-none" id="divider-line" style="left: 50%;">
      <div class="w-0.5 h-full bg-cyan-400 shadow-[0_0_12px_rgba(56,189,248,0.9)] relative -translate-x-1/2">
        <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-9 h-9 rounded-full bg-slate-900 border-2 border-cyan-400 flex items-center justify-center shadow-2xl text-cyan-300">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Hidden Range Input for Accessibility -->
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      id="split-range-input"
      aria-label="Drag slider to compare before and after image quality"
      class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-30"
    />
  </div>

  <!-- Legend & Reassurances -->
  <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-sans text-slate-200">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-rose-400"></span>
      <span>No Blurry Edges: <strong class="text-white">Clean Lines</strong></span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
      <span>No Artificial Rings: <strong class="text-white">Natural Faces</strong></span>
    </div>
    <div class="flex items-center gap-2 sm:justify-end">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>Processing Time: <strong class="text-emerald-300">3.43 ms</strong></span>
    </div>
  </div>
</div>

<script>
  function initBeforeAfterSlider() {
    const range = document.getElementById('split-range-input') as HTMLInputElement | null;
    const afterLayer = document.getElementById('after-layer');
    const dividerLine = document.getElementById('divider-line');
    const presetBtns = document.querySelectorAll('.preset-btn');

    if (!range || !afterLayer || !dividerLine) return;

    function updateSplit(val: number) {
      const leftPercent = val;
      const rightPercent = 100 - val;
      afterLayer.style.width = `${rightPercent}%`;
      dividerLine.style.left = `${leftPercent}%`;

      presetBtns.forEach((btn) => {
        const btnSplit = parseInt(btn.getAttribute('data-split') || '0', 10);
        if (Math.abs(btnSplit - val) < 2) {
          btn.className = 'preset-btn px-3 py-1.5 text-xs font-mono rounded bg-cyan-950 text-cyan-300 font-bold border border-cyan-500/60 shadow-sm';
        } else {
          btn.className = 'preset-btn px-3 py-1.5 text-xs font-mono rounded text-slate-200 hover:text-cyan-300 transition-colors font-medium';
        }
      });
    }

    range.addEventListener('input', (e) => {
      const val = parseInt((e.target as HTMLInputElement).value, 10);
      updateSplit(val);
    });

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const splitVal = parseInt(btn.getAttribute('data-split') || '50', 10);
        range.value = splitVal.toString();
        updateSplit(splitVal);
      });
    });
  }

  initBeforeAfterSlider();
  document.addEventListener('astro:page-load', initBeforeAfterSlider);
</script>
