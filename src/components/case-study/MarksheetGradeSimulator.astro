---
// Interactive Academic Tabulation & GPA Simulator
// Grounded in real Bangladesh Education Board (BISE / Madrasah Board) grading and 4th subject bonus algorithms
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl p-6 sm:p-8 space-y-6 shadow-2xl">
  <!-- Simulator Header -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-800 pb-4">
    <div>
      <div class="flex items-center gap-2 text-cyan-300 font-mono text-xs uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
        Interactive Academic Compilation Simulator
      </div>
      <h2 class="text-xl sm:text-2xl font-mono font-bold text-white">
        Board-Compliant GPA 5.0 &amp; 4th Subject Bonus Engine
      </h2>
      <p class="text-xs text-slate-300 mt-1 font-sans">
        Simulates the official Bangladesh grading formula, fail-gate validation, and instant tabulation merit ranking.
      </p>
    </div>

    <!-- Quick Scenario Presets -->
    <div class="flex items-center gap-1.5 flex-wrap">
      <span class="text-xs font-mono text-slate-400 mr-1">Presets:</span>
      <button
        type="button"
        id="preset-golden"
        class="px-2.5 py-1 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-mono transition-colors"
      >
        Golden A+
      </button>
      <button
        type="button"
        id="preset-bonus"
        class="px-2.5 py-1 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-mono transition-colors"
      >
        4th Sub Bonus A+
      </button>
      <button
        type="button"
        id="preset-pass"
        class="px-2.5 py-1 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-mono transition-colors"
      >
        Average Pass
      </button>
      <button
        type="button"
        id="preset-fail"
        class="px-2.5 py-1 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 border border-rose-500/30 text-xs font-mono transition-colors"
      >
        Fail Gate
      </button>
    </div>
  </div>

  <!-- Main Grid: Input Controls (Left) & Live Marksheet Preview (Right) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Left Column: Marks Input Sliders & Controls (7 Cols) -->
    <div class="lg:col-span-7 space-y-4">
      <div class="flex items-center justify-between text-xs font-mono text-slate-300 border-b border-slate-800 pb-2">
        <span class="font-bold text-white uppercase">Subject Marks Editor (100 Marks Each)</span>
        <span class="text-slate-400">Total Marks: <strong id="stat-total-marks" class="text-cyan-300">624</strong> / 700</span>
      </div>

      <!-- Subject Sliders Container -->
      <div class="space-y-3" id="subject-sliders">
        <!-- Bangla -->
        <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800 flex items-center justify-between gap-3">
          <div class="w-32 truncate">
            <span class="text-xs font-mono font-medium text-slate-200 block truncate">1. Quran / Bangla</span>
            <span class="text-[10px] font-mono text-slate-500">Compulsory</span>
          </div>
          <input
            type="range"
            min="0"
            max="100"
            value="85"
            class="flex-1 accent-cyan-400 h-1.5 bg-slate-800 rounded-lg cursor-pointer subject-range"
            data-subject="bangla"
          />
          <div class="w-16 text-right font-mono text-xs">
            <span class="text-white font-bold subject-val" id="val-bangla">85</span>
            <span class="text-[10px] ml-1 px-1.5 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800/40 subject-grade" id="grade-bangla">A+ (5.0)</span>
          </div>
        </div>

        <!-- English -->
        <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800 flex items-center justify-between gap-3">
          <div class="w-32 truncate">
            <span class="text-xs font-mono font-medium text-slate-200 block truncate">2. English</span>
            <span class="text-[10px] font-mono text-slate-500">Compulsory</span>
          </div>
          <input
            type="range"
            min="0"
            max="100"
            value="78"
            class="flex-1 accent-cyan-400 h-1.5 bg-slate-800 rounded-lg cursor-pointer subject-range"
            data-subject="english"
          />
          <div class="w-16 text-right font-mono text-xs">
            <span class="text-white font-bold subject-val" id="val-english">78</span>
            <span class="text-[10px] ml-1 px-1.5 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800/40 subject-grade" id="grade-english">A (4.0)</span>
          </div>
        </div>

        <!-- Mathematics -->
        <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800 flex items-center justify-between gap-3">
          <div class="w-32 truncate">
            <span class="text-xs font-mono font-medium text-slate-200 block truncate">3. Mathematics</span>
            <span class="text-[10px] font-mono text-slate-500">Compulsory</span>
          </div>
          <input
            type="range"
            min="0"
            max="100"
            value="92"
            class="flex-1 accent-cyan-400 h-1.5 bg-slate-800 rounded-lg cursor-pointer subject-range"
