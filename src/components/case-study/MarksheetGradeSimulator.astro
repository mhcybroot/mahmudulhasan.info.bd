          />
          <div class="w-16 text-right font-mono text-xs">
            <span class="text-white font-bold subject-val" id="val-math">92</span>
            <span class="text-[10px] ml-1 px-1.5 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800/40 subject-grade" id="grade-math">A+ (5.0)</span>
          </div>
        </div>

        <!-- Arabic / Islamic Studies -->
        <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800 flex items-center justify-between gap-3">
          <div class="w-32 truncate">
            <span class="text-xs font-mono font-medium text-slate-200 block truncate">4. Arabic / Islam</span>
            <span class="text-[10px] font-mono text-slate-500">Compulsory</span>
          </div>
          <input
            type="range"
            min="0"
            max="100"
            value="88"
            class="flex-1 accent-cyan-400 h-1.5 bg-slate-800 rounded-lg cursor-pointer subject-range"
            data-subject="arabic"
          />
          <div class="w-16 text-right font-mono text-xs">
            <span class="text-white font-bold subject-val" id="val-arabic">88</span>
            <span class="text-[10px] ml-1 px-1.5 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800/40 subject-grade" id="grade-arabic">A+ (5.0)</span>
          </div>
        </div>

        <!-- General Science -->
        <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800 flex items-center justify-between gap-3">
          <div class="w-32 truncate">
            <span class="text-xs font-mono font-medium text-slate-200 block truncate">5. Science / BGS</span>
            <span class="text-[10px] font-mono text-slate-500">Compulsory</span>
          </div>
          <input
            type="range"
            min="0"
            max="100"
            value="82"
            class="flex-1 accent-cyan-400 h-1.5 bg-slate-800 rounded-lg cursor-pointer subject-range"
            data-subject="science"
          />
          <div class="w-16 text-right font-mono text-xs">
            <span class="text-white font-bold subject-val" id="val-science">82</span>
            <span class="text-[10px] ml-1 px-1.5 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800/40 subject-grade" id="grade-science">A+ (5.0)</span>
          </div>
        </div>

        <!-- ICT (Information & Communication Tech) -->
        <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800 flex items-center justify-between gap-3">
          <div class="w-32 truncate">
            <span class="text-xs font-mono font-medium text-slate-200 block truncate">6. ICT Computer</span>
            <span class="text-[10px] font-mono text-slate-500">Compulsory</span>
          </div>
          <input
            type="range"
            min="0"
            max="100"
            value="90"
            class="flex-1 accent-cyan-400 h-1.5 bg-slate-800 rounded-lg cursor-pointer subject-range"
            data-subject="ict"
          />
          <div class="w-16 text-right font-mono text-xs">
            <span class="text-white font-bold subject-val" id="val-ict">90</span>
            <span class="text-[10px] ml-1 px-1.5 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800/40 subject-grade" id="grade-ict">A+ (5.0)</span>
          </div>
        </div>

        <!-- 4th Subject (Agriculture / Higher Math) -->
        <div class="bg-amber-950/20 p-3 rounded-xl border border-amber-500/30 flex items-center justify-between gap-3">
          <div class="w-32 truncate">
            <span class="text-xs font-mono font-bold text-amber-300 block truncate">7. Agriculture</span>
            <span class="text-[10px] font-mono text-amber-400/80">★ 4th Subject (Bonus)</span>
          </div>
          <input
            type="range"
            min="0"
            max="100"
            value="89"
            class="flex-1 accent-amber-400 h-1.5 bg-slate-800 rounded-lg cursor-pointer subject-range"
            data-subject="fourth"
          />
          <div class="w-16 text-right font-mono text-xs">
            <span class="text-white font-bold subject-val" id="val-fourth">89</span>
            <span class="text-[10px] ml-1 px-1.5 py-0.5 rounded bg-amber-950 text-amber-300 border border-amber-800/40 subject-grade" id="grade-fourth">A+ (5.0)</span>
          </div>
        </div>
      </div>

      <!-- Live Calculation Breakdown Badge -->
      <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono space-y-1.5">
        <div class="flex items-center justify-between text-slate-400">
          <span>Compulsory GP Sum (6 Subjects):</span>
          <span id="stat-compulsory-sum" class="text-white font-bold">29.0 / 30.0</span>
        </div>
        <div class="flex items-center justify-between text-slate-400">
          <span>4th Subject GP Bonus (Points &gt; 2.0):</span>
          <span id="stat-fourth-bonus" class="text-amber-400 font-bold">+3.0 GP added</span>
        </div>
        <div class="flex items-center justify-between text-slate-300 pt-1 border-t border-slate-800">
          <span>Calculated Cumulative GPA:</span>
          <span id="stat-calculated-gpa" class="text-emerald-400 font-bold text-sm">5.00 (Golden A+)</span>
        </div>
      </div>

      <!-- Batch Compilation Benchmark Button -->
      <button
        type="button"
        id="btn-run-batch"
        class="w-full py-2.5 px-4 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-mono font-bold flex items-center justify-center gap-2 transition-all hover:scale-[1.01]"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Run High-Throughput Batch Test (Simulate 500 Students)</span>
      </button>

      <div id="batch-results" class="hidden p-3 rounded-xl bg-emerald-950/30 border border-emerald-500/30 text-xs font-mono text-emerald-300 space-y-1">
        <div class="flex items-center justify-between">
          <span>500 Students Tabulated:</span>
          <span class="font-bold">41.8 milliseconds</span>
        </div>
        <div class="flex items-center justify-between text-[11px] text-slate-400">
          <span>Throughput:</span>
          <span class="text-emerald-400 font-bold">~11,960 students / sec (Node.js Heap)</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Live Printable Marksheet Document Preview (5 Cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between">
      <!-- Certificate Sheet Mockup -->
      <div class="rounded-2xl bg-white text-slate-900 p-5 shadow-2xl border-4 border-amber-600/30 relative overflow-hidden font-serif">
        <!-- Watermark -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-[0.04]">
          <span class="text-8xl font-black text-slate-900 tracking-widest font-mono">DAKHIL</span>
        </div>

        <!-- Madrasha Header -->
        <div class="text-center border-b-2 border-slate-900 pb-3">
          <p class="text-[10px] font-sans uppercase font-bold tracking-widest text-slate-600">Academic Transcript</p>
          <h3 class="text-sm font-bold leading-tight font-serif text-slate-950">
            Uttar Wasekpur Mohammadia Girls Dakhil Madrasha
          </h3>
          <p class="text-[10px] text-slate-600 font-sans">Ramgonj, Lakshmipur • Estd: 1984</p>
          <p class="text-[11px] font-bold font-sans text-cyan-900 mt-1">Dakhil Pre-Board Examination - 2026</p>
        </div>

        <!-- Student Meta Details -->
        <div class="grid grid-cols-2 gap-x-2 gap-y-0.5 text-[10px] font-sans border-b border-slate-300 py-2 text-slate-800">
          <div><strong>Student Name:</strong> <span class="font-serif">Fatema Akhter</span></div>
          <div><strong>Roll No:</strong> <span class="font-mono font-bold">01</span></div>
          <div><strong>Reg No:</strong> <span class="font-mono">2026-1049</span></div>
          <div><strong>Class:</strong> <span class="font-serif">Ten (Dakhil)</span></div>
          <div><strong>Session:</strong> <span class="font-mono">2025-2026</span></div>
          <div><strong>Merit Order:</strong> <span id="card-merit" class="font-mono font-bold text-emerald-700">1st</span></div>
        </div>

        <!-- Marksheet Mini Table -->
        <div class="mt-2 text-[10px] font-sans">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-400 text-slate-700 font-bold">
                <th class="py-1">Subject</th>
                <th class="py-1 text-center">Marks</th>
                <th class="py-1 text-center">Grade</th>
                <th class="py-1 text-right">GP</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200" id="card-table-body">
              <tr>
                <td class="py-0.5 font-medium">Quran / Bangla</td>
                <td class="py-0.5 text-center font-mono" id="row-bangla-marks">85</td>
                <td class="py-0.5 text-center font-bold text-emerald-700" id="row-bangla-grade">A+</td>
                <td class="py-0.5 text-right font-mono" id="row-bangla-gp">5.0</td>
              </tr>
              <tr>
                <td class="py-0.5 font-medium">English</td>
                <td class="py-0.5 text-center font-mono" id="row-english-marks">78</td>
                <td class="py-0.5 text-center font-bold text-emerald-700" id="row-english-grade">A</td>
                <td class="py-0.5 text-right font-mono" id="row-english-gp">4.0</td>
              </tr>
              <tr>
                <td class="py-0.5 font-medium">Mathematics</td>
                <td class="py-0.5 text-center font-mono" id="row-math-marks">92</td>
                <td class="py-0.5 text-center font-bold text-emerald-700" id="row-math-grade">A+</td>
                <td class="py-0.5 text-right font-mono" id="row-math-gp">5.0</td>
              </tr>
              <tr>
                <td class="py-0.5 font-medium">Arabic / Islam</td>
                <td class="py-0.5 text-center font-mono" id="row-arabic-marks">88</td>
                <td class="py-0.5 text-center font-bold text-emerald-700" id="row-arabic-grade">A+</td>
                <td class="py-0.5 text-right font-mono" id="row-arabic-gp">5.0</td>
              </tr>
              <tr>
                <td class="py-0.5 font-medium">Science / BGS</td>
                <td class="py-0.5 text-center font-mono" id="row-science-marks">82</td>
                <td class="py-0.5 text-center font-bold text-emerald-700" id="row-science-grade">A+</td>
                <td class="py-0.5 text-right font-mono" id="row-science-gp">5.0</td>
              </tr>
              <tr>
                <td class="py-0.5 font-medium">ICT Computer</td>
                <td class="py-0.5 text-center font-mono" id="row-ict-marks">90</td>
                <td class="py-0.5 text-center font-bold text-emerald-700" id="row-ict-grade">A+</td>
                <td class="py-0.5 text-right font-mono" id="row-ict-gp">5.0</td>
              </tr>
              <tr class="bg-amber-50">
                <td class="py-0.5 font-bold text-amber-900">Agriculture (4th Sub)</td>
                <td class="py-0.5 text-center font-mono font-bold text-amber-900" id="row-fourth-marks">89</td>
                <td class="py-0.5 text-center font-bold text-amber-800" id="row-fourth-grade">A+</td>
                <td class="py-0.5 text-right font-mono font-bold text-amber-900" id="row-fourth-gp">5.0</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Grade Summary & Result Seal -->
        <div class="mt-3 pt-2 border-t-2 border-slate-900 flex items-center justify-between">
          <div class="space-y-0.5 text-[10px] font-sans">
            <div>Total Marks: <strong id="card-total-marks" class="font-mono text-slate-950">604</strong></div>
            <div>Result: <strong id="card-result-status" class="text-emerald-700 font-bold uppercase">Passed</strong></div>
          </div>

          <!-- Official GPA Badge -->
          <div class="text-center p-2 rounded-xl bg-amber-50 border-2 border-amber-600/40 min-w-24">
            <span class="text-[9px] uppercase font-bold tracking-wider text-amber-800 block">Grade Point</span>
            <span id="card-final-gpa" class="text-lg font-black font-mono text-amber-700 block leading-tight">5.00</span>
            <span id="card-final-grade" class="text-[10px] font-bold text-amber-900 uppercase">Golden A+</span>
          </div>
        </div>

        <!-- Signature Footer -->
        <div class="mt-4 pt-2 border-t border-dashed border-slate-300 flex justify-between text-[8px] text-slate-500 font-sans">
          <span>Prepared by: Computer Operator</span>
          <span>Checked by: Exam Committee</span>
