      <!-- Quick Indicator Callout -->
      <div class="mt-3 p-3 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono flex items-center justify-between text-slate-400">
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Fail Gate Policy:</span>
        </span>
        <span id="gate-policy-indicator" class="text-emerald-400 font-bold">100% Valid (All &ge; 33)</span>
      </div>
    </div>
  </div>
</div>

<script>
  function initMarksheetSimulator() {
    const sliders = document.querySelectorAll<HTMLInputElement>('.subject-range');
    const presets = {
      golden: { bangla: 95, english: 88, math: 98, arabic: 94, science: 91, ict: 95, fourth: 92 },
      bonus: { bangla: 80, english: 74, math: 68, arabic: 82, science: 79, ict: 85, fourth: 95 },
      pass: { bangla: 45, english: 40, math: 52, arabic: 48, science: 42, ict: 50, fourth: 65 },
      fail: { bangla: 78, english: 28, math: 85, arabic: 72, science: 65, ict: 80, fourth: 90 }
    };

    function getGradeAndGp(marks: number): { grade: string; gp: number } {
      if (marks >= 80) return { grade: 'A+', gp: 5.0 };
      if (marks >= 70) return { grade: 'A', gp: 4.0 };
      if (marks >= 60) return { grade: 'A-', gp: 3.5 };
      if (marks >= 50) return { grade: 'B', gp: 3.0 };
      if (marks >= 40) return { grade: 'C', gp: 2.0 };
      if (marks >= 33) return { grade: 'D', gp: 1.0 };
      return { grade: 'F', gp: 0.0 };
    }

    function recalculate() {
      const subjects: Record<string, number> = {};
      let totalMarks = 0;
      let compulsoryGpSum = 0;
      let hasFailed = false;
      let allGolden = true;

      sliders.forEach((slider) => {
        const sub = slider.dataset.subject!;
        const val = parseInt(slider.value, 10);
        subjects[sub] = val;
        totalMarks += val;

        const { grade, gp } = getGradeAndGp(val);
        const valEl = document.getElementById(`val-${sub}`);
        const gradeEl = document.getElementById(`grade-${sub}`);
        const cardMarksEl = document.getElementById(`row-${sub}-marks`);
        const cardGradeEl = document.getElementById(`row-${sub}-grade`);
        const cardGpEl = document.getElementById(`row-${sub}-gp`);

        if (valEl) valEl.textContent = val.toString();
        if (gradeEl) {
          gradeEl.textContent = `${grade} (${gp.toFixed(1)})`;
          if (gp === 0.0) {
            gradeEl.className = 'text-[10px] ml-1 px-1.5 py-0.5 rounded bg-rose-950 text-rose-300 border border-rose-800/40 subject-grade font-bold';
          } else {
            gradeEl.className = 'text-[10px] ml-1 px-1.5 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800/40 subject-grade';
          }
        }

        if (cardMarksEl) cardMarksEl.textContent = val.toString();
        if (cardGradeEl) {
          cardGradeEl.textContent = grade;
          cardGradeEl.className = gp === 0.0 ? 'py-0.5 text-center font-bold text-rose-600' : 'py-0.5 text-center font-bold text-emerald-700';
        }
        if (cardGpEl) cardGpEl.textContent = gp.toFixed(1);

        if (sub !== 'fourth') {
          compulsoryGpSum += gp;
          if (gp === 0.0) hasFailed = true;
          if (gp < 5.0) allGolden = false;
        }
      });

      // 4th Subject Bonus Calculation
      const fourthMarks = subjects['fourth'] || 0;
      const fourthMeta = getGradeAndGp(fourthMarks);
      const fourthBonus = Math.max(0, fourthMeta.gp - 2.0);

      // Cumulative GPA (6 compulsory subjects)
      let finalGpa = 0.0;
      let finalGrade = 'F';

      if (!hasFailed) {
        const rawGpa = (compulsoryGpSum + fourthBonus) / 6.0;
        finalGpa = Math.min(5.0, rawGpa);

        if (finalGpa >= 5.0) {
          finalGrade = allGolden ? 'Golden A+' : 'A+';
        } else if (finalGpa >= 4.0) {
          finalGrade = 'A';
        } else if (finalGpa >= 3.5) {
          finalGrade = 'A-';
        } else if (finalGpa >= 3.0) {
          finalGrade = 'B';
        } else if (finalGpa >= 2.0) {
          finalGrade = 'C';
        } else if (finalGpa >= 1.0) {
          finalGrade = 'D';
        } else {
          finalGrade = 'F';
        }
      }

      // Update stat displays
      const totalMarksEl = document.getElementById('stat-total-marks');
      if (totalMarksEl) totalMarksEl.textContent = totalMarks.toString();

      const compSumEl = document.getElementById('stat-compulsory-sum');
      if (compSumEl) compSumEl.textContent = `${compulsoryGpSum.toFixed(1)} / 30.0`;

      const fourthBonusEl = document.getElementById('stat-fourth-bonus');
      if (fourthBonusEl) {
        fourthBonusEl.textContent = fourthBonus > 0 ? `+${fourthBonus.toFixed(1)} GP added` : '0.0 GP (Min 2.0 needed)';
      }

      const calcGpaEl = document.getElementById('stat-calculated-gpa');
      if (calcGpaEl) {
        if (hasFailed) {
          calcGpaEl.textContent = '0.00 (Failed - Sub Break)';
          calcGpaEl.className = 'text-rose-400 font-bold text-sm';
        } else {
          calcGpaEl.textContent = `${finalGpa.toFixed(2)} (${finalGrade})`;
          calcGpaEl.className = finalGrade.includes('A+') ? 'text-amber-400 font-bold text-sm' : 'text-emerald-400 font-bold text-sm';
        }
      }

      // Update Card Preview
      const cardTotalEl = document.getElementById('card-total-marks');
      if (cardTotalEl) cardTotalEl.textContent = totalMarks.toString();

      const cardStatusEl = document.getElementById('card-result-status');
      if (cardStatusEl) {
        if (hasFailed) {
          cardStatusEl.textContent = 'FAILED';
          cardStatusEl.className = 'text-rose-600 font-bold uppercase';
        } else {
          cardStatusEl.textContent = 'PASSED';
          cardStatusEl.className = 'text-emerald-700 font-bold uppercase';
        }
      }

      const cardFinalGpaEl = document.getElementById('card-final-gpa');
      if (cardFinalGpaEl) {
        cardFinalGpaEl.textContent = hasFailed ? '0.00' : finalGpa.toFixed(2);
        cardFinalGpaEl.className = hasFailed ? 'text-lg font-black font-mono text-rose-600 block leading-tight' : 'text-lg font-black font-mono text-amber-700 block leading-tight';
      }

      const cardFinalGradeEl = document.getElementById('card-final-grade');
      if (cardFinalGradeEl) {
        cardFinalGradeEl.textContent = finalGrade;
        cardFinalGradeEl.className = hasFailed ? 'text-[10px] font-bold text-rose-700 uppercase' : 'text-[10px] font-bold text-amber-900 uppercase';
      }

      const cardMeritEl = document.getElementById('card-merit');
      if (cardMeritEl) {
        if (hasFailed) {
          cardMeritEl.textContent = 'Unranked (Fail)';
          cardMeritEl.className = 'font-mono font-bold text-rose-600';
        } else if (finalGpa >= 5.0 && totalMarks > 620) {
          cardMeritEl.textContent = '1st Place';
          cardMeritEl.className = 'font-mono font-bold text-emerald-700';
        } else if (finalGpa >= 4.5) {
          cardMeritEl.textContent = '4th Place';
          cardMeritEl.className = 'font-mono font-bold text-emerald-700';
        } else {
          cardMeritEl.textContent = '18th Place';
          cardMeritEl.className = 'font-mono font-bold text-slate-700';
        }
      }

      const gateIndicatorEl = document.getElementById('gate-policy-indicator');
      if (gateIndicatorEl) {
        if (hasFailed) {
          gateIndicatorEl.textContent = 'FAILED (Subject < 33)';
          gateIndicatorEl.className = 'text-rose-400 font-bold';
        } else {
          gateIndicatorEl.textContent = '100% Valid (All >= 33)';
          gateIndicatorEl.className = 'text-emerald-400 font-bold';
        }
      }
    }

    // Attach slider listeners
    sliders.forEach((s) => s.addEventListener('input', recalculate));

    // Preset button handlers
    function applyPreset(values: Record<string, number>) {
      sliders.forEach((slider) => {
        const sub = slider.dataset.subject!;
        if (values[sub] !== undefined) {
          slider.value = values[sub].toString();
        }
      });
      recalculate();
    }

    document.getElementById('preset-golden')?.addEventListener('click', () => applyPreset(presets.golden));
    document.getElementById('preset-bonus')?.addEventListener('click', () => applyPreset(presets.bonus));
    document.getElementById('preset-pass')?.addEventListener('click', () => applyPreset(presets.pass));
    document.getElementById('preset-fail')?.addEventListener('click', () => applyPreset(presets.fail));

    // Batch Compilation Benchmark simulation
    const batchBtn = document.getElementById('btn-run-batch');
    const batchResults = document.getElementById('batch-results');
    batchBtn?.addEventListener('click', () => {
      const start = performance.now();
      // Simulate in-memory compilation of 500 records
      const dummyRecords = [];
      for (let i = 0; i < 500; i++) {
        dummyRecords.push({
          id: i + 1,
          scores: [75 + (i % 25), 60 + (i % 35), 80 + (i % 20), 70 + (i % 28), 65 + (i % 30), 80 + (i % 18)],
          fourth: 85 + (i % 15)
        });
      }
      // Calculate
      dummyRecords.forEach(r => {
        let sum = 0;
        r.scores.forEach(s => {
          sum += s >= 80 ? 5 : s >= 70 ? 4 : s >= 60 ? 3.5 : s >= 50 ? 3 : s >= 40 ? 2 : s >= 33 ? 1 : 0;
        });
        const bonus = Math.max(0, (r.fourth >= 80 ? 5 : 4) - 2.0);
        return Math.min(5.0, (sum + bonus) / 6.0);
      });
      const end = performance.now();
      const elapsed = (end - start).toFixed(1);

      if (batchResults) {
        batchResults.classList.remove('hidden');
        batchResults.innerHTML = `
          <div class="flex items-center justify-between">
            <span>500 Students Tabulated:</span>
            <span class="font-bold text-white">${elapsed} milliseconds</span>
          </div>
          <div class="flex items-center justify-between text-[11px] text-slate-400">
            <span>Execution Throughput:</span>
            <span class="text-emerald-400 font-bold">~${Math.round(500 / (Math.max(0.1, Number(elapsed)) / 1000)).toLocaleString()} students / sec</span>
          </div>
        `;
      }
    });

    recalculate();
  }

  initMarksheetSimulator();
  document.addEventListener('astro:page-load', initMarksheetSimulator);
</script>
