<script>
  function initSmartCampusSimulator() {
    // Tab switching
    const tabBtns = document.querySelectorAll('.campus-tab-btn');
    const screens = {
      overview: document.getElementById('screen-overview'),
      attendance: document.getElementById('screen-attendance'),
      results: document.getElementById('screen-results'),
      cluster: document.getElementById('screen-cluster'),
    };

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetScreen = btn.getAttribute('data-screen');
        tabBtns.forEach((b) => {
          b.className = 'campus-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold';
        });
        btn.className = 'campus-tab-btn px-3.5 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-semibold transition-all shadow-sm';

        Object.keys(screens).forEach((key) => {
          if (screens[key as keyof typeof screens]) {
            if (key === targetScreen) {
              screens[key as keyof typeof screens]!.classList.remove('hidden');
            } else {
              screens[key as keyof typeof screens]!.classList.add('hidden');
            }
          }
        });
      });
    });

    // Attendance punch dispatcher
    const memberSelect = document.getElementById('sim-member-select') as HTMLSelectElement | null;
    const timeSelect = document.getElementById('sim-time-select') as HTMLSelectElement | null;
    const punchBtn = document.getElementById('sim-dispatch-punch-btn');
    const punchLog = document.getElementById('sim-punch-log');
    const lateCountEl = document.getElementById('sim-late-count');
    const deductionEl = document.getElementById('sim-deduction');
    const netPayEl = document.getElementById('sim-net-pay');
    let currentLates = 0;

    punchBtn?.addEventListener('click', () => {
      if (!memberSelect || !timeSelect || !punchLog) return;
      const memberName = memberSelect.options[memberSelect.selectedIndex].text.split('(')[0].trim();
      const timeVal = timeSelect.value;

      let badge = 'PRESENT (ON-TIME)';
      let badgeColor = 'bg-emerald-500/20 text-emerald-300';
      let timeText = '08:15 AM';

      if (timeVal === 'grace') {
        badge = 'ON-TIME (GRACE)';
        badgeColor = 'bg-cyan-500/20 text-cyan-300';
        timeText = '08:42 AM';
      } else if (timeVal === 'late') {
        badge = 'LATE PUNCH';
        badgeColor = 'bg-amber-500/20 text-amber-300';
        timeText = '09:25 AM';
        currentLates++;
      } else if (timeVal === 'absent') {
        badge = 'ABSENT (> 3h DELAY)';
        badgeColor = 'bg-rose-500/20 text-rose-300';
        timeText = '12:30 PM';
        currentLates += 2;
      }

      if (lateCountEl) lateCountEl.textContent = `${currentLates} Incidents`;
      const penalty = currentLates * 1500;
      if (deductionEl) deductionEl.textContent = `BDT ${penalty.toLocaleString()}`;
      if (netPayEl) netPayEl.textContent = `BDT ${(85000 - penalty).toLocaleString()}`;

      const newLog = document.createElement('div');
      newLog.className = 'p-2.5 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-between text-[11px] animate-in fade-in duration-300';
      newLog.innerHTML = `
        <div>
          <span class="text-white font-bold">${memberName}</span>
          <span class="text-slate-400 ml-2">${timeText}</span>
        </div>
        <span class="px-2 py-0.5 rounded ${badgeColor} font-bold text-[10px]">${badge}</span>
      `;
      punchLog.insertBefore(newLog, punchLog.firstChild);
    });

    // GPA Tabulation Sliders
    const sliderInternal = document.getElementById('slider-internal') as HTMLInputElement | null;
    const sliderMidterm = document.getElementById('slider-midterm') as HTMLInputElement | null;
    const sliderFinal = document.getElementById('slider-final') as HTMLInputElement | null;

    const labelInternal = document.getElementById('label-internal');
    const labelMidterm = document.getElementById('label-midterm');
    const labelFinal = document.getElementById('label-final');

    const totalScoreEl = document.getElementById('res-total-score');
    const letterGradeEl = document.getElementById('res-letter-grade');
    const gradePointEl = document.getElementById('res-grade-point');
    const standingEl = document.getElementById('res-standing');

    const tableScore = document.getElementById('table-score');
    const tableGrade = document.getElementById('table-grade');
    const tableGp = document.getElementById('table-gp');

    function updateGrades() {
      if (!sliderInternal || !sliderMidterm || !sliderFinal) return;
      const internal = parseInt(sliderInternal.value) || 0;
      const midterm = parseInt(sliderMidterm.value) || 0;
      const finals = parseInt(sliderFinal.value) || 0;
      const total = internal + midterm + finals;

      if (labelInternal) labelInternal.textContent = `${internal} / 30`;
      if (labelMidterm) labelMidterm.textContent = `${midterm} / 20`;
      if (labelFinal) labelFinal.textContent = `${finals} / 50`;

      if (totalScoreEl) totalScoreEl.textContent = `${total} / 100`;

      let letter = 'F';
      let gp = '0.00';
      let standing = 'Fail (Course Retake Required)';
      let colorClass = 'bg-rose-500/20 text-rose-300';

      if (total >= 80) {
        letter = 'A+';
        gp = '4.00';
        standing = 'First Class Honours (Outstanding)';
        colorClass = 'bg-emerald-500/20 text-emerald-300';
      } else if (total >= 75) {
        letter = 'A';
        gp = '3.75';
        standing = 'First Class (Excellent)';
        colorClass = 'bg-emerald-500/20 text-emerald-300';
      } else if (total >= 70) {
        letter = 'A-';
        gp = '3.50';
        standing = 'First Class (Very Good)';
        colorClass = 'bg-cyan-500/20 text-cyan-300';
      } else if (total >= 65) {
        letter = 'B+';
        gp = '3.25';
        standing = 'Second Class Upper';
        colorClass = 'bg-cyan-500/20 text-cyan-300';
      } else if (total >= 60) {
        letter = 'B';
        gp = '3.00';
        standing = 'Second Class';
        colorClass = 'bg-amber-500/20 text-amber-300';
      } else if (total >= 50) {
        letter = 'C';
        gp = '2.50';
        standing = 'Third Class';
        colorClass = 'bg-amber-500/20 text-amber-300';
      } else if (total >= 40) {
        letter = 'D';
        gp = '2.00';
        standing = 'Pass';
        colorClass = 'bg-slate-700 text-slate-300';
      }

      if (letterGradeEl) {
        letterGradeEl.textContent = letter;
        letterGradeEl.className = `px-2.5 py-0.5 rounded-lg ${colorClass} font-bold text-base`;
      }
      if (gradePointEl) gradePointEl.textContent = gp;
      if (standingEl) standingEl.textContent = standing;

      if (tableScore) tableScore.textContent = `${total}`;
      if (tableGrade) tableGrade.textContent = letter;
      if (tableGp) tableGp.textContent = gp;
    }

    sliderInternal?.addEventListener('input', updateGrades);
    sliderMidterm?.addEventListener('input', updateGrades);
    sliderFinal?.addEventListener('input', updateGrades);

    // Transcript preview toggle
    const printTranscriptBtn = document.getElementById('btn-print-transcript');
    const transcriptBox = document.getElementById('transcript-preview-box');
    printTranscriptBtn?.addEventListener('click', () => {
      transcriptBox?.classList.toggle('hidden');
    });

    // Mock data seed button
    const seedBtn = document.getElementById('btn-seed-mock');
    const clusterMsg = document.getElementById('cluster-action-msg');
    seedBtn?.addEventListener('click', () => {
      if (clusterMsg) {
        clusterMsg.classList.remove('hidden');
        setTimeout(() => {
          clusterMsg.classList.add('hidden');
        }, 5000);
      }
    });

    const restartBtn = document.getElementById('btn-restart-cluster');
    restartBtn?.addEventListener('click', () => {
      if (clusterMsg) {
        clusterMsg.textContent = '🔄 Supervisor restarted all 4 micro-services in 1.4s with zero socket conflicts!';
        clusterMsg.classList.remove('hidden');
        setTimeout(() => {
          clusterMsg.classList.add('hidden');
        }, 5000);
      }
    });
  }

  initSmartCampusSimulator();
  document.addEventListener('astro:page-load', initSmartCampusSimulator);
</script>
