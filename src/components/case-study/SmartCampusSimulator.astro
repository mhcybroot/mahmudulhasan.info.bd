---
// Smart Academic Infrastructure Simulator: Vue 3 Micro-Frontend, Spring Boot 3.4 Loom, PostgreSQL, Result Tabulation
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl p-6 sm:p-8 space-y-8 shadow-2xl">
  <!-- Simulator Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-cyan-300 font-mono text-xs uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
        Interactive Smart Campus Sandbox
      </div>
      <h2 class="text-2xl sm:text-3xl font-mono font-bold text-white flex items-center gap-3">
        Smart Academic: Unified Campus ERP &amp; Portal
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 font-sans mt-1">
        Explore the unified Vue 3 executive dashboard, Spring Boot Project Loom attendance engine, and GPA tabulation.
      </p>
    </div>

    <!-- Subsystem Perspective Tabs -->
    <div class="flex items-center p-1 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono overflow-x-auto">
      <button
        type="button"
        id="campus-tab-overview"
        class="campus-tab-btn px-3.5 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-semibold transition-all shadow-sm"
        data-screen="overview"
      >
        🏛️ Executive Portal
      </button>
      <button
        type="button"
        id="campus-tab-attendance"
        class="campus-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-screen="attendance"
      >
        ⏱️ Attendance &amp; Loom
      </button>
      <button
        type="button"
        id="campus-tab-results"
        class="campus-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-screen="results"
      >
        📊 GPA Tabulation
      </button>
      <button
        type="button"
        id="campus-tab-cluster"
        class="campus-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-screen="cluster"
      >
        🖥️ Cluster Daemons
      </button>
    </div>
  </div>

  <!-- Screen 1: Executive Portal Overview (Default) -->
  <div id="screen-overview" class="campus-screen space-y-6">
    <!-- Live Campus KPIs -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <div class="text-[11px] font-mono text-slate-400 uppercase flex items-center justify-between">
          <span>Active Students</span>
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        </div>
        <div class="text-2xl font-mono font-bold text-white" id="kpi-students">1,482</div>
        <div class="text-[10px] text-emerald-400 font-mono">↑ 98.4% on campus</div>
      </div>

      <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <div class="text-[11px] font-mono text-slate-400 uppercase flex items-center justify-between">
          <span>Faculty on Duty</span>
          <span class="text-cyan-400 font-mono text-xs">96%</span>
        </div>
        <div class="text-2xl font-mono font-bold text-white">94 / 98</div>
        <div class="text-[10px] text-cyan-300 font-mono">4 on approved medical leave</div>
      </div>

      <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <div class="text-[11px] font-mono text-slate-400 uppercase flex items-center justify-between">
          <span>Campus Avg GPA</span>
          <span class="text-amber-400 font-mono text-xs">A (3.64)</span>
        </div>
        <div class="text-2xl font-mono font-bold text-emerald-400" id="kpi-gpa">3.64 / 4.00</div>
        <div class="text-[10px] text-slate-400 font-mono">Spring Semester Final</div>
      </div>

      <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <div class="text-[11px] font-mono text-slate-400 uppercase flex items-center justify-between">
          <span>Portal Interop</span>
          <span class="text-emerald-400 font-mono text-xs">Virtual Loom</span>
        </div>
        <div class="text-2xl font-mono font-bold text-cyan-300">&lt; 14 ms</div>
        <div class="text-[10px] text-emerald-400 font-mono">Zero iframe layout shift</div>
      </div>
    </div>

    <!-- Two Columns: Department Attendance Breakdown & Live Floor Status -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left: Department Attendance & Punctuality Leaderboard -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-mono font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              Department Attendance &amp; Shift Health
            </span>
            <span class="text-[10px] font-mono text-emerald-400 font-semibold">PostgreSQL Live Cache</span>
          </div>

          <div class="space-y-3 font-mono text-xs">
            <!-- Dept 1: Computer Science -->
            <div class="space-y-1">
              <div class="flex items-center justify-between text-slate-300">
                <span>Computer Science &amp; Engineering</span>
                <span class="text-emerald-400 font-bold">98.2% Present</span>
              </div>
              <div class="w-full bg-slate-900 rounded-full h-2 overflow-hidden border border-slate-800">
                <div class="bg-gradient-to-r from-cyan-500 to-emerald-400 h-2 rounded-full" style="width: 98.2%"></div>
              </div>
            </div>

            <!-- Dept 2: Mathematics -->
            <div class="space-y-1">
              <div class="flex items-center justify-between text-slate-300">
                <span>Department of Mathematics</span>
                <span class="text-emerald-400 font-bold">94.8% Present</span>
              </div>
              <div class="w-full bg-slate-900 rounded-full h-2 overflow-hidden border border-slate-800">
                <div class="bg-gradient-to-r from-cyan-500 to-emerald-400 h-2 rounded-full" style="width: 94.8%"></div>
              </div>
            </div>

            <!-- Dept 3: Physics -->
            <div class="space-y-1">
              <div class="flex items-center justify-between text-slate-300">
                <span>Applied Physics &amp; Electronics</span>
                <span class="text-cyan-400 font-bold">96.0% Present</span>
              </div>
              <div class="w-full bg-slate-900 rounded-full h-2 overflow-hidden border border-slate-800">
                <div class="bg-gradient-to-r from-cyan-500 to-emerald-400 h-2 rounded-full" style="width: 96.0%"></div>
              </div>
            </div>

            <!-- Dept 4: Business Administration -->
            <div class="space-y-1">
              <div class="flex items-center justify-between text-slate-300">
                <span>School of Business (BBA)</span>
                <span class="text-amber-400 font-bold">89.4% Present</span>
              </div>
              <div class="w-full bg-slate-900 rounded-full h-2 overflow-hidden border border-slate-800">
                <div class="bg-gradient-to-r from-amber-500 to-emerald-400 h-2 rounded-full" style="width: 89.4%"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Early Bird Punctuality Leaderboard -->
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="text-xs font-bold text-slate-200">🏆 Campus Punctuality Honor Roll</span>
            <span class="text-[10px] text-slate-400">Recorded &lt; 08:30 AM</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px]">
            <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between">
              <div class="truncate">
                <div class="text-white font-bold">Dr. Sarah Mitchell</div>
                <div class="text-slate-400 text-[10px]">CSE • 08:14:22 AM</div>
              </div>
              <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-bold">#1 First In</span>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between">
              <div class="truncate">
                <div class="text-white font-bold">Prof. Tariq Rahman</div>
                <div class="text-slate-400 text-[10px]">Mathematics • 08:18:05 AM</div>
              </div>
              <span class="px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 font-bold">#2 Early Bird</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Real-Time Smart Facility Occupancy & Theme Injection Status -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Facility Occupancy Telemetry
            </span>
            <span class="text-emerald-400 font-bold text-[10px]">Live Sensors</span>
          </div>

          <div class="space-y-2.5 text-[11px]">
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-900 border border-slate-800">
              <span class="text-slate-300">Software Engineering Lab 401</span>
              <span class="text-emerald-400 font-bold">48 / 50 seats (96%)</span>
            </div>
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-900 border border-slate-800">
              <span class="text-slate-300">Central Physics Auditorium B</span>
              <span class="text-cyan-400 font-bold">182 / 200 seats (91%)</span>
            </div>
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-900 border border-slate-800">
              <span class="text-slate-300">Mathematics Seminar Room 204</span>
              <span class="text-amber-400 font-bold">14 / 35 seats (40%)</span>
            </div>
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-900 border border-slate-800">
              <span class="text-slate-300">Executive Council Boardroom</span>
              <span class="text-slate-400">Vacant • Reserved 2:00 PM</span>
            </div>
          </div>
        </div>

        <!-- Micro-Frontend Architecture Callout -->
        <div class="p-4 rounded-2xl bg-cyan-950/30 border border-cyan-500/30 space-y-2 font-mono text-xs text-cyan-200">
          <div class="flex items-center gap-2 font-bold text-cyan-300">
            <span>⚡ Sandboxed Micro-Frontend Interop</span>
          </div>
          <p class="text-[11px] text-slate-300 leading-relaxed font-sans">
            The Vue 3 client wraps independent Spring Boot micro-services into <code class="text-cyan-300 font-mono">iframe?embedded=true</code> instances, dynamically injecting <code class="text-cyan-300 font-mono">smart-academic-theme.css</code> to ensure zero visual disconnect.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Screen 2: Attendance & Project Loom Concurrency -->
  <div id="screen-attendance" class="campus-screen hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Attendance Ingress Dispatcher -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              Faculty &amp; Student Shift Ingress
            </span>
            <span class="text-[10px] text-emerald-400">Java 21 Loom Virtual Thread</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-slate-400 mb-1">Select Academic Member</label>
              <select id="sim-member-select" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white text-xs focus:border-cyan-400 outline-none">
                <option value="sarah" data-dept="CSE" data-shift="Morning (08:30 - 16:30)">Dr. Sarah Mitchell (CSE Dept Head)</option>
                <option value="tariq" data-dept="MATH" data-shift="Morning (08:30 - 16:30)">Prof. Tariq Rahman (Mathematics)</option>
                <option value="ahmed" data-dept="PHY" data-shift="General (09:00 - 17:00)">Dr. Ahmed Hossain (Physics)</option>
                <option value="anika" data-dept="BBA" data-shift="Afternoon (11:00 - 19:00)">Ms. Anika Tabassum (BBA Faculty)</option>
              </select>
            </div>

            <div>
              <label class="block text-slate-400 mb-1">Punch Simulation Time</label>
              <select id="sim-time-select" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white text-xs focus:border-cyan-400 outline-none">
                <option value="ontime">08:15 AM (Early Bird • Full Attendance)</option>
                <option value="grace">08:42 AM (Within Grace Period • On-Time)</option>
                <option value="late">09:25 AM (Late Punch • 0.5x Half-Day Deduction)</option>
                <option value="absent">12:30 PM (Excessive Delay • Mark Absent)</option>
              </select>
            </div>
          </div>

          <div class="pt-2 flex items-center justify-between">
            <button
              type="button"
              id="sim-dispatch-punch-btn"
              class="px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-500 to-emerald-400 text-slate-950 font-bold hover:scale-[1.02] transition-transform shadow-lg cursor-pointer flex items-center gap-2"
            >
              <span>⚡ Execute Virtual Thread Punch</span>
            </button>
            <span class="text-[10px] text-slate-400">Spring Boot :8083 Ingestion</span>
          </div>
        </div>

        <!-- Attendance Punch Ingress Log Feed -->
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="text-xs font-bold text-white">Live Punch Telemetry Ingress</span>
            <span class="text-[10px] text-cyan-300" id="sim-thread-counter">Thread: ForkJoinPool-worker-1</span>
          </div>

          <div id="sim-punch-log" class="space-y-2 max-h-48 overflow-y-auto pr-1">
            <div class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-between text-[11px]">
              <div>
                <span class="text-white font-bold">Dr. Sarah Mitchell</span>
                <span class="text-slate-400 ml-2">CSE • 08:14 AM</span>
              </div>
              <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-bold text-[10px]">PRESENT (ON-TIME)</span>
            </div>
            <div class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-between text-[11px]">
              <div>
                <span class="text-white font-bold">Prof. Tariq Rahman</span>
                <span class="text-slate-400 ml-2">MATH • 08:21 AM</span>
              </div>
              <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-bold text-[10px]">PRESENT (ON-TIME)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Automated Payroll & Leave Balance Impact -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="text-xs font-bold text-white uppercase tracking-wider">Faculty Payroll Ledger</span>
            <span class="text-emerald-400 font-bold text-[10px]">Real-Time Reconciliation</span>
          </div>

          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Base Monthly Salary:</span>
              <span class="text-white font-bold">BDT 85,000</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Total Shift Days:</span>
              <span class="text-white font-bold">22 Days (176 hrs)</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Recorded Late Violations:</span>
              <span class="text-amber-400 font-bold" id="sim-late-count">0 Incidents</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Salary Deduction Penalty:</span>
              <span class="text-rose-400 font-bold" id="sim-deduction">BDT 0</span>
            </div>
            <div class="pt-2 border-t border-slate-800 flex items-center justify-between text-sm">
              <span class="text-cyan-300 font-bold">Estimated Net Pay:</span>
              <span class="text-emerald-400 font-bold text-base" id="sim-net-pay">BDT 85,000</span>
            </div>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-300 space-y-2">
          <div class="text-white font-bold flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Project Loom Throughput Benefit
          </div>
          <p class="text-[11px] text-slate-400 font-sans leading-relaxed">
            By switching from platform OS threads to Java 21 virtual threads, Spring Boot handles 10,000+ simultaneous biometric punch packets without thread pool exhaustion or out-of-memory crashes.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Screen 3: Result Management & GPA Tabulation -->
  <div id="screen-results" class="campus-screen hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Mark Breakdown Sliders -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              Subject Mark Evaluation (Max 100)
            </span>
            <span class="text-[10px] text-cyan-300">PostgreSQL ACID Transaction</span>
          </div>

          <div class="space-y-4">
            <!-- Continuous Assessment (Internal) 30% -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-slate-300">
                <span>Class Tests &amp; Lab Assignments (30 Marks)</span>
                <span class="text-cyan-300 font-bold" id="label-internal">26 / 30</span>
              </div>
              <input
                type="range"
                id="slider-internal"
                min="0"
                max="30"
                value="26"
                class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
              />
            </div>

            <!-- Midterm Exam 20% -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-slate-300">
                <span>Midterm Examination (20 Marks)</span>
                <span class="text-cyan-300 font-bold" id="label-midterm">18 / 20</span>
              </div>
              <input
                type="range"
                id="slider-midterm"
                min="0"
                max="20"
                value="18"
                class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
              />
            </div>

            <!-- Semester Final Exam 50% -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-slate-300">
                <span>Semester Final Examination (50 Marks)</span>
                <span class="text-cyan-300 font-bold" id="label-final">44 / 50</span>
              </div>
              <input
                type="range"
                id="slider-final"
                min="0"
                max="50"
                value="44"
                class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
              />
            </div>
          </div>
        </div>

        <!-- Grade Scale Reference Card -->
        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-400 space-y-2">
          <div class="text-xs font-bold text-white flex items-center justify-between">
            <span>UGC Bangladesh Academic Grading Scale</span>
            <span class="text-emerald-400 text-[10px]">Standard Scale</span>
          </div>
          <div class="grid grid-cols-4 gap-2 text-center text-[10px]">
            <div class="p-1.5 rounded bg-slate-900 border border-slate-800 text-white font-bold">80-100: A+ (4.00)</div>
            <div class="p-1.5 rounded bg-slate-900 border border-slate-800 text-slate-300">75-79: A (3.75)</div>
            <div class="p-1.5 rounded bg-slate-900 border border-slate-800 text-slate-300">70-74: A- (3.50)</div>
            <div class="p-1.5 rounded bg-slate-900 border border-slate-800 text-rose-400">&lt; 40: F (0.00)</div>
          </div>
        </div>
      </div>

      <!-- Right: Computed Grade & Official Academic Transcript Card -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="text-xs font-bold text-white uppercase tracking-wider">Tabulated Grade Summary</span>
            <span class="text-emerald-400 font-bold text-[10px]">Auto-Compiled</span>
          </div>

          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Total Aggregated Score:</span>
              <span class="text-2xl font-bold text-white" id="res-total-score">88 / 100</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Letter Grade:</span>
              <span class="px-2.5 py-0.5 rounded-lg bg-emerald-500/20 text-emerald-300 font-bold text-base" id="res-letter-grade">A+</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Grade Point (Scale 4.00):</span>
              <span class="text-xl font-bold text-cyan-300" id="res-grade-point">4.00</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Academic Standing:</span>
              <span class="text-emerald-400 font-bold" id="res-standing">First Class Honours</span>
            </div>
            <div class="pt-3 border-t border-slate-800">
              <button
                type="button"
                id="btn-print-transcript"
                class="w-full py-2.5 rounded-xl bg-slate-800 border border-slate-700 hover:border-cyan-400 text-white font-bold transition-all text-xs flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>📄 Preview Official Semester Transcript</span>
              </button>
            </div>
          </div>
        </div>

        <div id="transcript-preview-box" class="hidden p-4 rounded-2xl bg-white text-slate-950 font-serif text-[11px] space-y-2 shadow-2xl border border-slate-300">
