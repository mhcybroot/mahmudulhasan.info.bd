---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`rounded-2xl bg-slate-900 border border-slate-700 p-6 shadow-xl ${className}`}>
  <!-- Section Title -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-800">
    <div>
      <h3 class="text-xl font-mono font-bold text-white flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
        How It Compares: Real-World Performance &amp; Efficiency
      </h3>
      <p class="text-sm text-slate-300 mt-1">
        Benchmarked on standard computer hardware processing thousands of real-world photos.
      </p>
    </div>
    <span class="text-xs font-mono px-3 py-1 rounded bg-slate-800 text-emerald-300 border border-emerald-500/40 font-bold">
      VERIFIED DATA // 100% PASS
    </span>
  </div>

  <!-- Responsive Comparison Table with WCAG AA High Contrast -->
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse text-xs font-sans">
      <thead>
        <tr class="border-b border-slate-700 text-slate-300 font-mono text-xs uppercase tracking-wider bg-slate-950/60">
          <th scope="col" class="py-3.5 px-4 font-bold text-slate-200">What Matters To You</th>
          <th scope="col" class="py-3.5 px-4 text-cyan-300 bg-cyan-950/40 border-x border-cyan-700/50 font-bold">ImageUpscale Pro (Our App)</th>
          <th scope="col" class="py-3.5 px-4 text-slate-300 font-bold">Standard Desktop Apps (C++)</th>
          <th scope="col" class="py-3.5 px-4 text-slate-300 font-bold">Cloud &amp; Python Tools</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800 font-mono text-xs">
        <!-- Metric 1: Processing Speed -->
        <tr class="hover:bg-slate-800/50 transition-colors">
          <th scope="row" class="py-4 px-4 font-semibold text-slate-100 font-sans text-left">
            Batch Speed
            <span class="block text-xs font-mono text-slate-300 font-normal">How fast it cleans an entire folder</span>
          </th>
          <td class="py-4 px-4 font-bold text-emerald-300 bg-cyan-950/40 border-x border-cyan-700/50">
            292 Photos / Sec <span class="text-xs text-emerald-400 font-sans block sm:inline">(▲ 7x Faster)</span>
          </td>
          <td class="py-4 px-4 text-slate-200">
            41 Photos / Sec
          </td>
          <td class="py-4 px-4 text-slate-300">
            18 Photos / Sec (Laggy)
          </td>
        </tr>

        <!-- Metric 2: Waiting Time -->
        <tr class="hover:bg-slate-800/50 transition-colors">
          <th scope="row" class="py-4 px-4 font-semibold text-slate-100 font-sans text-left">
            Speed Per Photo
            <span class="block text-xs font-mono text-slate-300 font-normal">Time you wait for 1 photo</span>
          </th>
          <td class="py-4 px-4 font-bold text-cyan-300 bg-cyan-950/40 border-x border-cyan-700/50">
            3.43 ms (Instant)
          </td>
          <td class="py-4 px-4 text-slate-200">
            24.2 ms
          </td>
          <td class="py-4 px-4 text-slate-300">
            54.0 ms
          </td>
        </tr>

        <!-- Metric 3: Memory Footprint -->
        <tr class="hover:bg-slate-800/50 transition-colors">
          <th scope="row" class="py-4 px-4 font-semibold text-slate-100 font-sans text-left">
            PC Memory Used
            <span class="block text-xs font-mono text-slate-300 font-normal">Will it freeze your computer?</span>
          </th>
          <td class="py-4 px-4 font-bold text-emerald-300 bg-cyan-950/40 border-x border-cyan-700/50">
            &lt; 25 MB RAM (Zero Lag)
          </td>
          <td class="py-4 px-4 text-slate-200">
            180 MB RAM
          </td>
          <td class="py-4 px-4 text-amber-300">
            380+ MB (Slows PC)
          </td>
        </tr>

        <!-- Metric 4: Image Naturalness -->
        <tr class="hover:bg-slate-800/50 transition-colors">
          <th scope="row" class="py-4 px-4 font-semibold text-slate-100 font-sans text-left">
            Visual Quality &amp; Artifacts
            <span class="block text-xs font-mono text-slate-300 font-normal">No ugly white borders around text</span>
          </th>
          <td class="py-4 px-4 font-bold text-emerald-300 bg-cyan-950/40 border-x border-cyan-700/50">
            0% Halos (True-To-Life)
          </td>
          <td class="py-4 px-4 text-slate-200">
            Noticeable White Halos
          </td>
          <td class="py-4 px-4 text-slate-300">
            Grainy &amp; Oversharpened
          </td>
        </tr>

        <!-- Metric 5: Privacy & Internet -->
        <tr class="hover:bg-slate-800/50 transition-colors">
          <th scope="row" class="py-4 px-4 font-semibold text-slate-100 font-sans text-left">
            Data Privacy
            <span class="block text-xs font-mono text-slate-300 font-normal">Where do your photos go?</span>
          </th>
          <td class="py-4 px-4 font-bold text-emerald-300 bg-cyan-950/40 border-x border-cyan-700/50">
            100% Stays On Your PC
          </td>
          <td class="py-4 px-4 text-slate-200">
            Local Only
          </td>
          <td class="py-4 px-4 text-rose-300">
            Uploaded To Third-Party Cloud
          </td>
        </tr>

        <!-- Metric 6: Easy Setup -->
        <tr class="hover:bg-slate-800/50 transition-colors">
          <th scope="row" class="py-4 px-4 font-semibold text-slate-100 font-sans text-left">
            Installation &amp; Setup
            <span class="block text-xs font-mono text-slate-300 font-normal">How easy is it to use?</span>
          </th>
          <td class="py-4 px-4 font-bold text-cyan-300 bg-cyan-950/40 border-x border-cyan-700/50">
            Single 9.7MB App (Portable)
          </td>
          <td class="py-4 px-4 text-slate-200">
            Requires Extra DLLs &amp; Drivers
          </td>
          <td class="py-4 px-4 text-slate-300">
            Needs Complex Python Packages
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
