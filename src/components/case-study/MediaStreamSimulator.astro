---
// YT-Stream: High-Concurrency Media Ingestion & Multi-ISP Caching Engine Simulator
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl p-6 sm:p-8 space-y-8 shadow-2xl">
  <!-- Simulator Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-red-400 font-mono text-xs uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-red-400 animate-pulse"></span>
        Interactive Media Pipeline &amp; Stream Caching Sandbox
      </div>
      <h2 class="text-2xl sm:text-3xl font-mono font-bold text-white flex items-center gap-3">
        YT-Stream: Concurrency &amp; Transcode Simulator
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 font-sans mt-1">
        Experience 16-socket segmented TCP acceleration, SponsorBlock algorithmic cutting, and multi-ISP gateway routing.
      </p>
    </div>

    <!-- Active Perspective Switcher -->
    <div class="flex items-center p-1 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono overflow-x-auto">
      <button
        type="button"
        id="media-tab-tcp"
        class="media-tab-btn px-3.5 py-1.5 rounded-lg bg-red-500/20 text-red-300 border border-red-500/40 font-semibold transition-all shadow-sm"
        data-view="tcp"
      >
        ⚡ 16-Socket TCP Accelerator
      </button>
      <button
        type="button"
        id="media-tab-sponsor"
        class="media-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="sponsor"
      >
        ✂️ SponsorBlock Stripper
      </button>
      <button
        type="button"
        id="media-tab-isp"
        class="media-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="isp"
      >
        🌐 Multi-ISP &amp; Plex Sync
      </button>
    </div>
  </div>

  <!-- View 1: 16-Socket Segmented TCP Acceleration (Default) -->
  <div id="media-screen-tcp" class="media-screen space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Ingestion Parameters & Controls -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-red-400"></span>
              Downloader Ingress Mode
            </span>
            <span id="tcp-mode-badge" class="px-2 py-0.5 rounded-md bg-red-500/20 text-red-300 border border-red-500/30 text-[10px]">
              aria2c 16-Socket Multi-Stream
            </span>
          </div>

          <!-- Mode Toggle -->
          <div class="space-y-2">
            <label class="text-slate-400 text-[11px] uppercase tracking-wider">Select Download Engine Architecture</label>
            <div class="grid grid-cols-2 gap-2">
              <button
                type="button"
                id="btn-mode-aria2c"
                class="p-2.5 rounded-xl border border-red-500/50 bg-red-500/10 text-red-300 font-bold text-left transition-all hover:bg-red-500/20"
              >
                <div class="text-xs">⚡ aria2c (16 Conns)</div>
                <div class="text-[10px] text-red-200/70 font-normal">Multi-Segment TCP</div>
              </button>
              <button
                type="button"
                id="btn-mode-single"
                class="p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-400 font-bold text-left transition-all hover:border-slate-700 hover:text-slate-200"
              >
                <div class="text-xs">🐢 Standard Browser</div>
                <div class="text-[10px] text-slate-500 font-normal">Single Throttled Stream</div>
              </button>
            </div>
          </div>

          <!-- Video Payload Selector -->
          <div class="space-y-2">
            <label class="text-slate-400 text-[11px] uppercase tracking-wider">Test Media Target</label>
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
              <div class="text-white font-bold truncate">Distributed Systems &amp; Raft Consensus (4K 60FPS)</div>
              <div class="flex justify-between text-slate-400 text-[10px]">
                <span>Duration: 42m 15s</span>
                <span>Container: MP4 / H.265 (1.42 GB)</span>
              </div>
            </div>
          </div>

          <!-- Trigger Controls -->
          <div class="flex gap-2">
            <button
              type="button"
              id="btn-start-download"
              class="flex-1 py-2.5 px-4 rounded-xl bg-red-500 hover:bg-red-400 text-white font-bold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg active:scale-95"
            >
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span>Start Ingestion Pass</span>
            </button>
            <button
              type="button"
              id="btn-reset-download"
              class="py-2.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 text-xs transition-all cursor-pointer"
              title="Reset Simulator"
            >
              ↺
            </button>
          </div>

          <!-- Performance Telemetry -->
          <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-800">
            <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800">
              <div class="text-[10px] text-slate-400">TRANSFER SPEED</div>
              <div id="stat-download-speed" class="text-sm font-bold text-emerald-400 mt-0.5">28.4 MB/s</div>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800">
              <div class="text-[10px] text-slate-400">ESTIMATED TIME (ETA)</div>
              <div id="stat-download-eta" class="text-sm font-bold text-cyan-300 mt-0.5">00:50s</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Live Multi-Socket Segment Visualizer -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              Segmented Sockets (<span id="socket-count-label">16 Active TCP Sockets</span>)
            </span>
            <span id="socket-overall-percent" class="text-red-400 font-bold">0% Complete</span>
          </div>

          <!-- Main Aggregate Progress Bar -->
          <div class="space-y-1.5">
            <div class="flex justify-between text-[11px] text-slate-400">
              <span>Overall Chunk Ingestion Progress:</span>
              <span id="socket-downloaded-bytes" class="text-white font-bold">0 MB / 1,420 MB</span>
            </div>
            <div class="w-full h-3 rounded-full bg-slate-900 border border-slate-800 overflow-hidden">
              <div id="bar-overall-progress" class="h-full bg-gradient-to-r from-red-500 via-amber-400 to-emerald-400 transition-all duration-200" style="width: 0%"></div>
            </div>
          </div>

          <!-- 16 Chunk Sockets Grid -->
          <div class="space-y-2">
            <div class="text-[10px] text-slate-500 uppercase font-bold">Concurrent Byte Range Slices:</div>
            <div class="grid grid-cols-4 sm:grid-cols-8 gap-2" id="socket-grid">
              <!-- Sockets 1-16 generated dynamically in JS -->
            </div>
          </div>

          <!-- Live Terminal Output -->
          <div class="p-3 rounded-xl bg-black border border-slate-800 font-mono text-[11px] space-y-1">
            <div class="text-slate-500 text-[9px] flex items-center justify-between border-b border-slate-900 pb-1">
              <span>yt-dlp + aria2c INGESTION STDOUT</span>
              <span class="text-red-400">PID 8941</span>
            </div>
            <div id="tcp-terminal-stdout" class="text-slate-300 h-24 overflow-y-auto space-y-0.5 leading-snug pt-1">
              <div class="text-emerald-400">[yt-dlp] Ingesting playlist format 313+140 (4K 60FPS)...</div>
              <div class="text-cyan-400">[aria2c] Spawned 16 segmented TCP sockets (-x 16 -s 16 -k 1M).</div>
              <div class="text-slate-400">[READY] Waiting for user to trigger ingestion pass.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 2: SponsorBlock Algorithmic Stripper & Timeline Preview -->
  <div id="media-screen-sponsor" class="media-screen hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- SponsorBlock Rules & Filter Controls -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-red-400"></span>
              SponsorBlock Filter Engine
            </span>
            <span class="text-[10px] text-purple-300 font-mono">v2.0 Community Hash API</span>
          </div>

          <!-- Filter Category Toggles -->
          <div class="space-y-2">
            <label class="text-slate-400 text-[11px] uppercase tracking-wider">Automated Cut Categories</label>
            <div class="space-y-2">
              <label class="flex items-center justify-between p-2.5 rounded-xl bg-slate-900 border border-slate-800 cursor-pointer">
                <span class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                  <span class="text-white font-medium">Sponsor Adverts &amp; Product Placements</span>
                </span>
                <input type="checkbox" id="chk-sponsor" checked class="accent-rose-500" />
              </label>
              <label class="flex items-center justify-between p-2.5 rounded-xl bg-slate-900 border border-slate-800 cursor-pointer">
                <span class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
                  <span class="text-white font-medium">Channel Intros &amp; Intermission Cards</span>
                </span>
                <input type="checkbox" id="chk-intro" checked class="accent-purple-500" />
              </label>
              <label class="flex items-center justify-between p-2.5 rounded-xl bg-slate-900 border border-slate-800 cursor-pointer">
                <span class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                  <span class="text-white font-medium">Like &amp; Subscribe Interaction Begs</span>
                </span>
                <input type="checkbox" id="chk-interaction" checked class="accent-amber-500" />
              </label>
              <label class="flex items-center justify-between p-2.5 rounded-xl bg-slate-900 border border-slate-800 cursor-pointer">
                <span class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                  <span class="text-white font-medium">End Credits &amp; Outro Recaps</span>
                </span>
                <input type="checkbox" id="chk-outro" checked class="accent-blue-500" />
              </label>
            </div>
          </div>

          <!-- Video Timeline Scrubber Input -->
          <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 space-y-2">
            <div class="flex items-center justify-between text-slate-300">
              <span class="font-bold">Virtual Player Position:</span>
              <span id="player-time-display" class="font-mono text-cyan-300 font-bold">04:15 / 24:30</span>
            </div>
            <input
              type="range"
              id="player-time-slider"
              min="0"
              max="1470"
              value="255"
              step="5"
              class="w-full accent-cyan-400 cursor-pointer"
            />
            <div id="player-segment-status" class="text-[11px] p-2 rounded bg-slate-950 border border-slate-800 text-rose-300 font-mono">
              ⚠️ In Sponsor Segment (03:15 - 04:45) • Will be skipped!
            </div>
          </div>

          <!-- Time Saved Stat -->
          <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 space-y-1">
            <div class="flex items-center justify-between font-bold text-xs">
              <span>TIME SAVED VIA STRIPPING</span>
              <span id="sponsor-time-saved" class="text-emerald-400">03m 15s (13.2%)</span>
            </div>
            <p class="text-[11px] text-emerald-200/90 font-sans">
              FFmpeg cuts video directly on Keyframe boundaries with zero transcoding quality degradation.
            </p>
          </div>
        </div>
      </div>

      <!-- Visual Timeline Preview -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              24-Minute Lecture Timeline Heatmap
            </span>
            <span class="text-slate-500 text-[10px]">Segment-Accurate Cut List</span>
          </div>

          <!-- Timeline Strip -->
          <div class="space-y-2">
            <div class="relative w-full h-8 rounded-xl bg-slate-900 border border-slate-800 overflow-hidden flex">
              <!-- 00:00 - 00:30 Intro (Purple) -->
              <div class="h-full bg-purple-500/80 hover:opacity-90 transition-opacity" style="width: 2%" title="Intro: 00:00 - 00:30"></div>
              <!-- 00:30 - 03:15 Content (Emerald) -->
              <div class="h-full bg-emerald-600/70 hover:opacity-90 transition-opacity" style="width: 11%" title="Content: 00:30 - 03:15"></div>
              <!-- 03:15 - 04:45 Sponsor Plug (Rose) -->
              <div class="h-full bg-rose-500/90 animate-pulse hover:opacity-90 transition-opacity" style="width: 6%" title="Sponsor Ad: 03:15 - 04:45"></div>
              <!-- 04:45 - 12:20 Content (Emerald) -->
              <div class="h-full bg-emerald-600/70 hover:opacity-90 transition-opacity" style="width: 31%" title="Content: 04:45 - 12:20"></div>
              <!-- 12:20 - 13:00 Interaction Beg (Amber) -->
              <div class="h-full bg-amber-500/90 hover:opacity-90 transition-opacity" style="width: 3%" title="Interaction: 12:20 - 13:00"></div>
              <!-- 13:00 - 23:30 Content (Emerald) -->
              <div class="h-full bg-emerald-600/70 hover:opacity-90 transition-opacity" style="width: 43%" title="Content: 13:00 - 23:30"></div>
              <!-- 23:30 - 24:30 Outro (Blue) -->
              <div class="h-full bg-blue-500/80 hover:opacity-90 transition-opacity" style="width: 4%" title="Outro: 23:30 - 24:30"></div>
            </div>

            <!-- Timeline Legend -->
            <div class="flex items-center justify-between text-[10px] text-slate-400 flex-wrap gap-2 pt-1">
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Clean Content</span>
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-rose-500"></span> Sponsor (Cut)</span>
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-purple-500"></span> Intro (Cut)</span>
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Beg (Cut)</span>
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-blue-500"></span> Outro (Cut)</span>
            </div>
          </div>

          <!-- Cut Action List -->
          <div class="space-y-2">
            <div class="text-[10px] text-slate-400 font-bold uppercase">Identified Segment Metadata:</div>
            <div class="space-y-1.5 text-[11px]" id="sponsor-cut-items">
              <div class="p-2 rounded-lg bg-slate-900 border border-slate-800 flex justify-between items-center">
                <span class="text-rose-300 font-bold">03:15 – 04:45 (01m 30s)</span>
                <span class="text-slate-400">VPN / Cloud Hosting Sponsor Plug</span>
                <span class="px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 font-semibold text-[10px]">STRIPPED</span>
              </div>
              <div class="p-2 rounded-lg bg-slate-900 border border-slate-800 flex justify-between items-center">
                <span class="text-purple-300 font-bold">00:00 – 00:30 (00m 30s)</span>
                <span class="text-slate-400">Patreon Backer Splash Screen</span>
                <span class="px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 font-semibold text-[10px]">STRIPPED</span>
              </div>
              <div class="p-2 rounded-lg bg-slate-900 border border-slate-800 flex justify-between items-center">
                <span class="text-amber-300 font-bold">12:20 – 13:00 (00m 40s)</span>
                <span class="text-slate-400">Like, Subscribe &amp; Bell Notification Beg</span>
                <span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 font-semibold text-[10px]">STRIPPED</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 3: Multi-ISP Gateway Router & Jellyfin / Plex Webhook Sync -->
  <div id="media-screen-isp" class="media-screen hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Network Gateway Selector -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-red-400"></span>
              Multi-ISP Network Uplink
            </span>
            <span id="isp-active-badge" class="px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[10px]">
              BDIX Local Peering
            </span>
          </div>

          <!-- ISP Gateway Switcher -->
          <div class="space-y-2">
            <label class="text-slate-400 text-[11px] uppercase tracking-wider">Select Active Gateway Route</label>
            <div class="grid grid-cols-2 gap-2">
              <button
                type="button"
                id="btn-isp-bdix"
                class="p-2.5 rounded-xl border border-emerald-500/50 bg-emerald-500/10 text-emerald-300 font-bold text-left transition-all hover:bg-emerald-500/20"
              >
                <div class="text-xs">🇧🇩 BDIX Peering</div>
                <div class="text-[10px] text-emerald-200/70 font-normal">Unmetered 100 Mbps</div>
              </button>
              <button
                type="button"
                id="btn-isp-starlink"
                class="p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-400 font-bold text-left transition-all hover:border-slate-700 hover:text-slate-200"
              >
                <div class="text-xs">🛰️ Starlink Satellite</div>
                <div class="text-[10px] text-slate-500 font-normal">Global Failover Route</div>
              </button>
            </div>
          </div>

          <!-- Route Characteristics -->
          <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 space-y-2 font-mono text-[11px]">
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">Gateway Latency:</span>
              <span id="isp-stat-latency" class="text-emerald-400 font-bold">&lt; 4ms (Local Peering)</span>
            </div>
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">Bandwidth Cost Factor:</span>
              <span id="isp-stat-cost" class="text-cyan-300 font-bold">$0.00 / GB (Unmetered)</span>
            </div>
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">Traffic Routing Script:</span>
              <span id="isp-stat-script" class="text-amber-400 font-bold">use-local-isp.sh</span>
            </div>
          </div>

          <!-- Webhook Dispatcher -->
          <div class="space-y-2 pt-2 border-t border-slate-800">
            <label class="text-slate-400 text-[11px] uppercase tracking-wider">Home Theater Automated Sync</label>
            <button
              type="button"
              id="btn-trigger-webhook"
              class="w-full py-2.5 px-4 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg active:scale-95"
            >
              <span>Trigger Jellyfin &amp; Plex Webhook</span>
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Media Server Sync & JSON Telemetry -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              Jellyfin / Plex Home Theater Status
            </span>
            <span id="webhook-sync-status" class="text-slate-500 text-[10px]">Awaiting Download Completion</span>
          </div>

          <!-- Connected Servers Status Cards -->
          <div class="grid grid-cols-2 gap-3">
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-bold text-white text-xs">Jellyfin Server</span>
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              </div>
              <div class="text-[10px] text-slate-400">192.168.1.120:8096</div>
              <div class="text-[9px] text-cyan-300">Auto-Scrape: NFO + VTT Subtitles</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-bold text-white text-xs">Plex Media Server</span>
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              </div>
              <div class="text-[10px] text-slate-400">192.168.1.120:32400</div>
              <div class="text-[9px] text-amber-300">H.265 Direct Play Ready</div>
            </div>
          </div>

          <!-- Live Webhook JSON Payload -->
          <div class="p-3 rounded-xl bg-black border border-slate-800 font-mono text-[11px] space-y-2">
            <div class="text-slate-500 text-[9px] uppercase border-b border-slate-900 pb-1 flex justify-between">
              <span>POST /library/refresh Webhook Dispatch</span>
              <span id="webhook-http-code" class="text-emerald-400">HTTP 200 OK</span>
            </div>
            <pre id="webhook-json-payload" class="text-slate-300 font-mono text-[11px] overflow-x-auto leading-relaxed">
&#123;
  "event": "library.refresh",
  "media_title": "Distributed Systems & Raft Consensus",
  "transcode": "H.265 / HEVC",
  "sponsor_cuts_applied": 4,
  "subtitles": ["en", "bn"],
  "nfo_metadata": "generated",
  "storage_path": "/var/media/lectures/raft_consensus.mp4"
&#125;</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Tab Switching Logic
  const tabTcp = document.getElementById('media-tab-tcp');
  const tabSponsor = document.getElementById('media-tab-sponsor');
  const tabIsp = document.getElementById('media-tab-isp');

  const screenTcp = document.getElementById('media-screen-tcp');
  const screenSponsor = document.getElementById('media-screen-sponsor');
  const screenIsp = document.getElementById('media-screen-isp');

  function setMediaTab(view: 'tcp' | 'sponsor' | 'isp') {
    [tabTcp, tabSponsor, tabIsp].forEach(btn => {
      btn?.classList.remove('bg-red-500/20', 'text-red-300', 'border-red-500/40');
      btn?.classList.add('text-slate-400');
    });
    [screenTcp, screenSponsor, screenIsp].forEach(screen => screen?.classList.add('hidden'));

    if (view === 'tcp') {
      tabTcp?.classList.add('bg-red-500/20', 'text-red-300', 'border-red-500/40');
      tabTcp?.classList.remove('text-slate-400');
      screenTcp?.classList.remove('hidden');
    } else if (view === 'sponsor') {
      tabSponsor?.classList.add('bg-red-500/20', 'text-red-300', 'border-red-500/40');
      tabSponsor?.classList.remove('text-slate-400');
      screenSponsor?.classList.remove('hidden');
    } else if (view === 'isp') {
      tabIsp?.classList.add('bg-red-500/20', 'text-red-300', 'border-red-500/40');
      tabIsp?.classList.remove('text-slate-400');
      screenIsp?.classList.remove('hidden');
    }
  }

  tabTcp?.addEventListener('click', () => setMediaTab('tcp'));
  tabSponsor?.addEventListener('click', () => setMediaTab('sponsor'));
  tabIsp?.addEventListener('click', () => setMediaTab('isp'));

  // ==========================================
  // VIEW 1: 16-SOCKET TCP ACCELERATION
  // ==========================================
  const socketGrid = document.getElementById('socket-grid');
  const socketCount = 16;
  let isAria2c = true;
  let isDownloading = false;
  let downloadInterval: number | null = null;
  let currentProgress = 0;

  // Initialize Socket UI elements
  if (socketGrid) {
    socketGrid.innerHTML = '';
    for (let i = 0; i < socketCount; i++) {
      const socketEl = document.createElement('div');
      socketEl.id = `socket-${i}`;
      socketEl.className = 'p-2 rounded-lg bg-slate-900 border border-slate-800 text-center space-y-1 transition-all';
      socketEl.innerHTML = `
        <div class="text-[9px] text-slate-400 font-bold">#${i + 1}</div>
        <div class="socket-bar w-full h-1.5 rounded-full bg-slate-950 overflow-hidden">
          <div class="socket-fill h-full bg-red-500 transition-all" style="width: 0%"></div>
        </div>
        <div class="socket-val text-[8px] font-mono text-slate-500">IDLE</div>
      `;
      socketGrid.appendChild(socketEl);
    }
  }

  const btnModeAria = document.getElementById('btn-mode-aria2c');
  const btnModeSingle = document.getElementById('btn-mode-single');
  const tcpModeBadge = document.getElementById('tcp-mode-badge');
  const socketCountLabel = document.getElementById('socket-count-label');
  const statDownloadSpeed = document.getElementById('stat-download-speed');
  const statDownloadEta = document.getElementById('stat-download-eta');
  const btnStartDownload = document.getElementById('btn-start-download');
  const btnResetDownload = document.getElementById('btn-reset-download');
  const barOverallProgress = document.getElementById('bar-overall-progress');
  const socketOverallPercent = document.getElementById('socket-overall-percent');
  const socketDownloadedBytes = document.getElementById('socket-downloaded-bytes');
  const tcpTerminalStdout = document.getElementById('tcp-terminal-stdout');

  function setTcpMode(aria: boolean) {
    isAria2c = aria;
    resetDownloadPass();

    if (aria) {
      btnModeAria?.classList.add('border-red-500/50', 'bg-red-500/10', 'text-red-300');
      btnModeAria?.classList.remove('border-slate-800', 'bg-slate-900', 'text-slate-400');
      btnModeSingle?.classList.remove('border-red-500/50', 'bg-red-500/10', 'text-red-300');
      btnModeSingle?.classList.add('border-slate-800', 'bg-slate-900', 'text-slate-400');

      if (tcpModeBadge) {
        tcpModeBadge.className = 'px-2 py-0.5 rounded-md bg-red-500/20 text-red-300 border border-red-500/30 text-[10px]';
        tcpModeBadge.textContent = 'aria2c 16-Socket Multi-Stream';
      }
      if (socketCountLabel) socketCountLabel.textContent = '16 Active TCP Sockets';
      if (statDownloadSpeed) statDownloadSpeed.textContent = '28.4 MB/s';
      if (statDownloadEta) statDownloadEta.textContent = '00:50s';
    } else {
      btnModeSingle?.classList.add('border-red-500/50', 'bg-red-500/10', 'text-red-300');
      btnModeSingle?.classList.remove('border-slate-800', 'bg-slate-900', 'text-slate-400');
      btnModeAria?.classList.remove('border-red-500/50', 'bg-red-500/10', 'text-red-300');
      btnModeAria?.classList.add('border-slate-800', 'bg-slate-900', 'text-slate-400');

      if (tcpModeBadge) {
        tcpModeBadge.className = 'px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 border border-slate-700 text-[10px]';
        tcpModeBadge.textContent = 'Standard Browser (1 Socket)';
      }
      if (socketCountLabel) socketCountLabel.textContent = '1 Socket (15 Sockets Dormant)';
      if (statDownloadSpeed) statDownloadSpeed.textContent = '1.8 MB/s (Throttled)';
      if (statDownloadEta) statDownloadEta.textContent = '13m 08s';
    }
  }

  btnModeAria?.addEventListener('click', () => setTcpMode(true));
  btnModeSingle?.addEventListener('click', () => setTcpMode(false));

  function resetDownloadPass() {
    if (downloadInterval) clearInterval(downloadInterval);
    isDownloading = false;
    currentProgress = 0;

    if (barOverallProgress) barOverallProgress.style.width = '0%';
    if (socketOverallPercent) socketOverallPercent.textContent = '0% Complete';
    if (socketDownloadedBytes) socketDownloadedBytes.textContent = '0 MB / 1,420 MB';

    for (let i = 0; i < socketCount; i++) {
      const socketEl = document.getElementById(`socket-${i}`);
      const fillEl = socketEl?.querySelector('.socket-fill') as HTMLElement | null;
      const valEl = socketEl?.querySelector('.socket-val');
      if (fillEl) fillEl.style.width = '0%';
      if (valEl) valEl.textContent = 'IDLE';
      if (socketEl) socketEl.className = 'p-2 rounded-lg bg-slate-900 border border-slate-800 text-center space-y-1 transition-all';
    }
  }

  btnResetDownload?.addEventListener('click', resetDownloadPass);

  btnStartDownload?.addEventListener('click', () => {
    if (isDownloading) return;
    isDownloading = true;

    if (tcpTerminalStdout) {
      tcpTerminalStdout.innerHTML = `
        <div class="text-cyan-400">[INSPECTION] Ingress started. Mode: ${isAria2c ? 'aria2c 16-Socket' : 'Single Stream'}.</div>
        <div class="text-emerald-400">[CONNECT] Negotiated range byte slices across fiber uplink.</div>
      `;
    }

    const stepSpeed = isAria2c ? 2.5 : 0.4;

    downloadInterval = window.setInterval(() => {
      currentProgress += stepSpeed + (Math.random() * 0.5);
      if (currentProgress >= 100) {
        currentProgress = 100;
        clearInterval(downloadInterval!);
        isDownloading = false;

        if (tcpTerminalStdout) {
          tcpTerminalStdout.innerHTML += `
            <div class="text-emerald-400 font-bold">[COMPLETE] 1,420 MB ingested in ${isAria2c ? '50s' : '13m'}. Chunk SHA-256 verified!</div>
          `;
          tcpTerminalStdout.scrollTop = tcpTerminalStdout.scrollHeight;
        }
      }

      if (barOverallProgress) barOverallProgress.style.width = `${currentProgress}%`;
      if (socketOverallPercent) socketOverallPercent.textContent = `${Math.floor(currentProgress)}% Complete`;
      if (socketDownloadedBytes) {
        const mb = Math.floor((currentProgress / 100) * 1420);
        socketDownloadedBytes.textContent = `${mb} MB / 1,420 MB`;
      }

      // Update Individual Socket Animation
      const activeSockets = isAria2c ? 16 : 1;
      for (let i = 0; i < socketCount; i++) {
        const socketEl = document.getElementById(`socket-${i}`);
        const fillEl = socketEl?.querySelector('.socket-fill') as HTMLElement | null;
        const valEl = socketEl?.querySelector('.socket-val');

        if (i < activeSockets) {
          const jitter = Math.sin(Date.now() / 200 + i) * 8;
          const socketPct = Math.min(100, Math.max(0, currentProgress + jitter));
          if (fillEl) fillEl.style.width = `${socketPct}%`;
          if (valEl) valEl.textContent = `${Math.floor(socketPct)}%`;
          if (socketEl) socketEl.className = 'p-2 rounded-lg bg-red-950/20 border border-red-500/40 text-center space-y-1 transition-all';
        } else {
          if (fillEl) fillEl.style.width = '0%';
          if (valEl) valEl.textContent = 'OFF';
          if (socketEl) socketEl.className = 'p-2 rounded-lg bg-slate-950 border border-slate-900 text-center space-y-1 opacity-40';
        }
      }
    }, 150);
  });

  // ==========================================
  // VIEW 2: SPONSORBLOCK STRIPPER
  // ==========================================
  const slider = document.getElementById('player-time-slider') as HTMLInputElement | null;
  const timeDisplay = document.getElementById('player-time-display');
  const segmentStatus = document.getElementById('player-segment-status');

  function updateScrubber() {
    if (!slider) return;
    const val = parseInt(slider.value, 10);
    const mins = Math.floor(val / 60);
    const secs = val % 60;
    const timeStr = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;

    if (timeDisplay) timeDisplay.textContent = `${timeStr} / 24:30`;

    // Categorize segment
    if (val <= 30) {
      if (segmentStatus) {
        segmentStatus.className = 'text-[11px] p-2 rounded bg-purple-950/30 border border-purple-500/40 text-purple-300 font-mono';
        segmentStatus.textContent = '🟣 In Intro Segment (00:00 - 00:30) • Automatically skipped.';
      }
    } else if (val >= 195 && val <= 285) {
      if (segmentStatus) {
        segmentStatus.className = 'text-[11px] p-2 rounded bg-rose-950/30 border border-rose-500/40 text-rose-300 font-mono';
        segmentStatus.textContent = '⚠️ In Sponsor Plug (03:15 - 04:45) • 90 seconds stripped by FFmpeg cut.';
      }
    } else if (val >= 740 && val <= 780) {
      if (segmentStatus) {
        segmentStatus.className = 'text-[11px] p-2 rounded bg-amber-950/30 border border-amber-500/40 text-amber-300 font-mono';
        segmentStatus.textContent = '🔔 In Interaction Reminder (12:20 - 13:00) • Automatically skipped.';
      }
    } else if (val >= 1410) {
      if (segmentStatus) {
        segmentStatus.className = 'text-[11px] p-2 rounded bg-blue-950/30 border border-blue-500/40 text-blue-300 font-mono';
        segmentStatus.textContent = '🔵 In Outro Segment (23:30 - 24:30) • Automatically stripped.';
      }
    } else {
      if (segmentStatus) {
        segmentStatus.className = 'text-[11px] p-2 rounded bg-emerald-950/30 border border-emerald-500/40 text-emerald-300 font-mono';
        segmentStatus.textContent = '🟢 In Pure Lecture Content • Pristine H.265 audio/video stream.';
      }
    }
  }

  slider?.addEventListener('input', updateScrubber);

  // ==========================================
  // VIEW 3: MULTI-ISP & PLEX SYNC
  // ==========================================
  const btnIspBdix = document.getElementById('btn-isp-bdix');
  const btnIspStarlink = document.getElementById('btn-isp-starlink');
  const ispActiveBadge = document.getElementById('isp-active-badge');
  const ispStatLatency = document.getElementById('isp-stat-latency');
  const ispStatCost = document.getElementById('isp-stat-cost');
  const ispStatScript = document.getElementById('isp-stat-script');
  const btnTriggerWebhook = document.getElementById('btn-trigger-webhook');
  const webhookSyncStatus = document.getElementById('webhook-sync-status');
  const webhookHttpCode = document.getElementById('webhook-http-code');

  btnIspBdix?.addEventListener('click', () => {
    btnIspBdix?.classList.add('border-emerald-500/50', 'bg-emerald-500/10', 'text-emerald-300');
    btnIspBdix?.classList.remove('border-slate-800', 'bg-slate-900', 'text-slate-400');
    btnIspStarlink?.classList.remove('border-emerald-500/50', 'bg-emerald-500/10', 'text-emerald-300');
    btnIspStarlink?.classList.add('border-slate-800', 'bg-slate-900', 'text-slate-400');

    if (ispActiveBadge) {
      ispActiveBadge.className = 'px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[10px]';
      ispActiveBadge.textContent = 'BDIX Local Peering';
    }
    if (ispStatLatency) ispStatLatency.textContent = '< 4ms (Local Peering)';
    if (ispStatCost) ispStatCost.textContent = '$0.00 / GB (Unmetered)';
    if (ispStatScript) ispStatScript.textContent = 'use-local-isp.sh';
  });

  btnIspStarlink?.addEventListener('click', () => {
    btnIspStarlink?.classList.add('border-cyan-500/50', 'bg-cyan-500/10', 'text-cyan-300');
    btnIspStarlink?.classList.remove('border-slate-800', 'bg-slate-900', 'text-slate-400');
    btnIspBdix?.classList.remove('border-emerald-500/50', 'bg-emerald-500/10', 'text-emerald-300');
    btnIspBdix?.classList.add('border-slate-800', 'bg-slate-900', 'text-slate-400');

    if (ispActiveBadge) {
      ispActiveBadge.className = 'px-2 py-0.5 rounded-md bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-[10px]';
      ispActiveBadge.textContent = 'Starlink Satellite Gateway';
    }
    if (ispStatLatency) ispStatLatency.textContent = '28 - 34ms (Low Earth Orbit)';
    if (ispStatCost) ispStatCost.textContent = 'Priority Satellite Bandwidth';
    if (ispStatScript) ispStatScript.textContent = 'use-starlink.sh';
  });

  btnTriggerWebhook?.addEventListener('click', () => {
    if (webhookSyncStatus) {
      webhookSyncStatus.className = 'text-emerald-400 font-bold text-[10px] animate-pulse';
      webhookSyncStatus.textContent = 'Library Refresh Synced (Jellyfin + Plex)';
    }
    if (webhookHttpCode) {
      webhookHttpCode.textContent = 'HTTP 200 OK (24ms)';
    }
    setTimeout(() => {
      if (webhookSyncStatus) {
        webhookSyncStatus.className = 'text-emerald-400 font-bold text-[10px]';
        webhookSyncStatus.textContent = 'Ready (Direct Play Available on Apple TV & Android TV)';
      }
    }, 1500);
  });
</script>
