---
// Email Verifier Service: High-Throughput Direct Port 25 SMTP & Mailbox Deliverability Sandbox
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl p-6 sm:p-8 space-y-8 shadow-2xl">
  <!-- Simulator Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-cyan-400 font-mono text-xs uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
        Interactive SMTP Protocol &amp; Mailbox Deliverability Engine
      </div>
      <h2 class="text-2xl sm:text-3xl font-mono font-bold text-white flex items-center gap-3">
        Email Verifier Service Simulator
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 font-sans mt-1">
        Inspect 5-stage verification: RFC 5322 syntax validation, disposable hash lookup, DNS MX IPv4 resolution, direct Port 25 SMTP handshake, and UUID catch-all probing.
      </p>
    </div>

    <!-- Active Perspective Switcher -->
    <div class="flex items-center p-1 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono overflow-x-auto">
      <button
        type="button"
        id="ev-tab-single"
        class="ev-tab-btn px-3.5 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-semibold transition-all shadow-sm"
        data-view="single"
      >
        ⚡ Live SMTP Handshake
      </button>
      <button
        type="button"
        id="ev-tab-batch"
        class="ev-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="batch"
      >
        📊 Batch &amp; Anti-Burst Pacing
      </button>
      <button
        type="button"
        id="ev-tab-dns"
        class="ev-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="dns"
      >
        🛡️ SPF &amp; Reverse DNS (PTR)
      </button>
    </div>
  </div>

  <!-- View 1: Single Verification Sandbox (Default) -->
  <div id="ev-screen-single" class="ev-screen space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Input Form & Scenarios -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              Verification Target
            </span>
            <span class="text-[10px] text-slate-400 font-mono">verifier.py:28</span>
          </div>

          <!-- Email Input -->
          <div class="space-y-1.5">
            <label class="text-[11px] text-slate-300 font-sans font-semibold">Recipient Email Address:</label>
            <div class="relative">
              <input
                type="text"
                id="ev-input-email"
                value="alex.smith@enterprise-corp.com"
                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white font-mono text-xs focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all"
                placeholder="name@company.com"
              />
              <span class="absolute right-3 top-2.5 text-slate-500 text-[10px]">Port 25</span>
            </div>
          </div>

          <!-- Presets -->
          <div class="space-y-1.5">
            <label class="text-[11px] text-slate-300 font-sans font-semibold">Test Lead Scenarios:</label>
            <div class="grid grid-cols-1 gap-2">
              <button
                type="button"
                class="ev-preset-btn text-left p-2.5 rounded-xl border border-cyan-500/50 bg-cyan-950/30 text-white hover:border-cyan-400 transition-all text-xs"
                data-email="alex.smith@enterprise-corp.com"
                data-type="valid"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>Corporate Mailbox (Valid)</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono">250 OK</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">alex.smith@enterprise-corp.com • Active primary inbox</div>
              </button>

              <button
                type="button"
                class="ev-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-email="fake.lead8839@gmail.com"
                data-type="nonexistent"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>Non-Existent Mailbox (550)</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 font-mono">550 USER UNKNOWN</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">fake.lead8839@gmail.com • Deactivated or invalid user</div>
              </button>

              <button
                type="button"
                class="ev-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-email="burner921@10minutemail.com"
                data-type="disposable"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>Burner / Disposable Domain</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-mono">STAGE 2 DROP</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">burner921@10minutemail.com • Temporary disposable hash match</div>
              </button>

              <button
                type="button"
                class="ev-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-email="contact@catchall-cloud.io"
                data-type="catchall"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>Catch-All Domain (Risky)</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 font-mono">RANDOM UUID PASS</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">contact@catchall-cloud.io • Accepts all incoming addresses</div>
              </button>

              <button
                type="button"
                class="ev-preset-btn text-left p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700 transition-all text-xs"
                data-email="lead@greylist-exchange.net"
                data-type="greylist"
              >
                <div class="font-bold flex items-center justify-between">
                  <span>Greylisted / Rate-Limited (421)</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-orange-500/20 text-orange-300 font-mono">421 TEMP FAIL</span>
                </div>
                <div class="text-[11px] text-slate-400 font-sans mt-0.5">lead@greylist-exchange.net • Enforces 15m retry window</div>
              </button>
            </div>
          </div>

          <!-- Execution Controls -->
          <div class="pt-2 border-t border-slate-800 space-y-2">
            <div class="flex items-center justify-between">
              <label class="flex items-center gap-2 cursor-pointer text-slate-300 text-xs">
                <input type="checkbox" id="ev-opt-smtp" checked class="rounded bg-slate-900 border-slate-700 text-cyan-500 focus:ring-0" />
                <span>Perform Port 25 SMTP Check</span>
              </label>
              <span class="text-[10px] text-cyan-400 font-mono">RFC 5321</span>
            </div>
            <div class="flex items-center justify-between">
              <label class="flex items-center gap-2 cursor-pointer text-slate-300 text-xs">
                <input type="checkbox" id="ev-opt-cache" class="rounded bg-slate-900 border-slate-700 text-cyan-500 focus:ring-0" />
                <span>Simulate In-Memory TTL Cache Hit (&lt;2ms)</span>
              </label>
              <span class="text-[10px] text-emerald-400 font-mono">24h TTL</span>
            </div>
          </div>

          <button
            type="button"
            id="ev-btn-verify"
            class="w-full py-2.5 px-4 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold font-mono text-xs flex items-center justify-center gap-2 transition-all shadow-lg shadow-cyan-500/20"
          >
            <span>Execute Verification Pipeline</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Right Column: Verification Results & Socket Pipeline -->
      <div class="lg:col-span-7 space-y-4">
        <!-- Verdict Card -->
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Verification Assessment Verdict
            </span>
            <span id="ev-latency-badge" class="px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 text-[10px]">
              ⏱️ Latency: 1,180ms
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
              <div class="text-[10px] text-slate-400">DELIVERABILITY</div>
              <div id="ev-verdict-title" class="text-sm font-bold text-emerald-300">DELIVERABLE</div>
              <div id="ev-verdict-subtitle" class="text-[10px] text-slate-400 font-sans">Mailbox accepts messages</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
              <div class="text-[10px] text-slate-400">SMTP STATUS</div>
              <div id="ev-verdict-code" class="text-sm font-bold text-cyan-300">250 OK</div>
              <div id="ev-verdict-codemsg" class="text-[10px] text-slate-400 font-sans">Primary MX acknowledged</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
              <div class="text-[10px] text-slate-400">CATCH-ALL DOMAIN</div>
              <div id="ev-verdict-catchall" class="text-sm font-bold text-slate-300">FALSE (Deterministic)</div>
              <div id="ev-verdict-catchallmsg" class="text-[10px] text-slate-400 font-sans">Random UUID rejected</div>
            </div>
          </div>

          <!-- 5-Stage Pipeline Status Tracker -->
          <div class="space-y-2 pt-2 border-t border-slate-800">
            <div class="text-[11px] font-bold text-slate-300 font-sans">5-Stage Verification Pipeline Breakdown:</div>
            <div class="grid grid-cols-1 sm:grid-cols-5 gap-2 text-center text-[10px]">
              <div id="stage-node-1" class="p-2 rounded-lg bg-emerald-950/40 border border-emerald-500/50 text-emerald-300">
                <div class="font-bold">1. Syntax</div>
                <div class="text-[9px] text-slate-400">RFC 5322 Valid</div>
              </div>
              <div id="stage-node-2" class="p-2 rounded-lg bg-emerald-950/40 border border-emerald-500/50 text-emerald-300">
                <div class="font-bold">2. Disposable</div>
                <div class="text-[9px] text-slate-400">Passed Filter</div>
              </div>
              <div id="stage-node-3" class="p-2 rounded-lg bg-emerald-950/40 border border-emerald-500/50 text-emerald-300">
                <div class="font-bold">3. DNS MX</div>
                <div class="text-[9px] text-slate-400">IPv4 Resolved</div>
              </div>
              <div id="stage-node-4" class="p-2 rounded-lg bg-emerald-950/40 border border-emerald-500/50 text-emerald-300">
                <div class="font-bold">4. Port 25</div>
                <div class="text-[9px] text-slate-400">250 Mailbox Exists</div>
              </div>
              <div id="stage-node-5" class="p-2 rounded-lg bg-emerald-950/40 border border-emerald-500/50 text-emerald-300">
                <div class="font-bold">5. Catch-All</div>
                <div class="text-[9px] text-slate-400">Deterministic</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Raw SMTP Socket Session Terminal -->
        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-2 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span class="ml-2 text-slate-300 text-[11px] font-bold">Raw Port 25 Socket Protocol Stream</span>
            </div>
            <span class="text-[10px] text-cyan-400">TCP IPv4 Socket</span>
          </div>

          <div
            id="ev-terminal-stream"
            class="h-56 overflow-y-auto p-3 rounded-xl bg-slate-900 border border-slate-800/80 font-mono text-[11px] leading-relaxed space-y-1 text-slate-300 selection:bg-cyan-500/30"
          >
            <div class="text-slate-500">[00.000s] Initiating RFC 5322 normalization for: alex.smith@enterprise-corp.com</div>
            <div class="text-emerald-400">[00.002s] Syntax valid. Extracted User: alex.smith | Domain: enterprise-corp.com</div>
            <div class="text-slate-400">[00.003s] Checking disposable domain hash set (3,400+ entries)... PASS</div>
            <div class="text-cyan-300">[00.045s] DNS Query: enterprise-corp.com IN MX =&gt; mx1.enterprise-corp.com (pref: 10)</div>
            <div class="text-slate-400">[00.052s] Enforcing IPv4 resolution on mx1.enterprise-corp.com =&gt; 198.51.100.42:25</div>
            <div class="text-slate-500">[00.120s] Socket connecting to 198.51.100.42:25 (timeout: 5.0s)... CONNECTED</div>
            <div class="text-purple-300">&lt;&lt;&lt; 220 mx1.enterprise-corp.com ESMTP Postfix Service Ready</div>
            <div class="text-amber-300">&gt;&gt;&gt; EHLO mail.verifier.io</div>
            <div class="text-purple-300">&lt;&lt;&lt; 250-mx1.enterprise-corp.com Hello mail.verifier.io</div>
            <div class="text-purple-300">&lt;&lt;&lt; 250-SIZE 52428800</div>
            <div class="text-purple-300">&lt;&lt;&lt; 250 OK</div>
            <div class="text-amber-300">&gt;&gt;&gt; MAIL FROM:&lt;verify@example.com&gt;</div>
            <div class="text-purple-300">&lt;&lt;&lt; 250 2.1.0 Ok sender accepted</div>
            <div class="text-amber-300">&gt;&gt;&gt; RCPT TO:&lt;alex.smith@enterprise-corp.com&gt;</div>
            <div class="text-emerald-300 font-bold">&lt;&lt;&lt; 250 2.1.5 Recipient alex.smith@enterprise-corp.com Ok</div>
            <div class="text-slate-400">[00.680s] Primary address exists! Probing Catch-All with random UUID: verify_test_7f3a9b1c@enterprise-corp.com</div>
            <div class="text-amber-300">&gt;&gt;&gt; RCPT TO:&lt;verify_test_7f3a9b1c@enterprise-corp.com&gt;</div>
            <div class="text-rose-400">&lt;&lt;&lt; 550 5.1.1 &lt;verify_test_7f3a9b1c@enterprise-corp.com&gt;: Recipient address rejected: User unknown</div>
            <div class="text-emerald-400 font-bold">[01.180s] DETERMINISTIC MAILBOX CONFIRMED. Catch-all: FALSE. Zero emails dispatched. Session closed via QUIT.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 2: High-Throughput Batch Sandbox -->
  <div id="ev-screen-batch" class="ev-screen hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Batch Parameters & Controls -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-purple-400"></span>
              Batch Processing Configuration
            </span>
            <span class="text-[10px] text-slate-400 font-mono">batch_verifier.py</span>
          </div>

          <div class="space-y-2">
            <div class="flex justify-between text-slate-300 text-xs">
              <span>Batch Queue Size:</span>
              <span class="text-cyan-400 font-bold">250 Leads (CSV)</span>
            </div>
            <div class="flex justify-between text-slate-300 text-xs">
              <span>Same-Domain Anti-Burst Pacing:</span>
              <span class="text-purple-400 font-bold">1.5s - 2.5m dynamic</span>
            </div>
            <div class="flex justify-between text-slate-300 text-xs">
              <span>Greylist Auto-Retry Loop (421):</span>
              <span class="text-amber-400 font-bold">15 Min Cooldown</span>
            </div>
            <div class="flex justify-between text-slate-300 text-xs">
              <span>Target Parallel Concurrency:</span>
              <span class="text-emerald-400 font-bold">50 Async Workers</span>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 space-y-2 text-xs">
            <div class="text-slate-300 font-bold">Domain Throttling Guard:</div>
            <p class="text-[11px] text-slate-400 font-sans leading-relaxed">
              When verifying multiple leads at the same corporate domain (e.g. 15 leads from @microsoft.com), the engine paces requests dynamically to mimic organic delivery and prevent IP-level rate-limiting.
            </p>
          </div>

          <button
            type="button"
            id="ev-btn-run-batch"
            class="w-full py-2.5 px-4 rounded-xl bg-purple-500 hover:bg-purple-400 text-white font-bold font-mono text-xs flex items-center justify-center gap-2 transition-all shadow-lg shadow-purple-500/20"
          >
            <span>Trigger Async Batch Verification</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Right Column: Batch Live Metrics -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Live Queue Aggregation Telemetry
            </span>
            <span class="text-[10px] text-emerald-400 font-mono">Status: Stream Complete</span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center">
              <div class="text-[10px] text-slate-400">PROCESSED</div>
              <div class="text-lg font-bold text-white mt-0.5">250 / 250</div>
              <div class="text-[9px] text-emerald-400">100% Complete</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center">
              <div class="text-[10px] text-slate-400">DELIVERABLE</div>
              <div class="text-lg font-bold text-emerald-300 mt-0.5">214 (85.6%)</div>
              <div class="text-[9px] text-slate-400">Safe for Outreach</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center">
              <div class="text-[10px] text-slate-400">BOUNCE RISKS</div>
              <div class="text-lg font-bold text-rose-400 mt-0.5">26 (10.4%)</div>
              <div class="text-[9px] text-rose-300">550 Not Found</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center">
              <div class="text-[10px] text-slate-400">CATCH-ALL/BURN</div>
              <div class="text-lg font-bold text-amber-400 mt-0.5">10 (4.0%)</div>
              <div class="text-[9px] text-amber-300">Quarantined</div>
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="space-y-1.5 pt-2">
            <div class="flex justify-between text-[11px] text-slate-300 font-sans">
              <span>Pipeline Delivery Yield:</span>
              <span class="text-cyan-300 font-mono font-bold">85.6% Deliverable Quality Score</span>
            </div>
            <div class="h-2.5 rounded-full bg-slate-800 overflow-hidden flex">
              <div class="bg-emerald-500 h-full" style="width: 85.6%"></div>
              <div class="bg-rose-500 h-full" style="width: 10.4%"></div>
              <div class="bg-amber-500 h-full" style="width: 4.0%"></div>
            </div>
            <div class="flex justify-between text-[10px] text-slate-500 font-mono">
              <span>🟩 Valid Deliverable (214)</span>
              <span>🟥 Hard Bounces (26)</span>
              <span>🟨 Catch-All &amp; Disposable (10)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 3: SPF & Reverse DNS (PTR) Compliance -->
  <div id="ev-screen-dns" class="ev-screen hidden space-y-6">
    <div class="p-6 rounded-2xl bg-slate-950 border border-slate-800 space-y-5 font-mono text-xs">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div>
          <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            Hostinger / Hetzner VPS Deliverability &amp; Reputation Pre-Flight Check
          </span>
          <p class="text-[11px] text-slate-400 font-sans mt-0.5">
            To query destination Port 25 MTAs without being flagged as a spam bot, the verifying host must maintain cryptographic trust.
          </p>
        </div>
        <span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/30">
          ALL 4 CHECKS PASSED
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Item 1 -->
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-white flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span> 1. Outbound Port 25 Unblocked
            </span>
            <span class="text-[10px] text-cyan-300">TCP Handshake</span>
          </div>
          <p class="text-[11px] text-slate-400 font-sans leading-relaxed">
            VPS provider allows outbound TCP connection to destination port 25. Verified with zero packet drops.
          </p>
          <div class="text-[10px] text-slate-300 bg-slate-950 p-2 rounded-lg border border-slate-800">
            <code>nc -zvw3 aspmx.l.google.com 25 =&gt; Connection open!</code>
          </div>
        </div>

        <!-- Item 2 -->
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-white flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span> 2. Reverse DNS (PTR Record)
            </span>
            <span class="text-[10px] text-cyan-300">HELO FQDN Match</span>
          </div>
          <p class="text-[11px] text-slate-400 font-sans leading-relaxed">
            Verifying IPv4 address resolves backward to the exact HELO hostname provided during handshake.
          </p>
          <div class="text-[10px] text-slate-300 bg-slate-950 p-2 rounded-lg border border-slate-800">
            <code>45.132.241.64.in-addr.arpa =&gt; mail.verifier.io</code>
          </div>
        </div>

        <!-- Item 3 -->
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-white flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span> 3. Sender Policy Framework (SPF)
            </span>
            <span class="text-[10px] text-cyan-300">RFC 7208</span>
          </div>
          <p class="text-[11px] text-slate-400 font-sans leading-relaxed">
            Domain's TXT record authorizes the VPS IPv4 address to dispatch MAIL FROM queries under its domain.
          </p>
          <div class="text-[10px] text-slate-300 bg-slate-950 p-2 rounded-lg border border-slate-800">
            <code>v=spf1 ip4:45.132.241.64 include:_spf.mx.cloudflare.net ~all</code>
          </div>
        </div>

        <!-- Item 4 -->
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-white flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span> 4. Zero Outbound Email Delivery
            </span>
            <span class="text-[10px] text-cyan-300">Socket Triage</span>
          </div>
          <p class="text-[11px] text-slate-400 font-sans leading-relaxed">
            Terminates handshake immediately after RCPT TO code assessment via standard SMTP QUIT, never sending body bytes.
          </p>
          <div class="text-[10px] text-slate-300 bg-slate-950 p-2 rounded-lg border border-slate-800">
            <code>DATA command never invoked. 0 test emails sent to user inboxes.</code>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initEmailVerifierSimulator() {
    // Tab switching
    const tabSingle = document.getElementById('ev-tab-single');
    const tabBatch = document.getElementById('ev-tab-batch');
    const tabDns = document.getElementById('ev-tab-dns');
    const screenSingle = document.getElementById('ev-screen-single');
    const screenBatch = document.getElementById('ev-screen-batch');
    const screenDns = document.getElementById('ev-screen-dns');
    const allTabs = [tabSingle, tabBatch, tabDns];
    const allScreens = [screenSingle, screenBatch, screenDns];

    allTabs.forEach(tab => {
      tab?.addEventListener('click', () => {
        allTabs.forEach(t => {
          t?.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'shadow-sm');
          t?.classList.add('text-slate-400');
        });
        tab.classList.remove('text-slate-400');
        tab.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'shadow-sm');

        const view = tab.getAttribute('data-view');
        allScreens.forEach(s => s?.classList.add('hidden'));
        if (view === 'single') screenSingle?.classList.remove('hidden');
        else if (view === 'batch') screenBatch?.classList.remove('hidden');
        else if (view === 'dns') screenDns?.classList.remove('hidden');
      });
    });

    // Preset Buttons
    const emailInput = document.getElementById('ev-input-email') as HTMLInputElement | null;
    const presetButtons = document.querySelectorAll('.ev-preset-btn');
    let currentType = 'valid';

    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        presetButtons.forEach(b => {
          b.classList.remove('border-cyan-500/50', 'bg-cyan-950/30', 'text-white');
          b.classList.add('border-slate-800', 'bg-slate-900', 'text-slate-300');
        });
        btn.classList.remove('border-slate-800', 'bg-slate-900', 'text-slate-300');
        btn.classList.add('border-cyan-500/50', 'bg-cyan-950/30', 'text-white');

        const email = btn.getAttribute('data-email');
        currentType = btn.getAttribute('data-type') || 'valid';
        if (emailInput && email) {
          emailInput.value = email;
        }
      });
    });

    // Verification Pipeline Execution
    const btnVerify = document.getElementById('ev-btn-verify');
    const terminalStream = document.getElementById('ev-terminal-stream');
    const verdictTitle = document.getElementById('ev-verdict-title');
    const verdictSubtitle = document.getElementById('ev-verdict-subtitle');
    const verdictCode = document.getElementById('ev-verdict-code');
    const verdictCodemsg = document.getElementById('ev-verdict-codemsg');
    const verdictCatchall = document.getElementById('ev-verdict-catchall');
    const verdictCatchallmsg = document.getElementById('ev-verdict-catchallmsg');
    const latencyBadge = document.getElementById('ev-latency-badge');
    const optSmtp = document.getElementById('ev-opt-smtp') as HTMLInputElement | null;
    const optCache = document.getElementById('ev-opt-cache') as HTMLInputElement | null;

    const stageNodes = [
      document.getElementById('stage-node-1'),
      document.getElementById('stage-node-2'),
      document.getElementById('stage-node-3'),
      document.getElementById('stage-node-4'),
      document.getElementById('stage-node-5')
    ];

    function setStage(idx: number, state: 'pass' | 'fail' | 'skip') {
      const node = stageNodes[idx];
      if (!node) return;
      node.className = 'p-2 rounded-lg text-center text-[10px] ';
      if (state === 'pass') {
        node.className += 'bg-emerald-950/40 border border-emerald-500/50 text-emerald-300';
      } else if (state === 'fail') {
        node.className += 'bg-rose-950/40 border border-rose-500/50 text-rose-300';
      } else {
        node.className += 'bg-slate-900 border border-slate-800 text-slate-500';
      }
    }

    btnVerify?.addEventListener('click', () => {
      const email = emailInput?.value.trim() || 'test@example.com';
      const checkSmtp = optSmtp?.checked !== false;
      const useCache = optCache?.checked === true;

      if (!terminalStream) return;
      terminalStream.innerHTML = '';

      if (useCache) {
        if (latencyBadge) latencyBadge.textContent = '⏱️ Latency: 1.4ms (Cache Hit)';
        terminalStream.innerHTML = `
          <div class="text-emerald-400 font-bold">[00.001s] Cache HIT for target: ${email} (TTL valid: 23h 48m remaining)</div>
          <div class="text-slate-300">[00.001s] In-Memory Catch-All Cache &amp; MX IPv4 Record retrieved in 0.4ms.</div>
          <div class="text-cyan-300">[00.002s] Instant deliverability response synthesized without outbound network call.</div>
        `;
        if (verdictTitle) {
          verdictTitle.textContent = 'DELIVERABLE (CACHED)';
          verdictTitle.className = 'text-sm font-bold text-emerald-300';
        }
        if (verdictCode) verdictCode.textContent = '250 OK (CACHED)';
        if (verdictCatchall) verdictCatchall.textContent = 'FALSE (CACHED)';
        for (let i = 0; i < 5; i++) setStage(i, 'pass');
        return;
      }

      // Live Pipeline Execution
      if (currentType === 'valid') {
        if (latencyBadge) latencyBadge.textContent = '⏱️ Latency: 1,180ms';
        terminalStream.innerHTML = `
          <div class="text-slate-500">[00.000s] Normalizing RFC 5322 syntax for: ${email}</div>
          <div class="text-emerald-400">[00.002s] Syntax valid. User: alex.smith | Domain: enterprise-corp.com</div>
          <div class="text-slate-400">[00.003s] Disposable domain hash verification... PASS (Clean)</div>
          <div class="text-cyan-300">[00.045s] DNS Query: enterprise-corp.com IN MX =&gt; mx1.enterprise-corp.com (Priority: 10)</div>
          <div class="text-slate-400">[00.052s] Enforcing strict IPv4 A-record: mx1.enterprise-corp.com =&gt; 198.51.100.42:25</div>
          <div class="text-slate-500">[00.120s] Socket connecting to 198.51.100.42:25 (timeout: 5.0s)... CONNECTED</div>
          <div class="text-purple-300">&lt;&lt;&lt; 220 mx1.enterprise-corp.com ESMTP Postfix Service Ready</div>
          <div class="text-amber-300">&gt;&gt;&gt; EHLO mail.verifier.io</div>
          <div class="text-purple-300">&lt;&lt;&lt; 250-mx1.enterprise-corp.com Hello mail.verifier.io</div>
          <div class="text-purple-300">&lt;&lt;&lt; 250 OK</div>
          <div class="text-amber-300">&gt;&gt;&gt; MAIL FROM:&lt;verify@example.com&gt;</div>
          <div class="text-purple-300">&lt;&lt;&lt; 250 2.1.0 Ok sender accepted</div>
          <div class="text-amber-300">&gt;&gt;&gt; RCPT TO:&lt;${email}&gt;</div>
          <div class="text-emerald-300 font-bold">&lt;&lt;&lt; 250 2.1.5 Recipient ${email} Ok</div>
          <div class="text-slate-400">[00.680s] Probing Catch-All via randomized UUID: verify_test_7f3a9b1c@enterprise-corp.com</div>
          <div class="text-amber-300">&gt;&gt;&gt; RCPT TO:&lt;verify_test_7f3a9b1c@enterprise-corp.com&gt;</div>
          <div class="text-rose-400">&lt;&lt;&lt; 550 5.1.1 Recipient address rejected: User unknown</div>
          <div class="text-emerald-400 font-bold">[01.180s] DELIVERABLE CONFIRMED. Catch-all: FALSE. QUIT dispatched. Zero emails sent.</div>
        `;
        if (verdictTitle) {
          verdictTitle.textContent = 'DELIVERABLE';
          verdictTitle.className = 'text-sm font-bold text-emerald-300';
        }
        if (verdictSubtitle) verdictSubtitle.textContent = 'Mailbox active & accepting messages';
        if (verdictCode) verdictCode.textContent = '250 OK';
        if (verdictCodemsg) verdictCodemsg.textContent = 'Recipient accepted by MTA';
        if (verdictCatchall) verdictCatchall.textContent = 'FALSE (Deterministic)';
        if (verdictCatchallmsg) verdictCatchallmsg.textContent = 'Random UUID rejected with 550';
        for (let i = 0; i < 5; i++) setStage(i, 'pass');
      } else if (currentType === 'nonexistent') {
        if (latencyBadge) latencyBadge.textContent = '⏱️ Latency: 740ms';
        terminalStream.innerHTML = `
          <div class="text-slate-500">[00.000s] Normalizing RFC 5322 syntax for: ${email}</div>
          <div class="text-emerald-400">[00.002s] Syntax valid. Extracted domain: gmail.com</div>
          <div class="text-slate-400">[00.003s] Disposable domain check... PASS</div>
          <div class="text-cyan-300">[00.035s] DNS Query: gmail.com IN MX =&gt; gmail-smtp-in.l.google.com (Priority: 5)</div>
          <div class="text-slate-400">[00.040s] Enforcing IPv4 socket target: 142.251.163.26:25</div>
          <div class="text-slate-500">[00.110s] Socket connecting to 142.251.163.26:25... CONNECTED</div>
          <div class="text-purple-300">&lt;&lt;&lt; 220 mx.google.com ESMTP o15si2843914wms.42 - gsmtp</div>
          <div class="text-amber-300">&gt;&gt;&gt; EHLO mail.verifier.io</div>
          <div class="text-purple-300">&lt;&lt;&lt; 250-mx.google.com at your service</div>
          <div class="text-purple-300">&lt;&lt;&lt; 250 2.1.0 OK</div>
          <div class="text-amber-300">&gt;&gt;&gt; MAIL FROM:&lt;verify@example.com&gt;</div>
          <div class="text-purple-300">&lt;&lt;&lt; 250 2.1.0 OK sender accepted</div>
          <div class="text-amber-300">&gt;&gt;&gt; RCPT TO:&lt;${email}&gt;</div>
          <div class="text-rose-400 font-bold">&lt;&lt;&lt; 550-5.1.1 The email account that you tried to reach does not exist.</div>
          <div class="text-rose-400 font-bold">&lt;&lt;&lt; 550-5.1.1 Please try double-checking the recipient's email address.</div>
          <div class="text-rose-400 font-bold">[00.740s] VERDICT: UNDELIVERABLE (550 Mailbox Not Found). Hard bounce prevented.</div>
        `;
        if (verdictTitle) {
          verdictTitle.textContent = 'UNDELIVERABLE';
          verdictTitle.className = 'text-sm font-bold text-rose-400';
        }
        if (verdictSubtitle) verdictSubtitle.textContent = 'Mailbox does not exist on target MTA';
        if (verdictCode) verdictCode.textContent = '550 USER UNKNOWN';
        if (verdictCodemsg) verdictCodemsg.textContent = 'Google MTA rejected recipient';
        if (verdictCatchall) verdictCatchall.textContent = 'N/A';
        if (verdictCatchallmsg) verdictCatchallmsg.textContent = 'Aborted before catch-all test';
        setStage(0, 'pass');
        setStage(1, 'pass');
        setStage(2, 'pass');
        setStage(3, 'fail');
        setStage(4, 'skip');
      } else if (currentType === 'disposable') {
        if (latencyBadge) latencyBadge.textContent = '⏱️ Latency: 2.1ms';
        terminalStream.innerHTML = `
          <div class="text-slate-500">[00.000s] Normalizing RFC 5322 syntax for: ${email}</div>
          <div class="text-emerald-400">[00.001s] Syntax valid. Extracted domain: 10minutemail.com</div>
          <div class="text-amber-400 font-bold">[00.002s] STAGE 2 MATCH: 10minutemail.com found in in-memory disposable hash set!</div>
          <div class="text-rose-400 font-bold">[00.002s] PIPELINE ABORT: Burner/disposable email address rejected immediately.</div>
          <div class="text-slate-500">[00.002s] Zero network queries dispatched. Port 25 connection skipped.</div>
        `;
        if (verdictTitle) {
          verdictTitle.textContent = 'DISPOSABLE (BLOCKED)';
          verdictTitle.className = 'text-sm font-bold text-amber-400';
        }
        if (verdictSubtitle) verdictSubtitle.textContent = 'Known temporary burner provider';
        if (verdictCode) verdictCode.textContent = 'STAGE 2 DROP';
        if (verdictCodemsg) verdictCodemsg.textContent = 'Zero network sockets consumed';
        if (verdictCatchall) verdictCatchall.textContent = 'N/A';
        if (verdictCatchallmsg) verdictCatchallmsg.textContent = 'Skipped';
        setStage(0, 'pass');
        setStage(1, 'fail');
        setStage(2, 'skip');
        setStage(3, 'skip');
        setStage(4, 'skip');
      } else if (currentType === 'catchall') {
        if (latencyBadge) latencyBadge.textContent = '⏱️ Latency: 1,320ms';
        terminalStream.innerHTML = `
          <div class="text-slate-500">[00.000s] Normalizing RFC 5322 syntax for: ${email}</div>
          <div class="text-emerald-400">[00.002s] Syntax valid. Domain: catchall-cloud.io</div>
          <div class="text-slate-400">[00.003s] Disposable check... PASS</div>
          <div class="text-cyan-300">[00.038s] DNS Query: catchall-cloud.io IN MX =&gt; mail.catchall-cloud.io (pref: 10)</div>
          <div class="text-slate-400">[00.045s] IPv4 target resolved: 198.51.100.99:25</div>
          <div class="text-slate-500">[00.115s] Socket connect =&gt; CONNECTED</div>
          <div class="text-purple-300">&lt;&lt;&lt; 220 mail.catchall-cloud.io ESMTP Ready</div>
          <div class="text-amber-300">&gt;&gt;&gt; EHLO mail.verifier.io</div>
          <div class="text-purple-300">&lt;&lt;&lt; 250 OK</div>
          <div class="text-amber-300">&gt;&gt;&gt; MAIL FROM:&lt;verify@example.com&gt;</div>
          <div class="text-purple-300">&lt;&lt;&lt; 250 OK</div>
          <div class="text-amber-300">&gt;&gt;&gt; RCPT TO:&lt;${email}&gt;</div>
          <div class="text-emerald-300">&lt;&lt;&lt; 250 2.1.5 Recipient Ok</div>
          <div class="text-slate-400">[00.720s] Executing Stage 5 Catch-All test with random UUID: verify_test_9e4c1b2f@catchall-cloud.io</div>
          <div class="text-amber-300">&gt;&gt;&gt; RCPT TO:&lt;verify_test_9e4c1b2f@catchall-cloud.io&gt;</div>
          <div class="text-purple-300 font-bold">&lt;&lt;&lt; 250 2.1.5 Recipient Ok (Accepted non-existent UUID)</div>
          <div class="text-purple-400 font-bold">[01.320s] VERDICT: RISKY (Catch-All Domain). Server accepts all incoming mailboxes. 24h cached.</div>
        `;
        if (verdictTitle) {
          verdictTitle.textContent = 'RISKY (CATCH-ALL)';
          verdictTitle.className = 'text-sm font-bold text-purple-400';
        }
        if (verdictSubtitle) verdictSubtitle.textContent = 'Server accepts all recipients blindly';
        if (verdictCode) verdictCode.textContent = '250 (ALL ACCEPT)';
        if (verdictCodemsg) verdictCodemsg.textContent = 'Random UUID was accepted';
        if (verdictCatchall) verdictCatchall.textContent = 'TRUE (Catch-All)';
        if (verdictCatchallmsg) verdictCatchallmsg.textContent = 'Cached for 24 hours';
        for (let i = 0; i < 4; i++) setStage(i, 'pass');
        setStage(4, 'fail');
      } else if (currentType === 'greylist') {
        if (latencyBadge) latencyBadge.textContent = '⏱️ Latency: 890ms';
        terminalStream.innerHTML = `
          <div class="text-slate-500">[00.000s] Normalizing RFC 5322 syntax for: ${email}</div>
          <div class="text-emerald-400">[00.002s] Syntax valid. Domain: greylist-exchange.net</div>
          <div class="text-cyan-300">[00.040s] DNS Query: greylist-exchange.net IN MX =&gt; mx.greylist-exchange.net</div>
          <div class="text-slate-500">[00.120s] Socket connect to 203.0.113.88:25... CONNECTED</div>
          <div class="text-purple-300">&lt;&lt;&lt; 220 mx.greylist-exchange.net ESMTP Service</div>
          <div class="text-amber-300">&gt;&gt;&gt; EHLO mail.verifier.io</div>
          <div class="text-purple-300">&lt;&lt;&lt; 250 OK</div>
          <div class="text-amber-300">&gt;&gt;&gt; MAIL FROM:&lt;verify@example.com&gt;</div>
          <div class="text-purple-300">&lt;&lt;&lt; 250 OK</div>
          <div class="text-amber-300">&gt;&gt;&gt; RCPT TO:&lt;${email}&gt;</div>
          <div class="text-orange-400 font-bold">&lt;&lt;&lt; 421 4.7.1 Service temporarily unavailable; greylisted. Try again later.</div>
          <div class="text-orange-400 font-bold">[00.890s] GREYLIST DETECTED. Scheduled auto-retry worker sleeping domain for 15 minutes.</div>
        `;
        if (verdictTitle) {
          verdictTitle.textContent = 'GREYLISTED (RETRY)';
          verdictTitle.className = 'text-sm font-bold text-orange-400';
        }
        if (verdictSubtitle) verdictSubtitle.textContent = 'Temporarily throttled by destination MTA';
        if (verdictCode) verdictCode.textContent = '421 RATE LIMIT';
        if (verdictCodemsg) verdictCodemsg.textContent = 'Enqueued for 15-minute retry loop';
        if (verdictCatchall) verdictCatchall.textContent = 'N/A';
        if (verdictCatchallmsg) verdictCatchallmsg.textContent = 'Delayed';
        setStage(0, 'pass');
        setStage(1, 'pass');
        setStage(2, 'pass');
        setStage(3, 'fail');
        setStage(4, 'skip');
      }
    });

    // Batch Button Simulation
    const btnBatch = document.getElementById('ev-btn-run-batch');
    btnBatch?.addEventListener('click', () => {
      btnBatch.innerHTML = `<span>Simulating 250 Stream Handshakes...</span>`;
      setTimeout(() => {
        btnBatch.innerHTML = `<span>Batch Run Complete (250/250)</span>`;
        setTimeout(() => {
          btnBatch.innerHTML = `<span>Trigger Async Batch Verification</span>`;
        }, 2500);
      }, 1200);
    });
  }

  initEmailVerifierSimulator();
  document.addEventListener('astro:page-load', initEmailVerifierSimulator);
</script>
