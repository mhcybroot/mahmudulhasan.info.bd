---
// AMH Sniper: High-Speed Work Order Auto-Acceptor & Memory Hook Simulator
---

<div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl p-6 sm:p-8 space-y-8 shadow-2xl">
  <!-- Simulator Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-amber-400 font-mono text-xs uppercase tracking-wider mb-1 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
        Interactive Browser Automation &amp; Memory Hook Sandbox
      </div>
      <h2 class="text-2xl sm:text-3xl font-mono font-bold text-white flex items-center gap-3">
        AMH Sniper: In-Memory WO Auto-Claim Simulator
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 font-sans mt-1">
        Experience in-memory fetch interception, 80ms soft tab cycling, and sub-100ms automated order confirmation.
      </p>
    </div>

    <!-- Active Perspective Switcher -->
    <div class="flex items-center p-1 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono overflow-x-auto">
      <button
        type="button"
        id="sniper-tab-claim"
        class="sniper-tab-btn px-3.5 py-1.5 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 font-semibold transition-all shadow-sm"
        data-view="claim"
      >
        🎯 In-Memory Auto-Claim
      </button>
      <button
        type="button"
        id="sniper-tab-reload"
        class="sniper-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="reload"
      >
        ⚡ Soft Tab vs Hard Reload
      </button>
      <button
        type="button"
        id="sniper-tab-shield"
        class="sniper-tab-btn px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all font-semibold"
        data-view="shield"
      >
        🛡️ Rate-Limit Shield (429)
      </button>
    </div>
  </div>

  <!-- View 1: In-Memory Auto-Claim Sandbox (Default) -->
  <div id="sniper-screen-claim" class="sniper-screen space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Control Panel & Mode Switcher -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-amber-400"></span>
              Execution Profile
            </span>
            <span id="claim-mode-badge" class="px-2 py-0.5 rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[10px]">
              AMH Sniper MV3 Active
            </span>
          </div>

          <!-- Execution Mode Toggle -->
          <div class="space-y-2">
            <label class="text-slate-400 text-[11px] uppercase tracking-wider">Select Dispatch Competitor Mode</label>
            <div class="grid grid-cols-2 gap-2">
              <button
                type="button"
                id="btn-mode-sniper"
                class="p-2.5 rounded-xl border border-amber-500/50 bg-amber-500/10 text-amber-300 font-bold text-left transition-all hover:bg-amber-500/20"
              >
                <div class="text-xs">⚡ AMH Sniper</div>
                <div class="text-[10px] text-amber-200/70 font-normal">Memory Hook &lt; 90ms</div>
              </button>
              <button
                type="button"
                id="btn-mode-human"
                class="p-2.5 rounded-xl border border-slate-800 bg-slate-900 text-slate-400 font-bold text-left transition-all hover:border-slate-700 hover:text-slate-200"
              >
                <div class="text-xs">👤 Manual Dispatcher</div>
                <div class="text-[10px] text-slate-500 font-normal">Human Click 2.8s - 4.5s</div>
              </button>
            </div>
          </div>

          <!-- Action Controls -->
          <div class="space-y-2 pt-1">
            <button
              type="button"
              id="btn-dispatch-order"
              class="w-full py-3 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg active:scale-95"
            >
              <svg class="w-4 h-4 text-slate-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              <span>Broadcast New High-Value Work Order ($1,450)</span>
            </button>
            <div class="flex gap-2">
              <button
                type="button"
                id="btn-toggle-engine"
                class="flex-1 py-2 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 text-xs transition-all cursor-pointer font-bold"
              >
                Engine Status: <span id="label-engine-state" class="text-emerald-400">RUNNING</span>
              </button>
              <button
                type="button"
                id="btn-reset-claim-sim"
                class="py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 text-xs transition-all cursor-pointer"
                title="Reset Simulator"
              >
                ↺
              </button>
            </div>
          </div>

          <!-- Live Telemetry Counters -->
          <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-800">
            <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800">
              <div class="text-[10px] text-slate-400">TOTAL CLAIM LATENCY</div>
              <div id="stat-claim-latency" class="text-sm font-bold text-emerald-400 mt-0.5">84 ms</div>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800">
              <div class="text-[10px] text-slate-400">AUCTION OUTCOME</div>
              <div id="stat-claim-outcome" class="text-sm font-bold text-cyan-300 mt-0.5">ORDER SECURED</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Live Portal Table & Floating HUD -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              AMH Vendor Portal — New Work Orders Table
            </span>
            <div class="flex items-center gap-2">
              <span class="text-[10px] text-slate-500">Ant Design Soft Tab Cycle:</span>
              <span id="tab-cycle-indicator" class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 text-[10px] font-bold">
                80ms Sync
              </span>
            </div>
          </div>

          <!-- Mock Portal Work Order Table -->
          <div class="rounded-xl border border-slate-800 overflow-hidden bg-slate-900">
            <div class="grid grid-cols-12 bg-slate-950 p-2.5 text-[10px] text-slate-400 font-bold uppercase border-b border-slate-800">
              <div class="col-span-3">WO Number</div>
              <div class="col-span-4">Category &amp; Location</div>
              <div class="col-span-2">Payout</div>
              <div class="col-span-3 text-right">Action Status</div>
            </div>

            <!-- Table Rows -->
            <div id="portal-table-rows" class="divide-y divide-slate-800">
              <div id="row-incoming-wo" class="grid grid-cols-12 p-3 text-[11px] items-center bg-slate-900/60 transition-all duration-300">
                <div class="col-span-3 font-bold text-amber-300 flex items-center gap-1.5">
                  <span id="wo-pulse-dot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                  <span id="wo-ticket-number">WO-984210</span>
                </div>
                <div class="col-span-4 text-slate-300 truncate">
                  <span id="wo-category-text">Emergency HVAC Compressor</span><br/>
                  <span class="text-[9px] text-slate-500">Austin, TX (Subdivision 4)</span>
                </div>
                <div class="col-span-2 text-emerald-400 font-bold" id="wo-payout-text">$1,450.00</div>
                <div class="col-span-3 text-right">
                  <button
                    type="button"
                    id="btn-row-action"
                    class="px-3 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[10px] font-bold transition-all"
                  >
                    Auto-Claiming...
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating In-Page Sniper HUD Overlay -->
          <div class="p-3.5 rounded-xl bg-slate-900/90 border border-amber-500/40 space-y-2 shadow-xl">
            <div class="flex items-center justify-between text-[11px]">
              <span class="font-bold text-amber-300 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                AMH SNIPER HUD v2.3.0
              </span>
              <div class="flex items-center gap-3 text-[10px] text-slate-400">
                <span>Checks: <strong id="hud-checks-count" class="text-white">1,492</strong></span>
                <span>Claimed Today: <strong id="hud-claimed-today" class="text-emerald-400">7</strong></span>
                <span>Next Cycle: <strong id="hud-next-cycle" class="text-cyan-300">2.4s</strong></span>
              </div>
            </div>
            <div id="hud-event-log" class="text-[10px] font-mono text-slate-300 bg-black/60 p-2 rounded-lg border border-slate-800 h-16 overflow-y-auto space-y-0.5">
              <div class="text-emerald-400">[READY] In-memory fetch hook active. Monitoring /VendorNewOrders endpoint.</div>
              <div class="text-slate-400">[TAB] 80ms soft refresh executed: #rc-tabs-0-tab-New toggled.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 2: Soft Tab vs Hard Browser Reload Comparison -->
  <div id="sniper-screen-reload" class="sniper-screen hidden space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Side A: Standard Browser Full Reload -->
      <div class="p-6 rounded-2xl bg-slate-950 border border-rose-500/30 space-y-4 font-mono text-xs">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <span class="text-xs font-bold text-rose-400 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            Standard Browser Hard Reload (F5)
          </span>
          <span class="text-rose-400 bg-rose-500/10 px-2 py-0.5 rounded text-[10px]">3,200ms Delay</span>
        </div>
        <p class="text-slate-300 font-sans text-xs leading-relaxed">
          Full page reloads tear down the JavaScript VM, flash an annoying blank white screen, re-authenticate session cookies, and re-download 2.4 MB of React bundles.
        </p>
        <div class="space-y-2 p-3 rounded-xl bg-slate-900 border border-slate-800 text-[11px]">
          <div class="flex justify-between text-slate-300">
            <span>White-Screen Duration:</span>
            <span class="text-rose-400 font-bold">1,800 ms</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span>Network Payload Transferred:</span>
            <span class="text-rose-400 font-bold">2.4 MB (Full App Re-fetch)</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span>Memory Consumption:</span>
            <span class="text-rose-400 font-bold">Spikes 120 MB on re-parse</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span>Risk of Missing Instant Job:</span>
            <span class="text-rose-400 font-bold">98.5% (Lost to Bot)</span>
          </div>
        </div>
      </div>

      <!-- Side B: AMH Sniper In-Page Soft Refresh -->
      <div class="p-6 rounded-2xl bg-slate-950 border border-emerald-500/40 space-y-4 font-mono text-xs">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <span class="text-xs font-bold text-emerald-300 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            AMH Sniper 80ms In-Page Soft Tab
          </span>
          <span class="text-emerald-300 bg-emerald-500/10 px-2 py-0.5 rounded text-[10px]">80ms Instant</span>
        </div>
        <p class="text-slate-300 font-sans text-xs leading-relaxed">
          Natively triggers tab click events between `#rc-tabs-0-tab-AllOpen` and `#rc-tabs-0-tab-New` in 80 milliseconds. Fires internal React Query endpoint without white screens!
        </p>
        <div class="space-y-2 p-3 rounded-xl bg-slate-900 border border-slate-800 text-[11px]">
          <div class="flex justify-between text-slate-300">
            <span>White-Screen Duration:</span>
            <span class="text-emerald-400 font-bold">0 ms (Zero Screen Flicker)</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span>Network Payload Transferred:</span>
            <span class="text-emerald-400 font-bold">1.2 KB (JSON payload only)</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span>Memory Consumption:</span>
            <span class="text-emerald-400 font-bold">&lt; 18 MB Steady (Ring Buffer)</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span>Risk of Missing Instant Job:</span>
            <span class="text-emerald-400 font-bold">&lt; 0.5% (First to Claim)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 3: Rate-Limit Shield (429) & Backoff Telemetry -->
  <div id="sniper-screen-shield" class="sniper-screen hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Shield Controls -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              WAF Armor &amp; Rate-Limit Shield
            </span>
            <span id="shield-status-badge" class="px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 text-[10px]">
              ARMOR ONLINE
            </span>
          </div>

          <p class="text-slate-400 text-[11px] font-sans leading-relaxed">
            Simulate a Cloudflare or API Gateway rate-limit surge (HTTP 429 Too Many Requests). Watch the engine suppress polling to protect vendor account standing.
          </p>

          <div class="space-y-2">
            <button
              type="button"
              id="btn-simulate-429"
              class="w-full py-2.5 px-4 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 border border-rose-500/50 font-bold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg active:scale-95"
            >
              <span>Inject HTTP 429 Rate-Limit Surge</span>
            </button>
            <button
              type="button"
              id="btn-reset-shield"
              class="w-full py-2 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 text-xs transition-all cursor-pointer"
            >
              Reset Shield State
            </button>
          </div>

          <!-- Cooldown Timer -->
          <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 space-y-2">
            <div class="flex justify-between items-center">
              <span class="text-slate-400 font-bold text-[10px]">COOLDOWN SUSPENSION TIMER:</span>
              <span id="shield-cooldown-time" class="text-emerald-400 font-bold text-sm">00:00 (Idle)</span>
            </div>
            <div class="w-full h-2 rounded-full bg-slate-950 overflow-hidden">
              <div id="bar-shield-cooldown" class="h-full bg-rose-500 transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Shield Terminal Diagnostics -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 font-mono text-xs">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              Anti-Ban Defense Terminal &amp; Memory Guard
            </span>
            <span class="text-slate-500 text-[10px]">main-world/content.js:2594</span>
          </div>

          <div id="shield-terminal-stdout" class="text-slate-300 h-44 overflow-y-auto space-y-1 bg-black p-3 rounded-xl border border-slate-800 font-mono text-[11px] leading-snug">
            <div class="text-emerald-400">[ARMOR] RateLimitShield initialized. 0 rate limit violations recorded.</div>
            <div class="text-cyan-400">[MEMORY] Chromium RAM auto-recycle configured for every 200 soft cycles.</div>
            <div class="text-slate-400">[STEADY] In-flight timeout watchdog active (max 10s backpressure threshold).</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Tab Switching Logic
  const tabClaim = document.getElementById('sniper-tab-claim');
  const tabReload = document.getElementById('sniper-tab-reload');
  const tabShield = document.getElementById('sniper-tab-shield');

  const screenClaim = document.getElementById('sniper-screen-claim');
  const screenReload = document.getElementById('sniper-screen-reload');
  const screenShield = document.getElementById('sniper-screen-shield');

  function setSniperTab(view: 'claim' | 'reload' | 'shield') {
    [tabClaim, tabReload, tabShield].forEach(btn => {
      btn?.classList.remove('bg-amber-500/20', 'text-amber-300', 'border-amber-500/40');
      btn?.classList.add('text-slate-400');
    });
    [screenClaim, screenReload, screenShield].forEach(screen => screen?.classList.add('hidden'));

    if (view === 'claim') {
      tabClaim?.classList.add('bg-amber-500/20', 'text-amber-300', 'border-amber-500/40');
      tabClaim?.classList.remove('text-slate-400');
      screenClaim?.classList.remove('hidden');
    } else if (view === 'reload') {
      tabReload?.classList.add('bg-amber-500/20', 'text-amber-300', 'border-amber-500/40');
      tabReload?.classList.remove('text-slate-400');
      screenReload?.classList.remove('hidden');
    } else if (view === 'shield') {
      tabShield?.classList.add('bg-amber-500/20', 'text-amber-300', 'border-amber-500/40');
      tabShield?.classList.remove('text-slate-400');
      screenShield?.classList.remove('hidden');
    }
  }

  tabClaim?.addEventListener('click', () => setSniperTab('claim'));
  tabReload?.addEventListener('click', () => setSniperTab('reload'));
  tabShield?.addEventListener('click', () => setSniperTab('shield'));

  // ==========================================
  // VIEW 1: IN-MEMORY AUTO-CLAIM SIMULATION
  // ==========================================
  let isSniperMode = true;
  let isEngineRunning = true;
  let checksCount = 1492;
  let claimedCount = 7;
  let cycleInterval: number | null = null;

  const btnModeSniper = document.getElementById('btn-mode-sniper');
  const btnModeHuman = document.getElementById('btn-mode-human');
  const claimModeBadge = document.getElementById('claim-mode-badge');
  const statClaimLatency = document.getElementById('stat-claim-latency');
  const statClaimOutcome = document.getElementById('stat-claim-outcome');
  const btnDispatchOrder = document.getElementById('btn-dispatch-order');
  const btnToggleEngine = document.getElementById('btn-toggle-engine');
  const labelEngineState = document.getElementById('label-engine-state');
  const btnResetClaimSim = document.getElementById('btn-reset-claim-sim');

  const woTicketNumber = document.getElementById('wo-ticket-number');
  const woCategoryText = document.getElementById('wo-category-text');
  const woPayoutText = document.getElementById('wo-payout-text');
  const btnRowAction = document.getElementById('btn-row-action');
  const rowIncomingWo = document.getElementById('row-incoming-wo');
  const hudChecksCount = document.getElementById('hud-checks-count');
  const hudClaimedToday = document.getElementById('hud-claimed-today');
  const hudEventLog = document.getElementById('hud-event-log');

  function updateClaimMode(sniper: boolean) {
    isSniperMode = sniper;
    if (sniper) {
      btnModeSniper?.classList.add('border-amber-500/50', 'bg-amber-500/10', 'text-amber-300');
      btnModeSniper?.classList.remove('border-slate-800', 'bg-slate-900', 'text-slate-400');
      btnModeHuman?.classList.remove('border-amber-500/50', 'bg-amber-500/10', 'text-amber-300');
      btnModeHuman?.classList.add('border-slate-800', 'bg-slate-900', 'text-slate-400');

      if (claimModeBadge) {
        claimModeBadge.className = 'px-2 py-0.5 rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[10px]';
        claimModeBadge.textContent = 'AMH Sniper MV3 Active';
      }
      if (statClaimLatency) statClaimLatency.textContent = '84 ms';
      if (statClaimOutcome) statClaimOutcome.textContent = 'ORDER SECURED';
    } else {
      btnModeHuman?.classList.add('border-amber-500/50', 'bg-amber-500/10', 'text-amber-300');
      btnModeHuman?.classList.remove('border-slate-800', 'bg-slate-900', 'text-slate-400');
      btnModeSniper?.classList.remove('border-amber-500/50', 'bg-amber-500/10', 'text-amber-300');
      btnModeSniper?.classList.add('border-slate-800', 'bg-slate-900', 'text-slate-400');

      if (claimModeBadge) {
        claimModeBadge.className = 'px-2 py-0.5 rounded-md bg-rose-500/20 text-rose-300 border border-rose-500/30 text-[10px]';
        claimModeBadge.textContent = 'Human Manual Dispatcher';
      }
      if (statClaimLatency) statClaimLatency.textContent = '3,600 ms (Too Slow)';
      if (statClaimOutcome) statClaimOutcome.textContent = 'LOST TO COMPETITOR';
    }
  }

  btnModeSniper?.addEventListener('click', () => updateClaimMode(true));
  btnModeHuman?.addEventListener('click', () => updateClaimMode(false));

  function resetClaimSim() {
    if (btnRowAction) {
      btnRowAction.className = 'px-3 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[10px] font-bold';
      btnRowAction.textContent = 'Monitoring...';
    }
    if (rowIncomingWo) {
      rowIncomingWo.className = 'grid grid-cols-12 p-3 text-[11px] items-center bg-slate-900/60 transition-all duration-300';
    }
    if (hudEventLog) {
      hudEventLog.innerHTML = `
        <div class="text-emerald-400">[READY] In-memory fetch hook active. Monitoring /VendorNewOrders endpoint.</div>
        <div class="text-slate-400">[TAB] 80ms soft refresh executed: #rc-tabs-0-tab-New toggled.</div>
      `;
    }
  }

  btnResetClaimSim?.addEventListener('click', resetClaimSim);

  btnToggleEngine?.addEventListener('click', () => {
    isEngineRunning = !isEngineRunning;
    if (labelEngineState) {
      labelEngineState.textContent = isEngineRunning ? 'RUNNING' : 'PAUSED';
      labelEngineState.className = isEngineRunning ? 'text-emerald-400' : 'text-rose-400';
    }
  });

  btnDispatchOrder?.addEventListener('click', () => {
    const randomTicket = Math.floor(Math.random() * 800000 + 100000);
    const payouts = [1250, 1450, 2100, 3200, 850];
    const payout = payouts[Math.floor(Math.random() * payouts.length)];

    if (woTicketNumber) woTicketNumber.textContent = `WO-${randomTicket}`;
    if (woPayoutText) woPayoutText.textContent = `$${payout.toLocaleString()}.00`;

    if (rowIncomingWo) {
      rowIncomingWo.className = 'grid grid-cols-12 p-3 text-[11px] items-center bg-amber-950/40 border-l-4 border-amber-400 transition-all duration-300';
    }

    if (hudEventLog) {
      const time = new Date().toISOString().substring(11, 19);
      hudEventLog.innerHTML += `
        <div class="text-amber-300 font-bold">[${time}] 🚀 INCOMING WORK ORDER: WO-${randomTicket} ($${payout}) broadcasted!</div>
      `;
    }

    if (isSniperMode) {
      // Sniper execution in 84ms!
      setTimeout(() => {
        if (hudEventLog) {
          hudEventLog.innerHTML += `
            <div class="text-cyan-400">[+12ms] In-Memory Hook caught VendorNewOrders JSON before DOM paint!</div>
            <div class="text-purple-300">[+42ms] MutationObserver auto-checked "Accept Terms & Conditions".</div>
            <div class="text-emerald-400 font-bold">[+84ms] SUCCESS: Auto-clicked "Confirm WO". Order claimed! 🎉</div>
          `;
          hudEventLog.scrollTop = hudEventLog.scrollHeight;
        }

        if (btnRowAction) {
          btnRowAction.className = 'px-3 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[10px] font-bold';
          btnRowAction.textContent = 'CLAIMED (84ms) ✅';
        }
        if (rowIncomingWo) {
          rowIncomingWo.className = 'grid grid-cols-12 p-3 text-[11px] items-center bg-emerald-950/30 border-l-4 border-emerald-400 transition-all duration-300';
        }

        claimedCount++;
        if (hudClaimedToday) hudClaimedToday.textContent = claimedCount.toString();
        if (statClaimLatency) statClaimLatency.textContent = '84 ms';
        if (statClaimOutcome) {
          statClaimOutcome.className = 'text-sm font-bold text-emerald-400 mt-0.5';
          statClaimOutcome.textContent = 'ORDER CLAIMED ✅';
        }
      }, 300);

    } else {
      // Human dispatcher mode: takes 3.6s, lost to bot!
      if (btnRowAction) {
        btnRowAction.className = 'px-3 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[10px] font-bold animate-pulse';
        btnRowAction.textContent = 'Human Clicking...';
      }

      setTimeout(() => {
        if (hudEventLog) {
          hudEventLog.innerHTML += `
            <div class="text-rose-400">[+1,800ms] Human noticed row and clicked link...</div>
            <div class="text-rose-400">[+2,700ms] Human checked Terms modal box...</div>
            <div class="text-rose-500 font-bold">[+3,600ms] FAILED: "Order already claimed by another vendor."</div>
          `;
          hudEventLog.scrollTop = hudEventLog.scrollHeight;
        }

        if (btnRowAction) {
          btnRowAction.className = 'px-3 py-1 rounded-lg bg-rose-500/20 text-rose-300 border border-rose-500/40 text-[10px] font-bold';
          btnRowAction.textContent = 'LOST TO BOT ❌';
        }
        if (rowIncomingWo) {
          rowIncomingWo.className = 'grid grid-cols-12 p-3 text-[11px] items-center bg-rose-950/40 border-l-4 border-rose-500 transition-all duration-300';
        }
        if (statClaimLatency) statClaimLatency.textContent = '3,600 ms';
        if (statClaimOutcome) {
          statClaimOutcome.className = 'text-sm font-bold text-rose-400 mt-0.5';
          statClaimOutcome.textContent = 'LOST TO COMPETITOR ❌';
        }
      }, 800);
    }
  });

  // Background ticker simulation
  setInterval(() => {
    if (!isEngineRunning) return;
    checksCount++;
    if (hudChecksCount) hudChecksCount.textContent = checksCount.toLocaleString();
  }, 3200);

  // ==========================================
  // VIEW 3: RATE-LIMIT SHIELD (429) SIMULATION
  // ==========================================
  const btnSimulate429 = document.getElementById('btn-simulate-429');
  const btnResetShield = document.getElementById('btn-reset-shield');
  const shieldStatusBadge = document.getElementById('shield-status-badge');
  const shieldCooldownTime = document.getElementById('shield-cooldown-time');
  const barShieldCooldown = document.getElementById('bar-shield-cooldown');
  const shieldTerminalStdout = document.getElementById('shield-terminal-stdout');

  let shieldTimer: number | null = null;
  let cooldownSecs = 0;

  btnSimulate429?.addEventListener('click', () => {
    if (shieldTimer) clearInterval(shieldTimer);
    cooldownSecs = 30;

    if (shieldStatusBadge) {
      shieldStatusBadge.className = 'px-2 py-0.5 rounded-md bg-rose-500/20 text-rose-300 font-bold text-[10px] animate-pulse';
      shieldStatusBadge.textContent = 'COOLDOWN SHIELD ACTIVE (429)';
    }

    if (shieldTerminalStdout) {
      const time = new Date().toISOString().substring(11, 19);
      shieldTerminalStdout.innerHTML += `
        <div class="text-rose-400 font-bold">[${time}] ⚠️ HTTP 429 TOO MANY REQUESTS detected from WAF!</div>
        <div class="text-amber-300">[${time}] SHIELD ACTIVATED: Suppressing outgoing VendorNewOrders requests for 30s.</div>
        <div class="text-emerald-400">[${time}] Account protection active. Cloudflare ban prevented!</div>
      `;
      shieldTerminalStdout.scrollTop = shieldTerminalStdout.scrollHeight;
    }

    shieldTimer = window.setInterval(() => {
      cooldownSecs--;
      const pct = ((30 - cooldownSecs) / 30) * 100;
      if (barShieldCooldown) barShieldCooldown.style.width = `${pct}%`;
      if (shieldCooldownTime) shieldCooldownTime.textContent = `00:${cooldownSecs.toString().padStart(2, '0')} (Cooling)`;

      if (cooldownSecs <= 0) {
        clearInterval(shieldTimer!);
        if (shieldStatusBadge) {
          shieldStatusBadge.className = 'px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 text-[10px]';
          shieldStatusBadge.textContent = 'ARMOR ONLINE';
        }
        if (shieldCooldownTime) shieldCooldownTime.textContent = '00:00 (Idle)';
        if (barShieldCooldown) barShieldCooldown.style.width = '0%';

        if (shieldTerminalStdout) {
          shieldTerminalStdout.innerHTML += `
            <div class="text-emerald-400 font-bold">[COOLDOWN COMPLETE] 429 counter reset. Soft tab cycles safely resumed.</div>
          `;
          shieldTerminalStdout.scrollTop = shieldTerminalStdout.scrollHeight;
        }
      }
    }, 1000);
  });

  btnResetShield?.addEventListener('click', () => {
    if (shieldTimer) clearInterval(shieldTimer);
    if (shieldStatusBadge) {
      shieldStatusBadge.className = 'px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 text-[10px]';
      shieldStatusBadge.textContent = 'ARMOR ONLINE';
    }
    if (shieldCooldownTime) shieldCooldownTime.textContent = '00:00 (Idle)';
    if (barShieldCooldown) barShieldCooldown.style.width = '0%';
  });
</script>
