---
// SwiftPdfSimulator.astro
// Interactive SWIFT MT103 Wire Transfer Document Redaction & Arabic BiDi Typography Simulator
---

<div class="rounded-3xl border border-cyan-500/30 bg-slate-900/90 backdrop-blur-xl p-5 sm:p-7 shadow-2xl relative overflow-hidden">
  <!-- Ambient Glow -->
  <div class="absolute -top-24 -right-24 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Header Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b border-slate-800 gap-3">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-400 font-mono text-sm border border-cyan-500/40">
          📄
        </span>
        <div>
          <h3 class="text-base sm:text-lg font-bold text-white tracking-wide">
            Interactive SWIFT MT103 Wire Redactor &amp; BiDi Engine
          </h3>
          <p class="text-xs text-slate-400 mt-0.5">
            Test sub-pixel text replacement, Arabic RTL font reshaping, and true cryptographic stream sanitization.
          </p>
        </div>
      </div>
    </div>

    <!-- Mode Badge -->
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        PyMuPDF VECTOR ENGINE ACTIVE
      </span>
    </div>
  </div>

  <!-- Interactive Controls Bar -->
  <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-2.5">
    <button
      id="btn-toggle-redact"
      class="px-3 py-2.5 rounded-xl text-xs font-mono font-semibold transition-all border text-left bg-slate-800 text-slate-300 border-slate-700 hover:border-slate-500"
    >
      <div class="font-bold flex items-center justify-between">
        <span>🔒 Cryptographic Redaction</span>
        <span class="text-[10px] text-slate-400" id="redact-state-badge">OFF</span>
      </div>
      <div class="text-[10px] text-slate-400 mt-0.5">Wipe secret IBAN &amp; amount from PDF bytes</div>
    </button>

    <button
      id="btn-toggle-bidi"
      class="px-3 py-2.5 rounded-xl text-xs font-mono font-semibold transition-all border text-left bg-cyan-500/20 text-cyan-200 border-cyan-500/40 shadow-sm"
    >
      <div class="font-bold flex items-center justify-between">
        <span>🌐 Arabic BiDi Reshaper</span>
        <span class="text-[10px] text-cyan-300" id="bidi-state-badge">ACTIVE</span>
      </div>
      <div class="text-[10px] text-slate-400 mt-0.5">Fixes reverse &amp; disconnected Arabic glyphs</div>
    </button>

    <button
      id="btn-toggle-bbox"
      class="px-3 py-2.5 rounded-xl text-xs font-mono font-semibold transition-all border text-left bg-slate-800 text-slate-300 border-slate-700 hover:border-slate-500"
    >
      <div class="font-bold flex items-center justify-between">
        <span>📐 Sub-Pixel Bounding Boxes</span>
        <span class="text-[10px] text-slate-400" id="bbox-state-badge">OFF</span>
      </div>
      <div class="text-[10px] text-slate-400 mt-0.5">Show exact fitz.Rect() vector bounds</div>
    </button>
  </div>

  <!-- Document Viewport -->
  <div class="mt-5 p-4 sm:p-6 rounded-2xl bg-slate-950 border border-slate-800 text-slate-200 font-mono text-xs space-y-4 shadow-inner relative overflow-hidden">
    <!-- SWIFT MT103 Paper Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-800 pb-3 gap-2">
      <div>
        <div class="text-[10px] text-cyan-400 uppercase tracking-widest font-bold">FIN 103 CUSTOMER TRANSFER CONFIRMATION</div>
        <div class="text-sm font-bold text-white mt-0.5">S.W.I.F.T. SOCIETY FOR WORLDWIDE INTERBANK FINANCIAL TELECOMMUNICATION</div>
      </div>
      <div class="text-[11px] text-slate-400 font-sans">
        SENDER: <span class="text-cyan-300 font-mono font-bold">HSBCBDDHXXX</span> • RECEIVER: <span class="text-emerald-300 font-mono font-bold">SCBLSGSGXXX</span>
      </div>
    </div>

    <!-- Document Fields Grid -->
    <div class="space-y-3 pt-1">
      <!-- Field 20: Transaction Reference -->
      <div class="field-row p-2.5 rounded-lg bg-slate-900/60 border border-transparent transition-all" id="row-field20">
        <span class="text-slate-500 text-[11px] block">:20: SENDER'S REFERENCE</span>
        <span class="text-slate-100 font-bold">FT261028-994108872</span>
        <span class="bbox-tag hidden ml-2 text-[10px] text-cyan-400 bg-cyan-950 px-1.5 py-0.5 rounded border border-cyan-500/40">fitz.Rect(72.0, 142.1, 230.4, 155.0)</span>
      </div>

      <!-- Field 32A: Value Date & Amount (Subject to Redaction) -->
      <div class="field-row p-2.5 rounded-lg bg-slate-900/60 border border-transparent transition-all" id="row-field32">
        <span class="text-slate-500 text-[11px] block">:32A: VALUE DATE / CURRENCY / INTERBANK SETTLED AMOUNT</span>
        <div class="flex items-center gap-2 mt-0.5">
          <span class="text-slate-300">Date: 261028 (28 OCT 2026) |</span>
          <span id="field-amount" class="text-emerald-400 font-bold text-sm">USD 30,000.00</span>
          <span class="bbox-tag hidden ml-2 text-[10px] text-cyan-400 bg-cyan-950 px-1.5 py-0.5 rounded border border-cyan-500/40">fitz.Rect(185.0, 184.2, 310.8, 198.5)</span>
        </div>
      </div>

      <!-- Field 50K: Ordering Customer -->
      <div class="field-row p-2.5 rounded-lg bg-slate-900/60 border border-transparent transition-all" id="row-field50">
        <span class="text-slate-500 text-[11px] block">:50K: ORDERING CUSTOMER</span>
        <span class="text-slate-200">HK TIANHAO INDUSTRIAL LIMITED / 88 QUEENSWAY CENTRAL, HONG KONG</span>
        <span class="bbox-tag hidden ml-2 text-[10px] text-cyan-400 bg-cyan-950 px-1.5 py-0.5 rounded border border-cyan-500/40">fitz.Rect(72.0, 226.0, 480.0, 240.2)</span>
      </div>

      <!-- Field 59: Beneficiary Customer & IBAN (Subject to Redaction & Arabic BiDi) -->
      <div class="field-row p-2.5 rounded-lg bg-slate-900/60 border border-transparent transition-all" id="row-field59">
        <span class="text-slate-500 text-[11px] block">:59: BENEFICIARY CUSTOMER / ACCOUNT NUMBER</span>
        <div class="space-y-1 mt-0.5">
          <div class="flex items-center gap-2">
            <span class="text-slate-400">IBAN:</span>
            <span id="field-iban" class="text-cyan-300 font-bold">SG77 SCBL 0001 2948 5501 92</span>
            <span class="bbox-tag hidden ml-2 text-[10px] text-cyan-400 bg-cyan-950 px-1.5 py-0.5 rounded border border-cyan-500/40">fitz.Rect(110.0, 268.0, 340.5, 282.0)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-slate-400">Beneficiary Name:</span>
            <span id="field-arabic" class="text-amber-300 font-sans font-bold text-sm">شركة التجارة العربية (Arabian Trading Est.)</span>
            <span class="bbox-tag hidden ml-2 text-[10px] text-cyan-400 bg-cyan-950 px-1.5 py-0.5 rounded border border-cyan-500/40">fitz.Rect(165.0, 288.4, 450.0, 304.0)</span>
          </div>
        </div>
      </div>

      <!-- Field 70: Remittance Information -->
      <div class="field-row p-2.5 rounded-lg bg-slate-900/60 border border-transparent transition-all" id="row-field70">
        <span class="text-slate-500 text-[11px] block">:70: REMITTANCE INFORMATION</span>
        <span class="text-slate-300">COMMERCIAL INVOICE #INV-84910 - INDUSTRIAL COMPONENTS BATCH 4</span>
      </div>
    </div>

    <!-- Security Watermark / Stamp -->
    <div class="pt-2 flex items-center justify-between border-t border-slate-800 text-[10px] text-slate-500">
      <span>AUTH DIGEST: SHA-256 [08cf4910b830...771a]</span>
      <span class="text-emerald-400 font-bold">BANK VERIFICATION STATUS: 100% VALID VECTOR STREAM</span>
    </div>
  </div>

  <!-- Live Vector Execution Log Terminal -->
  <div class="mt-4 rounded-2xl bg-slate-950 border border-slate-800 p-4 font-mono text-xs space-y-2 shadow-inner">
    <div class="flex items-center justify-between text-[11px] pb-2 border-b border-slate-800">
      <span class="text-slate-400 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>PyMuPDF VECTOR REDACTION LOG</span>
      </span>
      <span class="text-emerald-400 text-[10px]" id="log-status">STATUS: IDLE • READY FOR VECTOR CALL</span>
    </div>
    <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800/80 text-[11px] leading-relaxed text-slate-300 font-mono overflow-x-auto space-y-1" id="vector-console">
      <div class="text-cyan-400">[PyMuPDF Core] Document loaded: HK TIANHAO INDUSTRIAL LIMITED = 30000 USD.PDF (Pages: 1)</div>
      <div class="text-slate-400">[Typography Scan] Sampled font 'Helvetica-Bold' at baseline y1 - 2.2pt (Font size: 11.0pt)</div>
      <div class="text-emerald-400">[BiDi Engine] Arabic glyph sequence detected in span :59: -> applied arabic_reshaper + bidi display layout</div>
      <div class="text-slate-400">[Vector Safety] Zero residual text streams. Memory stream clean.</div>
    </div>
  </div>
</div>

<script>
  let isRedacted = false;
  let isBidiActive = true;
  let isBboxVisible = false;

  const btnRedact = document.getElementById('btn-toggle-redact');
  const btnBidi = document.getElementById('btn-toggle-bidi');
  const btnBbox = document.getElementById('btn-toggle-bbox');

  const redactBadge = document.getElementById('redact-state-badge');
  const bidiBadge = document.getElementById('bidi-state-badge');
  const bboxBadge = document.getElementById('bbox-state-badge');

  const fieldAmount = document.getElementById('field-amount');
  const fieldIban = document.getElementById('field-iban');
  const fieldArabic = document.getElementById('field-arabic');

  const bboxTags = document.querySelectorAll('.bbox-tag');
  const fieldRows = document.querySelectorAll('.field-row');
  const vectorConsole = document.getElementById('vector-console');
  const logStatus = document.getElementById('log-status');

  function addLog(msg: string, colorClass = 'text-slate-300') {
    if (!vectorConsole) return;
    const line = document.createElement('div');
    line.className = colorClass;
    line.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
    vectorConsole.appendChild(line);
    vectorConsole.scrollTop = vectorConsole.scrollHeight;
  }

  // Redaction Toggle
  btnRedact?.addEventListener('click', () => {
    isRedacted = !isRedacted;
    if (isRedacted) {
      if (redactBadge) redactBadge.textContent = 'ACTIVE';
      btnRedact.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
      btnRedact.classList.add('bg-rose-500/20', 'text-rose-300', 'border-rose-500/40');

      if (fieldAmount) {
        fieldAmount.innerHTML = '<span class="bg-black text-black select-none px-2 py-0.5 rounded border border-rose-500/50">████████████</span>';
      }
      if (fieldIban) {
        fieldIban.innerHTML = '<span class="bg-black text-black select-none px-2 py-0.5 rounded border border-rose-500/50">██████████████████████</span>';
      }

      if (logStatus) logStatus.textContent = 'STATUS: CRYPTOGRAPHIC REDACTION APPLIED';
      addLog("fitz.Page.add_redact_annot() applied to Field :32A and :59: IBAN", "text-rose-400 font-bold");
      addLog("fitz.Page.apply_redactions() -> scrubbed raw character streams & glyph offsets permanently", "text-emerald-400");
    } else {
      if (redactBadge) redactBadge.textContent = 'OFF';
      btnRedact.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
      btnRedact.classList.remove('bg-rose-500/20', 'text-rose-300', 'border-rose-500/40');

      if (fieldAmount) fieldAmount.textContent = 'USD 30,000.00';
      if (fieldIban) fieldIban.textContent = 'SG77 SCBL 0001 2948 5501 92';

      if (logStatus) logStatus.textContent = 'STATUS: ORIGINAL VECTOR STREAM RESTORED';
      addLog("Redaction annotations cleared. Document restored to initial vector state.", "text-cyan-300");
    }
  });

  // BiDi Arabic Toggle
  btnBidi?.addEventListener('click', () => {
    isBidiActive = !isBidiActive;
    if (isBidiActive) {
      if (bidiBadge) bidiBadge.textContent = 'ACTIVE';
      btnBidi.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
      btnBidi.classList.add('bg-cyan-500/20', 'text-cyan-200', 'border-cyan-500/40');

      if (fieldArabic) fieldArabic.textContent = 'شركة التجارة العربية (Arabian Trading Est.)';
      addLog("BiDi layout engine active: correctly reshaped Arabic glyphs using Tajawal font", "text-emerald-400");
    } else {
      if (bidiBadge) bidiBadge.textContent = 'BROKEN LTR';
      btnBidi.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
      btnBidi.classList.remove('bg-cyan-500/20', 'text-cyan-200', 'border-cyan-500/40');

      // Emulate broken naive LTR PDF rendering
      if (fieldArabic) fieldArabic.textContent = 'ة ي ب ر ع ل ا   ة ر ا ج ت ل ا (Arabian Trading Est.)';
      addLog("WARNING: Naive PDF engine inverted Arabic glyphs: 'ة ي ب ر ع ل ا' (Broken LTR Rendering)", "text-amber-400 font-bold");
    }
  });

  // Bounding Box Toggle
  btnBbox?.addEventListener('click', () => {
    isBboxVisible = !isBboxVisible;
    if (isBboxVisible) {
      if (bboxBadge) bboxBadge.textContent = 'VISIBLE';
      btnBbox.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
      btnBbox.classList.add('bg-emerald-500/20', 'text-emerald-200', 'border-emerald-500/40');

      bboxTags.forEach(el => el.classList.remove('hidden'));
      fieldRows.forEach(el => el.classList.add('border-cyan-500/40', 'bg-cyan-950/20'));
      addLog("Extracted sub-pixel character quad bounds via fitz.Page.get_text('dict')", "text-cyan-300");
    } else {
      if (bboxBadge) bboxBadge.textContent = 'OFF';
      btnBbox.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
      btnBbox.classList.remove('bg-emerald-500/20', 'text-emerald-200', 'border-emerald-500/40');

      bboxTags.forEach(el => el.classList.add('hidden'));
      fieldRows.forEach(el => el.classList.remove('border-cyan-500/40', 'bg-cyan-950/20'));
      addLog("Sub-pixel bounding box overlays hidden.", "text-slate-400");
    }
  });
</script>
