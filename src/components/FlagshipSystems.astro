---
// Flagship Engineered Systems Component
---

<section id="systems" class="space-y-8 scroll-mt-24 pt-8">
  <!-- Section Heading -->
  <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-theme-border pb-4 gap-4">
    <div>
      <div class="flex items-center gap-2 text-theme-accent font-mono text-xs tracking-wider uppercase mb-1">
        <svg class="w-4 h-4 text-theme-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Proven Real-World Systems</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-theme-primary">Flagship Automated Solutions</h2>
    </div>
    <p class="text-sm text-theme-muted max-w-md">
      Tested in commercial buildings, factories, and corporate offices across Bangladesh with 100% crash-proof reliability.
    </p>
  </div>

  <!-- Spotlight Hero Card: PMS-V2 (Smart Parking Engine) -->
  <div class="rounded-3xl border border-theme-border bg-theme-card backdrop-blur-md overflow-hidden transition-all duration-300 hover:border-theme-accent/60 hover:shadow-[0_10px_35px_var(--accent-glow)]">
    <!-- Spotlight Top Bar -->
    <div class="p-5 sm:p-6 border-b border-theme-border flex flex-wrap items-center justify-between gap-4 bg-theme-base/60">
      <div class="space-y-1">
        <div class="flex items-center gap-3 flex-wrap">
          <h3 class="text-xl sm:text-2xl font-bold text-theme-primary">PMS-V2: Automated Smart Parking System</h3>
          <span class="px-2.5 py-0.5 rounded-full text-theme-secondaryAccent bg-theme-secondaryAccent/10 border border-theme-secondaryAccent/30 font-mono text-xs flex items-center gap-1.5">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-theme-secondaryAccent opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-theme-secondaryAccent"></span>
            </span>
            Active in Commercial Production
          </span>
        </div>
        <p class="text-xs sm:text-sm text-theme-muted">Stops parking revenue leakage, eliminates manual ticket delays, and opens barrier gates automatically via instant vehicle license plate recognition.</p>
      </div>

      <!-- Low-Latency Badges & Case Study Link -->
      <div class="flex items-center gap-2.5 flex-wrap">
        <span class="px-2.5 py-1 rounded-lg bg-theme-base border border-theme-border font-mono text-xs text-theme-accent">&lt;0.84s Instant Gate Open</span>
        <span class="px-2.5 py-1 rounded-lg bg-theme-base border border-theme-border font-mono text-xs text-theme-secondaryAccent">100% Leak-Proof Billing</span>
        <a
          href="/systems/pms-v2"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-theme-accent/10 hover:bg-theme-accent/20 text-theme-accent border border-theme-accent/30 hover:border-theme-accent text-xs font-mono font-semibold transition-all hover:scale-[1.02] shadow-sm"
        >
          <span>Read Full Case Study</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Interactive Two-Tab Spec View -->
    <div class="p-5 sm:p-6 space-y-6">
      <!-- Tab Controls -->
      <div class="flex border-b border-theme-border gap-6 text-sm">
        <button
          type="button"
          id="btn-tab-arch"
          class="pb-2.5 text-theme-accent border-b-2 border-theme-accent font-medium flex items-center gap-2 transition-all cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span>How It Works (System Flow)</span>
        </button>
        <button
          type="button"
          id="btn-tab-telemetry"
          class="pb-2.5 text-theme-muted hover:text-theme-primary border-b-2 border-transparent font-medium flex items-center gap-2 transition-all cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Live Production Activity Feed</span>
          <span class="w-2 h-2 rounded-full bg-theme-secondaryAccent animate-pulse"></span>
        </button>
      </div>

      <!-- Tab Content 1: Topology Microservices Node Map -->
      <div id="content-tab-arch" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 transition-all">
        <!-- Stage 01 -->
        <div class="p-4 rounded-2xl bg-theme-base border border-theme-border space-y-2 hover:border-theme-accent/50 hover:-translate-y-1 transition-all group">
          <div class="flex items-center justify-between text-theme-accent font-mono text-[10px] uppercase tracking-wider">
            <span>STAGE 01: SMART DETECTION</span>
            <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="font-mono text-sm text-theme-primary font-semibold">Frigate AI Camera OCR</div>
          <p class="text-xs text-theme-muted leading-relaxed">Identifies Bangladeshi and international license plates in milliseconds, even in rain or low night light.</p>
        </div>

        <!-- Stage 02 -->
        <div class="p-4 rounded-2xl bg-theme-base border border-theme-border space-y-2 hover:border-theme-secondaryAccent/50 hover:-translate-y-1 transition-all group">
          <div class="flex items-center justify-between text-theme-secondaryAccent font-mono text-[10px] uppercase tracking-wider">
            <span>STAGE 02: INSTANT DECISION</span>
            <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
            </svg>
          </div>
          <div class="font-mono text-sm text-theme-primary font-semibold">Rust Concurrency Core</div>
          <p class="text-xs text-theme-muted leading-relaxed">Checks subscriptions, tariffs, and parking slot availability in under 50ms without server slowdowns.</p>
        </div>

        <!-- Stage 03 -->
        <div class="p-4 rounded-2xl bg-theme-base border border-theme-border space-y-2 hover:border-theme-accent/50 hover:-translate-y-1 transition-all group">
          <div class="flex items-center justify-between text-theme-accent font-mono text-[10px] uppercase tracking-wider">
            <span>STAGE 03: GATE AUTOMATION</span>
            <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
          </div>
          <div class="font-mono text-sm text-theme-primary font-semibold">Relay & Safety Sensors</div>
          <p class="text-xs text-theme-muted leading-relaxed">Signals physical barrier gates to lift immediately, with ground loop safety sensors that never hit a car or person.</p>
        </div>

        <!-- Stage 04 -->
        <div class="p-4 rounded-2xl bg-theme-base border border-theme-border space-y-2 hover:border-theme-primary/50 hover:-translate-y-1 transition-all group">
          <div class="flex items-center justify-between text-theme-muted font-mono text-[10px] uppercase tracking-wider">
            <span>STAGE 04: ZERO LEAKAGE</span>
            <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7M4 7c0-2 1.5-3 3.5-3h9c2 0 3.5 1 3.5 3M4 7h16m-16 5h16" />
            </svg>
          </div>
          <div class="font-mono text-sm text-theme-primary font-semibold">PostgreSQL Audit Ledger</div>
          <p class="text-xs text-theme-muted leading-relaxed">Every vehicle entry, exit, payment, and discount is permanently recorded, stopping cash theft or employee manipulation.</p>
        </div>
      </div>

      <!-- Tab Content 2: Live Telemetry Stream Terminal -->
      <div id="content-tab-telemetry" class="hidden rounded-2xl bg-theme-base border border-theme-border p-4 font-mono text-xs space-y-2 overflow-x-auto shadow-inner">
        <div class="text-theme-muted border-b border-theme-border pb-2 mb-2 flex justify-between items-center text-[11px]">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-theme-secondaryAccent animate-ping"></span>
            <span>[PARKING-CONTROLLER-LOG: lane01.commercial.prod]</span>
          </span>
          <span class="text-theme-secondaryAccent flex items-center gap-1.5">
            <span>HARDWARE STATUS: HEALTHY</span>
            <span class="text-theme-border">|</span>
            <span class="text-theme-accent">TOKIO REACTOR 16 CORES</span>
          </span>
        </div>
        <div class="space-y-1.5 text-xs text-theme-secondary">
          <div><span class="text-theme-muted">14:02:18.004</span> [SMART-CAMERA] Inbound vehicle detected in Lane 01 (Confidence: 0.984)</div>
          <div class="text-theme-accent"><span class="text-theme-muted">14:02:18.012</span> [PLATE-READER] Plate identified: <span class="text-theme-secondaryAccent font-bold">DHK-METRO-GA-44-2190</span> (Speed: 0.048ms)</div>
          <div><span class="text-theme-muted">14:02:18.018</span> [SECURITY-CHECK] Anti-passback verification: <span class="text-theme-secondaryAccent">PASSED</span> (Valid entry authorization)</div>
          <div class="text-theme-secondaryAccent"><span class="text-theme-muted">14:02:18.022</span> [BILLING-ENGINE] Tariff calculated: Commercial Standard Hourly Rate</div>
          <div class="text-theme-accent"><span class="text-theme-muted">14:02:18.029</span> [GATE-CONTROLLER] Dispatching pulse: OPEN barrier gate 01</div>
          <div class="text-theme-secondaryAccent font-medium"><span class="text-theme-muted">14:02:18.079</span> [SYSTEM-AUDIT] Barrier fully raised. Lane entry event committed to financial database tx-1049221.</div>
        </div>
        <div class="pt-2 text-theme-accent text-[11px] flex items-center gap-1">
          <span>&gt; listening on /dev/ttyUSB0 (9600-8-N-1)</span>
          <span class="inline-block w-2 h-3.5 bg-theme-accent animate-pulse"></span>
        </div>
      </div>

      <!-- Tech Stack Badges & Metrics -->
      <div class="flex flex-wrap items-center justify-between pt-4 border-t border-theme-border gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-1 rounded-lg bg-theme-base border border-theme-border font-mono text-xs text-theme-primary">Rust 2024</span>
          <span class="px-2.5 py-1 rounded-lg bg-theme-base border border-theme-border font-mono text-xs text-theme-primary">Axum 0.8</span>
          <span class="px-2.5 py-1 rounded-lg bg-theme-base border border-theme-border font-mono text-xs text-theme-primary">Tokio Async</span>
          <span class="px-2.5 py-1 rounded-lg bg-theme-base border border-theme-border font-mono text-xs text-theme-primary">SeaORM</span>
          <span class="px-2.5 py-1 rounded-lg bg-theme-base border border-theme-border font-mono text-xs text-theme-primary">PostgreSQL 16</span>
          <span class="px-2.5 py-1 rounded-lg bg-theme-base border border-theme-border font-mono text-xs text-theme-primary">Flutter POS</span>
        </div>
        <div class="flex items-center gap-4 font-mono text-xs text-theme-muted">
          <span class="flex items-center gap-1.5"><span class="text-theme-accent">⚡</span> 12 Sub-daemons</span>
          <span class="flex items-center gap-1.5 text-theme-secondaryAccent"><span class="w-1.5 h-1.5 rounded-full bg-theme-secondaryAccent"></span> 0 Drops Under 10k RPS</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Split Row Below: Card A (Enterprise HRMS) & Card B (Activity Monitor) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Card A: Enterprise Skylink HRMS Suite -->
    <div class="p-6 rounded-3xl border border-theme-border bg-theme-card backdrop-blur-md space-y-4 hover:border-theme-accent/50 hover:-translate-y-1 transition-all duration-300">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-theme-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 004 11m0 0a8 8 0 00.99 7.132" />
          </svg>
          <h3 class="text-lg font-bold text-theme-primary">Skylink HRMS: Automated Biometric Attendance & Payroll</h3>
        </div>
        <span class="font-mono text-xs text-theme-secondaryAccent bg-theme-secondaryAccent/10 px-2 py-0.5 rounded-lg border border-theme-secondaryAccent/30 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-theme-secondaryAccent"></span>
          Hardware + Cloud
        </span>
      </div>

      <p class="text-sm text-theme-muted leading-relaxed">
        Solves 9:00 AM shift-change rush: handles thousands of factory and corporate workers clocking in simultaneously without missing records, server crashes, or payroll disputes.
      </p>

      <!-- Packet Trace Preview Box -->
      <div class="p-3.5 rounded-2xl bg-theme-base border border-theme-border font-mono text-xs space-y-1.5">
        <div class="text-theme-muted text-[10px] flex items-center justify-between uppercase">
          <span>HIGH-VOLUME WORKER RUSH INGESTION</span>
          <span class="text-theme-secondaryAccent font-bold">ZERO LOST PUNCHES</span>
        </div>
        <div class="text-theme-accent truncate font-semibold">POST /iclock/cdata (ZKTeco Biometric Terminal Sync)</div>
        <div class="text-theme-secondaryAccent text-[11px]">Java 21 Virtual Threads processes 10,000+ simultaneous punches with instant WhatsApp/SMS check-in alerts.</div>
      </div>

      <!-- Tech Badges -->
      <div class="pt-2 flex flex-wrap gap-2 border-t border-theme-border">
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">Java 21 LTS</span>
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">Spring Boot 3.4</span>
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">ZKTeco Hardware</span>
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">Automated Payroll</span>
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">PostgreSQL 16</span>
      </div>
    </div>

    <!-- Card B: Workstation Activity Monitor -->
    <div class="p-6 rounded-3xl border border-theme-border bg-theme-card backdrop-blur-md space-y-4 hover:border-theme-accent/50 hover:-translate-y-1 transition-all duration-300">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-theme-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <h3 class="text-lg font-bold text-theme-primary">Enterprise Workstation & Productivity Guard</h3>
        </div>
        <span class="font-mono text-xs text-theme-accent bg-theme-accent/10 px-2 py-0.5 rounded-lg border border-theme-accent/30 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-theme-accent"></span>
          Ultra-Lightweight Agent
        </span>
      </div>

      <p class="text-sm text-theme-muted leading-relaxed">
        Tracks team productive hours, security compliance, and focus drift with 99% less computer memory than commercial surveillance tools — completely unblockable and crash-proof.
      </p>

      <!-- Metrics Box -->
      <div class="p-3.5 rounded-2xl bg-theme-base border border-theme-border font-mono text-xs space-y-1.5">
        <div class="text-theme-muted text-[10px] flex items-center justify-between uppercase">
          <span>EFFICIENCY & DATA PRIVACY</span>
          <span class="text-theme-secondaryAccent font-bold">&lt;0.01% CPU IMPACT</span>
        </div>
        <div class="text-theme-primary truncate font-semibold">Bank-grade AES-256 local encrypted buffer queue</div>
        <div class="text-theme-secondaryAccent text-[11px]">&lt; 14MB RAM (Won't slow down work) • Works 100% offline with zero data loss.</div>
      </div>

      <!-- Tech Badges -->
      <div class="pt-2 flex flex-wrap gap-2 border-t border-theme-border">
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">Chrome MV3</span>
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">TypeScript</span>
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">Spring Boot 3.4</span>
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">Offline Auto-Sync</span>
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">Encrypted Storage</span>
      </div>
    </div>

    <!-- Card C: ImageUpscale Pro (Photo & Document Quality Enhancer) -->
    <div class="p-6 rounded-3xl border border-cyan-500/40 bg-theme-card backdrop-blur-md space-y-4 hover:border-cyan-400 hover:-translate-y-1 transition-all duration-300 md:col-span-2">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class="text-lg font-bold text-theme-primary">ImageUpscale Pro: Instant Photo &amp; Document Enhancer</h3>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/40">
                100% Offline &amp; Private
              </span>
            </div>
            <p class="text-xs text-theme-muted mt-0.5">Turns blurry, low-resolution photos into crisp HD visuals in milliseconds — zero cloud uploads, zero subscriptions.</p>
          </div>
        </div>

        <a
          href="/systems/image-upscale-simd"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 hover:border-cyan-400 text-xs font-mono font-semibold transition-all hover:scale-[1.02] shadow-sm self-start sm:self-auto"
        >
          <span>See Live Demo &amp; Results</span>
          <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Human-Centric Value Highlights Box -->
      <div class="p-3.5 rounded-2xl bg-theme-base border border-theme-border font-mono text-xs grid grid-cols-2 sm:grid-cols-4 gap-2">
        <div>
          <span class="text-theme-muted text-[10px] uppercase block">Processing Speed</span>
          <span class="text-emerald-400 font-bold">292 Photos / Sec</span>
        </div>
        <div>
          <span class="text-theme-muted text-[10px] uppercase block">Speed Per Photo</span>
          <span class="text-cyan-300 font-bold">3.43 ms (Instant)</span>
        </div>
        <div>
          <span class="text-theme-muted text-[10px] uppercase block">Computer Memory</span>
          <span class="text-theme-primary font-bold">&lt; 25 MB RAM (Zero Lag)</span>
        </div>
        <div>
          <span class="text-theme-muted text-[10px] uppercase block">Privacy &amp; Safety</span>
          <span class="text-emerald-300 font-bold">100% Stays On Your PC</span>
        </div>
      </div>

      <!-- Tech Badges -->
      <div class="pt-2 flex flex-wrap gap-2 border-t border-theme-border">
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">E-Commerce Ready</span>
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">NID / Document OCR</span>
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">Vintage Photo Restoration</span>
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">Free &amp; Open Source</span>
        <span class="px-2 py-0.5 rounded-lg bg-theme-base border border-theme-border font-mono text-[11px] text-theme-muted">Rust Powered</span>
      </div>
    </div>
  </div>
</section>

<script>
  const btnArch = document.getElementById('btn-tab-arch');
  const btnTelemetry = document.getElementById('btn-tab-telemetry');
  const contentArch = document.getElementById('content-tab-arch');
  const contentTelemetry = document.getElementById('content-tab-telemetry');

  btnArch?.addEventListener('click', () => {
    btnArch.className = 'pb-2.5 text-theme-accent border-b-2 border-theme-accent font-medium flex items-center gap-2 transition-all cursor-pointer';
