---
// Command Palette & Hotkeys Matrix Modal Component — Swiss Architectural
---

<div
  id="hotkeys-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 overflow-y-auto hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="hotkeys-title"
  aria-hidden="true"
  inert
>
  <!-- Backdrop Overlay -->
  <div id="hotkeys-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-md transition-opacity duration-200"></div>

  <!-- Modal Dialog Container -->
  <div class="relative w-full max-w-lg bg-theme-lowest border-2 border-theme-secondary rounded-sm shadow-2xl p-6 sm:p-8 z-10 space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-theme-border pb-3">
      <div>
        <span class="font-mono text-xs text-theme-accent font-semibold uppercase tracking-wider block">
          // SYSTEM TELEMETRY :: COMMAND MATRIX
        </span>
        <h2 id="hotkeys-title" class="text-lg sm:text-xl font-bold text-theme-primary mt-0.5">
          Keyboard Shortcuts &amp; Navigation
        </h2>
      </div>

      <button
        id="btn-close-hotkeys"
        type="button"
        class="p-1.5 rounded-sm text-theme-muted hover:text-theme-primary hover:bg-theme-surface transition-colors cursor-pointer"
        aria-label="Close shortcuts modal"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Shortcuts List -->
    <div class="space-y-2.5 font-mono text-xs text-theme-secondary">
      <button
        type="button"
        data-action="search"
        class="cmd-matrix-row w-full flex items-center justify-between p-2.5 bg-theme-surface border border-theme-border rounded-sm hover:border-theme-secondary hover:bg-theme-lowest transition-all text-left cursor-pointer group"
      >
        <div class="flex items-center gap-2">
          <kbd class="px-2 py-1 bg-theme-lowest group-hover:bg-theme-surface border border-theme-border rounded-sm font-bold text-theme-primary shadow-sm">/</kbd>
          <span class="text-theme-primary group-hover:text-theme-accent transition-colors font-medium">Instant Filter &amp; Search</span>
        </div>
        <span class="text-[11px] text-theme-muted">Filters 25 Flagship Modules</span>
      </button>

      <button
        type="button"
        data-action="dossier"
        class="cmd-matrix-row w-full flex items-center justify-between p-2.5 bg-theme-surface border border-theme-border rounded-sm hover:border-theme-secondary hover:bg-theme-lowest transition-all text-left cursor-pointer group"
      >
        <div class="flex items-center gap-2">
          <kbd class="px-2 py-1 bg-theme-lowest group-hover:bg-theme-surface border border-theme-border rounded-sm font-bold text-theme-primary shadow-sm">D</kbd>
          <span class="text-theme-primary group-hover:text-theme-accent transition-colors font-medium">Resume Dossier</span>
        </div>
        <span class="text-[11px] text-theme-muted">Printable Systems CV</span>
      </button>

      <button
        type="button"
        data-action="theme"
        class="cmd-matrix-row w-full flex items-center justify-between p-2.5 bg-theme-surface border border-theme-border rounded-sm hover:border-theme-secondary hover:bg-theme-lowest transition-all text-left cursor-pointer group"
      >
        <div class="flex items-center gap-2">
          <kbd class="px-2 py-1 bg-theme-lowest group-hover:bg-theme-surface border border-theme-border rounded-sm font-bold text-theme-primary shadow-sm">T</kbd>
          <span class="text-theme-primary group-hover:text-theme-accent transition-colors font-medium">Cycle Visual Theme</span>
        </div>
        <span class="text-[11px] text-theme-muted">6 System Editions</span>
      </button>

      <button
        type="button"
        data-action="share"
        class="cmd-matrix-row w-full flex items-center justify-between p-2.5 bg-theme-surface border border-theme-border rounded-sm hover:border-theme-secondary hover:bg-theme-lowest transition-all text-left cursor-pointer group"
      >
        <div class="flex items-center gap-2">
          <kbd class="px-2 py-1 bg-theme-lowest group-hover:bg-theme-surface border border-theme-border rounded-sm font-bold text-theme-primary shadow-sm">S</kbd>
          <span class="text-theme-primary group-hover:text-theme-accent transition-colors font-medium">Share System Spec</span>
        </div>
        <span class="text-[11px] text-theme-muted">Web Share / Copy URL</span>
      </button>

      <button
        type="button"
        data-action="gpg"
        class="cmd-matrix-row w-full flex items-center justify-between p-2.5 bg-theme-surface border border-theme-border rounded-sm hover:border-theme-secondary hover:bg-theme-lowest transition-all text-left cursor-pointer group"
      >
        <div class="flex items-center gap-2">
          <kbd class="px-2 py-1 bg-theme-lowest group-hover:bg-theme-surface border border-theme-border rounded-sm font-bold text-theme-primary shadow-sm">G</kbd>
          <span class="text-theme-primary group-hover:text-theme-accent transition-colors font-medium">GPG Key &amp; Fingerprint</span>
        </div>
        <span class="text-[11px] text-theme-muted">Cryptographic Proof</span>
      </button>

      <button
        type="button"
        data-action="flip"
        class="cmd-matrix-row w-full flex items-center justify-between p-2.5 bg-theme-surface border border-theme-border rounded-sm hover:border-theme-secondary hover:bg-theme-lowest transition-all text-left cursor-pointer group"
      >
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1">
            <kbd class="px-2 py-1 bg-theme-lowest group-hover:bg-theme-surface border border-theme-border rounded-sm font-bold text-theme-primary shadow-sm">[</kbd>
            <kbd class="px-2 py-1 bg-theme-lowest group-hover:bg-theme-surface border border-theme-border rounded-sm font-bold text-theme-primary shadow-sm">]</kbd>
          </div>
          <span class="text-theme-primary group-hover:text-theme-accent transition-colors font-medium">Prev / Next System</span>
        </div>
        <span class="text-[11px] text-theme-muted">Case Study Terminal Flip</span>
      </button>

      <button
        type="button"
        data-action="jump"
        class="cmd-matrix-row w-full flex items-center justify-between p-2.5 bg-theme-surface border border-theme-border rounded-sm hover:border-theme-secondary hover:bg-theme-lowest transition-all text-left cursor-pointer group"
      >
        <div class="flex items-center gap-2">
          <kbd class="px-2 py-1 bg-theme-lowest group-hover:bg-theme-surface border border-theme-border rounded-sm font-bold text-theme-primary shadow-sm">1-6</kbd>
          <span class="text-theme-primary group-hover:text-theme-accent transition-colors font-medium">Jump to Division</span>
        </div>
        <span class="text-[11px] text-theme-muted">Direct Section Teleport</span>
      </button>

      <div class="flex items-center justify-between p-2.5 bg-theme-surface border border-theme-border rounded-sm">
        <div class="flex items-center gap-2">
          <kbd class="px-2 py-1 bg-theme-lowest border border-theme-border rounded-sm font-bold text-theme-primary shadow-sm">?</kbd>
          <span class="text-theme-primary font-medium">Toggle This Matrix</span>
        </div>
        <span class="text-[11px] text-theme-muted">Command Palette</span>
      </div>

      <div class="flex items-center justify-between p-2.5 bg-theme-surface border border-theme-border rounded-sm">
        <div class="flex items-center gap-2">
          <kbd class="px-2 py-1 bg-theme-lowest border border-theme-border rounded-sm font-bold text-theme-primary shadow-sm">Esc</kbd>
          <span class="text-theme-primary font-medium">Dismiss Dialog</span>
        </div>
        <span class="text-[11px] text-theme-muted">Closes Active Modal</span>
      </div>
    </div>

    <!-- Footer Note -->
    <div class="pt-3 border-t border-theme-border flex items-center justify-between font-mono text-[11px] text-theme-muted">
      <span>ZERO-JANK FAST DISPATCH</span>
      <button
        id="btn-dismiss-hotkeys"
        type="button"
        class="px-3 py-1.5 bg-theme-surface border border-theme-border rounded-sm text-theme-primary hover:border-theme-secondary transition-colors cursor-pointer"
      >
        Dismiss (Esc)
      </button>
    </div>
  </div>
</div>

<script>
  const hotkeysModal = document.getElementById('hotkeys-modal');
  const hotkeysBackdrop = document.getElementById('hotkeys-backdrop');
  const closeHotkeysBtn = document.getElementById('btn-close-hotkeys');
  const dismissHotkeysBtn = document.getElementById('btn-dismiss-hotkeys');
  const footerTrigger = document.getElementById('footer-hotkeys-btn');

  let lastActiveElement: HTMLElement | null = null;

  function openHotkeys() {
    lastActiveElement = document.activeElement as HTMLElement;
    hotkeysModal?.classList.remove('hidden');
    hotkeysModal?.removeAttribute('aria-hidden');
    hotkeysModal?.removeAttribute('inert');
    document.body.style.overflow = 'hidden';
    closeHotkeysBtn?.focus();
  }

  function closeHotkeys() {
    hotkeysModal?.classList.add('hidden');
    hotkeysModal?.setAttribute('aria-hidden', 'true');
    hotkeysModal?.setAttribute('inert', '');
    document.body.style.overflow = '';
    lastActiveElement?.focus();
  }

  closeHotkeysBtn?.addEventListener('click', closeHotkeys);
  dismissHotkeysBtn?.addEventListener('click', closeHotkeys);
  hotkeysBackdrop?.addEventListener('click', closeHotkeys);
  footerTrigger?.addEventListener('click', openHotkeys);

  document.querySelectorAll('.cmd-matrix-row').forEach((row) => {
    row.addEventListener('click', () => {
      const action = row.getAttribute('data-action');
      closeHotkeys();

      if (action === 'search') {
        const searchInput = document.getElementById('system-search-input');
        if (searchInput) {
          document.getElementById('systems')?.scrollIntoView({ behavior: 'smooth' });
          searchInput.focus();
        } else {
          window.location.href = '/?focusSearch=1#systems';
        }
      } else if (action === 'dossier') {
        const resumeBtn = document.getElementById('nav-resume-btn') || document.getElementById('hero-resume-btn');
        resumeBtn?.click();
      } else if (action === 'theme') {
        const themes = ['swiss', 'obsidian', 'amber', 'synthwave', 'emerald', 'cleanroom'];
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'swiss';
        const nextTheme = themes[(themes.indexOf(currentTheme) + 1) % themes.length];
        const switcherBtn = document.querySelector(`.theme-dropdown-btn[data-theme="${nextTheme}"]`) as HTMLElement;
        if (switcherBtn) switcherBtn.click();
      } else if (action === 'share') {
        const specShareBtn = document.getElementById('btn-share-spec');
        if (specShareBtn) {
          specShareBtn.click();
        } else {
          const shareData = { title: document.title, url: window.location.href };
          if (navigator.share) {
            navigator.share(shareData).catch(() => {});
          } else if (navigator.clipboard) {
            navigator.clipboard.writeText(window.location.href);
          }
        }
      } else if (action === 'gpg') {
        const gpgBtn = document.querySelector('[data-trigger-gpg="true"]') as HTMLElement;
        gpgBtn?.click();
      } else if (action === 'flip') {
        const nextBtn = (document.getElementById('nav-next-project') || document.getElementById('btn-next-system')) as HTMLAnchorElement;
        if (nextBtn?.href) {
          window.location.href = nextBtn.href;
        } else {
          window.location.href = '/#systems';
        }
      } else if (action === 'jump') {
        const systemsEl = document.getElementById('systems');
        if (systemsEl) {
          systemsEl.scrollIntoView({ behavior: 'smooth' });
          history.pushState(null, '', '#systems');
        } else {
          window.location.href = '/#systems';
        }
      }
    });
  });

  const sectionKeyMap: Record<string, string> = {
    '1': 'systems',
    '2': 'deployments',
    '3': 'arsenal',
    '4': 'chronicle',
    '5': 'endorsements',
    '6': 'contact',
    '0': 'hero',
  };

  window.addEventListener('keydown', (e) => {
    if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) return;

    if (e.key in sectionKeyMap && !e.ctrlKey && !e.altKey && !e.metaKey) {
      const targetId = sectionKeyMap[e.key];
      const targetEl = document.getElementById(targetId);
      if (targetEl) {
        e.preventDefault();
        if (!hotkeysModal?.classList.contains('hidden')) closeHotkeys();
        targetEl.scrollIntoView({ behavior: 'smooth' });
        history.pushState(null, '', `#${targetId}`);
      } else if (window.location.pathname !== '/') {
        e.preventDefault();
        window.location.href = `/#${targetId}`;
      }
    }

    if (e.key === '/' && !e.ctrlKey && !e.altKey && !e.metaKey) {
      const searchInput = document.getElementById('system-search-input');
      if (!searchInput && window.location.pathname !== '/') {
        e.preventDefault();
        window.location.href = '/?focusSearch=1#systems';
      }
    }

    if ((e.key === 's' || e.key === 'S') && !e.ctrlKey && !e.altKey && !e.metaKey) {
      const specShareBtn = document.getElementById('btn-share-spec');
      if (specShareBtn) {
        specShareBtn.click();
      } else {
        e.preventDefault();
        const shareData = { title: document.title, url: window.location.href };
        if (navigator.share) {
          navigator.share(shareData).catch(() => {});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(window.location.href).then(() => {
            const hudAlt = document.getElementById('telemetry-alt');
            if (hudAlt) {
              const prev = hudAlt.textContent;
              hudAlt.textContent = 'COPIED!';
              setTimeout(() => { if (hudAlt) hudAlt.textContent = prev; }, 2000);
            }
          }).catch(() => {});
        }
      }
    }

    if (e.key === '?') {
      e.preventDefault();
      if (hotkeysModal?.classList.contains('hidden')) {
        openHotkeys();
      } else {
        closeHotkeys();
      }
    }
    if (e.key === 'Escape' && !hotkeysModal?.classList.contains('hidden')) {
      closeHotkeys();
    }
  });
</script>
