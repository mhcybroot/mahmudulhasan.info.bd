---
// Technical Arsenal Matrix Component — Swiss Division 03
---

<section id="arsenal" class="pt-12 pb-12 sm:pt-16 sm:pb-16 border-t border-theme-border space-y-8 scroll-mt-24">
  <!-- Section Heading — Swiss Division 03 -->
  <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-theme-border pb-3 gap-3">
    <div>
      <span class="font-mono text-xs text-theme-accent font-semibold tracking-wider uppercase block">
        // COMPETENCIES &amp; STACK :: DIVISION 03
      </span>
      <h2 class="text-headline-lg-mobile md:text-headline-lg font-bold text-theme-primary mt-1 flex items-center gap-2 group">
        <span>Technical Arsenal Matrix</span>
        <a href="#arsenal" class="opacity-0 group-hover:opacity-100 text-theme-accent transition-opacity text-base font-mono" title="Permanent section link">#</a>
      </h2>
    </div>
    <div class="font-mono text-xs text-theme-muted">
      STACK_AUDIT: HIGH-CONCURRENCY DETERMINISTIC CORE
    </div>
  </div>

  <!-- 4-Column Architectural Blueprint Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Pillar 1: Fast Backends & APIs -->
    <div class="bg-theme-lowest border border-theme-border p-5 rounded-sm flex flex-col justify-between space-y-4 hover:border-theme-secondary transition-colors">
      <div>
        <div class="font-mono text-[10px] text-theme-muted mb-1">[PILLAR_01]</div>
        <h3 class="text-headline-sm font-bold text-theme-primary mb-3">Fast Backends &amp; APIs</h3>
        <ul class="space-y-2 font-mono text-xs text-theme-secondary mb-4">
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> Rust (Axum, Tokio)</li>
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> Java 21 (Spring Boot 3.4, Loom)</li>
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> WebSockets &amp; gRPC</li>
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> Python FastAPI</li>
        </ul>
      </div>
      <div class="bg-[#eff4ff] dark:bg-theme-surface p-3.5 border border-theme-border rounded-sm">
        <span class="font-mono text-xs text-theme-secondary font-bold block mb-1">WHY IT MATTERS TO YOU:</span>
        <p class="text-xs text-theme-muted leading-relaxed">
          10k+ RPS throughput with zero memory leaks, slashing cloud server bills from $2,000/mo to a single $40/mo dedicated box.
        </p>
      </div>
    </div>

    <!-- Pillar 2: Secure Databases & Data -->
    <div class="bg-theme-lowest border border-theme-border p-5 rounded-sm flex flex-col justify-between space-y-4 hover:border-theme-secondary transition-colors">
      <div>
        <div class="font-mono text-[10px] text-theme-muted mb-1">[PILLAR_02]</div>
        <h3 class="text-headline-sm font-bold text-theme-primary mb-3">Secure Databases &amp; Data</h3>
        <ul class="space-y-2 font-mono text-xs text-theme-secondary mb-4">
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> PostgreSQL 16 &amp; SeaORM</li>
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> Spring Data JPA &amp; Hibernate</li>
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> Redis In-Memory Caching</li>
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> SQLite Edge Embedded Fallback</li>
        </ul>
      </div>
      <div class="bg-[#eff4ff] dark:bg-theme-surface p-3.5 border border-theme-border rounded-sm">
        <span class="font-mono text-xs text-theme-secondary font-bold block mb-1">WHY IT MATTERS TO YOU:</span>
        <p class="text-xs text-theme-muted leading-relaxed">
          Bank-grade ACID transactions and zero data loss even during sudden power outages or network dropouts.
        </p>
      </div>
    </div>

    <!-- Pillar 3: Smart Hardware & IoT -->
    <div class="bg-theme-lowest border border-theme-border p-5 rounded-sm flex flex-col justify-between space-y-4 hover:border-theme-secondary transition-colors">
      <div>
        <div class="font-mono text-[10px] text-theme-muted mb-1">[PILLAR_03]</div>
        <h3 class="text-headline-sm font-bold text-theme-primary mb-3">Smart Hardware &amp; IoT</h3>
        <ul class="space-y-2 font-mono text-xs text-theme-secondary mb-4">
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> ZKTeco Biometrics ADMS Push SDK</li>
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> RTSP AI Cameras &amp; YOLO OCR</li>
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> Barrier Gate Relays &amp; MCUs</li>
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> RS485 / Serial / Modbus Protocols</li>
        </ul>
      </div>
      <div class="bg-[#eff4ff] dark:bg-theme-surface p-3.5 border border-theme-border rounded-sm">
        <span class="font-mono text-xs text-theme-secondary font-bold block mb-1">WHY IT MATTERS TO YOU:</span>
        <p class="text-xs text-theme-muted leading-relaxed">
          Physical devices talk seamlessly to cloud or on-premise servers with sub-second response times and zero human intervention.
        </p>
      </div>
    </div>

    <!-- Pillar 4: Web & Cross-Platform -->
    <div class="bg-theme-lowest border border-theme-border p-5 rounded-sm flex flex-col justify-between space-y-4 hover:border-theme-secondary transition-colors">
      <div>
        <div class="font-mono text-[10px] text-theme-muted mb-1">[PILLAR_04]</div>
        <h3 class="text-headline-sm font-bold text-theme-primary mb-3">Web &amp; Cross-Platform</h3>
        <ul class="space-y-2 font-mono text-xs text-theme-secondary mb-4">
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> React 19 &amp; TypeScript</li>
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> Astro &amp; Tailwind CSS</li>
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> Flutter (iOS, Android, Windows)</li>
          <li class="flex items-center gap-2"><svg class="w-1.5 h-1.5 fill-current text-theme-accent shrink-0" viewBox="0 0 6 6" aria-hidden="true"><rect width="6" height="6"/></svg> Three.js WebGL Runtimes</li>
        </ul>
      </div>
      <div class="bg-[#eff4ff] dark:bg-theme-surface p-3.5 border border-theme-border rounded-sm">
        <span class="font-mono text-xs text-theme-secondary font-bold block mb-1">WHY IT MATTERS TO YOU:</span>
        <p class="text-xs text-theme-muted leading-relaxed">
          Pixel-perfect, ultra-snappy 60fps native performance across all screens from field technician phones to command centers.
        </p>
      </div>
    </div>
  </div>

  <!-- Division 03 Bottom Pipeline Connector -->
  <div class="pt-4 flex flex-wrap items-center justify-between border-t border-theme-border font-mono text-xs text-theme-muted">
    <span>4 ARCHITECTURAL PILLARS // HIGH-CONCURRENCY DETERMINISTIC CORE</span>
    <button type="button" data-trigger-dossier="true" class="text-theme-accent hover:underline font-semibold cursor-pointer flex items-center gap-1">
      <span>View Full Stack Verification in Dossier [D]</span>
      <svg class="w-3.5 h-3.5 inline text-theme-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
    </button>
  </div>
</section>
