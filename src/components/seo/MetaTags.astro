---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
  date?: string;
  section?: string;
}

const {
  title = "Mahmudul Hasan (@mhcybroot) | Full-Stack Software & Systems Engineer",
  description = "Official portfolio of Mahmudul Hasan (@mhcybroot). Architecting high-concurrency backends (Rust 2024 Axum, Java 21 Spring Boot), low-level IoT/hardware systems (ZKTeco ADMS, RTSP), and reactive modern web platforms.",
  image = "https://mahmudulhasan.info.bd/og-image.png",
  canonicalURL = "https://mahmudulhasan.info.bd",
  type = "website",
  date,
  section,
} = Astro.props;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Mahmudul Hasan Shoron (@mhcybroot)" />
<meta name="keywords" content="Mahmudul Hasan, Mahmudul Hasan Shoron, Shoron, Hasan Systems, hasansystems.com, mhcybroot, Systems Engineer, Concurrency, Rust Axum, Java 21 Spring Boot, PMS V2, Microkernel, BDCRM, aria2c, ZKTeco ADMS, RTSP CCTV, Full Stack Developer, Bangladesh Developer, Dhaka, Cloudflare Edge" />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Mahmudul Hasan (@mhcybroot) — Software & Systems Engineer Portfolio" />
<meta property="og:site_name" content="Mahmudul Hasan (@mhcybroot)" />
{type === 'article' && date && (
  <meta property="article:published_time" content={new Date(date).toISOString()} />
)}
{type === 'article' && (
  <meta property="article:author" content="https://mahmudulhasan.info.bd/#person" />
)}
{type === 'article' && section && (
  <meta property="article:section" content={section} />
)}

<!-- Twitter / X -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />
<meta name="twitter:creator" content="@mhcybroot" />
<meta name="twitter:site" content="@mhcybroot" />

<!-- Mobile & PWA -->
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#F8F9FF" />
<link rel="manifest" href="/manifest.json" />

<!-- Icons -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
