---
// Master Blueprint Footer — Swiss Architectural Editorial
---

<footer class="w-full border-t border-theme-border bg-theme-secondary text-white py-8 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6 text-xs font-mono">
    <div class="flex flex-col items-center md:items-start">
      <span class="font-bold uppercase tracking-wider text-white text-sm mb-1">
        MH // SYS-ARCH
      </span>
      <div class="text-[11px] text-slate-400">
        [SPEC-V4.2] MH // CYBROOT • ZERO-FAULT TOLERANCE
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-[11px] uppercase tracking-wider text-slate-300">
      <span id="dhaka-clock" class="text-theme-accent font-semibold">DHAKA --:--:-- [UTC+6]</span>
      <button id="footer-hotkeys-btn" type="button" class="hover:text-theme-accent transition-colors uppercase tracking-wider cursor-pointer font-mono" title="Open Keyboard Shortcuts">Hotkeys [?]</button>
      <a class="hover:text-theme-accent underline transition-colors" href="/rss.xml" target="_blank" rel="noopener noreferrer">RSS Feed</a>
      <a class="hover:text-theme-accent underline transition-colors" href="#systems">GPG Fingerprint</a>
      <a class="hover:text-theme-accent underline transition-colors" href="#arsenal">Industrial IoT Specs</a>
      <a class="hover:text-theme-accent underline transition-colors" href="#deployments">Root Node Status</a>
      <a class="hover:text-theme-accent underline transition-colors" href="#chronicle">System Audit Log</a>
    </div>

    <div class="text-slate-400 text-[11px] text-center md:text-right">
      © {new Date().getFullYear()} Mahmudul Hasan (@mhcybroot)
    </div>
  </div>
</footer>

<script>
  function updateDhakaClock() {
    const clockEl = document.getElementById('dhaka-clock');
    if (!clockEl) return;
    try {
      const now = new Date();
      const timeStr = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Dhaka',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false
      }).format(now);
      clockEl.textContent = `DHAKA ${timeStr} [UTC+6]`;
    } catch {
      clockEl.textContent = 'DHAKA [UTC+6]';
    }
  }
  updateDhakaClock();
  setInterval(updateDhakaClock, 1000);
</script>
