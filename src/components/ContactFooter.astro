---
// Contact & Identity Footer Component
---

<section id="contact" class="pt-12 pb-16 scroll-mt-24">
  <!-- Grand Finale CTA Card -->
  <div class="rounded-3xl border border-[#1E293B] bg-[#0F172A]/80 backdrop-blur-xl p-8 sm:p-12 space-y-8 relative overflow-hidden shadow-2xl">
    <!-- Subtle Background Accent Glow -->
    <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-[#06B6D4]/15 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="space-y-4 max-w-3xl relative z-10">
      <div class="inline-flex items-center gap-2 font-mono text-xs text-[#10B981] bg-[#10B981]/10 px-3 py-1 rounded-full border border-[#10B981]/30">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#10B981]"></span>
        </span>
        <span>SYSTEMS CAPACITY OPEN</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#F8FAFC] tracking-tight leading-tight">
        Let's Engineer High-Throughput Systems Together
      </h2>

      <p class="text-base sm:text-lg text-[#94A3B8] leading-relaxed">
        Available for mission-critical backend engineering, high-concurrency Rust/Java microservices, custom IoT daemon development, and low-latency architectural consultations.
      </p>
    </div>

    <!-- Direct Actions: Copy Email & Send Message -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 relative z-10">
      <!-- Email Address Endpoint Box -->
      <div class="flex items-center justify-between px-4 py-3 rounded-xl bg-[#090D16] border border-[#1E293B] gap-4 flex-1 hover:border-[#38BDF8]/50 transition-colors">
        <div class="flex items-center gap-2.5 overflow-hidden">
          <svg class="w-5 h-5 text-[#38BDF8] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span id="footer-contact-email" class="font-mono text-xs sm:text-sm text-[#F8FAFC] truncate">
            info@mahmudulhasan.info.bd
          </span>
        </div>

        <button
          id="btn-copy-email"
          type="button"
          class="px-3 py-1.5 rounded-lg bg-[#1E293B] border border-[#334155] font-mono text-xs text-[#CBD5E1] hover:text-[#38BDF8] hover:border-[#38BDF8] transition-all flex items-center gap-1.5 shrink-0 active:scale-95 cursor-pointer"
        >
          <svg id="copy-icon" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="copy-btn-text">Copy Email</span>
        </button>
      </div>

      <!-- Send Direct Message CTA -->
      <a
        href="mailto:info@mahmudulhasan.info.bd"
        class="px-6 py-3.5 rounded-xl bg-[#06B6D4] text-[#090D16] font-bold text-sm sm:text-base flex items-center justify-center gap-2 hover:bg-[#38BDF8] transition-all shadow-[0_0_25px_rgba(6,182,212,0.35)] active:scale-95 text-center"
      >
        <span>Send Direct Message</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Social Links & Operational Beacon -->
    <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-[#1E293B] relative z-10">
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="https://github.com/mhcybroot"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#090D16] border border-[#1E293B] text-xs font-mono text-[#CBD5E1] hover:text-[#38BDF8] hover:border-[#38BDF8] transition-all hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>GitHub (@mhcybroot)</span>
        </a>

        <a
          href="https://linkedin.com/in/mhcybroot"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#090D16] border border-[#1E293B] text-xs font-mono text-[#CBD5E1] hover:text-[#38BDF8] hover:border-[#38BDF8] transition-all hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
          <span>LinkedIn (@mhcybroot)</span>
        </a>
      </div>

      <div class="font-mono text-xs text-[#10B981] flex items-center gap-2 bg-[#090D16] px-3 py-1.5 rounded-lg border border-[#1E293B]">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#10B981]"></span>
        </span>
        <span>DHAKA POP NODE: ACTIVE</span>
      </div>
    </div>
  </div>

  <!-- Bottom Copyright & Architecture Notice -->
  <footer class="mt-12 pt-6 border-t border-[#1E293B]/60 flex flex-col sm:flex-row items-center justify-between text-xs text-[#64748B] font-mono gap-4">
    <div>
      <span class="text-[#94A3B8] font-semibold">~/mhcybroot</span> © {new Date().getFullYear()} Mahmudul Hasan. Systems Architecture & Infrastructure.
    </div>
    <div class="flex items-center gap-4 text-[#94A3B8]">
      <span>Built with Astro & Tailwind</span>
      <span>•</span>
      <span>Cloudflare Edge Network</span>
    </div>
  </footer>
</section>

<script>
  const copyBtn = document.getElementById('btn-copy-email');
  const copyBtnText = document.getElementById('copy-btn-text');
  const copyIcon = document.getElementById('copy-icon');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('info@mahmudulhasan.info.bd');
      if (copyBtnText) copyBtnText.textContent = 'Copied!';
      copyBtn?.classList.add('text-[#10B981]', 'border-[#10B981]');
      setTimeout(() => {
        if (copyBtnText) copyBtnText.textContent = 'Copy Email';
        copyBtn?.classList.remove('text-[#10B981]', 'border-[#10B981]');
      }, 2000);
    } catch (err) {
      console.error('Failed to copy email: ', err);
    }
  });
</script>
