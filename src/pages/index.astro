---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import Hero from '../components/Hero.astro';
import FlagshipSystems from '../components/FlagshipSystems.astro';
import CommercialDeployments from '../components/CommercialDeployments.astro';
import TechnicalArsenal from '../components/TechnicalArsenal.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import Endorsements from '../components/Endorsements.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Mahmudul Hasan (Shoron) | Software & Smart Hardware Systems Engineer"
  description="Software & Smart Hardware Systems Engineer Mahmudul Hasan Shoron (@mhcybroot), founder of Hasan Systems (hasansystems.com). High-throughput Rust Axum, Java 21 Spring Boot, and industrial IoT platforms."
  canonicalURL="https://mahmudulhasan.info.bd"
>
  <!-- Fixed Navbar & Mobile Drawer -->
  <Navbar />
  <MobileDrawer />

  <!-- Main Container — Continuous Swiss Architectural Drafting Sheet -->
  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Hero />
    <FlagshipSystems />
    <CommercialDeployments />
    <TechnicalArsenal />
    <CareerTimeline />
    <Endorsements />
    <Contact />
  </main>

  <!-- Master Swiss Architectural Blueprint Footer (Full-Bleed 100vw) -->
  <Footer />
</Layout>
