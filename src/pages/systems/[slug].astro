              <p class="text-slate-400 mt-2"># 3. Spin up local PostgreSQL database and start Spring Boot 4 + Vaadin 25 server</p>
              <p class="text-emerald-400">mvn spring-boot:run</p>
              <p class="text-slate-400 mt-2"># 4. Open reactive browser dashboard at http://localhost:8080</p>
              <p class="text-emerald-400">curl -I http://localhost:8080</p>
            </>
          ) : isEdugo ? (
            <>
              <p class="text-slate-400"># 1. Clone EduGo Institute Core repository</p>
              <p class="text-cyan-300">git clone https://github.com/mhcybroot/Edugo.git &amp;&amp; cd Edugo</p>
              <p class="text-slate-400 mt-2"># 2. Spin up PostgreSQL 16 database container via Docker Compose</p>
              <p class="text-emerald-400">docker compose up -d</p>
              <p class="text-slate-400 mt-2"># 3. Run backend unit tests and start Spring Boot 3.3 server with Vaadin</p>
              <p class="text-emerald-400">cd backend &amp;&amp; ./mvnw test &amp;&amp; ./mvnw spring-boot:run</p>
              <p class="text-slate-400 mt-2"># 4. Launch Flutter cross-platform mobile client</p>
              <p class="text-emerald-400">cd ../mobile &amp;&amp; flutter pub get &amp;&amp; flutter run --dart-define=API_BASE_URL=http://localhost:8080</p>
            </>
          ) : (
            <>
              <p class="text-slate-400"># 1. Clone repository and run verification tests</p>
              <p class="text-cyan-300">git clone https://github.com/mhcybroot/Image_upscale.git &amp;&amp; cd Image_upscale</p>
              <p class="text-emerald-400">cargo test --lib -- --nocapture</p>
              <p class="text-slate-400 mt-2"># 2. Compile optimized release binary</p>
              <p class="text-emerald-400">cargo build --release</p>
              <p class="text-slate-400 mt-2"># 3. Launch native desktop GUI</p>
              <p class="text-emerald-400">./target/release/image_upscale --gui</p>
            </>
          )}
        </div>
      </div>
    </section>
  </main>

  <ContactFooter />

  <!-- Clientside Copy Scripts -->
  <script>
    function initCaseStudyInteractions() {
      const copyCodeBtn = document.getElementById('copy-code-btn');
      copyCodeBtn?.addEventListener('click', async () => {
        const codeElement = document.querySelector('pre code');
        const code = codeElement ? codeElement.textContent || '' : '';
        try {
          await navigator.clipboard.writeText(code);
          copyCodeBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyCodeBtn.textContent = 'Copy Snippet';
          }, 2000);
        } catch {
          copyCodeBtn.textContent = 'Copied!';
        }
      });
    }

    initCaseStudyInteractions();
    document.addEventListener('astro:page-load', initCaseStudyInteractions);
  </script>
</Layout>
