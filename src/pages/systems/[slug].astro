                        <span class="text-rose-400">if</span> s.<span class="text-cyan-300">load</span>(<span class="text-amber-300">Ordering</span>::Relaxed) &#123;
                            <span class="text-rose-400">let</span> w = tw.<span class="text-cyan-300">load</span>(<span class="text-amber-300">Ordering</span>::Relaxed);
                            <span class="text-rose-400">let</span> h = th.<span class="text-cyan-300">load</span>(<span class="text-amber-300">Ordering</span>::Relaxed);
                            <span class="text-rose-400">let</span> qu = q.<span class="text-cyan-300">load</span>(<span class="text-amber-300">Ordering</span>::Relaxed);
                            
                            <span class="text-rose-400">let</span> res = tokio::task::<span class="text-cyan-300">spawn_blocking</span>(<span class="text-rose-400">move</span> || &#123;
                                crate::screen::<span class="text-cyan-300">capture_screen_jpeg</span>(w, h, qu)
                            &#125;).<span class="text-rose-400">await</span>;

                            <span class="text-rose-400">if let</span> <span class="text-amber-300">Ok</span>(<span class="text-amber-300">Ok</span>(data)) = res &#123;
                                <span class="text-rose-400">if</span> tx_clone.<span class="text-cyan-300">send</span>(<span class="text-amber-300">Message</span>::<span class="text-amber-300">Binary</span>(data.<span class="text-cyan-300">into</span>())).<span class="text-rose-400">await</span>.<span class="text-cyan-300">is_err</span>() &#123;
                                    <span class="text-rose-400">break</span>;
                                &#125;
                            &#125;
                        &#125;
                        tokio::time::<span class="text-cyan-300">sleep</span>(<span class="text-amber-300">Duration</span>::<span class="text-cyan-300">from_millis</span>(66)).<span class="text-rose-400">await</span>; <span class="text-slate-400">// ~15 FPS throttled</span>
                    &#125;
                &#125;);
            &#125;
            <span class="text-amber-300">Err</span>(_) =&gt; tokio::time::<span class="text-cyan-300">sleep</span>(<span class="text-amber-300">Duration</span>::<span class="text-cyan-300">from_secs</span>(5)).<span class="text-rose-400">await</span>,
        &#125;
    &#125;
&#125;</code></pre>
          ) : (
            <pre class="p-6 text-xs sm:text-sm font-mono text-slate-200 overflow-x-auto leading-relaxed selection:bg-cyan-500/30 selection:text-cyan-100"><code><span class="text-rose-400">pub fn</span> <span class="text-cyan-300">apply_adaptive_sharpen</span>(img: &<span class="text-amber-300">RgbaImage</span>, strength: <span class="text-rose-400">f32</span>) -&gt; <span class="text-amber-300">RgbaImage</span> &#123;
    <span class="text-slate-400">// Clamp strength & compute FidelityFX peak negative cross weight</span>
    <span class="text-rose-400">let</span> sharpness = strength.<span class="text-cyan-300">clamp</span>(0.0, 1.0);
    <span class="text-rose-400">let</span> w = -0.125 * sharpness;

    <span class="text-rose-400">let</span> src_raw = img.<span class="text-cyan-300">as_raw</span>();
    <span class="text-rose-400">let mut</span> dst_img = <span class="text-amber-300">RgbaImage</span>::<span class="text-cyan-300">new</span>(width, height);
    <span class="text-rose-400">let</span> dst_raw = dst_img.<span class="text-cyan-300">as_mut</span>();
    <span class="text-rose-400">let</span> row_stride = (width * 4) <span class="text-rose-400">as usize</span>;

    <span class="text-slate-400">// Process rows in parallel via Rayon: zero lock contention & zero cache thrashing</span>
    dst_raw
        .<span class="text-cyan-300">par_chunks_exact_mut</span>(row_stride)
        .<span class="text-cyan-300">enumerate</span>()
        .<span class="text-cyan-300">for_each</span>(|(y, row_out)| &#123;
            <span class="text-slate-400">/* 5-Tap cross neighbor gathering: Center, Top, Bottom, Left, Right */</span>
            <span class="text-rose-400">for</span> c <span class="text-rose-400">in</span> 0..3 &#123;
                <span class="text-rose-400">let</span> min_val = center.<span class="text-cyan-300">min</span>(top).<span class="text-cyan-300">min</span>(bottom).<span class="text-cyan-300">min</span>(left).<span class="text-cyan-300">min</span>(right);
                <span class="text-rose-400">let</span> max_val = center.<span class="text-cyan-300">max</span>(top).<span class="text-cyan-300">max</span>(bottom).<span class="text-cyan-300">max</span>(left).<span class="text-cyan-300">max</span>(right);

                <span class="text-slate-400">// Dynamic contrast-adaptive amplification factor (prevents ringing)</span>
                <span class="text-rose-400">let</span> amp = ((min_val / (max_val + 1.0))
                    .<span class="text-cyan-300">min</span>((255.0 - max_val) / (255.0 - min_val + 1.0)))
                    .<span class="text-cyan-300">clamp</span>(0.0, 1.0);
                <span class="text-rose-400">let</span> peak_w = w * amp;
                <span class="text-rose-400">let</span> enhanced = (center + peak_w * (top + bottom + left + right)) / (1.0 + 4.0 * peak_w);

                row_out[out_idx + c] = enhanced.<span class="text-cyan-300">clamp</span>(0.0, 255.0).<span class="text-cyan-300">round</span>() <span class="text-rose-400">as u8</span>;
            &#125;
            row_out[out_idx + 3] = src_raw[center_idx + 3]; <span class="text-slate-400">// Alpha pass-through</span>
        &#125;);
    dst_img
&#125;</code></pre>
          )}
        </div>
