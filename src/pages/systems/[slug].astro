                <span class="text-emerald-400 font-bold">✓</span> 1-Click Self-Contained Offline Windows Bundle (Embedded JRE)
              </div>
            </>
          ) : isLandtrust ? (
            <>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Historical Chain-of-Title Audit (CS 1910 → SA → RS → BS)
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Sub-28ms PostGIS Parcel Boundary Overlap Detection
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Instant Land Unit Converter (Bigha, Katha, Decimal, Sqft)
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Mutation (নামজারি) Clearance &amp; DCR Fee Verification
              </div>
            </>
          ) : isModernOs ? (
