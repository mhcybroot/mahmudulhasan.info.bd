---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TelemetryHud from '../../components/case-study/TelemetryHud.astro';
import BeforeAfterSlider from '../../components/case-study/BeforeAfterSlider.astro';
import ParkingGateSimulator from '../../components/case-study/ParkingGateSimulator.astro';
import BiometricPunchSimulator from '../../components/case-study/BiometricPunchSimulator.astro';
import WorkstationTelemetrySimulator from '../../components/case-study/WorkstationTelemetrySimulator.astro';
import ArchitectureModal from '../../components/case-study/ArchitectureModal.astro';
import BenchmarkMatrix from '../../components/case-study/BenchmarkMatrix.astro';
import CaseStudyJsonLd from '../../components/seo/CaseStudyJsonLd.astro';
import ThemeSwitcher from '../../components/ThemeSwitcher.astro';
import ContactFooter from '../../components/ContactFooter.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const isPms = data.slug === 'pms-v2';
const isHrms = data.slug === 'skylink-hrms';
const isMonitor = data.slug === 'skylink-monitor';

let pageDescription = "Instant offline photo and document enhancer. Cleans and upscales 290+ photos per second with zero cloud uploads and natural contrast-adaptive sharpness.";
if (isPms) {
  pageDescription = "Autonomous Smart Parking & Barrier Gate Automation platform. Sub-second gate opening (<0.84s), anti-passback security, and zero revenue leakage built with Rust and Flutter.";
} else if (isHrms) {
  pageDescription = "Enterprise Biometric Attendance & Automated Payroll Platform. Ingests 10,000+ punches/min with Java 21 Project Loom virtual threads, ZKTeco ADMS, and zero salary errors.";
} else if (isMonitor) {
  pageDescription = "Ultra-Lightweight Workstation Activity & Focus Monitor. Runs in pure Rust 2024 with under 14MB RAM, <0.01% CPU, on-demand WebSocket screen streaming, and zero invasive keyloggers.";
}
---

<Layout
  title={`${data.title} | Mahmudul Hasan`}
  description={pageDescription}
>
  <CaseStudyJsonLd
    title={data.title}
    description={pageDescription}
    slug={data.slug}
    githubUrl={data.githubUrl}
    date={data.date}
    primaryLanguage={data.primaryLanguage}
    keywords={[data.seo.focusKeyword, ...data.seo.secondaryKeywords]}
  />

  <ArchitectureModal />

  <!-- Sticky Top Navigation Bar -->
  <header class="sticky top-0 z-40 w-full border-b border-theme-border/80 bg-theme-bg/95 backdrop-blur-md transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-mono">
        <a href="/" class="text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-1 font-medium">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
          </svg>
          Portfolio Root
        </a>
        <span class="text-slate-500">/</span>
        <span class="text-slate-300 font-medium">Projects</span>
        <span class="text-slate-500">/</span>
        <span class="text-cyan-400 font-bold truncate max-w-[160px] sm:max-w-none">{data.slug}</span>
      </nav>

      <!-- Action Buttons & Theme Switcher -->
      <div class="flex items-center gap-3">
        <a
          href={data.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700 hover:border-cyan-400 text-xs font-mono text-slate-100 transition-all hover:scale-[1.02]"
        >
          <svg class="w-4 h-4 text-slate-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          View Source
        </a>

        <a
          href="#technical-deepdive"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-cyan-950/80 border border-cyan-500/50 hover:border-cyan-400 text-xs font-mono text-cyan-300 transition-all font-semibold"
        >
          <span>Under The Hood ↓</span>
        </a>

        <ThemeSwitcher />
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16">
    <!-- Hero & Value Proposition Section -->
    <section class="space-y-6">
      <div class="max-w-4xl space-y-4">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-mono font-extrabold text-white tracking-tight leading-tight">
          {data.title}
        </h1>
        <p class="text-base sm:text-lg text-slate-200 font-sans leading-relaxed">
          {isPms ? (
            <>
              Commercial parking automation and revenue protection platform engineered with <strong class="text-white font-semibold">Rust (Axum &amp; Tokio)</strong> and <strong class="text-white font-semibold">Flutter</strong>. Opens barrier gates in <strong class="text-emerald-300 font-semibold">&lt; 0.84 seconds</strong>, stops manual cash leakage, and guarantees 100% operational uptime.
            </>
          ) : isHrms ? (
            <>
              Enterprise biometric attendance and automated payroll platform engineered with <strong class="text-white font-semibold">Java 21 (Project Loom)</strong> and <strong class="text-white font-semibold">Spring Boot 3.4</strong>. Ingests raw HTTP push telemetry from ZKTeco biometric terminals during peak shift rush hours, with zero lost punches and 1-click salary disbarment.
            </>
          ) : isMonitor ? (
            <>
              Enterprise workstation activity and productivity monitoring daemon engineered in <strong class="text-white font-semibold">Rust 2024 (Tokio &amp; xcap)</strong> and <strong class="text-white font-semibold">Spring Boot 3.4</strong>. Replaces heavy commercial surveillance software with an ultra-lightweight client consuming <strong class="text-emerald-300 font-semibold">&lt; 14 MB RAM</strong> and <strong class="text-emerald-300 font-semibold">&lt; 0.01% CPU</strong>, featuring on-demand WebSocket streaming and local keyring encryption.
            </>
          ) : (
            <>
              Turn blurry, low-resolution photos into <strong class="text-white font-semibold">crystal-clear HD and 4K visuals</strong> in milliseconds. 
              Enjoy <strong class="text-emerald-300 font-semibold">100% offline privacy</strong>: your personal photos never leave your computer, with zero monthly cloud subscriptions.
            </>
          )}
        </p>

        <!-- Quick Summary Bar for Regular Visitors -->
        <div class="flex flex-wrap gap-4 pt-2 text-xs font-sans text-slate-200">
          {isPms ? (
            <>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Sub-Second Gate Opening (&lt; 0.84s)
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> 100% Leak-Proof Financial Ledger
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Anti-Passback Hardware Security
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> 100% Offline-Capable Gate Lanes
              </div>
            </>
          ) : isHrms ? (
            <>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> 10,000+ Punches / Minute Ingestion
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Zero Lost Punches Under Shift Rush
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Direct ZKTeco ADMS Protocol Sync
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> 1-Click Automated Monthly Payroll
              </div>
            </>
          ) : isMonitor ? (
            <>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> &lt; 14 MB Total RAM Footprint
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> &lt; 0.01% CPU Overhead
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Zero Keyloggers (Bank-Grade Privacy)
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> 100% Offline Local Buffer Resilience
              </div>
            </>
          ) : (
            <>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Free &amp; Open Source
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Works Offline (No Wi-Fi needed)
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Runs on Windows &amp; Linux
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> No Account or Sign-up
              </div>
            </>
          )}
        </div>
      </div>

      <!-- Human-Centric Telemetry HUD Cards -->
      <TelemetryHud metrics={data.metrics} stack={data.stack} />
    </section>

    <!-- Interactive Viewport -->
    <section class="space-y-4">
      {isPms ? (
        <ParkingGateSimulator />
      ) : isHrms ? (
        <BiometricPunchSimulator />
      ) : isMonitor ? (
        <WorkstationTelemetrySimulator />
      ) : (
        <BeforeAfterSlider />
      )}
    </section>

    <!-- Real-World Business & Personal Applications (Who Benefits) -->
    <section class="space-y-6">
      <div class="border-b border-theme-border pb-4">
        <h2 class="text-2xl font-mono font-bold text-white flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-cyan-400"></span>
          Real-World Applications: Who Benefits Most?
        </h2>
        <p class="text-sm text-slate-300 mt-1 font-sans">
          {isPms 
            ? "Built to stop revenue theft and eliminate vehicle entry queues across commercial properties."
            : isHrms
            ? "Built to eliminate shift-change attendance chaos and reduce month-end payroll reconciliation from days to minutes."
            : isMonitor
            ? "Built to deliver lightweight team focus insights with zero computer lag and total privacy protection."
            : "Built to solve real digital photography and business document challenges without cloud dependencies."}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {isPms ? (
          <>
            <!-- Use Case 1: Malls & Commercial Towers -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 space-y-3 shadow-lg hover:border-cyan-400 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-cyan-950 border border-cyan-500/50 flex items-center justify-center text-cyan-300 font-mono text-lg font-bold">
                🏢
              </div>
              <h3 class="font-mono font-bold text-white text-base">Shopping Malls &amp; Commercial Towers</h3>
              <p class="text-xs text-slate-200 font-sans leading-relaxed">
                Stops manual parking fee theft and unrecorded exits. Automatically calculates dynamic tiered tariffs, manages 1,000+ parking spaces across multi-level floors, and provides real-time financial shift auditing.
              </p>
            </div>

            <!-- Use Case 2: Toll Plazas & Logistics -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 space-y-3 shadow-lg hover:border-emerald-400 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-emerald-950 border border-emerald-500/50 flex items-center justify-center text-emerald-300 font-mono text-lg font-bold">
                🚛
              </div>
              <h3 class="font-mono font-bold text-white text-base">Toll Plazas &amp; Factory Gates</h3>
              <p class="text-xs text-slate-200 font-sans leading-relaxed">
                Eliminates shift rush queues and congestion. Processes continuous heavy commercial trucks and buses at &lt; 0.84 seconds per gate lift with zero database timeouts or server memory crashes.
              </p>
            </div>

            <!-- Use Case 3: Residential & Corporate -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 space-y-3 shadow-lg hover:border-cyan-400 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-cyan-950 border border-cyan-500/50 flex items-center justify-center text-cyan-300 font-mono text-lg font-bold">
                🛡️
              </div>
              <h3 class="font-mono font-bold text-white text-base">Corporate Campuses &amp; Communities</h3>
              <p class="text-xs text-slate-200 font-sans leading-relaxed">
                Provides instant barrier access for whitelisted executive and resident vehicles. Built-in anti-passback rules block unauthorized tailgating and shared parking pass misuse.
              </p>
            </div>
          </>
        ) : isHrms ? (
          <>
            <!-- Use Case 1: RMG Factories & Manufacturing -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 space-y-3 shadow-lg hover:border-cyan-400 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-cyan-950 border border-cyan-500/50 flex items-center justify-center text-cyan-300 font-mono text-lg font-bold">
                🏭
              </div>
              <h3 class="font-mono font-bold text-white text-base">Manufacturing Plants &amp; RMG</h3>
              <p class="text-xs text-slate-200 font-sans leading-relaxed">
                Handles thousands of factory workers clocking in at 9:00 AM shift change simultaneously. Eliminates manual queue bottlenecks, prevents proxy punches, and accurately calculates overtime hours.
              </p>
            </div>

            <!-- Use Case 2: Multi-Branch Enterprises -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 space-y-3 shadow-lg hover:border-emerald-400 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-emerald-950 border border-emerald-500/50 flex items-center justify-center text-emerald-300 font-mono text-lg font-bold">
                🌐
              </div>
              <h3 class="font-mono font-bold text-white text-base">Multi-Branch Corporate Enterprises</h3>
              <p class="text-xs text-slate-200 font-sans leading-relaxed">
                Aggregates real-time attendance across dozens of distributed branch offices into a central PostgreSQL ledger with automated employee shift scheduling and supervisor approval workflows.
              </p>
            </div>

            <!-- Use Case 3: Finance & Payroll -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 space-y-3 shadow-lg hover:border-cyan-400 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-cyan-950 border border-cyan-500/50 flex items-center justify-center text-cyan-300 font-mono text-lg font-bold">
                💰
              </div>
              <h3 class="font-mono font-bold text-white text-base">Finance &amp; Payroll Departments</h3>
              <p class="text-xs text-slate-200 font-sans leading-relaxed">
                Replaces 4 to 7 days of manual spreadsheet reconciliations with 1-click automated salary calculation. Generates bank-ready salary disbarment advice sheets, tax withholdings, and instant employee payslips.
              </p>
            </div>
          </>
        ) : isMonitor ? (
          <>
            <!-- Use Case 1: Remote Software Engineering Teams -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 space-y-3 shadow-lg hover:border-cyan-400 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-cyan-950 border border-cyan-500/50 flex items-center justify-center text-cyan-300 font-mono text-lg font-bold">
                👨‍💻
              </div>
              <h3 class="font-mono font-bold text-white text-base">Remote Software Engineering Teams</h3>
              <p class="text-xs text-slate-200 font-sans leading-relaxed">
                Keeps developer laptops lightning fast. Running heavy Docker containers, IntelliJ IDEs, and Rust builds without any surveillance lag or memory throttling.
              </p>
            </div>

            <!-- Use Case 2: Operations & Agency Leadership -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 space-y-3 shadow-lg hover:border-emerald-400 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-emerald-950 border border-emerald-500/50 flex items-center justify-center text-emerald-300 font-mono text-lg font-bold">
                📊
              </div>
              <h3 class="font-mono font-bold text-white text-base">Agencies &amp; BPO Operations</h3>
              <p class="text-xs text-slate-200 font-sans leading-relaxed">
                Eliminates client billing disputes. Generates automated, cryptographic proof of work and focus hours, with on-demand encrypted screen stream verification for project supervisors.
              </p>
            </div>

            <!-- Use Case 3: Information Security & Privacy -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 space-y-3 shadow-lg hover:border-cyan-400 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-cyan-950 border border-cyan-500/50 flex items-center justify-center text-cyan-300 font-mono text-lg font-bold">
                🔒
              </div>
              <h3 class="font-mono font-bold text-white text-base">Information Security &amp; Compliance</h3>
              <p class="text-xs text-slate-200 font-sans leading-relaxed">
                Zero keyloggers protects banking logins, passwords, and private correspondence. Authentication tokens are securely encrypted inside native OS credential vaults.
              </p>
            </div>
          </>
        ) : (
          <>
            <!-- Use Case 1: E-Commerce -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 space-y-3 shadow-lg hover:border-cyan-400 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-cyan-950 border border-cyan-500/50 flex items-center justify-center text-cyan-300 font-mono text-lg font-bold">
                🛒
              </div>
              <h3 class="font-mono font-bold text-white text-base">E-Commerce &amp; Product Catalogs</h3>
              <p class="text-xs text-slate-200 font-sans leading-relaxed">
                Suppliers often send low-resolution product photos. ImageUpscale Pro enlarges small images, crisping textures, labels, and product details so online stores (Daraz, Shopify, Facebook) look sharp and trustworthy.
              </p>
            </div>

            <!-- Use Case 2: Document OCR -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 space-y-3 shadow-lg hover:border-emerald-400 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-emerald-950 border border-emerald-500/50 flex items-center justify-center text-emerald-300 font-mono text-lg font-bold">
                🪪
              </div>
              <h3 class="font-mono font-bold text-white text-base">ID &amp; Document Verification</h3>
              <p class="text-xs text-slate-200 font-sans leading-relaxed">
                Photos of National IDs (NID), passports, and receipts are often shaky or dim. The smart edge-contrast filter clarifies small printed numbers and text without creating artificial digital blurs.
              </p>
            </div>

            <!-- Use Case 3: Photography -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 space-y-3 shadow-lg hover:border-cyan-400 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-cyan-950 border border-cyan-500/50 flex items-center justify-center text-cyan-300 font-mono text-lg font-bold">
                📸
              </div>
              <h3 class="font-mono font-bold text-white text-base">Vintage Photos &amp; Memories</h3>
              <p class="text-xs text-slate-200 font-sans leading-relaxed">
                Old digital camera and phone photos from the 2000s look tiny on modern 4K monitors. ImageUpscale Pro restores their clarity naturally, avoiding the waxy "plastic doll" face look common in generic AI filters.
              </p>
            </div>
          </>
        )}
      </div>
    </section>

    <!-- Benchmark Comparison Matrix -->
    <section>
      {isPms ? (
        <div class="rounded-3xl border border-slate-700 bg-slate-900/90 backdrop-blur-xl p-6 sm:p-8 space-y-6 shadow-2xl">
          <div class="border-b border-slate-800 pb-4">
            <h2 class="text-2xl font-mono font-bold text-white flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-cyan-400"></span>
              Engineering Benchmark: PMS-V2 vs. Legacy Parking Systems
            </h2>
            <p class="text-sm text-slate-300 mt-1 font-sans">
              Measured under simulated commercial entry load (10,000 concurrent barrier passage requests).
            </p>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left font-mono text-xs text-slate-200 border-collapse">
              <thead>
                <tr class="border-b border-slate-700 text-slate-400 uppercase">
                  <th class="py-3 px-4 font-semibold">Evaluation Metric</th>
                  <th class="py-3 px-4 font-bold text-cyan-300 bg-cyan-950/40">PMS-V2 (Rust 2024 + Tokio)</th>
                  <th class="py-3 px-4 font-semibold">Legacy Parking Systems (Node / PHP)</th>
                  <th class="py-3 px-4 font-semibold text-emerald-400">Operational Advantage</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800">
                <tr>
                  <td class="py-3.5 px-4 font-medium text-white">Barrier Gate Open Latency</td>
                  <td class="py-3.5 px-4 font-bold text-emerald-300 bg-cyan-950/20">0.78 seconds</td>
                  <td class="py-3.5 px-4 text-slate-400">3.80 - 6.20 seconds</td>
                  <td class="py-3.5 px-4 text-emerald-400 font-bold">5x Faster Gate Lift</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-medium text-white">Peak Shift Throughput</td>
                  <td class="py-3.5 px-4 font-bold text-emerald-300 bg-cyan-950/20">10,000+ RPS (0 drops)</td>
                  <td class="py-3.5 px-4 text-slate-400">Drops packets @ 120 RPS</td>
                  <td class="py-3.5 px-4 text-emerald-400 font-bold">Zero Crash Under Rush</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-medium text-white">Core Memory Footprint</td>
                  <td class="py-3.5 px-4 font-bold text-emerald-300 bg-cyan-950/20">&lt; 35 MB RAM</td>
                  <td class="py-3.5 px-4 text-slate-400">420 - 750 MB RAM</td>
                  <td class="py-3.5 px-4 text-emerald-400 font-bold">92% Less Memory</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-medium text-white">Offline Autonomous Operation</td>
                  <td class="py-3.5 px-4 font-bold text-emerald-300 bg-cyan-950/20">100% Operational (Edge Buffer)</td>
                  <td class="py-3.5 px-4 text-slate-400">Halts &amp; Locks Gate on Internet Loss</td>
                  <td class="py-3.5 px-4 text-emerald-400 font-bold">Zero Gridlock During Blackouts</td>
                </tr>
                <tr>
