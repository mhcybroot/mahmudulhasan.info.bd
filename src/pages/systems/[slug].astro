<span class="text-slate-400">/// Formal Proof 1: Capability Rights Attenuation &amp; Privilege Escalation Prevention</span>
<span class="text-slate-400">/// Verifies that delegated capabilities can NEVER exceed the rights held by the parent token,</span>
<span class="text-slate-400">/// and that delegation without `DELEGATE` permission is strictly rejected.</span>
<span class="text-rose-400">pub fn</span> <span class="text-cyan-300">verify_rights_attenuation_and_non_escalation</span>() -&gt; <span class="text-rose-400">bool</span> &#123;
    <span class="text-rose-400">let mut</span> table = <span class="text-amber-300">CapabilityTable</span>::<span class="text-cyan-300">new</span>();

    <span class="text-slate-400">// Grant parent token with READ, WRITE, DELEGATE rights (no EXECUTE)</span>
    <span class="text-rose-400">let</span> parent_rights = <span class="text-amber-300">CapabilityRights</span>::READ_WRITE.<span class="text-cyan-300">union</span>(<span class="text-amber-300">CapabilityRights</span>::DELEGATE);
    <span class="text-rose-400">let</span> parent = table.<span class="text-cyan-300">grant</span>(<span class="text-amber-300">ResourceType</span>::MemoryFrame, 0x1000, parent_rights);

    <span class="text-slate-400">// 1. Delegating a subset (READ) must succeed</span>
    <span class="text-rose-400">let</span> child1 = table.<span class="text-cyan-300">delegate</span>(parent.id, <span class="text-amber-300">CapabilityRights</span>::READ);
    <span class="text-rose-400">if</span> child1.<span class="text-cyan-300">is_none</span>() &#123;
