    <span class="text-rose-400">let</span> illegal_escalation = <span class="text-amber-300">CapabilityRights</span>::READ.<span class="text-cyan-300">union</span>(<span class="text-amber-300">CapabilityRights</span>::EXECUTE);
    <span class="text-rose-400">if</span> table.<span class="text-cyan-300">delegate</span>(parent.id, illegal_escalation).<span class="text-cyan-300">is_some</span>() &#123;
        <span class="text-rose-400">return false</span>; <span class="text-slate-400">// Escalation allowed -&gt; Security Invariant Violated!</span>
    &#125;

    <span class="text-slate-400">// 3. Child token without DELEGATE right attempting to delegate must fail</span>
    <span class="text-rose-400">if</span> table.<span class="text-cyan-300">delegate</span>(child1.id, <span class="text-amber-300">CapabilityRights</span>::READ).<span class="text-cyan-300">is_some</span>() &#123;
        <span class="text-rose-400">return false</span>; <span class="text-slate-400">// Delegation without DELEGATE right allowed -&gt; Violated!</span>
    &#125;

    <span class="text-rose-400">true</span>
&#125;</code></pre>
