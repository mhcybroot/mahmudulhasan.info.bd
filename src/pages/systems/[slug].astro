---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TelemetryHud from '../../components/case-study/TelemetryHud.astro';
import BeforeAfterSlider from '../../components/case-study/BeforeAfterSlider.astro';
import ParkingGateSimulator from '../../components/case-study/ParkingGateSimulator.astro';
import BiometricPunchSimulator from '../../components/case-study/BiometricPunchSimulator.astro';
import WorkstationTelemetrySimulator from '../../components/case-study/WorkstationTelemetrySimulator.astro';
import SwiftPdfSimulator from '../../components/case-study/SwiftPdfSimulator.astro';
import SmartHomeVisualizer from '../../components/case-study/SmartHomeVisualizer.astro';
import MarksheetGradeSimulator from '../../components/case-study/MarksheetGradeSimulator.astro';
import VirtualClassroomSimulator from '../../components/case-study/VirtualClassroomSimulator.astro';
import EdgeAiAttendanceSimulator from '../../components/case-study/EdgeAiAttendanceSimulator.astro';
import SecureNotesSimulator from '../../components/case-study/SecureNotesSimulator.astro';
import ConveyanceBillingSimulator from '../../components/case-study/ConveyanceBillingSimulator.astro';
import SmartCampusSimulator from '../../components/case-study/SmartCampusSimulator.astro';
import LandTrustSimulator from '../../components/case-study/LandTrustSimulator.astro';
import MicrokernelSimulator from '../../components/case-study/MicrokernelSimulator.astro';
import MediaStreamSimulator from '../../components/case-study/MediaStreamSimulator.astro';
import WorkOrderSniperSimulator from '../../components/case-study/WorkOrderSniperSimulator.astro';
import GeckoBrowserSimulator from '../../components/case-study/GeckoBrowserSimulator.astro';
import FintechLedgerSimulator from '../../components/case-study/FintechLedgerSimulator.astro';
import QuickbooksSyncSimulator from '../../components/case-study/QuickbooksSyncSimulator.astro';
import EdugoPlatformSimulator from '../../components/case-study/EdugoPlatformSimulator.astro';
import ArchitectureModal from '../../components/case-study/ArchitectureModal.astro';
import BenchmarkMatrix from '../../components/case-study/BenchmarkMatrix.astro';
import CaseStudyJsonLd from '../../components/seo/CaseStudyJsonLd.astro';
import ThemeSwitcher from '../../components/ThemeSwitcher.astro';
import ContactFooter from '../../components/ContactFooter.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const isPms = data.slug === 'pms-v2';
const isHrms = data.slug === 'skylink-hrms';
const isMonitor = data.slug === 'skylink-monitor';
const isSwift = data.slug === 'swift-pdf-editor';
const isHomesync = data.slug === 'homesync-iot';
const isMarksheet = data.slug === 'marksheets-automation';
const isEdumeet = data.slug === 'edumeet-webrtc';
const isSmartAi = data.slug === 'smartai-edge-vision';
const isNotes = data.slug === 'secure-notes-cloud';
const isSssms = data.slug === 'sssms-conveyance-ledger';
const isCampus = data.slug === 'smart-academic-infra';
const isLandtrust = data.slug === 'landtrust-bhumisetu';
const isModernOs = data.slug === 'modern-os-microkernel';
const isYtStream = data.slug === 'yt-playlist-engine';
const isSniper = data.slug === 'amh-wo-sniper';
const isGecko = data.slug === 'gecko-browser-engine';
const isDoller = data.slug === 'doller-fintech-wallet';
const isQuickbooks = data.slug === 'quickbooks-ledger-sync';
const isEdugo = data.slug === 'edugo-institute-core';

let pageDescription = "Instant offline photo and document enhancer. Cleans and upscales 290+ photos per second with zero cloud uploads and natural contrast-adaptive sharpness.";
if (isPms) {
  pageDescription = "Autonomous Smart Parking & Barrier Gate Automation platform. Sub-second gate opening (<0.84s), anti-passback security, and zero revenue leakage built with Rust and Flutter.";
} else if (isHrms) {
  pageDescription = "Enterprise Biometric Attendance & Automated Payroll Platform. Ingests 10,000+ punches/min with Java 21 Project Loom virtual threads, ZKTeco ADMS, and zero salary errors.";
} else if (isMonitor) {
  pageDescription = "Ultra-Lightweight Workstation Activity & Focus Monitor. Runs in pure Rust 2024 with under 14MB RAM, <0.01% CPU, on-demand WebSocket screen streaming, and zero invasive keyloggers.";
} else if (isSwift) {
  pageDescription = "Financial SWIFT Wire Confirmation Redaction & Precision Typography Engine. Sub-pixel PyMuPDF vector editing, bidirectional Arabic/English typesetting, and zero metadata leakage.";
} else if (isHomesync) {
  pageDescription = "Interactive 3D Digital Twin & Smart IoT Configurator. Real-time 60 FPS WebGL room visualizer with dynamic Kelvin lighting shaders, security radar cones, and Matter/Zigbee mesh.";
} else if (isMarksheet) {
  pageDescription = "Academic Result Tabulation & Automated Marksheet Engine. Ingests teacher spreadsheets, enforces Bangladesh board GPA 5.0 and 4th subject rules, and compiles batch print-ready PDFs.";
} else if (isEdumeet) {
  pageDescription = "Low-Latency Virtual Classroom & WebRTC Video Conferencing Platform. Built in Flutter with multi-flavor APKs, adaptive 3G/4G bandwidth throttling, and live attendance logging.";
} else if (isSmartAi) {
  pageDescription = "Mobile Edge Vision & Geofenced Attendance System. Android native (Kotlin & Jetpack Compose) running Google ML Kit on-device face tracking with FusedLocation geofencing for sub-350ms zero-trust presence.";
} else if (isNotes) {
  pageDescription = "Enterprise Encrypted Knowledge Base & RBAC Engine. Clean Layered Architecture in NestJS & MongoDB with compound B-Tree indexing, JWT authentication, and sub-5ms lookups across millions of notes.";
} else if (isSssms) {
  pageDescription = "Enterprise Conveyance Billing & Instant Disbursal Platform. Engineered in Flutter & Cloud Firestore with multi-leg journey auditing, automated PDF vouchers, and bKash/EFT payouts.";
} else if (isCampus) {
  pageDescription = "Unified Micro-Frontend & Multi-Tier Campus ERP Infrastructure. Engineered in Spring Boot 3.4, Java 21 Loom, Vue.js 3, and PostgreSQL with zero-downtime micro-service orchestration.";
} else if (isLandtrust) {
  pageDescription = "Digital Land Record Ledger & Title Deed Verification Engine. Engineered in Flutter, Spring Boot, and PostgreSQL PostGIS with CS-SA-RS-BS survey chain verification and parcel overlap detection.";
} else if (isModernOs) {
  pageDescription = "Pure #![no_std] Rust Microkernel Operating System. Features Ring 0 privilege isolation, formal capability non-escalation proofs, lock-free SPSC IPC, and zero ambient authority.";
} else if (isYtStream) {
  pageDescription = "High-Concurrency Media Ingestion & Multi-ISP Caching Engine. Features 16-socket segmented TCP acceleration via aria2c, SponsorBlock ad stripping, H.265 transcoding, and Jellyfin/Plex sync.";
} else if (isSniper) {
  pageDescription = "High-Speed Work Order Auto-Acceptor & Memory Hook Engine. Chrome Extension MV3 with MAIN-world fetch interception, 80ms soft tab cycling, and sub-100ms automated order confirmation.";
} else if (isGecko) {
  pageDescription = "Independent Android Web Browser & GeckoView Omni 134 Runtime. Replaces Android System WebView with Mozilla Quantum, singleton GeckoRuntime lifecycle, and reactive delegates in Kotlin.";
} else if (isDoller) {
  pageDescription = "Multi-Currency Trading, Settlement & PnL Ledger Engine. Engineered in Java 21, Spring Boot 3.5, and Flutter with double-entry accounting, Flyway V1-V10, and automated daily closes.";
} else if (isQuickbooks) {
  pageDescription = "Automated Multi-Entity CSV Normalization, Tiered Bank Reconciliation & Resilient Intuit OAuth 2.0 API Gateway built on Java 21, Spring Boot 4 & Vaadin 25 Flow.";
} else if (isEdugo) {
  pageDescription = "Multi-Tenant Academic ERP & Dual-Security Microservice Architecture. Engineered in Java 21, Spring Boot 3.3, Vaadin Flow, and Flutter 3.29 with dual filter chains and Flyway V1-V8.";
}
---

<Layout
  title={`${data.title} | Mahmudul Hasan`}
  description={pageDescription}
>
  <CaseStudyJsonLd
    title={data.title}
    description={pageDescription}
    slug={data.slug}
    githubUrl={data.githubUrl}
    date={data.date}
    primaryLanguage={data.primaryLanguage}
    keywords={[data.seo.focusKeyword, ...data.seo.secondaryKeywords]}
  />

  <ArchitectureModal />

  <!-- Sticky Top Navigation Bar -->
  <header class="sticky top-0 z-40 w-full border-b border-theme-border/80 bg-theme-bg/95 backdrop-blur-md transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-mono">
        <a href="/" class="text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-1 font-medium">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
          </svg>
          Portfolio Root
        </a>
        <span class="text-slate-500">/</span>
        <span class="text-slate-300 font-medium">Projects</span>
        <span class="text-slate-500">/</span>
        <span class="text-cyan-400 font-bold truncate max-w-[160px] sm:max-w-none">{data.slug}</span>
      </nav>

      <!-- Action Buttons & Theme Switcher -->
      <div class="flex items-center gap-3">
        <a
          href={data.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700 hover:border-cyan-400 text-xs font-mono text-slate-100 transition-all hover:scale-[1.02]"
        >
          <svg class="w-4 h-4 text-slate-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          View Source
        </a>

        <a
          href="#technical-deepdive"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-cyan-950/80 border border-cyan-500/50 hover:border-cyan-400 text-xs font-mono text-cyan-300 transition-all font-semibold"
        >
          <span>Under The Hood ↓</span>
        </a>

        <ThemeSwitcher />
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16">
    <!-- Hero & Value Proposition Section -->
    <section class="space-y-6">
      <div class="max-w-4xl space-y-4">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-mono font-extrabold text-white tracking-tight leading-tight">
          {data.title}
        </h1>
        <p class="text-base sm:text-lg text-slate-200 font-sans leading-relaxed">
          {isPms ? (
            <>
              Commercial parking automation and revenue protection platform engineered with <strong class="text-white font-semibold">Rust (Axum &amp; Tokio)</strong> and <strong class="text-white font-semibold">Flutter</strong>. Opens barrier gates in <strong class="text-emerald-300 font-semibold">&lt; 0.84 seconds</strong>, stops manual cash leakage, and guarantees 100% operational uptime.
            </>
          ) : isHrms ? (
            <>
              Enterprise biometric attendance and automated payroll platform engineered with <strong class="text-white font-semibold">Java 21 (Project Loom)</strong> and <strong class="text-white font-semibold">Spring Boot 3.4</strong>. Ingests raw HTTP push telemetry from ZKTeco biometric terminals during peak shift rush hours, with zero lost punches and 1-click salary disbarment.
            </>
          ) : isMonitor ? (
            <>
              Enterprise workstation activity and productivity monitoring daemon engineered in <strong class="text-white font-semibold">Rust 2024 (Tokio &amp; xcap)</strong> and <strong class="text-white font-semibold">Spring Boot 3.4</strong>. Replaces heavy commercial surveillance software with an ultra-lightweight client consuming <strong class="text-emerald-300 font-semibold">&lt; 14 MB RAM</strong> and <strong class="text-emerald-300 font-semibold">&lt; 0.01% CPU</strong>, featuring on-demand WebSocket streaming and local keyring encryption.
            </>
          ) : isSwift ? (
            <>
              Financial document redaction and typography verification platform engineered with <strong class="text-white font-semibold">Python (FastAPI &amp; PyMuPDF)</strong> and <strong class="text-white font-semibold">Flutter</strong>. Delivers sub-pixel font metric reconstruction, bidirectional Arabic/English typesetting (Tajawal &amp; Amiri), and true cryptographic stream black-boxing with <strong class="text-emerald-300 font-semibold">zero metadata residue</strong>.
            </>
          ) : isHomesync ? (
            <>
              Interactive 3D digital twin smart home configurator engineered with <strong class="text-white font-semibold">React 19, Three.js &amp; React Three Fiber</strong>. Renders real-time architectural floorplans at a locked <strong class="text-emerald-300 font-semibold">60 FPS</strong> with dynamic Kelvin ambient lighting shaders, security radar cones, and Matter/Zigbee mesh simulation.
            </>
          ) : isMarksheet ? (
            <>
              High-throughput academic examination tabulation and merit compiler engineered with <strong class="text-white font-semibold">Node.js 22, Express &amp; Prisma ORM</strong>. Automatically ingests multi-subject Excel marks rosters, computes official <strong class="text-emerald-300 font-semibold">GPA 5.0 scales and 4th-subject bonus points</strong>, and batch compiles hundreds of print-ready A4 PDF marksheets with zero human arithmetic mistakes.
            </>
          ) : isEdumeet ? (
            <>
              Low-latency virtual classroom and WebRTC live lecture conferencing suite engineered in <strong class="text-white font-semibold">Flutter 3.29 &amp; Dart</strong>. Features a multi-flavor architecture generating isolated <strong class="text-emerald-300 font-semibold">Student, Teacher &amp; Admin APKs</strong>, with adaptive 3G/4G bandwidth downscaling (VP8/H.264), automated in-call attendance logging, and sub-95ms delay.
            </>
          ) : isSmartAi ? (
            <>
              Mobile edge-AI attendance and zero-trust presence verification platform engineered in <strong class="text-white font-semibold">Kotlin 2.0 &amp; Android Jetpack Compose</strong>. Combines on-device <strong class="text-emerald-300 font-semibold">Google ML Kit face landmark tracking</strong> with <strong class="text-emerald-300 font-semibold">50-meter GPS geofencing</strong>, verifying student attendance in under 350ms with zero cellular data costs and offline Room DB sync.
            </>
          ) : isNotes ? (
            <>
              Enterprise encrypted knowledge management and multi-tenant documentation suite engineered in <strong class="text-white font-semibold">NestJS 10, TypeScript &amp; MongoDB</strong>. Built on a Clean Layered Architecture with the <strong class="text-emerald-300 font-semibold">Repository Pattern</strong>, it enforces strict multi-tenant isolation, cryptographic JWT token guards, and compound B-Tree indexing (<strong class="text-emerald-300 font-semibold">&lt; 4.8ms queries</strong> across millions of records).
            </>
          ) : isSssms ? (
            <>
              Enterprise employee conveyance billing and instant payout disbursal platform engineered in <strong class="text-white font-semibold">Flutter 3.29 &amp; Cloud Firestore</strong>. Replaces chaotic paper travel slips with an auditable <strong class="text-emerald-300 font-semibold">multi-leg journey tracker</strong> (Rickshaw, CNG, Bus, Bike Fuel), automated fare audit boundaries, print-ready PDF vouchers, and 1-click <strong class="text-emerald-300 font-semibold">bKash, Nagad &amp; EFT mobile banking settlement</strong>.
            </>
          ) : isCampus ? (
            <>
              Unified academic ERP and micro-frontend administration infrastructure engineered in <strong class="text-white font-semibold">Spring Boot 3.4, Java 21 Project Loom &amp; Vue.js 3</strong>. Consolidates multi-department attendance, automated GPA merit tabulation, faculty payroll, and student focus telemetry into a single glassmorphic executive portal with <strong class="text-emerald-300 font-semibold">sandboxed micro-frontend iframe interop</strong> and zero cross-origin styling friction.
            </>
          ) : isLandtrust ? (
            <>
              Digital land record ledger and title deed verification platform engineered in <strong class="text-white font-semibold">Flutter 3.29, Spring Boot 3.4 &amp; PostgreSQL PostGIS</strong>. Solves Bangladesh's foremost property litigation crisis by verifying historical <strong class="text-emerald-300 font-semibold">CS → SA → RS → BS survey chains</strong>, detecting parcel boundary overlaps in sub-28ms, and computing high-precision traditional land units (Katha, Bigha, Decimal, Sqft).
            </>
          ) : isModernOs ? (
            <>
              High-performance, capability-secure pure microkernel operating system built from scratch in <strong class="text-white font-semibold">#![no_std] Rust</strong>. Strips Ring 0 supervisor mode down to an audited <strong class="text-emerald-300 font-semibold">&lt; 2,500 LOC core</strong>, runs device drivers (NVMe) and filesystems (VFS) in isolated Ring 3 user daemons, achieves sub-nanosecond IPC with <strong class="text-emerald-300 font-semibold">lock-free SPSC ring buffers</strong>, and mathematically proves privilege non-escalation.
            </>
          ) : isYtStream ? (
            <>
              High-concurrency media ingestion and stream caching engine engineered in <strong class="text-white font-semibold">Python 3.12, yt-dlp &amp; aria2c</strong>. Eliminates bandwidth throttling and buffering with <strong class="text-emerald-300 font-semibold">16 concurrent TCP socket streams</strong>, strips sponsor plugs automatically via SponsorBlock APIs, transcodes into space-saving H.265 containers, routes across <strong class="text-emerald-300 font-semibold">multi-ISP gateways</strong> (BDIX vs Starlink), and auto-syncs into Jellyfin and Plex home-theaters.
            </>
          ) : isSniper ? (
            <>
              High-speed browser automation and in-memory API interception engine engineered as a <strong class="text-white font-semibold">Chrome Extension MV3</strong>. Eliminates white-screen reload overhead with an <strong class="text-emerald-300 font-semibold">80ms in-page soft tab toggle</strong>, hooks directly into <strong class="text-emerald-300 font-semibold">window.fetch &amp; XMLHttpRequest</strong> in the page's MAIN execution world, auto-latches terms checkboxes via MutationObservers, and claims vendor work orders in under 250ms with zero manual clicks.
            </>
          ) : isGecko ? (
            <>
              Independent, privacy-first mobile web browser and rendering harness built in native <strong class="text-white font-semibold">Android Kotlin &amp; SDK 34</strong>. Replaces Google Chromium/Blink with <strong class="text-emerald-300 font-semibold">Mozilla GeckoView Omni 134</strong>, establishes a persistent singleton <strong class="text-emerald-300 font-semibold">GeckoRuntime</strong> across the Android activity lifecycle, binds reactive session delegates for progress and navigation, and resolves URL schemes with zero external dependencies.
            </>
          ) : isDoller ? (
            <>
              Enterprise foreign exchange trading, counterparty clearing, and real-time PnL explain engine engineered in <strong class="text-white font-semibold">Java 21, Spring Boot 3.5 &amp; Flutter 3.29</strong>. Enforces balanced <strong class="text-emerald-300 font-semibold">double-entry accounting journals</strong> across USD, EUR, GBP, AED, and BDT, features 10 sequential Flyway PostgreSQL schema migrations, automates end-of-day close seals with immutable snapshots, and guarantees offline trade resilience via mobile outbox queues.
            </>
          ) : isQuickbooks ? (
            <>
              Automated multi-entity accounting synchronization and bank statement reconciliation engine built in <strong class="text-white font-semibold">Java 21, Spring Boot 4 &amp; Vaadin 25 Flow</strong>. Normalizes heterogeneous CSV exports into <strong class="text-emerald-300 font-semibold">canonical QuickBooks Online payloads</strong>, enforces strict pre-flight tax-rate and idempotency gates, executes multi-tier reconciliation with exact, date-window, and fuzzy matching, and manages multi-tenant OAuth 2.0 credentials via an <strong class="text-emerald-300 font-semibold">AES-256-GCM encrypted vault</strong>.
            </>
          ) : isEdugo ? (
            <>
              Multi-tenant academic enterprise resource planning platform engineered in <strong class="text-white font-semibold">Java 21, Spring Boot 3.3, Vaadin Flow &amp; Flutter 3.29</strong>. Solves the dual-client dilemma through <strong class="text-emerald-300 font-semibold">simultaneous Spring Security filter chains</strong>: stateless HMAC-SHA256 JWT at @Order(0) for high-frequency mobile APIs, and stateful session-based OAuth2 Google login at @Order(1) for desktop administrators, backed by 8 sequential Flyway PostgreSQL migrations.
            </>
          ) : (
            <>
              Turn blurry, low-resolution photos into <strong class="text-white font-semibold">crystal-clear HD and 4K visuals</strong> in milliseconds. 
              Enjoy <strong class="text-emerald-300 font-semibold">100% offline privacy</strong>: your personal photos never leave your computer, with zero monthly cloud subscriptions.
            </>
          )}
        </p>

        <!-- Quick Summary Bar for Regular Visitors -->
        <div class="flex flex-wrap gap-4 pt-2 text-xs font-sans text-slate-200">
          {isPms ? (
            <>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Sub-Second Gate Opening (&lt; 0.84s)
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> 100% Leak-Proof Financial Ledger
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Anti-Passback Hardware Security
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> 100% Offline-Capable Gate Lanes
              </div>
            </>
          ) : isHrms ? (
            <>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> 10,000+ Punches / Minute Ingestion
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Zero Lost Punches Under Shift Rush
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Direct ZKTeco ADMS Protocol Sync
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> 1-Click Automated Monthly Payroll
              </div>
            </>
          ) : isMonitor ? (
            <>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> &lt; 14 MB Total RAM Footprint
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> &lt; 0.01% CPU Overhead
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Zero Keyloggers (Bank-Grade Privacy)
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> 100% Offline Local Buffer Resilience
              </div>
            </>
          ) : isSwift ? (
            <>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Sub-Pixel Typography Alignment
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> True Cryptographic Stream Scrubbing
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Native BiDi Arabic Reshaper (Tajawal/Amiri)
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Zero Underlying Metadata Leakage
              </div>
            </>
          ) : isHomesync ? (
            <>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> 60 FPS WebGL Frame Budget (16.6ms)
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Real-Time Kelvin Lighting Shaders
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Matter 3.0 &amp; Zigbee Topology
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> &lt; 38 MB GPU VRAM Footprint
              </div>
            </>
          ) : isMarksheet ? (
            <>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Board-Compliant GPA 5.0 Engine
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> Automatic 4th Subject Bonus (GP &gt; 2.0)
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-emerald-400 font-bold">✓</span> 1,200+ PDF Marksheets / Min
