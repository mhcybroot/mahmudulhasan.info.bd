---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TelemetryHud from '../../components/case-study/TelemetryHud.astro';
import BeforeAfterSlider from '../../components/case-study/BeforeAfterSlider.astro';
import ParkingGateSimulator from '../../components/case-study/ParkingGateSimulator.astro';
import BiometricPunchSimulator from '../../components/case-study/BiometricPunchSimulator.astro';
import WorkstationTelemetrySimulator from '../../components/case-study/WorkstationTelemetrySimulator.astro';
import SwiftPdfSimulator from '../../components/case-study/SwiftPdfSimulator.astro';
import SmartHomeVisualizer from '../../components/case-study/SmartHomeVisualizer.astro';
import MarksheetGradeSimulator from '../../components/case-study/MarksheetGradeSimulator.astro';
import VirtualClassroomSimulator from '../../components/case-study/VirtualClassroomSimulator.astro';
import EdgeAiAttendanceSimulator from '../../components/case-study/EdgeAiAttendanceSimulator.astro';
import SecureNotesSimulator from '../../components/case-study/SecureNotesSimulator.astro';
import ConveyanceBillingSimulator from '../../components/case-study/ConveyanceBillingSimulator.astro';
import SmartCampusSimulator from '../../components/case-study/SmartCampusSimulator.astro';
import LandTrustSimulator from '../../components/case-study/LandTrustSimulator.astro';
import MicrokernelSimulator from '../../components/case-study/MicrokernelSimulator.astro';
import MediaStreamSimulator from '../../components/case-study/MediaStreamSimulator.astro';
import WorkOrderSniperSimulator from '../../components/case-study/WorkOrderSniperSimulator.astro';
import GeckoBrowserSimulator from '../../components/case-study/GeckoBrowserSimulator.astro';
import FintechLedgerSimulator from '../../components/case-study/FintechLedgerSimulator.astro';
import QuickbooksSyncSimulator from '../../components/case-study/QuickbooksSyncSimulator.astro';
import EdugoPlatformSimulator from '../../components/case-study/EdugoPlatformSimulator.astro';
import BdCrmPipelineSimulator from '../../components/case-study/BdCrmPipelineSimulator.astro';
import EmailVerifierSimulator from '../../components/case-study/EmailVerifierSimulator.astro';
import CameramanVisionSimulator from '../../components/case-study/CameramanVisionSimulator.astro';
import ClassroomLivekitSimulator from '../../components/case-study/ClassroomLivekitSimulator.astro';
import SelfMtFinanceSimulator from '../../components/case-study/SelfMtFinanceSimulator.astro';
import ArchitectureModal from '../../components/case-study/ArchitectureModal.astro';
import BenchmarkMatrix from '../../components/case-study/BenchmarkMatrix.astro';
import CaseStudyJsonLd from '../../components/seo/CaseStudyJsonLd.astro';
import ThemeSwitcher from '../../components/ThemeSwitcher.astro';
import ContactFooter from '../../components/ContactFooter.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  const sortedProjects = projectEntries.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

  return sortedProjects.map((entry, index) => {
    const prev = index > 0 ? sortedProjects[index - 1] : sortedProjects[sortedProjects.length - 1];
    const next = index < sortedProjects.length - 1 ? sortedProjects[index + 1] : sortedProjects[0];
    return {
      params: { slug: entry.data.slug },
      props: {
        entry,
        prevProject: { slug: prev.data.slug, title: prev.data.title },
        nextProject: { slug: next.data.slug, title: next.data.title },
      },
    };
  });
}

const { entry, prevProject, nextProject } = Astro.props;
const { data } = entry;
const isPms = data.slug === 'pms-v2';
const isHrms = data.slug === 'skylink-hrms';
const isMonitor = data.slug === 'skylink-monitor';
const isSwift = data.slug === 'swift-pdf-editor';
const isHomesync = data.slug === 'homesync-iot';
const isMarksheet = data.slug === 'marksheets-automation';
const isEdumeet = data.slug === 'edumeet-webrtc';
const isSmartAi = data.slug === 'smartai-edge-vision';
const isNotes = data.slug === 'secure-notes-cloud';
const isSssms = data.slug === 'sssms-conveyance-ledger';
const isCampus = data.slug === 'smart-academic-infra';
const isLandtrust = data.slug === 'landtrust-bhumisetu';
const isModernOs = data.slug === 'modern-os-microkernel';
const isYtStream = data.slug === 'yt-playlist-engine';
const isSniper = data.slug === 'amh-wo-sniper';
const isGecko = data.slug === 'gecko-browser-engine';
const isDoller = data.slug === 'doller-fintech-wallet';
const isQuickbooks = data.slug === 'quickbooks-ledger-sync';
const isEdugo = data.slug === 'edugo-institute-core';
const isCrm = data.slug === 'bd-crm-pipeline';
const isEmailVerifier = data.slug === 'email-verifier-service';
const isCameraman = data.slug === 'cameraman-edge-vision';
const isClassroom = data.slug === 'classroom-livekit-webrtc';
const isSelfMt = data.slug === 'self-mt-finance-ledger';

let pageDescription = "Instant offline photo and document enhancer. Cleans and upscales 290+ photos per second with zero cloud uploads and natural contrast-adaptive sharpness.";
if (isPms) {
  pageDescription = "Autonomous Smart Parking & Barrier Gate Automation platform. Sub-second gate opening (<0.84s), anti-passback security, and zero revenue leakage built with Rust and Flutter.";
} else if (isHrms) {
  pageDescription = "Enterprise Biometric Attendance & Automated Payroll Platform. Ingests 10,000+ punches/min with Java 21 Project Loom virtual threads, ZKTeco ADMS, and zero salary errors.";
} else if (isMonitor) {
  pageDescription = "Ultra-Lightweight Workstation Activity & Focus Monitor. Runs in pure Rust 2024 with under 14MB RAM, <0.01% CPU, on-demand WebSocket screen streaming, and zero invasive keyloggers.";
} else if (isSwift) {
  pageDescription = "Financial SWIFT Wire Confirmation Redaction & Precision Typography Engine. Sub-pixel PyMuPDF vector editing, bidirectional Arabic/English typesetting, and zero metadata leakage.";
} else if (isHomesync) {
  pageDescription = "Interactive 3D Digital Twin & Smart IoT Configurator. Real-time 60 FPS WebGL room visualizer with dynamic Kelvin lighting shaders, security radar cones, and Matter/Zigbee mesh.";
} else if (isMarksheet) {
  pageDescription = "Academic Result Tabulation & Automated Marksheet Engine. Ingests teacher spreadsheets, enforces Bangladesh board GPA 5.0 and 4th subject rules, and compiles batch print-ready PDFs.";
} else if (isEdumeet) {
  pageDescription = "Low-Latency Virtual Classroom & WebRTC Video Conferencing Platform. Built in Flutter with multi-flavor APKs, adaptive 3G/4G bandwidth throttling, and live attendance logging.";
} else if (isSmartAi) {
  pageDescription = "Mobile Edge Vision & Geofenced Attendance System. Android native (Kotlin & Jetpack Compose) running Google ML Kit on-device face tracking with FusedLocation geofencing for sub-350ms zero-trust presence.";
} else if (isNotes) {
  pageDescription = "Enterprise Encrypted Knowledge Base & RBAC Engine. Clean Layered Architecture in NestJS & MongoDB with compound B-Tree indexing, JWT authentication, and sub-5ms lookups across millions of notes.";
} else if (isSssms) {
  pageDescription = "Enterprise Conveyance Billing & Instant Disbursal Platform. Engineered in Flutter & Cloud Firestore with multi-leg journey auditing, automated PDF vouchers, and bKash/EFT payouts.";
} else if (isCampus) {
  pageDescription = "Unified Micro-Frontend & Multi-Tier Campus ERP Infrastructure. Engineered in Spring Boot 3.4, Java 21 Loom, Vue.js 3, and PostgreSQL with zero-downtime micro-service orchestration.";
} else if (isLandtrust) {
  pageDescription = "Digital Land Record Ledger & Title Deed Verification Engine. Engineered in Flutter, Spring Boot, and PostgreSQL PostGIS with CS-SA-RS-BS survey chain verification and parcel overlap detection.";
} else if (isModernOs) {
  pageDescription = "Pure #![no_std] Rust Microkernel Operating System. Features Ring 0 privilege isolation, formal capability non-escalation proofs, lock-free SPSC IPC, and zero ambient authority.";
} else if (isYtStream) {
  pageDescription = "High-Concurrency Media Ingestion & Multi-ISP Caching Engine. Features 16-socket segmented TCP acceleration via aria2c, SponsorBlock ad stripping, H.265 transcoding, and Jellyfin/Plex sync.";
} else if (isSniper) {
  pageDescription = "High-Speed Work Order Auto-Acceptor & Memory Hook Engine. Chrome Extension MV3 with MAIN-world fetch interception, 80ms soft tab cycling, and sub-100ms automated order confirmation.";
} else if (isGecko) {
  pageDescription = "Independent Android Web Browser & GeckoView Omni 134 Runtime. Replaces Android System WebView with Mozilla Quantum, singleton GeckoRuntime lifecycle, and reactive delegates in Kotlin.";
} else if (isDoller) {
  pageDescription = "Multi-Currency Trading, Settlement & PnL Ledger Engine. Engineered in Java 21, Spring Boot 3.5, and Flutter with double-entry accounting, Flyway V1-V10, and automated daily closes.";
} else if (isQuickbooks) {
  pageDescription = "Automated Multi-Entity CSV Normalization, Tiered Bank Reconciliation & Resilient Intuit OAuth 2.0 API Gateway built on Java 21, Spring Boot 4 & Vaadin 25 Flow.";
} else if (isEdugo) {
  pageDescription = "Multi-Tenant Academic ERP & Dual-Security Microservice Architecture. Engineered in Java 21, Spring Boot 3.3, Vaadin Flow, and Flutter 3.29 with dual filter chains and Flyway V1-V8.";
} else if (isCrm) {
  pageDescription = "Multi-Tenant B2B Sales Pipeline, Fuzzy Duplicate Rescan & SLA Escalation Platform. Engineered in Java 21, Spring Boot 3.3, PostgreSQL 16, and React 18 with Flyway V1-V5.";
} else if (isEmailVerifier) {
  pageDescription = "High-Throughput Direct Port 25 SMTP Mailbox Verification & Catch-All Detection REST API. Engineered in Python 3.12, FastAPI, Asyncio, and Docker/Dokploy.";
} else if (isCameraman) {
  pageDescription = "Edge CCTV AI Webhook Ingestion, Bangla BRTA ANPR & Industrial Safety Vision Pipeline. Engineered in pure Rust 2021, Axum 0.7, Tokio, and SQLx PostgreSQL.";
} else if (isClassroom) {
  pageDescription = "Low-Latency WebRTC SFU Virtual Classroom & Media Streaming Engine. Engineered in Java 21, Spring Boot 3.4, Vaadin 24 Flow, LiveKit SFU, and WebRTC Dynacast.";
} else if (isSelfMt) {
  pageDescription = "Envelope Budgeting, Zero-Based Accounting & Offline-First Financial Ledger. Engineered in Flutter 3.29, Dart 3.11, BLoC Architecture, Freezed Immutability, and Firebase.";
}

const specWords = entry.body ? entry.body.trim().split(/\s+/).length : 850;
const readingMinutes = Math.max(2, Math.ceil(specWords / 200));
---

<Layout
  title={`${data.title} | Mahmudul Hasan`}
  description={pageDescription}
  canonicalURL={`https://mahmudulhasan.info.bd/systems/${data.slug}`}
  type="article"
  date={data.date}
  section={data.primaryLanguage}
>
  <Fragment slot="head">
    <link rel="prev" href={`https://mahmudulhasan.info.bd/systems/${prevProject.slug}`} />
    <link rel="next" href={`https://mahmudulhasan.info.bd/systems/${nextProject.slug}`} />
  </Fragment>
  <CaseStudyJsonLd
    title={data.title}
    description={pageDescription}
    slug={data.slug}
    githubUrl={data.githubUrl}
    date={data.date}
    primaryLanguage={data.primaryLanguage}
    keywords={[data.seo.focusKeyword, ...data.seo.secondaryKeywords]}
  />

  <!-- Sticky Top Navigation Bar -->
  <header class="sticky top-0 z-40 w-full border-b border-theme-border bg-theme-surface/95 backdrop-blur-md transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-mono">
        <a href="/" class="text-theme-secondary hover:text-theme-accent transition-colors flex items-center gap-1 font-medium">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
          </svg>
          Portfolio Root
        </a>
        <span class="text-theme-muted">/</span>
        <a href="/#systems" class="text-theme-secondary hover:text-theme-accent transition-colors font-medium">Projects</a>
        <span class="text-theme-muted">/</span>
        <span class="text-theme-accent font-bold truncate max-w-[160px] sm:max-w-none">{data.slug}</span>
      </nav>

      <!-- Action Buttons & Theme Switcher -->
      <div class="flex items-center gap-3">
        <a
          href={data.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm bg-theme-lowest border border-theme-border hover:border-theme-accent text-xs font-mono text-theme-primary transition-all hover:scale-[1.02]"
        >
          <svg class="w-4 h-4 text-theme-muted" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          View Source
        </a>

        <a
          href="#technical-deepdive"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm bg-theme-lowest border border-theme-border hover:border-theme-accent text-xs font-mono text-theme-secondary hover:text-theme-primary transition-all font-semibold"
        >
          <span>Under The Hood ↓</span>
        </a>

        <button
          type="button"
          data-trigger-dossier="true"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm bg-theme-lowest border border-theme-border hover:border-theme-accent text-xs font-mono text-theme-secondary hover:text-theme-primary transition-all font-semibold cursor-pointer"
          title="View Engineering Resume Dossier (Hotkey: D)"
        >
          <svg class="w-3.5 h-3.5 text-theme-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Dossier [D]</span>
        </button>

        <button
          type="button"
          id="btn-share-spec"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm bg-theme-lowest border border-theme-border hover:border-theme-accent text-xs font-mono text-theme-secondary hover:text-theme-primary transition-all font-semibold cursor-pointer"
          title="Share Specification (Hotkey: S)"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span id="share-btn-text">Share Spec</span>
        </button>

        <ThemeSwitcher />
      </div>
    </div>
  </header>

  <!-- Real-Time Reading Progress Telemetry Bar -->
  <div id="reading-progress-bar" class="fixed top-16 left-0 h-0.5 bg-theme-accent z-50 transition-all duration-75 pointer-events-none" style="width: 0%"></div>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16">
    <!-- Hero & Value Proposition Section -->
    <section class="space-y-6">
      <div class="max-w-4xl space-y-4">
        <!-- Architectural Telemetry Metadata Rubric -->
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-theme-muted mb-1">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-theme-lowest border border-theme-border rounded-sm text-theme-accent font-bold uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-theme-accent animate-pulse"></span>
            SYS_SPEC // {data.slug.toUpperCase()}
          </span>
          <span class="px-2.5 py-1 bg-theme-lowest border border-theme-border rounded-sm text-theme-primary font-semibold">
            {data.primaryLanguage}
          </span>
          <span class="px-2.5 py-1 bg-theme-lowest border border-theme-border rounded-sm text-theme-muted">
            AUDITED {data.date}
          </span>
          <span class="px-2.5 py-1 bg-theme-lowest border border-theme-border rounded-sm text-theme-secondary font-medium">
            ⏱ ~{readingMinutes} MIN SPEC READ
          </span>
          <span class="px-2.5 py-1 bg-theme-lowest border border-theme-border rounded-sm text-emerald-700 dark:text-emerald-400 font-semibold">
            ● ZERO FAULT VERIFIED
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-mono font-extrabold text-theme-primary tracking-tight leading-tight">
          {data.title}
        </h1>
        <p class="text-base sm:text-lg text-theme-secondary font-sans leading-relaxed">
          {isPms ? (
            <>
              Automates commercial parking gates and stops ticket revenue theft. Opens barrier gates in under <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">&lt; 0.84 seconds</strong> using instant license plate recognition, engineered in <strong class="text-theme-primary font-semibold">Rust (Axum &amp; Tokio)</strong> and <strong class="text-theme-primary font-semibold">Flutter POS</strong> for 100% crash-proof uptime.
            </>
          ) : isHrms ? (
            <>
              Automates employee attendance and cuts month-end payroll processing from days to minutes. Ingests rush-hour biometric punches from factory and office terminals with <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">zero missed records</strong>, engineered in <strong class="text-theme-primary font-semibold">Java 21 (Project Loom)</strong> and <strong class="text-theme-primary font-semibold">Spring Boot 3.4</strong>.
            </>
          ) : isMonitor ? (
            <>
              Tracks team focus, productive hours, and security compliance without slowing down their computers. Replaces heavy commercial surveillance software with an ultra-lightweight client consuming <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">&lt; 14 MB RAM</strong> and <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">&lt; 0.01% CPU</strong>, built in <strong class="text-theme-primary font-semibold">Rust 2024 (Tokio)</strong> and <strong class="text-theme-primary font-semibold">Spring Boot 3.4</strong>.
            </>
          ) : isSwift ? (
            <>
              Permanently blacks out confidential bank account numbers, passwords, and sensitive client details from financial PDF statements before sharing. Guarantees <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">zero data leaks</strong> and zero recoverable text, engineered with <strong class="text-theme-primary font-semibold">Python (PyMuPDF)</strong> and <strong class="text-theme-primary font-semibold">Flutter</strong> with native Arabic and English typography.
            </>
          ) : isHomesync ? (
            <>
              Turns architectural floorplans into interactive 3D virtual models where homeowners and electricians test smart lighting and security sensors in real time. Runs at a smooth <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">60 FPS</strong> in any browser, built with <strong class="text-theme-primary font-semibold">React 19, Three.js &amp; React Three Fiber</strong>.
            </>
          ) : isMarksheet ? (
            <>
              Eliminates teacher grading mistakes and compresses weeks of exam tabulation into minutes. Ingests multi-subject Excel rosters, applies official <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">GPA 5.0 and 4th-subject bonus rules</strong>, and batch-generates 1,200+ print-ready PDF marksheets, built with <strong class="text-theme-primary font-semibold">Node.js 22 &amp; Prisma ORM</strong>.
            </>
          ) : isEdumeet ? (
            <>
              A live video classroom built for students and teachers with slow internet connections. Automatically downscales video to prevent buffering on spotty mobile data, logs attendance automatically, and maintains <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">under 95ms delay</strong>, engineered in <strong class="text-theme-primary font-semibold">Flutter 3.29 &amp; WebRTC</strong>.
            </>
          ) : isSmartAi ? (
            <>
              Stops students or staff from faking attendance for friends. Uses on-device facial recognition and a <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">50-meter GPS geofence</strong> to verify presence in under a second with zero cellular data cost and offline sync, engineered in <strong class="text-theme-primary font-semibold">Kotlin 2.0 &amp; Jetpack Compose</strong>.
            </>
          ) : isNotes ? (
            <>
              A private, bank-grade encrypted documentation workspace for corporate teams to store confidential wikis and credentials. Enforces strict permission controls and sub-5ms search across millions of records with <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">zero data leaks</strong>, engineered in <strong class="text-theme-primary font-semibold">NestJS 10, TypeScript &amp; MongoDB</strong>.
            </>
          ) : isSssms ? (
            <>
              Replaces chaotic paper travel slips with an auditable mobile expense tracker for employee visits (Rickshaw, CNG, Bus, Fuel). Verifies standard transit rates, generates accounting vouchers, and disburses reimbursements in seconds via <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">bKash, Nagad &amp; bank transfer</strong>, built in <strong class="text-theme-primary font-semibold">Flutter 3.29 &amp; Firestore</strong>.
            </>
          ) : isCampus ? (
            <>
              Consolidates student attendance, teacher payroll, GPA grade cards, and fee tracking into a single easy administrative dashboard. Replaces 5 disconnected school software systems with <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">zero monthly cloud subscription fees</strong>, built in <strong class="text-theme-primary font-semibold">Spring Boot 3.4 (Java 21 Loom) &amp; Vue.js 3</strong>.
            </>
          ) : isLandtrust ? (
            <>
              Protects property buyers from land fraud and double-selling by verifying historical Bangladesh ownership chains (CS, SA, RS, BS). Automatically checks boundary disputes in <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">sub-28ms</strong> and converts traditional units (Katha, Bigha, Decimal), engineered in <strong class="text-theme-primary font-semibold">Flutter 3.29, Spring Boot 3.4 &amp; PostGIS</strong>.
            </>
          ) : isModernOs ? (
            <>
              A computer operating system engineered from scratch in Rust where device driver crashes (like Wi-Fi or disk errors) can never crash the whole computer. Strips core supervisor privileges down to an audited <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">&lt; 2,500 lines of code</strong>, built in pure <strong class="text-theme-primary font-semibold">#![no_std] Rust</strong>.
            </>
          ) : isYtStream ? (
            <>
              Downloads and archives video playlists and educational lectures at full internet speed via 16 simultaneous network streams. Automatically skips promotional sponsor plugs and streams smoothly on home TVs with <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">zero buffering</strong>, built in <strong class="text-theme-primary font-semibold">Python 3.12, yt-dlp &amp; aria2c</strong>.
            </>
          ) : isSniper ? (
            <>
              A lightning-fast browser automation assistant that monitors contractor job portals and claims high-value work orders in <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">under 250 milliseconds</strong> before competitors can even refresh the page, engineered as a <strong class="text-theme-primary font-semibold">Chrome Extension MV3</strong> with in-memory API interception.
            </>
          ) : isGecko ? (
            <>
              An independent, privacy-first mobile web browser built on Mozilla's Gecko engine instead of Google Chrome. Protects user search history, blocks invasive trackers, and loads pages smoothly with <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">zero Google Play dependencies</strong>, engineered in native <strong class="text-theme-primary font-semibold">Android Kotlin &amp; GeckoView 134</strong>.
            </>
          ) : isDoller ? (
            <>
              A foreign currency exchange platform that records every trade, dollar exchange, and profit calculation with zero mathematical discrepancies. Enforces balanced <strong class="text-emerald-700 dark:text-emerald-400 font-semibold">double-entry accounting</strong> and works reliably even during sudden internet dropouts, engineered in <strong class="text-theme-primary font-semibold">Java 21, Spring Boot 3.5 &amp; Flutter 3.29</strong>.
            </>
