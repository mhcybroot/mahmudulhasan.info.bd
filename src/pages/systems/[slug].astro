    <span class="text-rose-400">let</span> child1 = child1.<span class="text-cyan-300">unwrap</span>();
    <span class="text-rose-400">if</span> !table.<span class="text-cyan-300">verify</span>(child1.id, <span class="text-amber-300">CapabilityRights</span>::READ) &#123;
